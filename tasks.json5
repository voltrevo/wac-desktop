{
  // The desktop as dist/index.html, with a disk (the browser's storage, when it is offered); its own apps, each a page
  // of its own in dist/apps/<name>/ and the Archive Explorer in dist/explorer/; the `wac` command as dist/bin/wac, for
  // the Terminal (tools/wacbin.py); then site.wac, which puts each app's module at dist/apps/<name>.wasm, where the
  // desktop starts it from its site, and writes the site's index.json.
  build: "wac run --allow-read --allow-write --allow-run build.wac src/desktop.wac dist --title 'Desktop' --grant read,write && wac run --allow-read --allow-write --allow-run build.wac src/app.wac dist/explorer --title 'Archive Explorer' && wac run --allow-read --allow-write --allow-run build.wac src/apps/calc.wac dist/apps/calc --title 'Calculator' && wac run --allow-read --allow-write --allow-run build.wac src/apps/viewer.wac dist/apps/viewer --title 'Viewer' && wac run --allow-read --allow-write --allow-run build.wac src/apps/editor.wac dist/apps/editor --title 'Editor' && wac run --allow-read --allow-write --allow-run build.wac src/apps/mdedit.wac dist/apps/markdown --title 'Markdown editor' && wac run --allow-read --allow-write --allow-run build.wac src/apps/terminal.wac dist/apps/terminal --title 'Terminal' --spawn applet && wac run --allow-read --allow-write --allow-run build.wac src/apps/ide.wac dist/apps/ide --title 'wac IDE' --grant read,write --spawn checker && wac run --allow-read --allow-write --allow-run build.wac src/apps/stackfall.wac dist/apps/stackfall --title 'Stackfall' && wac run --allow-read --allow-write --allow-run build.wac src/apps/mandelbrot.wac dist/apps/mandelbrot --title 'Mandelbrot' --grant read,write && wac run --allow-read --allow-write --allow-run build.wac src/apps/pip.wac dist/apps/pip --title 'Pip and the Lost Lanterns' --grant read,write && python3 tools/wacbin.py dist && wac run --allow-read --allow-write site.wac dist",
  serve: "wac sh --allow-read --allow-net -c 'httpd -8080 dist'",
  // The disk tests stand on a `MemoryStore`, whose clock is the host's, so they take `Sys`; and a test that takes
  // `Sys` runs only under some grant. Reading is the least of them, and nothing here reads a file.
  test: "wac test --allow-read test",
  // In Chromium, against dist/ — build first; both need Playwright. The desktop, used as a person uses it:
  "test:stackfall-audio": "node tools/stackfall_audio_test.js",
  "test:stackfall": "node tools/stackfall_test.js",
  "test:mandelbrot": "node tools/mandelbrot_test.js",
  "test:pip": "node tools/pip_test.js",
  "test:settings": "node tools/settings_test.js",
  // Pip's songs as WAV files in music/, to listen to outside the game.
  "pip:music": "mkdir -p music && wac run --allow-read --allow-write tools/pip_music.wac -- music",
  "test:desk": "node tools/desk_test.js",
  // and real drops on the Archive Explorer — files, folders, file:// and http://.
  "test:drops": "node tools/drop_test.js",
  // Regenerate test/fixtures.wac from tools/fixtures.py.
  fixtures: "python3 tools/fixtures.py",
  // Regenerate samples/demo.zip, then src/desk/seed.wac — the welcome note and demo.zip a new desktop gets.
  demo: "python3 tools/demo.py",
  seed: "python3 tools/seed.py",
}
