{
  // The desktop as dist/index.html, with a disk (the browser's storage, when it is offered); and the
  // Archive Explorer on its own as dist/explorer/index.html.
  build: "wac run --allow-read --allow-write --allow-run build.wac src/desktop.wac dist --title 'Desktop' --grant read,write --spawn applet && wac run --allow-read --allow-write --allow-run build.wac src/app.wac dist/explorer --title 'Archive Explorer'",
  serve: "wac sh --allow-read --allow-net -c 'httpd -8080 dist'",
  // The disk tests stand on a `MemoryStore`, whose clock is the host's, so they take `Sys`; and a test that takes
  // `Sys` runs only under some grant. Reading is the least of them, and nothing here reads a file.
  test: "wac test --allow-read test",
  // In Chromium, against dist/ — build first; both need Playwright. The desktop, used as a person uses it:
  "test:desk": "node tools/desk_test.js",
  // and real drops on the Archive Explorer — files, folders, file:// and http://.
  "test:drops": "node tools/drop_test.js",
  // Regenerate test/fixtures.wac from tools/fixtures.py.
  fixtures: "python3 tools/fixtures.py",
  // Regenerate samples/demo.zip, then src/desk/seed.wac — the welcome note and demo.zip a new desktop gets.
  demo: "python3 tools/demo.py",
  seed: "python3 tools/seed.py",
}
