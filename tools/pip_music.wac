// Pip's songs as WAV files, to listen to outside the game: each song with every layer, and the fields' song as a
// level plays it — two bars with only what is always there, then two more as each layer is earned.
//
//     wac run --allow-read --allow-write tools/pip_music.wac <folder>

import { Sys } from "std";
import { Vec } from "core";
import { LAYERS, Song, mixed, songs, stems } from "../src/apps/pip/music.wac";
import { RATE } from "../src/apps/pip/chip.wac";

void le(Vec<u8> out, i32 v, i32 bytes) { for (i32 k = 0; k < bytes; k++) { out.push(((v >> (8 * k)) & 255) as@ u8); } }

/** `samples` as a 16-bit mono WAV. */
u8[] wav(f64[] samples) {
  Vec<u8> out = Vec.create();
  i32 data = samples.len() * 2;
  u8[] riff = "RIFF".toBytes();
  for (i32 i = 0; i < 4; i++) { out.push(riff[i]); }
  le(out, 36 + data, 4);
  u8[] head = "WAVEfmt ".toBytes();
  for (i32 i = 0; i < 8; i++) { out.push(head[i]); }
  le(out, 16, 4);
  le(out, 1, 2);
  le(out, 1, 2);
  le(out, RATE, 4);
  le(out, RATE * 2, 4);
  le(out, 2, 2);
  le(out, 16, 2);
  u8[] d = "data".toBytes();
  for (i32 i = 0; i < 4; i++) { out.push(d[i]); }
  le(out, data, 4);
  for (i32 i = 0; i < samples.len(); i++) {
    f64 x = samples[i] > 1.0 ? 1.0 : (samples[i] < 0.0 - 1.0 ? 0.0 - 1.0 : samples[i]);
    le(out, (x * 32767.0) as~ i32, 2);
  }
  return out.toArray();
}

/** A looping song twice round, so the join is heard. */
f64[] twice(f64[] s) {
  f64[] out = f64[].filled(s.len() * 2, 0.0);
  for (i32 i = 0; i < out.len(); i++) { out[i] = s[i % s.len()]; }
  return out;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  string dir = args.len() > 0 ? args[0] : ".";
  Song[] all = songs();
  for (i32 i = 0; i < all.len(); i++) {
    Song s = all[i];
    f64[][] parts = stems(s);
    f64[] full = mixed(parts, LAYERS - 1);
    await sys.files().writeFile("\{dir}/\{s.name}.wav", wav(s.loops ? twice(full) : full));
    sys.stdout().line("\{s.name}: \{(s.length() as f64) / (RATE as f64)} s");
    if (s.name == "field" || s.name == "towers") {
      // As a level plays it: layer 0, then one more each two bars, round the song as far as it takes.
      i32 bar = s.length() / s.bars;
      f64[] grow = f64[].filled(bar * 2 * LAYERS, 0.0);
      for (i32 k = 0; k < grow.len(); k++) {
        i32 upTo = k / (bar * 2);
        f64 v = 0.0;
        for (i32 l = 0; l <= upTo; l++) { v = v + parts[l][k % s.length()]; }
        grow[k] = v;
      }
      await sys.files().writeFile("\{dir}/\{s.name}-lanterns.wav", wav(grow));
    }
  }
  return 0;
}
