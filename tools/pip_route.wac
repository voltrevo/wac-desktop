// A route across one of Pip's levels, found by trying keys, written as a run file (`src/apps/pip/runs.wac`):
//
//     wac run --allow-read --allow-write tools/pip_route.wac -- <level 1-19> <out.piprun>
//
// **For testing what plays runs back** — the Replays card, a run brought in, racing it — with a run that is real: a beam
// search over a few steps of keys at a time, each candidate played again from the level's start by the game's own
// rules and kept for the lanterns it has lit, then for how near it is to the next lantern or the open door. It is not
// fast and its routes are not good; it only has to reach the door.

import { Sys } from "std";
import { Vec } from "core";
import { Level, allLevels } from "../src/apps/pip/levels.wac";
import { Keys, World, load, step } from "../src/apps/pip/world.wac";
import { LEVEL_RUN, Leg, Run, checkRun, keyByte, keysOf, runBytes } from "../src/apps/pip/runs.wac";

static i32 CHUNK = 8;
static i32 BEAM = 48;
static i32 TILE = 16;

struct Tried {
  u8[] keys;
  f64 score;
  bool won;
}

/** `keys` played from the start of `l`. */
World played(Level l, u8[] keys) {
  World w = load(l);
  for (i32 i = 0; i < keys.len() && !w.won; i++) { step(w, keysOf(keys[i])); }
  return w;
}

/** Where the next thing to reach is: the nearest lantern not lit, or the door once every one is. */
f64 distance(World w) {
  f64 best = 1.0e9;
  bool open = w.lit == w.lanterns;
  for (i32 y = 0; y < w.rows; y++) {
    for (i32 x = 0; x < w.cols; x++) {
      u8 c = w.tiles[y * w.cols + x];
      bool want = open ? c == 'E' : c == 'L';
      if (!want) { continue; }
      f64 dx = (x * TILE + 8) as f64 - w.hero.x;
      f64 dy = (y * TILE + 8) as f64 - w.hero.y;
      f64 d = (dx < 0.0 ? 0.0 - dx : dx) + 1.6 * (dy < 0.0 ? 0.0 - dy : dy);
      if (d < best) { best = d; }
    }
  }
  return best;
}

f64 scoreOf(World w) {
  if (w.won) { return 1.0e12; }
  return (w.lit as f64) * 1.0e6 - distance(w) - (w.deaths as f64) * 5000.0 - (w.hero.dying > 0 ? 5000.0 : 0.0);
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 2) {
    sys.stderr().line("usage: pip_route.wac <level 1-19> <out.piprun>");
    return 2;
  }
  Level[] levels = allLevels();
  i32 index = 0;
  u8[] digits = args[0].toBytes();
  for (i32 i = 0; i < digits.len(); i++) { index = index * 10 + (digits[i] - '0') as i32; }
  index = index - 1;
  Level l = levels[index];
  // Each chunk: a direction — left, none, right — and the jump held all of it, part of it, or not at all.
  Vec<u8[]> moves = Vec.create();
  for (i32 dir = 0; dir < 3; dir++) {
    for (i32 jump = 0; jump < 3; jump++) {
      u8[] m = u8[].filled(CHUNK, 0 as u8);
      for (i32 s = 0; s < CHUNK; s++) {
        bool held = jump == 1 || (jump == 2 && s < 3);
        Keys k = Keys(dir == 0, dir == 2, held, held && s == 0);
        m[s] = keyByte(k);
      }
      moves.push(m);
    }
  }
  Vec<Tried> beam = Vec.create();
  beam.push(Tried(u8[](), 0.0, false));
  for (i32 depth = 0; depth < 400; depth++) {
    Vec<Tried> next = Vec.create();
    for (i32 b = 0; b < beam.len(); b++) {
      for (i32 m = 0; m < moves.len(); m++) {
        u8[] base = beam.get(b).keys;
        u8[] keys = u8[].filled(base.len() + CHUNK, 0 as u8);
        for (i32 i = 0; i < base.len(); i++) { keys[i] = base[i]; }
        for (i32 i = 0; i < CHUNK; i++) { keys[base.len() + i] = moves.get(m)[i]; }
        World w = played(l, keys);
        if (w.won) {
          // Cut at the step that went through the door: a run stops there.
          World again = load(l);
          i32 n = 0;
          while (!again.won) { step(again, keysOf(keys[n])); n++; }
          u8[] run = u8[].filled(n, 0 as u8);
          for (i32 i = 0; i < n; i++) { run[i] = keys[i]; }
          Run r = Run(LEVEL_RUN, [Leg(index, run)]);
          if (!checkRun(r, levels).ok) { sys.stderr().line("found a run that does not stand"); return 1; }
          auto wrote = sys.files().writeFile(args[1], runBytes(r)).wait();
          if (wrote.isErr()) { sys.stderr().line("\{args[1]}: could not write it"); return 1; }
          sys.stdout().line("\{l.name}: \{n} steps, written to \{args[1]}");
          return 0;
        }
        next.push(Tried(keys, scoreOf(w), false));
      }
    }
    // The best `BEAM` of them, no two at the same score — the same place reached two ways is one place.
    Vec<Tried> kept = Vec.create();
    while (kept.len() < BEAM && next.len() > 0) {
      i32 top = 0;
      for (i32 i = 1; i < next.len(); i++) { if (next.get(i).score > next.get(top).score) { top = i; } }
      Tried t = next.get(top);
      next.remove(top);
      bool same = false;
      for (i32 i = 0; i < kept.len(); i++) { if (kept.get(i).score == t.score) { same = true; } }
      if (!same) { kept.push(t); }
    }
    beam = kept;
    if (depth % 20 == 0) { sys.stdout().line("depth \{depth}: best \{beam.get(0).score}"); }
  }
  sys.stderr().line("\{l.name}: no way to the door found");
  return 1;
}
