// Render the actual game at a fixed frame for artwork review, without a browser or changing the level files.
// wac run --allow-write --allow-read tools/pip_art.wac /tmp/pip-art
import { Sys } from "std";
import { Buf } from "core";
import { allLevels } from "../src/apps/pip/levels.wac";
import { Keys, load, step } from "../src/apps/pip/world.wac";
import { Screen, SCREEN_W, SCREEN_H, drawWorld, snap } from "../src/apps/pip/art.wac";
export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() != 1) { sys.stderr().line("usage: pip_art.wac <output-prefix>"); return 2; }
  auto levels = allLevels();
  for (i32 scene = 0; scene < 5; scene++) {
    auto w = load(levels[scene >= 3 ? 0 : scene]);
    for (i32 i = 0; i < 10; i++) { step(w, Keys.none()); }
    Screen s = Screen.create(); snap(s, w);
    s.camX = scene >= 3 ? w.cols * 16 - SCREEN_W : (scene == 2 ? 256 : 0);
    if (scene == 4) { w.lit = w.lanterns; }
    s.camY = w.rows * 16 - SCREEN_H;
    drawWorld(s, w, null, 120);
    Buf b = Buf.create();
    b.pushStr("P6\n\{SCREEN_W} \{SCREEN_H}\n255\n");
    for (i32 i = 0; i < SCREEN_W * SCREEN_H; i++) {
      b.push(s.px[i * 4]); b.push(s.px[i * 4 + 1]); b.push(s.px[i * 4 + 2]);
    }
    auto result = await sys.files().writeFile(args[0] + "-\{scene}.ppm", b.take());
    if (result.isErr()) { sys.stderr().line("could not write preview"); return 1; }
  }
  return 0;
}
