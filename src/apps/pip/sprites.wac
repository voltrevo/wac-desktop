/** Choose by physical state and simulation steps: a paused game freezes its pose, regardless of redraw rate. */
export i32 pipPose(Hero h, i32 steps, i32 landedAt) {
  if (h.dying > 0) { return 17; }
  if (!h.ground) {
    if (h.wall != 0 && h.vy > 0.0) { return 16; }
    if (h.vy < -3.0) { return 9; }
    if (h.vy < -1.0) { return 10; }
    if (h.vy <= 1.0) { return 11; }
    return h.vy < 3.5 ? 12 : 13;
  }
  i32 landed = steps - landedAt;
  if (landed >= 0 && landed < 7) { return landed < 3 ? 14 : 15; }
  if (h.stride > 0) { return 3 + (h.stride / 4) % 6; }
  if (steps % 240 >= 232) { return 2; }
  return (steps / 48) % 2;
}
