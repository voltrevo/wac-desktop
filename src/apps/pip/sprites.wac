// Pip's hand-authored 16 × 20 pixel poses. Each frame redraws the whole silhouette, with consistent face, hood and light.
// The image-review tools read these same rows; there is no separate illustrative version of the character.

import { Hero } from "./world.wac";

export static i32 PIP_W = 16;
export static i32 PIP_H = 20;

