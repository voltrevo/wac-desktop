// Pip's sounds, made here as a little sound chip would make them: square waves of a few widths, a triangle, and
// noise, each shaped by a volume that falls away. Every effect, and the tune, is samples worked out once when the
// game starts and handed to the page (`Page.sound`), which plays them as often as they are cued.
//
// **The tune is original**: eight bars in A minor over A–F–C–G, a square-wave lead over a triangle bass and a
// whisper of noise on the off-beats, looped.

import { Vec } from "core";

export static i32 RATE = 22050;

/** Samples for `seconds`. */
i32 len(f64 seconds) { return (seconds * (RATE as f64)) as~ i32; }

/** The frequency of a note `semis` semitones from A4. */
export f64 hz(i32 semis) {
  f64 f = 440.0;
  i32 n = semis;
  // 2^(1/12), applied as many times as there are semitones: exact enough for a chip.
  while (n > 0) { f = f * 1.0594630943592953; n--; }
  while (n < 0) { f = f / 1.0594630943592953; n++; }
  return f;
}

/** A square wave of `duty` (0.5 is even) sliding from `from` Hz to `to`, falling to silence, into `out` at `at`. */
void square(f64[] out, i32 at, f64 seconds, f64 from, f64 to, f64 duty, f64 volume) {
  i32 n = len(seconds);
  f64 phase = 0.0;
  for (i32 i = 0; i < n && at + i < out.len(); i++) {
    f64 t = (i as f64) / (n as f64);
    f64 f = from + (to - from) * t;
    phase = phase + f / (RATE as f64);
    phase = phase - phase.floor();
    f64 env = (1.0 - t) * (1.0 - t);
    out[at + i] = out[at + i] + (phase < duty ? volume : 0.0 - volume) * env;
  }
}

/** A triangle wave, as a chip's bass channel, held at `volume` and let go at the end. */
void triangle(f64[] out, i32 at, f64 seconds, f64 f, f64 volume) {
  i32 n = len(seconds);
  f64 phase = 0.0;
  for (i32 i = 0; i < n && at + i < out.len(); i++) {
    phase = phase + f / (RATE as f64);
    phase = phase - phase.floor();
    f64 wave = phase < 0.5 ? 4.0 * phase - 1.0 : 3.0 - 4.0 * phase;
    f64 tail = i > n - 200 ? ((n - i) as f64) / 200.0 : 1.0;
    out[at + i] = out[at + i] + wave * volume * tail;
  }
}

/** Noise from a shift register, as a chip makes it, falling away; `pitch` is how often it changes. */
void noise(f64[] out, i32 at, f64 seconds, i32 pitch, f64 volume) {
  i32 n = len(seconds);
  i32 reg = 0x7FFF;
  f64 v = 1.0;
  for (i32 i = 0; i < n && at + i < out.len(); i++) {
    if (i % pitch == 0) {
      i32 bit = (reg ^ (reg >> 1)) & 1;
      reg = (reg >> 1) | (bit << 14);
      v = (reg & 1) == 1 ? 1.0 : 0.0 - 1.0;
    }
    f64 t = (i as f64) / (n as f64);
    out[at + i] = out[at + i] + v * volume * (1.0 - t) * (1.0 - t);
  }
}

f64[] silence(f64 seconds) { return f64[].filled(len(seconds), 0.0); }

/** The effects, by cue: `world.wac`'s CUE_ numbers index this. */
export f64[][] effects() {
  f64[] jump = silence(0.16);
  square(jump, 0, 0.16, 280.0, 620.0, 0.5, 0.35);
  f64[] wall = silence(0.16);
  square(wall, 0, 0.16, 420.0, 900.0, 0.25, 0.3);
  f64[] lantern = silence(0.32);
  square(lantern, 0, 0.1, hz(7), hz(7), 0.5, 0.3);
  square(lantern, len(0.07), 0.1, hz(11), hz(11), 0.5, 0.3);
  square(lantern, len(0.14), 0.18, hz(14), hz(14), 0.5, 0.3);
  f64[] stomp = silence(0.14);
  square(stomp, 0, 0.14, 520.0, 140.0, 0.5, 0.4);
  noise(stomp, 0, 0.06, 6, 0.2);
  f64[] hurt = silence(0.5);
  noise(hurt, 0, 0.35, 12, 0.35);
  square(hurt, 0, 0.5, 440.0, 90.0, 0.5, 0.3);
  f64[] checkpoint = silence(0.3);
  square(checkpoint, 0, 0.12, hz(3), hz(3), 0.5, 0.28);
  square(checkpoint, len(0.1), 0.2, hz(10), hz(10), 0.5, 0.28);
  f64[] open = silence(0.6);
  i32[] up = [3, 7, 10, 15];
  for (i32 i = 0; i < up.len(); i++) { square(open, len(0.09 * (i as f64)), 0.2, hz(up[i]), hz(up[i]), 0.5, 0.28); }
  f64[] win = silence(1.3);
  i32[] tune = [0, 3, 7, 12, 10, 12, 15, 19];
  for (i32 i = 0; i < tune.len(); i++) {
    f64 d = i == tune.len() - 1 ? 0.5 : 0.18;
    square(win, len(0.11 * (i as f64)), d, hz(tune[i]), hz(tune[i]), 0.5, 0.26);
  }
  triangle(win, 0, 1.2, hz(0 - 24), 0.25);
  f64[] crumble = silence(0.12);
  noise(crumble, 0, 0.12, 30, 0.25);
  f64[] land = silence(0.06);
  noise(land, 0, 0.06, 40, 0.12);
  // Index 0 is nothing; the rest are CUE_JUMP onwards, in order.
  return [silence(0.01), jump, wall, lantern, stomp, hurt, checkpoint, open, win, crumble, land];
}

/** A note name — `E5`, `C#4` — as semitones from A4; `.` for a rest and `-` for a held note are -1000. */
export i32 noteOf(string n) {
  if (n == "." || n == "-" || n == "") { return 0 - 1000; }
  u8[] b = n.toBytes();
  i32[] fromC = [9, 11, 0, 2, 4, 5, 7];
  i32 semi = fromC[(b[0] - 'A') as i32];
  i32 at = 1;
  if (b.len() > 2 && b[1] == '#') {
    semi++;
    at = 2;
  }
  i32 octave = (b[at] - '0') as i32;
  // C4 is 9 below A4.
  return semi - 9 + (octave - 4) * 12;
}

/** The words of `s`, split at spaces. */
string[] notes(string s) {
  Vec<string> out = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i == s.len() || s.slice(i, i + 1) == " ") {
      if (i > start) { out.push(s.slice(start, i)); }
      start = i + 1;
    }
  }
  return out.toArray();
}

/** Each note of `line` — eighths, a `-` holding the one before — played by the lead or the bass into `out`. */
void voiceLine(f64[] out, string line, f64 eighth, bool lead) {
  string[] ns = notes(line);
  for (i32 i = 0; i < ns.len(); i++) {
    i32 semi = noteOf(ns[i]);
    if (semi == 0 - 1000) { continue; }
    i32 held = 1;
    while (i + held < ns.len() && ns[i + held] == "-") { held++; }
    f64 d = eighth * (held as f64);
    if (lead) {
      // A lead that rings a little past its length, at a quarter duty — the thin, bright sound of a chip's lead.
      square(out, len(eighth * (i as f64)), d * 1.15, hz(semi), hz(semi), 0.25, 0.16);
    } else {
      triangle(out, len(eighth * (i as f64)), d * 0.9, hz(semi), 0.3);
    }
  }
}

/** The tune, eight bars at 128 beats a minute, to loop. */
export f64[] tune() {
  f64 eighth = 60.0 / 128.0 / 2.0;
  f64[] out = silence(eighth * 64.0);
  voiceLine(out, "E5 - A5 - G5 E5 D5 -   C5 - D5 E5 - - C5 A4   G4 - C5 - E5 - G5 E5   D5 - - B4 D5 - G5 - "
          + "E5 - A5 - B5 A5 G5 E5   F5 - E5 D5 C5 - A4 C5   E5 - G5 - C6 - B5 G5   A5 - - - G5 - . .", eighth, true);
  voiceLine(out, "A2 A3 A2 A3 A2 A3 A2 A3   F2 F3 F2 F3 F2 F3 F2 F3   C3 C4 C3 C4 C3 C4 C3 C4   G2 G3 G2 G3 G2 G3 G2 G3 "
          + "A2 A3 A2 A3 A2 A3 A2 A3   F2 F3 F2 F3 F2 F3 F2 F3   C3 C4 C3 C4 C3 C4 C3 C4   G2 G3 G2 G3 B2 B3 G2 G3", eighth, false);
  for (i32 i = 1; i < 64; i = i + 2) { noise(out, len(eighth * (i as f64)), 0.03, 3, 0.05); }
  return out;
}
