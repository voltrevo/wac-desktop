// Pip's music: one theme, arranged for each kind of place, on a small sound chip, written down as a tracker would.
//
// **A song is tracks of notes on a grid** — `E5 - A5 - G5 E5`, a token a step, `-` holding the note before and `.` a
// rest — each played by an instrument: a pulse wave of some width, perhaps sweeping (the chorus of an old chip), a
// triangle, noise, a kick, a snare, a hat, or an arpeggio that runs through a chord fast enough to sound like one. Any
// of them can have vibrato, slide into a note (`~E5`), and echo. A chord is a root, minor, or major with `^`: `F4^`.
//
// **The theme is written once** (`THEME`) and every song is an arrangement of it: moved to another key, into the
// major, slowed to half speed, under a different bass and beat.
//
// **Each song is seven layers.** Layer 0 is always there — a bass and a pulse — and layers 1 to 4 are the melody, the
// chords, a counter-melody and the drums, which a level brings in as its lanterns are lit; layer 5 is a sparkle for
// when the door opens, and layer 6 a ticking hat while Pip is ahead of the ghost of the best run. The game plays every layer from the same moment and turns each up when it is earned, so they
// never drift apart (`Page.sound`'s voices, started together, with their volumes set as the level goes on).

import { Vec } from "core";
import { sin } from "../maths.wac";
import { RATE, noteOf } from "./chip.wac";

export static i32 PULSE = 0;
export static i32 TRI = 1;
export static i32 KICK = 2;
export static i32 SNARE = 3;
export static i32 HAT = 4;
export static i32 ARP = 5;
export static i32 LAYERS = 7;
/** The layers by what earns them: always there, the melody, three for lanterns, the open door, and racing a ghost. */
export static i32 RACE = 6;

/** How an instrument sounds: its wave, how loud, its shape over a note, and what it does to the note. */
export struct Inst {
  i32 kind;
  f64 volume;
  /** A pulse's width: 0.5 square, 0.25 and 0.125 thinner and brighter. */
  f64 duty;
  /** Seconds to rise, seconds to fall to `sustain`, the level held, and seconds to die away after. */
  f64 attack;
  f64 decay;
  f64 sustain;
  f64 release;
  /** Vibrato: how far, in semitones, and how fast. */
  f64 vibrato;
  f64 vibratoRate;
  /** A pulse whose width sweeps, this many times a second: 0 for none. */
  f64 sweep;
  /** Echo: how much comes back, and after how long. */
  f64 echo;
  f64 echoTime;
}

/** A line of notes, `perBeat` tokens to a beat, played by `inst` in `layer`; repeated to the song's end. */
export struct Track {
  Inst inst;
  i32 layer;
  i32 perBeat;
  string notes;
}

export struct Song {
  string name;
  f64 bpm;
  i32 bars;
  /** Played round and round: notes and echoes run off the end into the start. Otherwise once, with a tail. */
  bool loops;
  Vec<Track> tracks;

  Song make(string name, f64 bpm, i32 bars, bool loops) { return Song(name, bpm, bars, loops, Vec.create()); }

  Song add(this, Inst inst, i32 layer, i32 perBeat, string notes) {
    this.tracks.push(Track(inst, layer, perBeat, notes));
    return this;
  }

  /** Samples in the song: its bars, and, played once, two seconds for its last notes to die away. */
  i32 length(this) {
    f64 secs = (this.bars as f64) * 4.0 * 60.0 / this.bpm + (this.loops ? 0.0 : 2.0);
    return (secs * (RATE as f64)) as~ i32;
  }
}

// ── Instruments ─────────────────────────────────────────────────────────────

Inst inst(i32 kind, f64 volume, f64 duty) { return Inst(kind, volume, duty, 0.005, 0.15, 0.7, 0.06, 0.0, 5.0, 0.0, 0.0, 0.25); }

export Inst lead(f64 volume, f64 duty) { return inst(PULSE, volume, duty); }

export Inst singing(f64 volume, f64 duty) {
  Inst i = inst(PULSE, volume, duty);
  i.vibrato = 0.18;
  i.vibratoRate = 5.5;
  i.release = 0.12;
  i.echo = 0.3;
  i.echoTime = 0.3;
  return i;
}

export Inst triangle(f64 volume) {
  Inst i = inst(TRI, volume, 0.5);
  i.sustain = 0.9;
  return i;
}

export Inst pad(f64 volume) {
  Inst i = inst(PULSE, volume, 0.3);
  i.attack = 0.25;
  i.decay = 0.3;
  i.sustain = 0.8;
  i.release = 0.5;
  i.sweep = 0.35;
  i.vibrato = 0.06;
  return i;
}

export Inst arp(f64 volume, f64 duty) {
  Inst i = inst(ARP, volume, duty);
  i.sustain = 0.6;
  return i;
}

export Inst sparkle(f64 volume) {
  Inst i = inst(ARP, volume, 0.125);
  i.decay = 0.08;
  i.sustain = 0.35;
  i.echo = 0.45;
  i.echoTime = 0.21;
  return i;
}

export Inst kick(f64 volume) { return inst(KICK, volume, 0.5); }
export Inst snare(f64 volume) { return inst(SNARE, volume, 0.5); }
export Inst hat(f64 volume) { return inst(HAT, volume, 0.5); }

Inst echoing(Inst i, f64 amount, f64 time) {
  i.echo = amount;
  i.echoTime = time;
  return i;
}

// ── Notes, as text ──────────────────────────────────────────────────────────

/** The tokens of `s`: split at spaces, the `|` that mark bars left out. */
export string[] tokens(string s) {
  Vec<string> out = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i == s.len() || s.slice(i, i + 1) == " ") {
      if (i > start) {
        string t = s.slice(start, i);
        if (t != "|") { out.push(t); }
      }
      start = i + 1;
    }
  }
  return out.toArray();
}

string join(string[] ts) {
  string out = "";
  for (i32 i = 0; i < ts.len(); i++) { out = out + (i > 0 ? " " : "") + ts[i]; }
  return out;
}

/** A note's name for semitones from A4: `C#5`. */
export string nameOf(i32 semis) {
  string[] names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
  i32 v = semis + 9 + 48;
  return names[v % 12] + "\{v / 12}";
}

bool isNote(string t) {
  if (t.len() < 2) { return false; }
  u8 c = t.toBytes()[t.slice(0, 1) == "~" ? 1 : 0];
  return c >= 'A' && c <= 'G';
}

/** A token's parts: whether it slides in, its note, and whether it is a major chord. */
struct Parts {
  bool slide;
  string note;
  bool major;
}

Parts partsOf(string t) {
  bool slide = t.slice(0, 1) == "~";
  string rest = slide ? t.slice(1, t.len()) : t;
  bool major = rest.slice(rest.len() - 1, rest.len()) == "^";
  return Parts(slide, major ? rest.slice(0, rest.len() - 1) : rest, major);
}

/** Each note of `s` with `f` applied to its semitones; everything else as it was. */
string mapNotes(string s, fn<i32(i32)> f) {
  string[] ts = tokens(s);
  for (i32 i = 0; i < ts.len(); i++) {
    if (!isNote(ts[i])) { continue; }
    Parts p = partsOf(ts[i]);
    ts[i] = (p.slide ? "~" : "") + nameOf(f(noteOf(p.note))) + (p.major ? "^" : "");
  }
  return join(ts);
}

/** `s` moved `by` semitones. */
export string transposed(string s, i32 by) { return mapNotes(s, (i32 n) => n + by); }

/** `s`, in A minor, into A major: C, F and G a semitone up. */
export string majored(string s) {
  return mapNotes(s, (i32 n) => {
    i32 c = (n + 9 + 48) % 12;
    return c == 0 || c == 5 || c == 7 ? n + 1 : n;
  });
}

/** `s` slowed by `k`: each token held `k` times as long. */
export string stretched(string s, i32 k) {
  string[] ts = tokens(s);
  string out = "";
  for (i32 i = 0; i < ts.len(); i++) {
    out = out + (i > 0 ? " " : "") + ts[i];
    for (i32 j = 1; j < k; j++) { out = out + (ts[i] == "." ? " ." : " -"); }
  }
  return out;
}

/** `s`, `n` times over. */
export string times(string s, i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + (i > 0 ? " " : "") + s; }
  return out;
}

/**
 * A bar of eighths for each of `roots` — the root and its octave, in turn — as a chip's bass pumps; or, `climbing`,
 * sixteenths up the chord and back, as a bass that climbs.
 */
export string bass(string roots, bool climbing) {
  string[] rs = tokens(roots);
  string out = "";
  for (i32 b = 0; b < rs.len(); b++) {
    Parts p = partsOf(rs[b]);
    i32 r = noteOf(p.note);
    i32 third = p.major ? 4 : 3;
    for (i32 k = 0; k < (climbing ? 16 : 8); k++) {
      i32 n = climbing ? r + [0, 7, 12, third + 12, 19, third + 12, 12, 7][k % 8] : (k % 2 == 0 ? r : r + 12);
      out = out + (out == "" ? "" : " ") + nameOf(n);
    }
  }
  return out;
}

// ── The theme, and its arrangements ─────────────────────────────────────────

/** Pip's theme: eight bars of eighths in A minor, over A–F–C–G twice. */
export string THEME() {
  return "E5 - A5 - G5 E5 D5 - | C5 - D5 E5 - - C5 A4 | G4 - C5 - E5 - G5 E5 | D5 - - B4 D5 - G5 - | "
       + "E5 - A5 - B5 A5 G5 E5 | F5 - E5 D5 C5 - A4 C5 | E5 - G5 - C6 - B5 G5 | A5 - - - G5 - . .";
}

/** A line under the theme, in half notes, a third or a sixth below it. */
export string COUNTER() {
  return "C5 - - - E5 - - - | A4 - - - C5 - - - | E4 - - - G4 - - - | B4 - - - D5 - - - | "
       + "C5 - - - E5 - - - | A4 - - - F4 - - - | G4 - - - C5 - - - | E5 - - - D5 - - -";
}

/** The chords, a bar each. */
export string CHORDS() { return "A3 F3^ C4^ G3^ A3 F3^ C4^ G3^"; }

string arpBars(string chords) {
  string[] cs = tokens(chords);
  string out = "";
  for (i32 i = 0; i < cs.len(); i++) { out = out + (i > 0 ? " " : "") + cs[i] + " - - -"; }
  return out;
}

string drums(string bar, i32 bars) { return times(bar, bars); }

/** The six layers every level song has, with what is particular to it passed in. */
Song layered(string name, f64 bpm, string melody, string counter, string chords, string bassLine, Inst bassInst,
             i32 bassPerBeat, string kicks, string snares, string hats, Inst melodyInst) {
  Song s = Song.make(name, bpm, 8, true);
  s.add(bassInst, 0, bassPerBeat, bassLine);
  s.add(hat(0.07), 0, 2, times(". h . h . h . h", 8));
  s.add(melodyInst, 1, 2, melody);
  s.add(arp(0.09, 0.25), 2, 1, arpBars(chords));
  s.add(echoing(pad(0.1), 0.25, 0.35), 3, 2, counter);
  s.add(kick(0.5), 4, 2, kicks);
  s.add(snare(0.22), 4, 2, snares);
  s.add(hat(0.08), 4, 4, hats);
  s.add(sparkle(0.06), 5, 1, arpBars(transposed(chords, 24)));
  s.add(hat(0.1), RACE, 4, times("h . h h h . h h h . h h h . h h", 8));
  return s;
}

/** The fields: the theme as it was first written, its bass pumping. */
export Song field() {
  return layered("field", 128.0, THEME(), COUNTER(), CHORDS(), bass("A2 F2^ C3^ G2^ A2 F2^ C3^ G2^", false), triangle(0.32), 2,
                 drums("k . . k k . . .", 8), drums(". . s . . . s .", 8), times(". . h . . . h . . . h . . . h h", 8),
                 lead(0.15, 0.25));
}

/** The towers: up a tone and faster, the bass climbing the chord. */
export Song towers() {
  return layered("towers", 150.0, transposed(THEME(), 2), transposed(COUNTER(), 2), transposed(CHORDS(), 2),
                 bass(transposed("A2 F2^ C3^ G2^ A2 F2^ C3^ G2^", 2), true), lead(0.1, 0.125), 4,
                 drums("k . k . k . k .", 8), drums(". . s . . . s s", 8), times("h h h h h h h h h h h h h h h h", 8),
                 lead(0.15, 0.25));
}

/** The wind: in the major, slower, singing, over a pad that breathes. */
export Song wind() {
  Song s = layered("wind", 112.0, majored(THEME()), majored(COUNTER()), "A3^ F#3 C#4 E3^ A3^ F#3 C#4 E3^",
                   "A2 - - - - - - - F#2 - - - - - - - C#3 - - - - - - - E2 - - - - - - - "
                   + "A2 - - - - - - - F#2 - - - - - - - C#3 - - - - - - - E2 - - - - - - -", pad(0.13), 2,
                   drums("k . . . . . k .", 8), drums(". . . . s . . .", 8), times(". h . h . h . h", 16),
                   singing(0.14, 0.5));
  return s;
}

/** The dark: half speed, a drone under it, the theme coming and going in its echoes, a heartbeat for drums. */
export Song dark() {
  Song s = Song.make("dark", 76.0, 16, true);
  s.add(triangle(0.3), 0, 1, "A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - "
                             + "F1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -");
  s.add(echoing(pad(0.05), 0.4, 0.5), 0, 1, times("A3 - - - - - - - E3 - - - - - - -", 4));
  s.add(echoing(lead(0.08, 0.125), 0.55, 0.42), 1, 2, stretched(THEME(), 2));
  s.add(echoing(arp(0.05, 0.5), 0.4, 0.6), 2, 1, stretched(arpBars(CHORDS()), 2));
  s.add(echoing(pad(0.07), 0.45, 0.5), 3, 2, stretched(COUNTER(), 2));
  s.add(kick(0.42), 4, 2, times("k . k . . . . .", 16));
  s.add(sparkle(0.05), 5, 1, stretched(arpBars(transposed(CHORDS(), 24)), 2));
  s.add(hat(0.08), RACE, 4, times("h . h . h . h . h . h . h . h .", 16));
  return s;
}

/** The title: slow, the theme on a triangle over a breathing pad. */
export Song title() {
  Song s = Song.make("title", 84.0, 8, true);
  s.add(pad(0.13), 0, 1, arpBarsHeld("A3 F3 C4 G3 A3 F3 C4 G3"));
  s.add(triangle(0.18), 0, 1, "A2 - - - F2 - - - C3 - - - G2 - - - A2 - - - F2 - - - C3 - - - G2 - - -");
  s.add(echoing(triangle(0.26), 0.35, 0.36), 0, 2, THEME());
  return s;
}

string arpBarsHeld(string roots) {
  string[] rs = tokens(roots);
  string out = "";
  for (i32 i = 0; i < rs.len(); i++) { out = out + (i > 0 ? " " : "") + rs[i] + " - - -"; }
  return out;
}

/** The last level: the theme in the major, everything playing, fast. */
export Song finale() {
  return layered("finale", 140.0, majored(THEME()), majored(COUNTER()), "A3^ F#3 C#4 E3^ A3^ F#3 C#4 E3^",
                 bass("A2^ F#2 C#3 E2^ A2^ F#2 C#3 E2^", false), triangle(0.32), 2,
                 drums("k . . k k . . .", 8), drums(". . s . . . s s", 8), times("h h h h h h h h h h h h h h h h", 8),
                 lead(0.16, 0.25));
}

/** A level cleared: the theme's first notes, in the major, as a fanfare, once. */
export Song fanfare() {
  Song s = Song.make("fanfare", 140.0, 2, false);
  s.add(lead(0.2, 0.25), 0, 4, "A4 . C#5 . E5 . A5 - - - E5 . A5 - - - | C#6 - - - - - - - . . . . . . . .");
  s.add(lead(0.12, 0.5), 0, 4, "E4 . A4 . C#5 . E5 - - - C#5 . E5 - - - | A5 - - - - - - - . . . . . . . .");
  s.add(triangle(0.3), 0, 2, "A2 - - - E2 - - - | A2 - - - - - . .");
  s.add(snare(0.18), 0, 4, "s s s s s s s s s s s s s . . . | s . . . . . . . . . . . . . . .");
  s.add(kick(0.45), 0, 2, "k . . . k . . . | k . . . . . . .");
  return s;
}

/** Every song, by name. */
export Song[] songs() { return [title(), field(), towers(), wind(), dark(), finale(), fanfare()]; }

/** The song called `name`; the fields' for a name it does not know. */
export Song songNamed(string name) {
  if (name == "title") { return title(); }
  if (name == "towers") { return towers(); }
  if (name == "wind") { return wind(); }
  if (name == "dark") { return dark(); }
  if (name == "finale") { return finale(); }
  if (name == "fanfare") { return fanfare(); }
  return field();
}

// ── Playing it ──────────────────────────────────────────────────────────────

/** The frequency `semis` from A4. */
f64 freqOf(f64 semis) {
  // 2^(semis/12), by halving and doubling into range and a short series for what is left.
  f64 f = 440.0;
  f64 s = semis;
  while (s >= 12.0) { f = f * 2.0; s = s - 12.0; }
  while (s < 0.0) { f = f / 2.0; s = s + 12.0; }
  // 2^(s/12) for s in [0, 12): e^(s ln2 / 12).
  f64 x = s * 0.057762265046662105;
  f64 term = 1.0;
  f64 sum = 1.0;
  for (i32 n = 1; n < 14; n++) {
    term = term * x / (n as f64);
    sum = sum + term;
  }
  return f * sum;
}

/** Where sample `i` lands in `out`: round to the start when the song loops, or nowhere past its end. */
i32 placed(i32 i, i32 n, bool loops) { return loops ? i % n : (i < n ? i : 0 - 1); }

/** One note of `ins`, from sample `start` for `len` samples, at `semis`, sliding from `from` when it slides in. */
void note(f64[] out, bool loops, Inst ins, i32 start, i32 len, f64 semis, f64 from, bool slide, bool major) {
  f64 rate = RATE as f64;
  i32 release = (ins.release * rate) as~ i32;
  i32 total = len + release;
  if (ins.kind == KICK) { total = (0.3 * rate) as~ i32; }
  if (ins.kind == SNARE) { total = (0.22 * rate) as~ i32; }
  if (ins.kind == HAT) { total = (0.05 * rate) as~ i32; }
  // A kick starts where its wave crosses zero, rising: from anywhere else its first sample would be a click.
  f64 phase = ins.kind == KICK ? 0.25 : 0.0;
  f64 level = 0.0;
  i32 reg = 0x7FFF;
  // Drums come in over two milliseconds, for the same reason.
  f64 onset = 0.002 * rate;
  f64 noise = 1.0;
  for (i32 i = 0; i < total; i++) {
    i32 at = placed(start + i, out.len(), loops);
    if (at < 0) { return; }
    f64 t = (i as f64) / rate;
    f64 v = 0.0;
    if (ins.kind == KICK) {
      f64 f = 45.0 + 110.0 * (1.0 - t / 0.08 > 0.0 ? 1.0 - t / 0.08 : 0.0);
      phase = phase + f / rate;
      phase = phase - phase.floor();
      f64 tri = phase < 0.5 ? 4.0 * phase - 1.0 : 3.0 - 4.0 * phase;
      f64 env = 1.0 - t / 0.3;
      v = tri * env * env;
    } else if (ins.kind == SNARE || ins.kind == HAT) {
      // Noise from a shift register, changing every sample for a hat and every other for a snare's body.
      if (ins.kind == HAT || i % 2 == 0) {
        i32 bit = (reg ^ (reg >> 1)) & 1;
        reg = (reg >> 1) | (bit << 14);
        noise = (reg & 1) == 1 ? 1.0 : 0.0 - 1.0;
      }
      f64 span = ins.kind == HAT ? 0.05 : 0.22;
      f64 env = 1.0 - t / span;
      v = noise * env * env * env;
      if (ins.kind == SNARE && t < 0.06) {
        phase = phase + 190.0 / rate;
        phase = phase - phase.floor();
        v = v * 0.7 + (phase < 0.5 ? 0.5 : 0.0 - 0.5) * (1.0 - t / 0.06);
      }
    } else {
      // The pitch: sliding in, the vibrato, and an arpeggio's step through its chord.
      f64 s = semis;
      if (slide && t < 0.06) { s = from + (semis - from) * t / 0.06; }
      if (ins.vibrato > 0.0 && t > 0.12) { s = s + ins.vibrato * sin(6.283185307179586 * ins.vibratoRate * t); }
      if (ins.kind == ARP) {
        i32 k = ((t * 50.0).floor() as~ i32) % 3;
        s = s + (k == 0 ? 0.0 : (k == 1 ? (major ? 4.0 : 3.0) : 7.0));
      }
      phase = phase + freqOf(s) / rate;
      phase = phase - phase.floor();
      if (ins.kind == TRI) {
        v = phase < 0.5 ? 4.0 * phase - 1.0 : 3.0 - 4.0 * phase;
      } else {
        f64 duty = ins.sweep > 0.0 ? 0.3 + 0.17 * sin(6.283185307179586 * ins.sweep * t) : ins.duty;
        v = phase < duty ? 1.0 : 0.0 - 1.0;
      }
      // The envelope: up, down to what is held, and away once the note ends.
      f64 a = (ins.attack * rate);
      f64 d = (ins.decay * rate);
      f64 x = i as f64;
      if (i < len) {
        level = x < a ? x / a : (x < a + d ? 1.0 - (1.0 - ins.sustain) * (x - a) / d : ins.sustain);
      } else {
        level = level * (1.0 - 1.0 / ((release + 1) as f64));
      }
      v = v * level;
    }
    if ((ins.kind == KICK || ins.kind == SNARE || ins.kind == HAT) && (i as f64) < onset) { v = v * (i as f64) / onset; }
    out[at] = out[at] + v * ins.volume;
  }
}

/** A track, into `out`: every note, then its echo. */
void play(f64[] out, bool loops, f64 bpm, Track tr) {
  string[] ts = tokens(tr.notes);
  if (ts.len() == 0) { return; }
  f64 step = 60.0 / bpm / (tr.perBeat as f64) * (RATE as f64);
  i32 steps = ((out.len() as f64) / step).floor() as~ i32;
  if (!loops) { steps = ts.len(); }
  f64[] mine = f64[].filled(out.len(), 0.0);
  f64 last = 0.0;
  for (i32 i = 0; i < steps; i++) {
    string t = ts[i % ts.len()];
    if (t == "-" || t == ".") { continue; }
    i32 held = 1;
    while (i + held < steps && ts[(i + held) % ts.len()] == "-") { held++; }
    i32 start = ((i as f64) * step) as~ i32;
    i32 len = ((held as f64) * step) as~ i32;
    if (isNote(t)) {
      Parts p = partsOf(t);
      f64 n = noteOf(p.note) as f64;
      note(mine, loops, tr.inst, start, len, n, last, p.slide, p.major);
      last = n;
    } else {
      note(mine, loops, tr.inst, start, len, 0.0, 0.0, false, false);
    }
  }
  if (tr.inst.echo > 0.0) {
    i32 d = (tr.inst.echoTime * (RATE as f64)) as~ i32;
    // Twice round when it loops, so the echo of the end is heard at the start.
    for (i32 pass = 0; pass < (loops ? 2 : 1); pass++) {
      for (i32 i = 0; i < mine.len(); i++) {
        i32 from = i - d;
        if (from < 0) {
          if (!loops || pass == 0) { continue; }
          from = from + mine.len();
        }
        if (pass == 1 && i >= d) { continue; }
        mine[i] = mine[i] + mine[from] * tr.inst.echo;
      }
    }
  }
  for (i32 i = 0; i < out.len(); i++) { out[i] = out[i] + mine[i]; }
}

/**
 * **The song, a buffer per layer**, scaled together so that all of them at once peak just short of full: what the game
 * plays together, each voice turned up as its layer is earned.
 */
export f64[][] stems(Song s) {
  i32 n = s.length();
  f64[][] out = f64[][].filled(LAYERS, f64[]());
  for (i32 l = 0; l < LAYERS; l++) { out[l] = f64[].filled(n, 0.0); }
  for (i32 i = 0; i < s.tracks.len(); i++) {
    Track tr = s.tracks.get(i);
    play(out[tr.layer], s.loops, s.bpm, tr);
  }
  f64 peak = 0.0;
  for (i32 i = 0; i < n; i++) {
    f64 sum = 0.0;
    for (i32 l = 0; l < LAYERS; l++) { sum = sum + out[l][i]; }
    if (sum > peak) { peak = sum; }
    if (0.0 - sum > peak) { peak = 0.0 - sum; }
  }
  if (peak > 0.0) {
    f64 scale = 0.85 / peak;
    for (i32 l = 0; l < LAYERS; l++) { for (i32 i = 0; i < n; i++) { out[l][i] = out[l][i] * scale; } }
  }
  return out;
}

/** Layers 0 to `upTo` of `stems`, mixed. */
export f64[] mixed(f64[][] stems, i32 upTo) {
  f64[] out = f64[].filled(stems[0].len(), 0.0);
  for (i32 l = 0; l <= upTo && l < stems.len(); l++) {
    for (i32 i = 0; i < out.len(); i++) { out[i] = out[i] + stems[l][i]; }
  }
  return out;
}
