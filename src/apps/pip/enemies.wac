// Enemy artwork on a 16 × 16 pixel grid. Each palette belongs to its creature; collision boxes remain in world.wac.
import { Buf } from "core";
import { BEETLE, FROG, BAT, GHOST, CRAWLER, Foe } from "./world.wac";

export i32[] enemyPalette(i32 kind) {
  if (kind == 0) { return [0x152039, 0x55364A, 0xA64F60, 0xDB7B78, 0xF1B7A0, 0xFFF0CF, 0x152039, 0x7D6170, 0x6A3E56, 0xB58D69]; }
  if (kind == 1) { return [0x152C37, 0x34554E, 0x608566, 0x9EB47B, 0xD4D9A0, 0xFFF0CF, 0x182F39, 0x7D9673, 0xD4B76B, 0x3E6D65]; }
  if (kind == 2) { return [0x181E36, 0x39304F, 0x6B527D, 0xA184AB, 0xD5AFCA, 0xFFF0CF, 0x1C2137, 0xD5817D, 0x635E8B, 0xAF967D]; }
  if (kind == 3) { return [0x3F527D, 0x627CA5, 0x9AB7D0, 0xD9E5DF, 0xFFF1CD, 0xFFF6DE, 0x35466B, 0x91DDD4, 0x6F91BF, 0xBCD8DC]; }
  if (kind == 4) { return [0x252839, 0x62454A, 0xB47755, 0xE7AD65, 0xFFE0A0, 0xFFF2CF, 0x252839, 0x6C6660, 0xAD664D, 0xD8C49A]; }
  return enemyPalette(0);
}

