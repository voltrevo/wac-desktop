/** Animation follows simulation time and the foe's actual state, never a separate animation timer. */
export i32 enemyPose(Foe f, i32 steps) {
  i32 phase = steps / 5 + (f.startX as~ i32) / 16;
  if (f.kind == FROG) {
    if (!f.ground) {
      if (f.vy < -1.2) { return 2; }
      return f.vy <= 1.2 ? 3 : 4;
    }
    if (f.timer <= 10) { return 1; }
    return phase % 32 == 31 ? 5 : 0;
  }
  if (f.kind == BAT) {
    if (f.timer == 0) { return 0; }
    return 1 + phase % 4;
  }
  if (f.kind == GHOST) {
    if (f.vx == 0.0 && f.vy == 0.0) { return 0; }
    return 1 + (steps / 7) % 3;
  }
  return phase % 4;
}

/** A crawler's surface is on its right: floor, left wall, ceiling, right wall as it turns clockwise. */
export string[] enemyRows(i32 kind, i32 pose, i32 turn) {
  string[] rows = enemySprite(kind, pose);
  if (kind != CRAWLER || turn % 4 == 0) { return rows; }
  u8[][] raw = u8[][].filled(16, u8[]());
  for (i32 y = 0; y < 16; y++) { raw[y] = rows[y].toBytes(); }
  string[] out = string[].filled(16, "");
  for (i32 y = 0; y < 16; y++) {
    Buf row = Buf.create();
    for (i32 x = 0; x < 16; x++) {
      i32 sx = turn == 1 ? y : (turn == 2 ? 15 - x : 15 - y);
      i32 sy = turn == 1 ? 15 - x : (turn == 2 ? 15 - y : x);
      row.push(raw[sy][sx]);
    }
    out[y] = string.fromBytes(row.take());
  }
  return out;
}
