// Pip's look: the screen scaled up whole and crisp, in the middle of the window, with the words over it.

export string pipCss() {
  return mainCss() + touchCss(".pip.touch-on") + "@media (pointer: coarse) {" + touchCss(".pip.touch-auto") + "}";
}

/**
 * **The on-screen controls' look, under `p`**: the touch-mode class that shows them — always, or on a touch screen.
 * Across a wide window they lie over the picture's lower corners, see-through; in a tall one — a phone held upright —
 * the picture moves to the top and they take the space below it, covering nothing.
 */
string touchCss(string p) {
  return everywhere("""
    @P { touch-action: none; }
    @P .ptouch { display: block; }
    @P .plat { bottom: 150px; font-size: 10px; padding: 4px 7px; }
    /* The keys are no use to a thumb: the cards' buttons and the controls say what to press. */
    @P .pkeys { display: none; }
    @container pip (max-aspect-ratio: 1/1) {
      @P .pscreen { bottom: auto; height: auto; aspect-ratio: 16 / 9; }
      @P .ppad { top: 56.25cqw; height: auto; width: 60%; background: rgba(255, 255, 255, .03); }
      @P .pjump { bottom: calc((100cqh - 56.25cqw) / 2 - 56px); right: 9%; width: 112px; height: 112px; }
      @P.swap .pjump { right: auto; left: 9%; }
      @P .plat { top: calc(56.25cqw + 8px); bottom: auto; }
      @P .pstick:not(.on) { bottom: calc((100cqh - 56.25cqw) / 2 - 44px); }
    }
  """, p);
}

/** `s` with every `@P` made `p`. */
string everywhere(string s, string p) {
  string out = "";
  string rest = s;
  i32 at = rest.indexOf("@P");
  while (at >= 0) {
    out = out + rest.slice(0, at) + p;
    rest = rest.slice(at + 2, rest.len());
    at = rest.indexOf("@P");
  }
  return out + rest;
}

string mainCss() {
  return """
    .pippage, .pip { height: 100%; }
    .pip { container: pip / size; }
    .ptouch { display: none; position: absolute; inset: 0; pointer-events: none; }
    .ppad { position: absolute; left: 0; bottom: 0; width: 50%; height: 62%; pointer-events: auto; touch-action: none; }
    .pip.swap .ppad { left: auto; right: 0; }
    .pstick { position: absolute; left: 64px; bottom: 44px; width: 88px; height: 88px; margin: -44px 0 0 -44px; border-radius: 50%;
              border: 2px solid rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .06); display: grid; place-items: center;
              pointer-events: none; }
    .pip.swap .pstick:not(.on) { left: auto; right: 20px; }
    .pstick.on { bottom: auto; margin: -44px 0 0 -44px; border-color: rgba(255, 255, 255, .45); }
    .pknob { width: 40px; height: 40px; border-radius: 50%; background: rgba(255, 255, 255, .35); }
    .pknob.l, .pknob.r { background: #ffd45c; box-shadow: 0 0 12px #ffb040; }
    .pjump { position: absolute; right: 26px; bottom: 30px; width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center;
             font-weight: 700; font-size: 15px; color: #ffd45c; background: rgba(255, 212, 92, .16); border: 2px solid rgba(255, 212, 92, .6);
             pointer-events: auto; touch-action: none; }
    .pjump.on { background: rgba(255, 212, 92, .5); color: #10122a; }
    .pip.swap .pjump { right: auto; left: 26px; }
    .ptbtns { position: absolute; top: 6px; right: 6px; display: flex; gap: 6px; pointer-events: auto; }
    .ptbtn { width: 44px; height: 44px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .25); background: rgba(7, 9, 26, .6);
             color: #f4f0e4; font: inherit; font-size: 15px; display: grid; place-items: center; touch-action: manipulation; }
    .pbtn.go { border-color: #ffd45c; }
    /* Full screen, drawn: four corners out, or — full already — turned in. */
    .pfs { width: 16px; height: 16px; display: inline-block; vertical-align: -2px;
           --c: linear-gradient(currentColor, currentColor);
           background: var(--c) 0 0 / 6px 2px, var(--c) 0 0 / 2px 6px, var(--c) 100% 0 / 6px 2px, var(--c) 100% 0 / 2px 6px,
                       var(--c) 0 100% / 6px 2px, var(--c) 0 100% / 2px 6px, var(--c) 100% 100% / 6px 2px, var(--c) 100% 100% / 2px 6px;
           background-repeat: no-repeat; }
    .pfs.in { transform: scale(.75) rotate(180deg); }
    .pip { position: relative; overflow: hidden; outline: 0; background: #07091a; color: #f4f0e4; user-select: none; -webkit-user-select: none;
           font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    .pscreen { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; image-rendering: crisp-edges; }
    .phud { position: absolute; left: 10px; top: 8px; font-size: 13px; text-shadow: 0 1px 0 #000, 0 0 6px #000; pointer-events: none; }
    .plat { position: absolute; right: 8px; bottom: 8px; padding: 6px 9px; border-radius: 6px; font-size: 11.5px; line-height: 1.55;
            background: rgba(7, 9, 26, .72); pointer-events: none; }
    .plat div { display: flex; justify-content: space-between; gap: 14px; }
    .plat span { color: #9aa0c8; }
    .plat b { color: #ffd45c; font-weight: 600; }
    .pover { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(7, 9, 26, .55); }
    .pcard { max-width: 720px; max-height: calc(100% - 24px); overflow-y: auto; margin: 12px; padding: 18px 24px; border-radius: 10px;
             background: rgba(16, 18, 42, .94); border: 2px solid #ffd45c; box-shadow: 0 0 40px -10px #ffb040; text-align: center; }
    .pcard h1 { margin: 0 0 8px; font-size: 22px; color: #ffd45c; letter-spacing: .02em; }
    .pcard p { margin: 8px 0; font-size: 13.5px; line-height: 1.5; }
    .pkeys { display: grid; grid-template-columns: max-content 1fr; gap: 3px 14px; margin: 12px 0; font-size: 12.5px; text-align: left; }
    .pkeys > span:nth-child(odd) { color: #9aa0c8; }
    .pkeys b, .pgo b { color: #ffd45c; }
    .plevels { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3px 6px; margin: 12px 0; font-size: 12.5px; text-align: left; }
    .plevel { display: flex; gap: 10px; padding: 3px 8px; border-radius: 5px; background: rgba(255, 255, 255, .05); }
    .plevel b { color: #ffd45c; }
    .plevel span { margin-left: auto; color: #9aa0c8; }
    .plevel.locked { opacity: .45; }
    .plevel.on { background: rgba(255, 212, 92, .2); box-shadow: 0 0 0 1px #ffd45c inset; }
    .plevel:not(.locked) { cursor: pointer; }
    .plevel:not(.locked):hover { background: rgba(255, 255, 255, .12); }
    /* Paused, the level being played: dashed, whether or not the arrows are on it. */
    .plevel.here { outline: 1px dashed #ffd45c; outline-offset: -1px; }
    .pgo { color: #c8cce8; }
    .pm { display: inline-block; width: 9px; height: 9px; margin-left: 6px; border-radius: 50%; vertical-align: 0; }
    .pm.gold { background: #ffd45c; box-shadow: 0 0 6px #ffb040; } .pm.silver { background: #d8dce8; }
    .pm.bronze { background: #c8844a; } .pm.none { background: transparent; box-shadow: inset 0 0 0 1px #4a4e70; }
    .pmedal { text-transform: capitalize; }
    .pbest { color: #7fe08a; font-weight: 700; }
    .pfaint { color: #9aa0c8; }
    .pnote { color: #ffd45c; }
    .pbtns { display: flex; gap: 8px; justify-content: center; margin-top: 10px; }
    .pbtn { font: inherit; font-size: 12.5px; color: #f4f0e4; background: rgba(255, 255, 255, .06); border: 1px solid #4a4e70;
            border-radius: 6px; padding: 4px 10px; cursor: pointer; }
    .pbtn:hover { border-color: #ffd45c; } .pbtn b { color: #ffd45c; margin-right: 4px; }
    .pdelta { font-variant-numeric: tabular-nums; } .pdelta.ahead { color: #7fe08a; } .pdelta.behind { color: #ff8a7a; }
    .pfull { color: #ffd45c; }
    .psplits { position: absolute; right: 8px; top: 8px; min-width: 260px; padding: 6px 9px; border-radius: 6px; font-size: 11.5px;
               line-height: 1.6; background: rgba(7, 9, 26, .78); pointer-events: none; }
    .psrow { display: grid; grid-template-columns: 1fr auto 56px; gap: 10px; align-items: center; }
    .psrow.now { color: #ffd45c; }
    .psrow .pm { width: 7px; height: 7px; }
    .pstime, .pdelta { text-align: right; font-variant-numeric: tabular-nums; }
    .psfoot { display: flex; justify-content: space-between; gap: 12px; margin-top: 4px; padding-top: 4px; border-top: 1px solid #2a2e50; color: #9aa0c8; }
    .pfullsplits { max-height: 230px; overflow-y: auto; margin: 10px 0; font-size: 12px; text-align: left; }
    .pfullsplits .psrow { grid-template-columns: 1fr auto auto 56px; }
    .popts { display: flex; flex-direction: column; gap: 4px; margin: 12px 0; font-size: 12.5px; text-align: left; }
    .popt { display: flex; align-items: center; gap: 12px; padding: 4px 8px; border-radius: 5px; }
    .popt.on { background: rgba(255, 212, 92, .14); box-shadow: 0 0 0 1px #ffd45c inset; }
    .potitle { flex: 1; color: #c8cce8; }
    .pchoices { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
    .pc { padding: 1px 7px; border-radius: 4px; color: #9aa0c8; cursor: pointer; }
    .pc.on { background: #ffd45c; color: #10122a; }
    .preplays { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 6px; margin: 12px 0; font-size: 12.5px; text-align: left; }
    /* A narrow window — a phone's — has room for two levels to a row, or one: last, so these win over the rules above. */
    @container pip (max-width: 600px) {
      .pcard { padding: 14px 12px; margin: 8px; max-height: calc(100% - 16px); }
      .pcard h1 { font-size: 18px; }
      .pcard p { font-size: 12.5px; }
      .plevels, .preplays { grid-template-columns: 1fr 1fr; font-size: 12px; }
      .plevel { gap: 6px; padding: 5px 6px; }
      .pbtns { flex-wrap: wrap; }
      .pbtn { padding: 8px 12px; }
    }
    @container pip (max-width: 380px) { .plevels, .preplays { grid-template-columns: 1fr; } }
  """;
}
