// Pip's pictures: a 320 × 180 screen of pixels, drawn afresh each frame into one buffer the page sends whole.
//
// **Everything is drawn by hand here**, as an old machine's game would be: sprites are rows of letters, each a
// colour; clustered earth, moss and stone share a restrained palette. The moon, mist, hills and layered fir trees
// move more slowly than the ground, giving the little stage depth. A lit lantern throws a warm glow, added to what is
// under it, and so does Pip.

import { Vec } from "core";
import { BAT, CRAWLER, FROG, Foe, GHOST, HERO_H, HERO_W, Mover, TILE, World, tileAt } from "./world.wac";

export static i32 SCREEN_W = 320;
export static i32 SCREEN_H = 180;

/** The screen, and where the camera is on the level, in pixels. */
export struct Screen {
  u8[] px;
  i32 camX;
  i32 camY;
  /** The camera's place to the fraction of a pixel, across and down, and how far ahead of Pip it looks (`follow`). */
  f64 camF;
  f64 camYF;
  f64 lead;
  /** The sky, a colour a row; and the stars, x and y in turns. */
  i32[] sky;
  i32[] stars;

  Screen create() {
    i32[] sky = i32[].filled(SCREEN_H, 0);
    for (i32 y = 0; y < SCREEN_H; y++) { sky[y] = mix(0x101B35, 0x65516B, (y as f64) / ((SCREEN_H - 1) as f64)); }
    i32[] stars = i32[].filled(120, 0);
    i32 seed = 12345;
    for (i32 i = 0; i < 60; i++) {
      seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
      stars[i * 2] = seed % 640;
      seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
      stars[i * 2 + 1] = seed % 110;
    }
    return Screen(u8[].filled(SCREEN_W * SCREEN_H * 4, 255 as u8), 0, 0, 0.0, 0.0, 0.0, sky, stars);
  }
}

/** `a` and `b`, colours as 0xRRGGBB, mixed `t` of the way from `a` to `b`. */
export i32 mix(i32 a, i32 b, f64 t) {
  i32 out = 0;
  for (i32 s = 0; s < 24; s = s + 8) {
    f64 x = ((a >> s) & 255) as f64;
    f64 y = ((b >> s) & 255) as f64;
    out = out | ((((x + (y - x) * t) as~ i32) & 255) << s);
  }
  return out;
}

void dot(Screen s, i32 x, i32 y, i32 c) {
  if (x < 0 || y < 0 || x >= SCREEN_W || y >= SCREEN_H) { return; }
  i32 at = (y * SCREEN_W + x) * 4;
  s.px[at] = ((c >> 16) & 255) as@ u8;
  s.px[at + 1] = ((c >> 8) & 255) as@ u8;
  s.px[at + 2] = (c & 255) as@ u8;
}

/** Light added to a pixel, `amount` of `c`. */
void glow(Screen s, i32 x, i32 y, i32 c, f64 amount) {
  if (x < 0 || y < 0 || x >= SCREEN_W || y >= SCREEN_H) { return; }
  i32 at = (y * SCREEN_W + x) * 4;
  for (i32 k = 0; k < 3; k++) {
    i32 add = ((((c >> (16 - 8 * k)) & 255) as f64) * amount) as~ i32;
    i32 v = (s.px[at + k] as i32) + add;
    s.px[at + k] = (v > 255 ? 255 : v) as@ u8;
  }
}

void rect(Screen s, i32 x, i32 y, i32 w, i32 h, i32 c) {
  for (i32 j = y < 0 ? 0 : y; j < y + h && j < SCREEN_H; j++) {
    for (i32 i = x < 0 ? 0 : x; i < x + w && i < SCREEN_W; i++) { dot(s, i, j, c); }
  }
}

/** A warm glow of radius `r` about (`cx`, `cy`), strongest in the middle. */
void halo(Screen s, i32 cx, i32 cy, i32 r, i32 c, f64 strength) {
  for (i32 y = cy - r; y <= cy + r; y++) {
    for (i32 x = cx - r; x <= cx + r; x++) {
      i32 d2 = (x - cx) * (x - cx) + (y - cy) * (y - cy);
      if (d2 >= r * r) { continue; }
      f64 f = 1.0 - (d2 as f64) / ((r * r) as f64);
      glow(s, x, y, c, strength * f * f);
    }
  }
}

/** The colour each letter of a sprite stands for; a `.` is not drawn. */
i32 paint(u8 ch) {
  if (ch == 'o') { return 0x152039; }
  if (ch == 'h') { return 0x80D4BB; }
  if (ch == 'F') { return 0xC99882; }
  if (ch == 'B') { return 0xA57857; }
  if (ch == 'C') { return 0x285C69; }
  if (ch == 'c') { return 0x4A9F9B; }
  if (ch == 'f') { return 0xF2C9A0; }
  if (ch == 'e') { return 0x152039; }
  if (ch == 'b') { return 0x6B4430; }
  if (ch == 'r') { return 0xCD716B; }
  if (ch == 'R') { return 0x743E57; }
  if (ch == 'w') { return 0xFFF4D6; }
  if (ch == 'g') { return 0x96B67C; }
  if (ch == 'G') { return 0x4C7567; }
  if (ch == 'y') { return 0xFFD45C; }
  if (ch == 'v') { return 0x9A86B3; }
  if (ch == 'V') { return 0x524569; }
  if (ch == 'W') { return 0xE8ECFF; }
  if (ch == 'k') { return 0x30365A; }
  if (ch == 'O') { return 0xE07A2A; }
  if (ch == 'Y') { return 0xF8C870; }
  return 0 - 1;
}

/** Draw `rows` at (`x`, `y`), mirrored when `flip`. */
void sprite(Screen s, string[] rows, i32 x, i32 y, bool flip) { seeThrough(s, rows, x, y, flip, 1.0); }

/** The same, `alpha` of the way over what is there: a ghost's sheet, or the ghost of Pip's best run. */
void seeThrough(Screen s, string[] rows, i32 x, i32 y, bool flip, f64 alpha) {
  for (i32 j = 0; j < rows.len(); j++) {
    u8[] r = rows[j].toBytes();
    for (i32 i = 0; i < r.len(); i++) {
      i32 c = paint(r[flip ? r.len() - 1 - i : i]);
      if (c < 0) { continue; }
      i32 px = x + i;
      i32 py = y + j;
      if (px < 0 || py < 0 || px >= SCREEN_W || py >= SCREEN_H) { continue; }
      if (alpha >= 1.0) {
        dot(s, px, py, c);
        continue;
      }
      i32 at = (py * SCREEN_W + px) * 4;
      i32 under = ((s.px[at] as i32) << 16) | ((s.px[at + 1] as i32) << 8) | (s.px[at + 2] as i32);
      dot(s, px, py, mix(under, c, alpha));
    }
  }
}

/** A bat, wings up or down. */
string[] bat(bool up) {
  if (up) {
    return ["v.........v.", "vv.......vv.", "vVv.ooo.vVv.", ".vVvoVVovVv.", "..vVVrVrVv..", "...oVVVVo...",
            "....oVVo....", ".....oo.....", "............", "............", "............", "............"];
  }
  return ["............", "............", "....ooo.....", "...oVVVo....", "..vVVrVrVv..", ".vVVVVVVVVv.",
          "vVv.oVVo.vVv", "vv...oo...vv", "v..........v", "............", "............", "............"];
}

/** A ghost: a sheet with eyes, its hem rippling. */
string[] ghost(bool ripple) {
  return ["....WWWW....", "..WWWWWWWW..", ".WWWWWWWWWW.", ".WWkkWWkkWW.", ".WWkkWWkkWW.", ".WWWWWWWWWW.",
          ".WWWWkkWWWW.", ".WWWWWWWWWW.", ".WWWWWWWWWW.", ".WWWWWWWWWW.", ripple ? ".W.WW.WW.WW." : ".WW.WW.WW.W.",
          "............"];
}

/** A crawler: an orange shell all spikes, its feet on whatever it walks on. */
string[] crawler(bool step) {
  return ["..Y..Y..Y...", "..OYOOYOOY..", ".OOOOOOOOOO.", "YOOkOOOOkOOY", ".OOOOOOOOOO.", "YOOOOOOOOOOY",
          ".OOOOOOOOOO.", "YOOOOOOOOOOY", ".OOOOOOOOOO.", "..OYOOYOOY..", step ? ".o.o.o.o.o.." : "..o.o.o.o.o.",
          "............"];
}

/** Pip, facing right: hooded and round, in a cloak; the legs by what Pip is doing. */
string[] pip(string legs) {
  string a = "...obo.obo..";
  string b = "...obo.obo..";
  if (legs == "run1") { a = "..obo...obo."; b = ".obo.....oo."; }
  if (legs == "run2") { a = "....obobo..."; b = "....obo....."; }
  if (legs == "jump") { a = "..obo..obo.."; b = "............"; }
  if (legs == "fall") { a = "..obo...obo."; b = "..oo.....oo."; }
  return ["....oooo....",
          "...ohhhco...",
          "..ohccccCo..",
          "..ohccCCCo..",
          ".ohCffffCCo.",
          ".ocFfffweCo.",
          ".ocFfffffCo.",
          "..oCFFFfCo..",
          "..ohCyyCCo..",
          ".ohccyCCbCo.",
          ".ohccyCCBCo.",
          ".ocCCyCCCCo.",
          "..oCCCCCCo..",
          a, b, "............"];
}

string[] beetle(bool step) {
  return ["............",
          "....oooo....",
          "..ooRrrRoo..",
          ".oRrrrrrrRo.",
          ".oRrwrrwrRo.",
          "oRRrrrrrrRRo",
          "oRrrrRRrrrRo",
          "oRRRRRRRRRRo",
          ".oooooooooo.",
          step ? ".o.o....o.o." : "..o.o..o.o..",
          "............",
          "............"];
}

string[] frog(bool up) {
  if (up) {
    return [".oo......oo.", "ogwo....owgo", "oggGooooGggo", ".oggggggggo.", "oggwwwwwwggo", "oGggggggggGo",
            ".oGggggggGo.", "..oGGooGGo..", ".oGo....oGo.", "oGo......oGo", "............", "............"];
  }
  return ["............", "............", ".oo......oo.", "ogwo....owgo", "oggGooooGggo", ".oggggggggo.",
          "oggwwwwwwggo", "oGggggggggGo", "oGGggggggGGo", "oGGoooooGGGo", "oo.......ooo", "............"];
}

/** Whether Pip is in tile (`tx`, `ty`). */
bool touchesTile(World w, i32 tx, i32 ty) {
  f64 l = (tx * TILE) as f64;
  f64 t = (ty * TILE) as f64;
  return w.hero.x < l + (TILE as f64) && w.hero.x + HERO_W > l && w.hero.y < t + (TILE as f64) && w.hero.y + HERO_H > t;
}

i32 hash(i32 x, i32 y) {
  i32 h = x * 374761393 + y * 668265263;
  h = (h ^ (h >> 13)) * 1274126177;
  return (h ^ (h >> 16)) & 0x7FFFFFFF;
}

/** The same wood grain and brass nails on fixed and moving platforms. */
void plank(Screen s, i32 x, i32 y, i32 width) {
  rect(s, x, y, width, 5, 0x594050);
  rect(s, x, y, width, 1, 0xDBAE7C);
  rect(s, x, y + 1, width, 2, 0xA97660);
  rect(s, x + 2, y + 2, width - 4, 1, 0xC18E6A);
  for (i32 at = 2; at < width; at += 8) { dot(s, x + at, y + 1, 0xF4D8A0); dot(s, x + at, y + 2, 0x594050); }
}

/** A tile at (`sx`, `sy`) on the screen. */
void drawTile(Screen s, World w, i32 tx, i32 ty, i32 sx, i32 sy, i32 frame) {
  u8 c = tileAt(w, tx, ty);
  if (c == '#') {
    // Grass grows where there is air above, not under spikes or a block.
    u8 above = tileAt(w, tx, ty - 1);
    bool top = ty > 0 && above != '#' && above != '^' && above != 'X' && above != 'S';
    // Broad clusters read as earth and stones; independent speckles made every block look like static.
    rect(s, sx, sy, TILE, TILE, 0x3D3546);
    rect(s, sx, sy + 12, TILE, 4, 0x342F40);
    for (i32 k = 0; k < 3; k++) {
      i32 h = hash(tx * 7 + k, ty);
      i32 x = sx + 1 + h % 10;
      i32 y = sy + 5 + (h >> 8) % 8;
      i32 width = 3 + (h >> 4) % 3;
      rect(s, x, y, width, 3, 0x292B3D);
      rect(s, x, y, width - 1, 1, 0x665061);
      rect(s, x + 1, y + 1, width - 1, 1, 0x4F4153);
    }
    if (tileAt(w, tx - 1, ty) != '#') { rect(s, sx, sy, 1, TILE, 0x756075); }
    if (tileAt(w, tx + 1, ty) != '#') { rect(s, sx + 15, sy, 1, TILE, 0x24293C); }
    if (top) {
      rect(s, sx, sy, TILE, 1, 0xA0C78D);
      rect(s, sx, sy + 1, TILE, 2, 0x63976E);
      rect(s, sx, sy + 3, TILE, 2, 0x3C685A);
      for (i32 k = 0; k < 4; k++) {
        i32 h = hash(tx * 4 + k, ty);
        i32 x = sx + k * 4;
        rect(s, x, sy + 4, 2 + h % 2, 1 + (h >> 4) % 3, 0x36564F);
        if (h % 3 == 0) {
          rect(s, x + 1, sy - 3, 1, 3, 0x63976E);
          dot(s, x, sy - 2, 0x8EB885); dot(s, x + 2, sy - 1, 0x8EB885);
        }
      }
      if (hash(tx, ty) % 9 == 0) {
        rect(s, sx + 8, sy - 4, 1, 4, 0x63976E);
        rect(s, sx + 7, sy - 5, 3, 2, 0xD6A291);
        dot(s, sx + 8, sy - 5, 0xF3D6AF);
      }
    }
  } else if (c == 'X') {
    i32 shake = w.crumbling[ty * w.cols + tx] > 0 ? (frame / 2 % 2 == 0 ? 1 : 0 - 1) : 0;
    rect(s, sx + shake, sy, TILE, TILE, 0x38394D);
    rect(s, sx + shake + 1, sy + 1, 14, 6, 0x8C8591);
    rect(s, sx + shake + 1, sy + 1, 14, 1, 0xB9ABA6);
    rect(s, sx + shake + 2, sy + 2, 11, 1, 0xA3979C);
    rect(s, sx + shake + 1, sy + 8, 6, 7, 0x77717F);
    rect(s, sx + shake + 8, sy + 8, 7, 7, 0x817987);
    rect(s, sx + shake + 1, sy + 8, 6, 1, 0xA3979C);
    rect(s, sx + shake + 8, sy + 8, 7, 1, 0xA3979C);
    dot(s, sx + shake + 10, sy + 4, 0x38394D);
    rect(s, sx + shake + 9, sy + 5, 1, 3, 0x38394D);
    if (tileAt(w, tx, ty - 1) == '.') { rect(s, sx + shake + 2, sy, 5, 1, 0x91A488); }
  } else if (c == '|') {
    // An updraft: motes rising through it.
    for (i32 k = 0; k < 3; k++) {
      i32 h = hash(tx * 3 + k, ty);
      i32 y = sy + 15 - ((frame + h) / 2 + k * 5) % 16;
      glow(s, sx + h % 14 + 1, y, 0x9FD8FF, 0.35);
      glow(s, sx + h % 14 + 1, y + 1, 0x9FD8FF, 0.2);
    }
  } else if (c == '<' || c == '>') {
    // Wind: streaks blowing through.
    i32 way = c == '>' ? 1 : 0 - 1;
    for (i32 k = 0; k < 2; k++) {
      i32 h = hash(tx, ty * 5 + k);
      i32 x = ((frame * 2 + h) % 16) * way;
      i32 at = way > 0 ? sx + x : sx + 15 + x;
      for (i32 d = 0; d < 4; d++) { glow(s, at - d * way, sy + 3 + (h % 10), 0xCFE6FF, 0.25 - (d as f64) * 0.05); }
    }
  } else if (c == 'S') {
    // A spring set into the ground: its red plate flush with the grass, pressed down while Pip is on it.
    bool pressed = w.hero.ground && touchesTile(w, tx, ty - 1);
    i32 top = pressed ? 5 : 0;
    rect(s, sx, sy, TILE, TILE, 0x4A3226);
    rect(s, sx + 2, sy, 12, TILE, 0x2A1E1A);
    for (i32 y = sy + top + 4; y < sy + 15; y = y + 2) { rect(s, sx + 4, y, 8, 1, 0xB8B8C8); }
    rect(s, sx + 1, sy + top, 14, 3, 0xD84A3A);
    rect(s, sx + 1, sy + top, 14, 1, 0xF07A5A);
  } else if (c == '=') {
    plank(s, sx, sy, TILE);
  } else if (c == '^') {
    for (i32 k = 0; k < 4; k++) {
      for (i32 j = 0; j < 8; j++) {
        i32 half = j / 2;
        rect(s, sx + k * 4 + 2 - half, sy + 8 + j, half * 2 + 1 > 4 ? 4 : half * 2 + 1, 1, j < 2 ? 0xE6E6EE : 0x9EA0B0);
      }
    }
  } else if (c == 'L' || c == 'l') {
    bool lit = c == 'l';
    i32 bob = lit ? 0 : ((frame / 20 + tx) % 2);
    i32 lx = sx + 4;
    i32 ly = sy + 3 + bob;
    rect(s, lx + 2, ly - 2, 4, 1, 0xC39B69);
    dot(s, lx + 1, ly - 1, 0x8B684D); dot(s, lx + 6, ly - 1, 0x8B684D);
    rect(s, lx, ly, 8, 11, 0x202438);
    rect(s, lx, ly, 8, 2, 0xA7784B);
    rect(s, lx + 1, ly, 6, 1, 0xE4BD78);
    rect(s, lx + 1, ly + 2, 6, 7, lit ? 0xEBA956 : 0x344C69);
    rect(s, lx + 1, ly + 2, 1, 6, lit ? 0xFFE4A3 : 0x6E98A3);
    rect(s, lx + 6, ly + 2, 1, 7, lit ? 0xC77E46 : 0x263B57);
    rect(s, lx, ly + 9, 8, 2, 0x8B684D);
    rect(s, lx + 1, ly + 9, 6, 1, 0xE4BD78);
    if (lit) {
      i32 flick = (frame / 6 + tx) % 3;
      rect(s, lx + 3, ly + 4 + (flick == 1 ? 1 : 0), 2, 4, 0xFFF4D6);
      dot(s, lx + 4, ly + 3, 0xFFD078);
    } else {
      rect(s, lx + 3, ly + 6, 2, 2, 0x7D8A97);
      dot(s, lx + 2, ly + 3, 0xA7BAC1);
    }
  } else if (c == 'C' || c == 'c') {
    rect(s, sx + 5, sy + 1, 2, 15, 0xB8B8C8);
    i32 wave = (frame / 10) % 2;
    rect(s, sx + 7, sy + 2 + wave, 7, 5, c == 'c' ? 0xFFD45C : 0xCD716B);
  } else if (c == 'E') {
    bool open = w.lit == w.lanterns;
    // A little stone arch, still occupying the same doorway as the rules' original rectangle.
    rect(s, sx + 3, sy - 15, 10, 2, 0xA3979C);
    rect(s, sx + 1, sy - 13, 14, 29, 0x77717F);
    rect(s, sx + 1, sy - 13, 2, 28, 0xA3979C);
    rect(s, sx + 13, sy - 13, 2, 28, 0x474354);
    rect(s, sx + 3, sy - 12, 10, 27, open ? 0xF0C780 : 0x49394D);
    rect(s, sx + 4, sy - 13, 8, 1, open ? 0xFFE3A3 : 0x8F6872);
    if (!open) {
      rect(s, sx + 4, sy - 11, 1, 25, 0x775467);
      rect(s, sx + 7, sy - 11, 1, 25, 0x332D43);
      rect(s, sx + 10, sy - 11, 1, 25, 0x332D43);
      rect(s, sx + 5, sy - 8, 6, 5, 0x202D46);
      rect(s, sx + 7, sy - 8, 1, 5, 0xB79371);
      rect(s, sx + 5, sy - 6, 6, 1, 0xB79371);
      rect(s, sx + 10, sy + 3, 2, 2, 0xF4D8A0);
    }
    for (i32 y = 0; y < 5; y++) {
      rect(s, sx + 1, sy - 9 + y * 5, 2, 1, 0x474354);
      rect(s, sx + 13, sy - 9 + y * 5, 2, 1, 0x303044);
    }
    rect(s, sx, sy + 15, 16, 1, 0xB9ABA6);
  }
}

/** The sky, its stars, and two ranges of hills, each moving slower than the ground. */
void drawSky(Screen s, i32 frame, i32 up) {
  for (i32 y = 0; y < SCREEN_H; y++) {
    i32 c = s.sky[y];
    for (i32 x = 0; x < SCREEN_W; x++) { dot(s, x, y, c); }
  }
  for (i32 i = 0; i < s.stars.len() / 2; i++) {
    i32 x = (s.stars[i * 2] - s.camX / 8) % 640;
    if (x < 0) { x = x + 640; }
    i32 twinkle = (frame / 15 + i) % 7 == 0 ? 0x8890C0 : 0xD8DCF0;
    dot(s, x, s.stars[i * 2 + 1], twinkle);
  }
  // Chunked clouds and a round, cratered moon keep their edges on the same one-pixel grid as the sprites.
  for (i32 i = 0; i < 4; i++) {
    i32 cx = (i * 119 + 39 - s.camX / 12) % 480;
    rect(s, cx, 34 + i % 2 * 22, 36, 2, 0x3D3D60);
    rect(s, cx + 8, 32 + i % 2 * 22, 19, 2, 0x3D3D60);
    rect(s, cx + 2, 36 + i % 2 * 22, 48, 1, 0x343653);
  }
  i32 moon = 269 - s.camX / 16 % 400;
  for (i32 y = -9; y <= 9; y++) {
    for (i32 x = -9; x <= 9; x++) {
      if (x * x + y * y <= 82) { dot(s, moon + x, 27 + y, x > 3 || y > 5 ? 0xC6B8AE : 0xF2DEC0); }
    }
  }
  rect(s, moon + 2, 23, 3, 2, 0xD3C1AD);
  rect(s, moon - 4, 29, 2, 3, 0xD3C1AD);
  dot(s, moon + 3, 32, 0xB2A8A5);
  hills(s, s.camX / 5, 117 + up / 6, 0x343A57, 32);
  hills(s, s.camX / 3, 145 + up / 3, 0x344652, 24);
  forest(s, s.camX / 5, 122 + up / 5, 40, false);
  // A thin strip of mist separates the distant ridges from the nearer trees.
  rect(s, 0, 124 + up / 5, SCREEN_W, 2, 0x4B5365);
  forest(s, s.camX / 3, 164 + up / 3, 72, true);
}

void hills(Screen s, i32 shift, i32 base, i32 c, i32 height) {
  for (i32 x = 0; x < SCREEN_W; x++) {
    i32 wx = x + shift;
    // Two triangle waves of different lengths, which makes a ridge that does not repeat soon.
    i32 a = wx % 160;
    i32 b = (wx + 57) % 97;
    i32 ta = a < 80 ? a : 160 - a;
    i32 tb = b < 48 ? b : 97 - b;
    i32 top = base - (ta * height) / 80 - (tb * height) / 160;
    for (i32 y = top < 0 ? 0 : top; y < SCREEN_H; y++) { dot(s, x, y, c); }
  }
}

/** Jagged fir silhouettes, with a few cool edges catching moonlight. Stable world coordinates avoid shimmer. */
void forest(Screen s, i32 shift, i32 base, i32 size, bool near) {
  i32 spacing = near ? 47 : 29;
  i32 start = shift / spacing;
  for (i32 i = start - 1; i <= start + SCREEN_W / spacing + 2; i++) {
    i32 h = hash(i + 30, near ? 11 : 7);
    i32 x = i * spacing - shift + h % 15;
    i32 height = size / 2 + h % (size / 2);
    i32 bottom = base + h % 12;
    i32 colour = near ? 0x243C48 : 0x303F55;
    rect(s, x - 1, bottom - height + 3, 3, height, colour);
    for (i32 tier = 0; tier < 3; tier++) {
      i32 top = bottom - height + tier * height / 5;
      i32 depth = height / 2;
      for (i32 y = 0; y < depth; y++) {
        i32 half = y / 3 + tier;
        rect(s, x - half, top + y, half * 2 + 1, 1, colour);
        if (near && y % 5 == 0) { rect(s, x - half, top + y, 2, 1, 0x40535B); }
      }
    }
  }
}

/** How far ahead the camera looks at a run, and how wide the middle is where Pip moves without the camera moving. */
static f64 LEAD = 40.0;
static f64 SLACK = 20.0;

/** How far Pip moves up or down before the camera follows. */
static f64 SLACK_Y = 24.0;

f64 clampCamY(World w, f64 y) {
  f64 most = ((w.rows * TILE - SCREEN_H) as f64);
  return y > most ? most : (y < 0.0 ? 0.0 : y);
}

f64 clampCam(World w, f64 x) {
  f64 most = ((w.cols * TILE - SCREEN_W) as f64);
  return x < 0.0 ? 0.0 : (x > most ? most : x);
}

/**
 * **The camera, one step on** — called with the rules' steps, so it moves the same at any frame rate.
 *
 * It looks ahead of where Pip is going, by Pip's speed rather than which way Pip faces, and that lead grows and
 * shrinks slowly: turning round, or a hop back, does not swing the view. Pip moves freely in a slack middle band, and
 * only leaving it moves the camera, which eases there rather than jumping. It stops at the level's ends.
 */
export void follow(Screen s, World w) {
  // Up and down the same way, without a lead: Pip a little below the middle, so more of a climb shows above.
  f64 high = w.hero.y + 7.0 - (SCREEN_H as f64) * 0.55;
  f64 aim = s.camYF;
  if (high > s.camYF + SLACK_Y) { aim = high - SLACK_Y; }
  if (high < s.camYF - SLACK_Y) { aim = high + SLACK_Y; }
  s.camYF = clampCamY(w, s.camYF + (aim - s.camYF) * 0.15);
  s.camY = s.camYF.round() as~ i32;
  f64 run = w.hero.vx / 2.3;
  f64 want = (run > 1.0 ? 1.0 : (run < 0.0 - 1.0 ? 0.0 - 1.0 : run)) * LEAD;
  s.lead = s.lead + (want - s.lead) * 0.03;
  f64 focus = w.hero.x + 5.0 + s.lead - ((SCREEN_W / 2) as f64);
  f64 target = s.camF;
  if (focus > s.camF + SLACK) { target = focus - SLACK; }
  if (focus < s.camF - SLACK) { target = focus + SLACK; }
  s.camF = clampCam(w, s.camF + (target - s.camF) * 0.18);
  s.camX = s.camF.round() as~ i32;
}

/** The camera straight to Pip: at a level's start, or when Pip comes back to a flag. */
export void snap(Screen s, World w) {
  s.lead = 0.0;
  s.camYF = clampCamY(w, w.hero.y + 7.0 - (SCREEN_H as f64) * 0.55);
  s.camY = s.camYF.round() as~ i32;
  s.camF = clampCam(w, w.hero.x + 5.0 - ((SCREEN_W / 2) as f64));
  s.camX = s.camF.round() as~ i32;
}

/** The whole picture: the sky, the level, what moves, Pip, and the light. */
export void drawWorld(Screen s, World w, World? best, i32 frame) {
  // How far the view is above the level's floor: the hills sink as Pip climbs, the far ones slower.
  drawSky(s, frame, w.rows * TILE - SCREEN_H - s.camY);
  i32 x0 = s.camX / TILE;
  i32 y0 = s.camY / TILE;
  i32 y1 = (s.camY + SCREEN_H) / TILE + 1;
  for (i32 ty = y0; ty <= y1 && ty < w.rows; ty++) {
    for (i32 tx = x0; tx <= x0 + SCREEN_W / TILE + 1 && tx < w.cols; tx++) {
      drawTile(s, w, tx, ty, tx * TILE - s.camX, ty * TILE - s.camY, frame);
    }
  }
  for (i32 i = 0; i < w.movers.len(); i++) {
    Mover m = w.movers.get(i);
    i32 mx = (m.x as~ i32) - s.camX;
    i32 my = (m.y as~ i32) - s.camY;
    plank(s, mx, my, 48);
    rect(s, mx + 21, my + 5, 6, 2, 0x45313C);
    rect(s, mx + 22, my + 7, 4, 2, 0x302638);
  }
  for (i32 i = 0; i < w.foes.len(); i++) {
    Foe f = w.foes.get(i);
    if (!f.alive) { continue; }
    i32 fx = (f.x as~ i32) - s.camX;
    i32 fy = (f.y as~ i32) - s.camY;
    if (f.kind == FROG) { sprite(s, frog(!f.ground), fx, fy, f.vx < 0.0); }
    else if (f.kind == BAT) { sprite(s, bat(f.timer == 0 || (frame / 5) % 2 == 0), fx, fy, false); }
    else if (f.kind == GHOST) { seeThrough(s, ghost((frame / 10) % 2 == 0), fx, fy + ((frame / 20) % 2), f.x > w.hero.x, 0.7); }
    else if (f.kind == CRAWLER) { sprite(s, crawler((frame / 8) % 2 == 0), fx, fy, false); }
    else { sprite(s, beetle((frame / 8) % 2 == 0), fx, fy, f.vx > 0.0); }
  }
  i32 hx = (w.hero.x as~ i32) - 1 - s.camX;
  i32 hy = (w.hero.y as~ i32) - 2 - s.camY;
  string legs = "stand";
  if (!w.hero.ground) { legs = w.hero.vy < 0.0 ? "jump" : "fall"; }
  else if (w.hero.stride > 0) { legs = (w.hero.stride / 6) % 2 == 0 ? "run1" : "run2"; }
  // The ghost of the best run, see-through, behind Pip.
  if (best is not null && best!.hero.dying == 0 && !best!.won) {
    World b = best!;
    string bl = "stand";
    if (!b.hero.ground) { bl = b.hero.vy < 0.0 ? "jump" : "fall"; }
    else if (b.hero.stride > 0) { bl = (b.hero.stride / 6) % 2 == 0 ? "run1" : "run2"; }
    seeThrough(s, pip(bl), (b.hero.x as~ i32) - 1 - s.camX, (b.hero.y as~ i32) - 2 - s.camY, b.hero.facing < 0, 0.35);
  }
  bool blink = w.hero.dying > 0 && (frame / 3) % 2 == 0;
  if (!blink) { sprite(s, pip(legs), hx, hy, w.hero.facing < 0); }
  // The light: each lit lantern, the open door, and a little around Pip — and, in the dark, all there is to see by.
  Vec<i32> lights = Vec.create();
  for (i32 ty = y0 - 2 < 0 ? 0 : y0 - 2; ty <= y1 + 2 && ty < w.rows; ty++) {
    for (i32 tx = x0 - 3; tx <= x0 + SCREEN_W / TILE + 4 && tx < w.cols; tx++) {
      u8 c = tileAt(w, tx, ty);
      i32 sx = tx * TILE - s.camX + 8;
      i32 sy = ty * TILE - s.camY + 8;
      if (c == 'l') {
        halo(s, sx, sy, 30 + (frame / 6 + tx) % 3, 0xFFB040, 0.55);
        light(lights, sx, sy, 64 + (frame / 6 + tx) % 3, 100);
      }
      // An unlit lantern glimmers, so it can be found in the dark; a flag touched, a little more.
      if (c == 'L') { light(lights, sx, sy, 14, 60); }
      if (c == 'c') { light(lights, sx, sy, 24, 60); }
      if (c == 'E' && w.lit == w.lanterns) {
        halo(s, sx, sy - 6, 34, 0xFFD080, 0.5);
        light(lights, sx, sy - 6, 60, 100);
      }
    }
  }
  halo(s, hx + 6, hy + 8, 22, 0x6070C0, 0.25);
  light(lights, hx + 6, hy + 8, 52, 100);
  if (w.level.dark) { darken(s, lights); }
}

/** A light at (`x`, `y`) of radius `r`, `strength` in hundredths. */
void light(Vec<i32> lights, i32 x, i32 y, i32 r, i32 strength) {
  lights.push(x);
  lights.push(y);
  lights.push(r);
  lights.push(strength);
}

/**
 * **The dark**: everything dimmed to an eighth, but where the lights reach, brightest at each light and falling away
 * to its edge. Lights add, so two lanterns side by side light the ground between them.
 */
void darken(Screen s, Vec<i32> lights) {
  // How lit each pixel is, built light by light over each one's own square, then laid over the picture.
  f64[] lit = f64[].filled(SCREEN_W * SCREEN_H, 0.12);
  for (i32 k = 0; k < lights.len() / 4; k++) {
    i32 cx = lights.get(k * 4);
    i32 cy = lights.get(k * 4 + 1);
    i32 r = lights.get(k * 4 + 2);
    f64 strength = (lights.get(k * 4 + 3) as f64) / 100.0;
    for (i32 y = cy - r < 0 ? 0 : cy - r; y < cy + r && y < SCREEN_H; y++) {
      for (i32 x = cx - r < 0 ? 0 : cx - r; x < cx + r && x < SCREEN_W; x++) {
        i32 d2 = (x - cx) * (x - cx) + (y - cy) * (y - cy);
        if (d2 < r * r) { lit[y * SCREEN_W + x] = lit[y * SCREEN_W + x] + (1.0 - (d2 as f64) / ((r * r) as f64)) * strength; }
      }
    }
  }
  for (i32 i = 0; i < lit.len(); i++) {
    if (lit[i] >= 1.0) { continue; }
    for (i32 c = 0; c < 3; c++) { s.px[i * 4 + c] = (((s.px[i * 4 + c] as i32) as f64 * lit[i]) as~ i32) as@ u8; }
  }
}
