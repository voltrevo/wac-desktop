// Pip's five levels, as text: built and checked by a script outside the repository, which places their pieces and
// checks that every lantern, checkpoint and the door can be reached from the start by runs, jumps and drops.
//
//     .  air          #  ground        =  a plank, stood on from above and jumped through from below
//     ^  spikes       X  a block that crumbles a moment after it is stood on, and comes back
//     L  a lantern    C  a checkpoint  E  the door, open once every lantern is lit
//     P  where Pip starts              p  a beetle that patrols   h  a frog that hops at Pip
//     M  the left end of a plank that slides three tiles right and back
//
// Each is 64 tiles wide and 12 high; the bottom row is bedrock.

/** A level: its name, and its rows from the top. */
export struct Level {
  string name;
  string[] rows;
}

export Level[] allLevels() {
  return [
    Level("First Light", [
      "................................................................",
      "................................................................",
      "................................................................",
      "...............................L................................",
      "......................................L.........................",
      "..............................===...............................",
      "................L...................................L...........",
      "...........................##........####....................E..",
      ".P.........................##...C....####.........p......#######",
      "#########....########....################....###################",
      "#########^^^^########^^^^################^^^^###################",
      "################################################################"]),
    Level("Plank Hollow", [
      "................................................................",
      "...............................L................................",
      "................................................................",
      "..............................===...............................",
      "...............................................L................",
      "..........L...............===............L......................",
      "...................====.......................===............E..",
      ".........===............................h................#######",
      ".P.............p...........C........#########............#######",
      "########....#######....########.....#########.....##############",
      "########^^^^#######^^^^########^^^^^#########^^^^^##############",
      "################################################################"]),
    Level("Crumbling Steps", [
      "................................................................",
      "................................................................",
      "................................................................",
      ".......................L.........L............L.................",
      "................................................................",
      "................................===..........................E..",
      "......................XXX....................XXX.........L.#####",
      ".................XXX.......XXX..........XXX.......XXX......#####",
      ".P...h......XXX...................C........................#####",
      "##########.....................######.................##########",
      "##########^^^^^^^^^^^^^^^^^^^^^######^^^^^^^^^^^^^^^^^##########",
      "################################################################"]),
    Level("Lantern Mill", [
      "................................................................",
      "................................................................",
      "...............................L................................",
      "................................................................",
      "..........L...................===...........L...................",
      ".......................M................................L.....E.",
      "..........................................====...M..........####",
      "........M..........####......C..p...........................####",
      ".P.................####.....########.........h.......###########",
      "#######.........#######.....########.....########....###########",
      "#######^^^^^^^^^#######^^^^^########^^^^^########^^^^###########",
      "################################################################"]),
    Level("The Long Night", [
      "................................................................",
      "................................................................",
      ".............................L..................................",
