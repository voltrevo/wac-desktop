// Pip's twelve levels, as text. The first five are short, placed by hand; the seven after are long, built from pieces
// by `tools/pip_levels.py`. test/pip_test.wac checks that every lantern, flag and door in each can be reached.
//
//     .  air          #  ground        =  a plank, stood on from above and jumped through from below
//     ^  spikes       X  a block that crumbles a moment after it is stood on, and comes back
//     L  a lantern    C  a checkpoint  E  the door, open once every lantern is lit
//     P  where Pip starts              p  a beetle that patrols   h  a frog that hops at Pip
//     M  the left end of a plank that slides three tiles right and back
//     S  a spring, which throws Pip about seven tiles up
//
// Each is 12 high, the bottom row bedrock, and as wide as its rows: the first five 64, the rest longer.

/** A level: its name, and its rows from the top. */
export struct Level {
  string name;
  string[] rows;
}

