/**
 * Paint's look, on the desktop's tokens so it follows the theme: a toolbar, the tools down the left, the picture on a
 * quiet ground in the middle — over a checkerboard, so what is transparent shows as such — and the colours below.
 */
export string paintCss() {
  return """
    .paintpage, .paint { height: 100%; }
    .paint { display: flex; flex-direction: column; position: relative; outline: 0; background: var(--surface);
             color: var(--text); user-select: none; -webkit-user-select: none; font-size: 13px; }
    .ptop { display: flex; align-items: center; gap: 4px; padding: 6px 8px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
    .ptop .btn { height: 30px; padding: 0 10px; }
    .psep { width: 1px; height: 22px; background: var(--line); margin: 0 4px; }
    .pgrow { flex: 1; }
    .pbtn { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px;
            border: 1px solid transparent; background: none; color: var(--text); cursor: pointer; font: inherit; font-weight: 600; }
    .pbtn:hover:not([disabled]) { background: var(--hover); border-color: var(--line); }
    .pbtn[disabled] { opacity: .35; cursor: default; }
    .pzoom { min-width: 58px; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface-2);
             color: var(--text); font: inherit; font-variant-numeric: tabular-nums; cursor: pointer; }
    .pzoom:hover { border-color: var(--faint); }
    .popts { display: flex; align-items: center; gap: 10px; padding: 0 12px; min-height: 38px; border-bottom: 1px solid var(--line);
             background: var(--surface-2); flex-wrap: wrap; }
    .plabel { color: var(--muted); }
    .prange { width: 150px; accent-color: var(--accent); }
    .pval { min-width: 44px; font-variant-numeric: tabular-nums; color: var(--muted); }
    .phint { color: var(--faint); font-size: 12px; }
    .pseg { display: inline-flex; gap: 0; }
    .pseg .pchip { border-radius: 0; } .pseg .pchip:first-child { border-radius: 7px 0 0 7px; }
    .pseg .pchip:last-child { border-radius: 0 7px 7px 0; margin-left: -1px; }
    .pchip { height: 26px; padding: 0 10px; border-radius: 7px; border: 1px solid var(--line-strong); background: var(--surface);
             color: var(--text); font: inherit; font-size: 12px; cursor: pointer; }
    .pchip.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); position: relative; }
    .pbody { flex: 1; display: flex; min-height: 0; }
    .ptools { display: flex; flex-direction: column; gap: 4px; padding: 8px 6px; border-right: 1px solid var(--line); overflow-y: auto; }
    .ptool { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 9px;
             border: 1px solid transparent; background: none; color: var(--text); cursor: pointer; flex: none; }
    .ptool:hover { background: var(--hover); }
    .ptool.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
    .pscroll { flex: 1; overflow: auto; background: var(--sunken); position: relative; }
    .pstage { display: flex; min-width: 100%; min-height: 100%; width: max-content; padding: 20px; box-sizing: border-box; }
    .pframe { margin: auto; position: relative; flex: none; touch-action: none; cursor: crosshair;
              box-shadow: 0 0 0 1px var(--line-strong), 0 10px 30px -14px rgb(0 0 0 / .45);
              background: repeating-conic-gradient(#d9dce3 0% 25%, #ffffff 0% 50%) 0 0 / 16px 16px; }
    .pframe.t-picker { cursor: copy; } .pframe.t-bucket { cursor: cell; }
    .pcanvas { display: block; width: 100%; height: 100%; }
    /* While a stroke is under way: the whole window, so the pointer stays over the frame wherever it goes. */
    .pcover { position: fixed; inset: 0; z-index: 5; cursor: crosshair; }
    .pbottom { display: flex; align-items: center; gap: 14px; padding: 8px 10px; border-top: 1px solid var(--line); flex-wrap: wrap; }
    .pcolours { display: flex; align-items: center; gap: 12px; }
    .pwell { position: relative; width: 52px; height: 44px; flex: none; }
    .pcolor { position: absolute; width: 30px; height: 30px; padding: 0; border: 2px solid var(--surface); border-radius: 7px;
              box-shadow: 0 0 0 1px var(--line-strong); cursor: pointer; }
    .pcolor:hover { box-shadow: 0 0 0 1px var(--accent); }
    .pfg { left: 0; top: 0; z-index: 1; } .pbg { left: 18px; top: 14px; }
    .pswap { position: absolute; right: -8px; top: -6px; width: 18px; height: 18px; padding: 0; border: 0; background: none;
             color: var(--muted); cursor: pointer; display: flex; } .pswap .ic { width: 13px; height: 13px; }
    .ppalette { display: grid; grid-template-columns: repeat(14, 18px); gap: 3px; }
    .pswatch { width: 18px; height: 18px; padding: 0; border-radius: 4px; border: 1px solid rgb(0 0 0 / .18); cursor: pointer; }
    .pswatch:hover { transform: scale(1.15); }
    .pstatus { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 14px; color: var(--muted);
               font-variant-numeric: tabular-nums; min-width: 0; white-space: nowrap; }
    .pnote { color: var(--text); overflow: hidden; text-overflow: ellipsis; }
    .ppos { min-width: 70px; text-align: right; }
    /* The selection: marching ants, as two dashed borders a dash apart; a floating one is moved by dragging inside it. */
    .psel { position: absolute; pointer-events: none; outline: 1px dashed #000; box-shadow: 0 0 0 1px #fff;
            outline-offset: 0; animation: pants .6s steps(2) infinite; }
    .psel.floating { outline-color: var(--accent); }
    .pframe.t-select { cursor: crosshair; }
    @keyframes pants { 50% { outline-color: #fff; box-shadow: 0 0 0 1px #000; } }
    .ptextbox { position: absolute; pointer-events: none; outline: 1px dashed var(--accent); outline-offset: 2px; }
    .pframe.t-text { cursor: text; }
    .ptextin { height: 28px; width: min(320px, 40%); padding: 0 10px; border-radius: 7px; border: 1px solid var(--accent);
               background: var(--surface); color: var(--text); font: inherit; }
    .pshort { width: 90px; }
    .pact-btn { display: inline-flex; align-items: center; gap: 5px; }
    .pact-btn[disabled] { opacity: .4; cursor: default; }
    .pact-btn .ic { width: 13px; height: 13px; }
    /* The colour picker, over the bottom left, above a layer that closes it when clicked. */
    .ppickshade { position: absolute; inset: 0; z-index: 9; }
    .ppickaway { position: absolute; inset: 0; }
    .ppicker { position: absolute; left: 10px; bottom: 64px; width: 244px; padding: 10px 12px 12px; border-radius: 12px;
               background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-lg);
               display: flex; flex-direction: column; gap: 9px; }
    .ppickhead { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 12px; }
    .psv { position: relative; width: 220px; height: 150px; border-radius: 6px; cursor: crosshair; touch-action: none;
           background-image: linear-gradient(to top, #000, transparent), linear-gradient(to right, #fff, transparent); }
    .psvdot { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 99px;
              border: 2px solid #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / .5); pointer-events: none; }
    .phue, .palpha { width: 220px; margin: 0; height: 14px; border-radius: 7px; -webkit-appearance: none; appearance: none; }
    .phue { background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00); }
    .palpha { background: linear-gradient(to right, transparent, var(--c)),
                          repeating-conic-gradient(#c8ccd4 0% 25%, #fff 0% 50%) 0 0 / 8px 8px; }
    .phue::-webkit-slider-thumb, .palpha::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px;
              border-radius: 99px; background: #fff; border: 0; box-shadow: 0 0 0 1px rgb(0 0 0 / .45), 0 1px 3px rgb(0 0 0 / .3); }
    .ppickrow { display: flex; align-items: center; gap: 8px; }
    .pbefore, .pafter { width: 26px; height: 26px; border-radius: 6px; box-shadow: 0 0 0 1px var(--line-strong); flex: none; }
    .pbefore { cursor: pointer; }
    .phex { flex: 1; min-width: 0; height: 28px; padding: 0 8px; border-radius: 7px; border: 1px solid var(--line-strong);
            background: var(--surface-2); color: var(--text); font: 12.5px ui-monospace, monospace; }
    .precent { display: grid; grid-template-columns: repeat(7, 26px); gap: 4px; }
    .precent .pswatch { width: 26px; height: 20px; }
    .pfrom { align-self: flex-start; }
    .pmodal { position: absolute; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center;
              background: rgb(0 0 0 / .35); }
    .pcard { width: min(440px, calc(100% - 40px)); max-height: calc(100% - 40px); overflow-y: auto; padding: 18px 20px;
             border-radius: 14px; background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg); line-height: 1.45; }
    .pcard h2 { margin: 0 0 10px; font-size: 18px; }
    .pfaint { color: var(--muted); margin: 0 0 10px; }
    .pfields { display: grid; grid-template-columns: 90px 1fr; gap: 8px 12px; align-items: center; margin: 10px 0; }
    .pfields > span:first-child, .pfields > span:nth-child(3) { color: var(--muted); }
    .pnum, .pname { height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line-strong); background: var(--surface-2);
                    color: var(--text); font: inherit; min-width: 0; }
    .pact { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
    .pkeys { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; font-size: 13px; }
    .pkeys > span:nth-child(odd) { color: var(--muted); }
    @media (max-width: 640px) { .ppalette { grid-template-columns: repeat(7, 18px); } .ptop .btn .label { display: none; } }
  """;
}
