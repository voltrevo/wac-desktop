// Pip and the Lost Lanterns: a little platformer in five levels, with a chip's sounds — and a measure, on screen, of
// how long a key takes to show.
//
// **Light every lantern, then reach the door.** Pip runs, jumps — higher the longer the key is held — slides down
// walls and jumps off them, stomps beetles and frogs, and comes back at the last flag touched. Each level's best time
// is kept in the program's own folder.
//
// **Made to feel the latency by.** A key is stamped by the browser when it is pressed (`ElementEvent.at`), on the
// same clock the program reads, wherever it runs — in a worker, or in a window of the desktop's, a process away. The
// corner says, for the keys that moved Pip: how long the key took to reach the program; how long until the frame
// showing it was drawn — to the frame after it was sent, which is when it is on screen at the latest; and how long
// until the jump's sound was sent. `L` hides it.
//
// **A fixed step**: the rules run sixty times a second whatever the screen's rate (`pip/world.wac`); each frame runs
// as many steps as time has passed, then draws. The sounds are made once, at the start (`pip/chip.wac`).

import { Ticket, Vec } from "core";
import { Desktop, Element, ElementEvent, Node, Page, Ref, Sound, Ui, Voice, html.b, html.button, html.canvas, html.div,
         html.h1, html.p, html.span, html.style } from "web";
import { css } from "../style.wac";
import { pipCss } from "./pip/style.wac";
import { Level, allLevels } from "./pip/levels.wac";
import { CUE_JUMP, CUE_OPEN, CUE_WALL_JUMP, CUE_WIN, Keys, RUN_LEVELS, World, load, step } from "./pip/world.wac";
import { SCREEN_H, SCREEN_W, Screen, drawInputs, drawWorld, follow, snap } from "./pip/art.wac";
import { Checked, FULL_RUN, LEVEL_RUN, Leg, RESTART, Run, checkRun, clockOf, deltaAt, deltaOf, keyByte, keysOf, lastAttempt,
         runBytes, runOf, stepsIn, sumOfBest, total } from "./pip/runs.wac";
import { BETWEEN, FULL_GHOST, GHOST, INPUTS, LATENCY, Option, SCREEN, SOUND, SPLITS, SWAP, TOUCH, defaultOptions, optionsText, readOptions,
         turn } from "./pip/options.wac";
import { RATE, effects } from "./pip/chip.wac";
import { LAYERS, RACE, mixed, songNamed, stems } from "./pip/music.wac";
import { fixed } from "./maths.wac";

static i32 TITLE = 0;
static i32 PLAYING = 1;
static i32 PAUSED = 2;
static i32 CLEARED = 3;
static i32 DONE = 4;
/** The Options card, the Replays card, a run being watched, and a full run's end. */
static i32 OPTIONS = 5;
static i32 REPLAYS = 6;
static i32 WATCHING = 7;
static i32 FULL_DONE = 8;
static f64 STEP_MS = 16.666666666666668;
static string KEPT = "best";
static string FULL = "fullrun";
static string OPTIONS_FILE = "options";

/** A running measure: the last few values, to show their mean. */
struct Meter {
  Vec<f64> seen;
  f64 last;

  Meter create() { return Meter(Vec.create(), 0.0 - 1.0); }

  void add(this, f64 v) {
    this.last = v;
    this.seen.push(v);
    if (this.seen.len() > 30) { this.seen.remove(0); }
  }

  string shown(this) {
    if (this.last < 0.0) { return "–"; }
    f64 sum = 0.0;
    for (i32 i = 0; i < this.seen.len(); i++) { sum = sum + this.seen.get(i); }
    return "\{fixed(this.last, 0)} ms (mean \{fixed(sum / (this.seen.len() as f64), 0)})";
  }
}

struct Pip {
  Page page;
  Level[] levels;
  i32 index;
  World world;
  Screen screen;
  i32 mode;
  Keys keys;
  /** Held keys by name, so a key's repeats are not new presses and its release lets go only of it. */
  Vec<string> held;
  /** When the earliest key not yet taken up by a step was pressed, and when the last one taken up was; -1 none. */
  f64 pressedAt;
  f64 takenAt;
  /** The frame showing a key, sent: when that key was pressed. */
  f64 showing;
  Meter arrive;
  Meter toScreen;
  Meter toSound;
  /** The time between pictures, averaged: the frames a second the latency corner shows. */
  f64 drawMs;
  bool latency;
  bool muted;
  /** The effects by cue, the tune, and the tune playing. */
  Sound[] fx;
  /** The music playing (`Band`). */
  Band band;
  /** Each level's best, in steps; 0 none yet. And how far the player has got. */
  i32[] best;
  i32 reached;
  bool newBest;
  /** Each level's par, in steps, which the medals are measured by. */
  i32[] pars;
  /**
   * **The ghost**: the keys of each level's best run, a byte a step (`keyByte`), and — while a level is played — this
   * run's keys so far, and the best run played again beside it in a world of its own. The rules are the same and
   * nothing in them is random, so the same keys make the same run. `G` hides it.
   */
  u8[][] bestRuns;
  Vec<u8> recording;
  World? shadow;
  i32 shadowAt;
  bool ghosts;
  i32 frame;
  Element? canvas;
  Element? stage;
  fn<void()> bump;
  /** Paused: the level the arrows have chosen, which Enter plays — the one being played until they move. */
  i32 pick;
  /** Time not yet stepped, carried to the next frame (`paced`); and when a picture was last drawn, for the counter. */
  Pace pace;
  f64 drawnAt;
  /** The ghost's keys on the level being played: whichever the options say (`ghostFor`). */
  u8[] ghostRun;
  Speed sp;
  Touch touch;
  /** Whether the game fills the screen: as the host says (`fullscreenchange`), not as asked. */
  bool screenFull;
}

/**
 * **On-screen controls, for a touch screen**: a pad for the left thumb — touch anywhere in it and slide, left or right
 * of where the thumb came down, to run that way, turning without lifting — and a Jump button for the right, held for
 * a higher jump as the key is. Each keeps its own finger until it lifts (`prevent="capture"`), so the two are
 * followed apart and a finger slid off still lets go. They are keys like any other: the ghost, a run's keys and the
 * keys-held display cannot tell them from a keyboard's.
 */
struct Touch {
  /**
   * The pad's finger, or -1; where it came down, where it is now, which way that runs — -1, 0 or 1 — and how hard, as
   * `Keys.slow` has it: 0 full, more the less far it has slid.
   */
  i32 pad;
  i32 fromX;
  i32 fromY;
  i32 atX;
  i32 dir;
  i32 slow;
  /** The Jump button's finger, or -1. */
  i32 jump;
}

/**
 * How far from where it came down a thumb must slide to run — a small dead zone, so a thumb resting is still — and how
 * far it can be, so turning back is quick. Between the two, **the further it slides the faster Pip runs**: from
 * `SLOWEST` levels of `RUN_LEVELS` just past the dead zone, to full at its reach.
 */
static i32 DEAD = 8;
static i32 REACH = 46;
static i32 SLOWEST = 3;

/** The speedrunning side of the game, all of it opt-in (`pip/options.wac`). */
struct Speed {
  Option[] options;
  /** The Options and Replays cards: what they were opened over — the title or the pause card — and the row chosen. */
  i32 back;
  i32 row;
  /** The full run under way; null when none is. */
  Full? full;
  /** The best full run: each level's keys and time; empty until there is one. */
  Leg[] bestFull;
  i32[] bestSplits;
  /** The last steps' keys, for the keys-held display. */
  Vec<u8> recent;
  /** The run being watched. */
  Watch? watch;
  /** A run brought in from elsewhere, raced as the ghost on its level until the title. */
  Leg? race;
  /** The desktop, to save a run to and choose one from; null on a page of its own. */
  Desktop? desk;
  /** A line on the Replays card: what was saved, or why a run was not taken. */
  string note;
}

/** **A full run**: every level in order, on one clock that does not stop for a level started again. */
struct Full {
  /** Each finished level's time, and its keys — restarts among them. */
  Vec<i32> splits;
  Vec<Leg> legs;
  /** This level's keys so far. */
  Vec<u8> keys;
  bool newBest;
  /** The best full run's level times when this run started: what it is compared with, all the way. */
  i32[] against;
}

/** A run watched: the run, each level's time, where it is — which level and which key — and how. */
struct Watch {
  Run run;
  i32[] times;
  i32 leg;
  i32 at;
  i32 steps;
  bool paused;
  /** How fast, as a power of two: 0 is as played, -2 a quarter, 2 four times. */
  i32 speed;
  f64 owed;
  bool imported;
}

/** What `bump` is until the window is drawn. */
void quiet() { }

// ── Time kept ───────────────────────────────────────────────────────────────

/**
 * **A level's par**, in steps: the way across it at a run — floor after floor, and each climb between, for a tower —
 * and a little for each lantern, with room to spare. Gold is par or better, silver within half as much again, and
 * bronze any finish. Worked out from the level's shape, not from anyone's run, so it is a fair first guess.
 */
export i32 par(World w) {
  f64 run = 16.0 / 2.3;
  f64 way = (w.cols as f64) * run;
  if (w.rows > 12) {
    f64 floors = ((w.rows - 3) / 7) as f64;
    way = floors * ((w.cols - 4) as f64) * run + floors * 7.0 * 16.0 * 2.5 / 2.3;
  }
  return ((way * 1.3) as~ i32) + w.lanterns * 30;
}

/** The medal for `steps` against `par`: 3 gold, 2 silver, 1 bronze, 0 none yet. */
export i32 medal(i32 steps, i32 par) {
  if (steps <= 0) { return 0; }
  if (steps <= par) { return 3; }
  if (steps * 2 <= par * 3) { return 2; }
  return 1;
}

string medalName(i32 m) { return m == 3 ? "gold" : (m == 2 ? "silver" : (m == 1 ? "bronze" : "none")); }

/** Steps as a time: `1:02.4`. */
export string clock(i32 steps) {
  i32 tenths = steps * 10 / 60;
  i32 secs = tenths / 10;
  return "\{secs / 60}:\{secs % 60 < 10 ? "0" : ""}\{secs % 60}.\{tenths % 10}";
}

void keepBest(Pip g) {
  string text = "\{g.reached}";
  for (i32 i = 0; i < g.best.len(); i++) { text = text + " \{g.best[i]}"; }
  g.page.sys.files().writeFile(KEPT, (text + "\n").toBytes());
}

/** A whole number, or 0. */
i32 wholeOf(string s) {
  i32 v = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] >= '0' && b[i] <= '9') { v = v * 10 + ((b[i] - '0') as i32); } }
  return v;
}

/** What `keepBest` wrote, onto `best` — the furthest level reached first. */
export i32 restoreBest(string text, i32[] best) {
  Vec<string> words = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    bool gap = i == text.len() || text.slice(i, i + 1) == " " || text.slice(i, i + 1) == "\n";
    if (gap) {
      if (i > start) { words.push(text.slice(start, i)); }
      start = i + 1;
    }
  }
  if (words.len() == 0) { return 0; }
  for (i32 i = 0; i < best.len() && i + 1 < words.len(); i++) { best[i] = wholeOf(words.get(i + 1)); }
  i32 r = wholeOf(words.get(0));
  return r < best.len() ? r : best.len() - 1;
}

// ── Music ───────────────────────────────────────────────────────────────────

/**
 * **The music**: a song for each kind of place (`music.wac`), rendered the first time it is wanted, a sound per layer;
 * the song playing, a voice per layer, all started for one moment so they never drift apart; and how loud each is now.
 */
struct Band {
  string style;
  Vec<string> made;
  Vec<Sound[]> sounds;
  Voice[] voices;
  f64[] volumes;
  Sound? fanfare;

  Band create() { return Band("", Vec.create(), Vec.create(), Voice[](), f64[](), null); }
}

/** The song a level gets: the dark, a tower's, the wind's where there is wind or an updraft, or the fields'. */
export string styleOf(World w) {
  if (w.level.dark) { return "dark"; }
  if (w.rows > 12) { return "towers"; }
  for (i32 i = 0; i < w.tiles.len(); i++) {
    u8 c = w.tiles[i];
    if (c == '|' || c == '<' || c == '>') { return "wind"; }
  }
  return "field";
}

/** The sounds of song `style`, a layer each: made and sent the first time, and kept. */
Sound[] soundsOf(Pip g, string style) {
  for (i32 i = 0; i < g.band.made.len(); i++) { if (g.band.made.get(i) == style) { return g.band.sounds.get(i); } }
  f64[][] parts = stems(songNamed(style));
  Sound[] made = Sound[].filled(parts.len(), g.fx[0]);
  for (i32 l = 0; l < parts.len(); l++) {
    // A layer this song leaves empty is a sample of silence, not seconds of it.
    bool any = false;
    for (i32 i = 0; i < parts[l].len() && !any; i++) { if (parts[l][i] != 0.0) { any = true; } }
    made[l] = g.page.sound(any ? parts[l] : [0.0], RATE);
  }
  g.band.made.push(style);
  g.band.sounds.push(made);
  return made;
}

/** Song `style` playing, every layer from the same moment, each as loud as it should be — unless it already is. */
void play(Pip g, string style) {
  if (g.band.style == style && g.band.voices.len() > 0) { return; }
  silence(g);
  Sound[] layers = soundsOf(g, style);
  g.band.style = style;
  f64 at = g.page.now() + 120.0;
  g.band.voices = Voice[].filled(layers.len(), g.fx[0].play(0.0));
  g.band.volumes = f64[].filled(layers.len(), 0.0);
  for (i32 l = 0; l < layers.len(); l++) {
    f64 v = loudness(g, l);
    g.band.voices[l] = layers[l].playAt(v, true, at, 0.0);
    g.band.volumes[l] = v;
  }
}

/** The song stopped. */
void silence(Pip g) {
  for (i32 l = 0; l < g.band.voices.len(); l++) { g.band.voices[l].stop(); }
  g.band.voices = Voice[]();
  g.band.style = "";
}

/**
 * How loud layer `l` should be now. The melody and what is under it always play; the chords, the counter-melody and
 * the drums come in a third of the lanterns at a time; the sparkle when the door opens; the ticking hat while Pip is
 * ahead of the ghost. Paused, or falling, it all ducks; muted, it is silent. The title and the finale play whole.
 */
f64 loudness(Pip g, i32 l) {
  if (g.muted) { return 0.0; }
  bool held = g.mode == PAUSED || (g.mode == OPTIONS && g.sp.back == PAUSED);
  f64 duck = held ? 0.35 : (g.mode == PLAYING && g.world.hero.dying > 0 ? 0.45 : 1.0);
  f64 full = 0.8 * duck;
  if (g.band.style == "title" || g.band.style == "finale") { return l == RACE ? 0.0 : full; }
  World w = g.world;
  if (l <= 1) { return full; }
  if (l <= 4) {
    i32 earned = w.lanterns > 0 ? 3 * w.lit / w.lanterns : 3;
    return earned >= l - 1 ? full : 0.0;
  }
  if (l == 5) { return w.lit == w.lanterns ? full : 0.0; }
  return ahead(g) ? full : 0.0;
}

/** Whether Pip is ahead of the ghost: more lanterns lit, or as many and further on — up a tower, along a level. */
bool ahead(Pip g) {
  World? ghost = g.shadow;
  if (ghost is null || !g.ghosts || g.mode != PLAYING) { return false; }
  World b = ghost!;
  if (b.won) { return false; }
  if (g.world.lit != b.lit) { return g.world.lit > b.lit; }
  return g.world.rows > 12 ? g.world.hero.y < b.hero.y - 8.0 : g.world.hero.x > b.hero.x + 8.0;
}

/** Each layer turned to where it should be: up over most of a second as it is earned, down at once. */
void tuneUp(Pip g) {
  for (i32 l = 0; l < g.band.voices.len(); l++) {
    f64 v = loudness(g, l);
    f64 d = v - g.band.volumes[l];
    if (d < 0.001 && d > 0.0 - 0.001) { continue; }
    g.band.voices[l].fade(v, d > 0.0 ? 700 : 150);
    g.band.volumes[l] = v;
  }
}

// ── Play ────────────────────────────────────────────────────────────────────

/**
 * **Full screen, asked for or left**: the host decides — a browser only just after a tap or a key, a desktop by its own
 * rules and with its own way out — and the game hears what it decided (`screenFull`).
 */
void toggleScreen(Pip g) {
  if (g.stage is not null) { g.stage!.fullScreen(!g.screenFull); }
}

void begin(Pip g, i32 index) {
  // As a level starts — by a key or a tap, which is when a host lets a page fill the screen — if the options say so.
  if (g.sp.options[SCREEN].chosen == 1 && !g.screenFull && g.stage is not null) { g.stage!.fullScreen(true); }
  g.index = index;
  g.world = load(g.levels[index]);
  g.recording = Vec.create();
  g.shadowAt = 0;
  g.ghostRun = ghostFor(g, index);
  g.shadow = g.ghostRun.len() > 0 ? load(g.levels[index]) : null;
  g.sp.recent.clear();
  g.mode = PLAYING;
  g.newBest = false;
  snap(g.screen, g.world);
  g.keys = Keys.none();
  g.held.clear();
  play(g, styleOf(g.world));
  g.bump();
}

/**
 * The level the arrow `k` moves to from `at`, in the title's and the pause card's list — three to a row, so up and
 * down move by three — and never past the furthest level reached; `at` for any other key.
 */
export i32 movedTo(i32 at, i32 reached, string k) {
  i32 to = k == "ArrowUp" ? at - 3 : (k == "ArrowDown" ? at + 3 : (k == "ArrowLeft" ? at - 1 : (k == "ArrowRight" ? at + 1 : at)));
  return to < 0 ? 0 : (to > reached ? reached : to);
}

/** On the title, level `i` chosen — any reached so far — and shown behind the title, as it starts. */
void choose(Pip g, i32 i) {
  i32 n = i < 0 ? 0 : (i > g.reached ? g.reached : i);
  if (n == g.index) { return; }
  g.index = n;
  g.world = load(g.levels[n]);
  snap(g.screen, g.world);
  g.bump();
}

bool isArrow(string k) { return k == "ArrowUp" || k == "ArrowDown" || k == "ArrowLeft" || k == "ArrowRight"; }

/** Paused: the keys let go, the clock stopped, and the pause card's list on the level being played. */
void pause(Pip g) {
  g.mode = PAUSED;
  g.pick = g.index;
  g.held.clear();
  letGo(g);
  readKeys(g);
  g.bump();
}

void goOn(Pip g) {
  g.mode = PLAYING;
  g.held.clear();
  readKeys(g);
  g.bump();
}

/** Whether a key is one of `names`, a list split by spaces. */
bool isKey(string k, string names) { return k != "" && k != " " && (" " + names + " ").indexOf(" " + k + " ") >= 0; }

bool isLeft(string k) { return isKey(k, "ArrowLeft a A"); }
bool isRight(string k) { return isKey(k, "ArrowRight d D"); }
bool isJump(string k) { return isKey(k, "ArrowUp w W z Z k K x X"); }

bool holding(Pip g, string k) {
  for (i32 i = 0; i < g.held.len(); i++) { if (g.held.get(i) == k) { return true; } }
  return false;
}

/** Which way and whether to jump, from the keys held now. */
void readKeys(Pip g) {
  bool l = false;
  bool r = false;
  bool j = false;
  for (i32 i = 0; i < g.held.len(); i++) {
    string k = g.held.get(i);
    if (isLeft(k)) { l = true; }
    if (isRight(k)) { r = true; }
    if (isJump(k) || k == " ") { j = true; }
  }
  g.keys.left = l || g.touch.dir < 0;
  g.keys.right = r || g.touch.dir > 0;
  g.keys.jump = j || g.touch.jump >= 0;
  // A key held runs at full speed; only the thumb alone runs slower.
  g.keys.slow = l || r ? 0 : g.touch.slow;
}

/** The on-screen controls let go of: paused, the window left — as the keys are. */
void letGo(Pip g) {
  g.touch.pad = 0 - 1;
  g.touch.dir = 0;
  g.touch.slow = 0;
  g.touch.jump = 0 - 1;
}

/** A thumb on the pad: where it came down is the middle, and it runs nowhere until it slides. */
void padDown(Pip g, ElementEvent e) {
  if (g.mode != PLAYING || g.touch.pad >= 0) { return; }
  g.touch.pad = e.pointer;
  g.touch.fromX = e.x;
  g.touch.fromY = e.y;
  g.touch.atX = e.x;
  g.touch.dir = 0;
  g.touch.slow = 0;
  g.bump();
}

void padMove(Pip g, ElementEvent e) {
  if (e.pointer != g.touch.pad) { return; }
  // Past its reach, the middle follows the thumb: turning back is never more than a short slide.
  if (e.x - g.touch.fromX > REACH) { g.touch.fromX = e.x - REACH; }
  if (g.touch.fromX - e.x > REACH) { g.touch.fromX = e.x + REACH; }
  g.touch.atX = e.x;
  i32 dx = e.x - g.touch.fromX;
  i32 dir = dx < 0 - DEAD ? 0 - 1 : (dx > DEAD ? 1 : 0);
  i32 slow = dir == 0 ? 0 : slowAt(dx < 0 ? 0 - dx : dx);
  if (dir != g.touch.dir || slow != g.touch.slow) {
    if (dir != 0 && g.touch.dir == 0 && g.pressedAt < 0.0) { g.pressedAt = e.at; }
    g.touch.dir = dir;
    g.touch.slow = slow;
    readKeys(g);
  }
  g.bump();
}

/** How far short of full speed a thumb `d` from where it came down pushes the run, past the dead zone (`Keys.slow`). */
export i32 slowAt(i32 d) {
  if (d >= REACH) { return 0; }
  i32 levels = RUN_LEVELS - SLOWEST;
  i32 level = SLOWEST + ((d - DEAD) * levels + (REACH - DEAD) / 2) / (REACH - DEAD);
  if (level > RUN_LEVELS) { level = RUN_LEVELS; }
  if (level < SLOWEST) { level = SLOWEST; }
  return RUN_LEVELS - level;
}

void padUp(Pip g, ElementEvent e) {
  if (e.pointer != g.touch.pad) { return; }
  g.touch.pad = 0 - 1;
  g.touch.dir = 0;
  g.touch.slow = 0;
  readKeys(g);
  g.bump();
}

void jumpDown(Pip g, ElementEvent e) {
  if (g.mode != PLAYING || g.touch.jump >= 0) { return; }
  g.touch.jump = e.pointer;
  g.keys.jumped = true;
  if (g.pressedAt < 0.0) { g.pressedAt = e.at; }
  readKeys(g);
  g.bump();
}

void jumpUp(Pip g, ElementEvent e) {
  if (e.pointer != g.touch.jump) { return; }
  g.touch.jump = 0 - 1;
  readKeys(g);
  g.bump();
}

/**
 * The controls themselves: the pad — its stick where the thumb came down, and how far it has slid — and Jump; a
 * pause button while playing; and, watching a run, pause and back. Shown on a touch screen, by the stylesheet, or
 * as the options say (`Touch controls`).
 */
Node touchControls(Pip g) {
  Touch t = g.touch;
  bool held = t.pad >= 0;
  i32 knob = t.atX - t.fromX;
  knob = knob > REACH ? REACH : (knob < 0 - REACH ? 0 - REACH : knob);
  if (g.mode == WATCHING) {
    Watch? v = g.sp.watch;
    return <div class="ptouch">
      <div class="ptbtns">
        <button class="ptbtn" title="Pause or go on" onclick={(ElementEvent e) => { watchKey(g, " "); }}>{v is not null && v!.paused ? "▶" : "❚❚"}</button>
        <button class="ptbtn" title="Back to the replays" onclick={(ElementEvent e) => { watchKey(g, "Escape"); }}>✕</button>
      </div>
    </div>;
  }
  // **Always this one element**, empty when there is nothing to touch: were it a `<span/>` while paused and the card
  // over the game a `<span/>` while playing, the view would match the two, and make the card afresh as it redrew —
  // a tap on it landing on a button already gone.
  if (g.mode != PLAYING) { return <div class="ptouch"></div>; }
  return <div class="ptouch">
    <div class="ppad" prevent="* capture"
         onpointerdown={(ElementEvent e) => { padDown(g, e); }}
         onpointermove={(ElementEvent e) => { padMove(g, e); }}
         onpointerup={(ElementEvent e) => { padUp(g, e); }}
         onpointercancel={(ElementEvent e) => { padUp(g, e); }}>
      <div class={held ? "pstick on" : "pstick"} style={held ? "left: \{t.fromX}px; top: \{t.fromY}px" : ""}>
        <div class={"pknob" + (t.dir < 0 ? " l" : (t.dir > 0 ? " r" : ""))} style={"transform: translateX(\{knob}px)"}></div>
      </div>
    </div>
    <div class={t.jump >= 0 ? "pjump on" : "pjump"} prevent="* capture"
         onpointerdown={(ElementEvent e) => { jumpDown(g, e); }}
         onpointerup={(ElementEvent e) => { jumpUp(g, e); }}
         onpointercancel={(ElementEvent e) => { jumpUp(g, e); }}>Jump</div>
    <div class="ptbtns">
      <button class="ptbtn" title={g.screenFull ? "Leave full screen" : "Full screen"} onclick={(ElementEvent e) => { toggleScreen(g); }}>
        <span class={g.screenFull ? "pfs in" : "pfs"}></span></button>
      <button class="ptbtn" title="Pause" onclick={(ElementEvent e) => { pause(g); }}>❚❚</button>
    </div>
  </div>;
}

void down(Pip g, ElementEvent e) {
  string k = e.value;
  g.arrive.add(g.page.now() - e.at);
  if (k == "F" && (e.mods & 1) != 0) {
    toggleScreen(g);
    return;
  }
  if (g.mode == OPTIONS) { optionsKey(g, k); return; }
  if (g.mode == REPLAYS) { replaysKey(g, k); return; }
  if (g.mode == WATCHING) { watchKey(g, k); return; }
  if (g.mode == FULL_DONE) {
    if (k == "Enter" || k == " " || k == "Escape") { toTitle(g); }
    if (k == "x" || k == "X") { exportFull(g); }
    return;
  }
  if (g.mode == TITLE && (k == "f" || k == "F")) { startFull(g); return; }
  if (g.mode == TITLE && (k == "v" || k == "V")) { openReplays(g); return; }
  if ((g.mode == TITLE || g.mode == PAUSED) && (k == "o" || k == "O")) { openOptions(g); return; }
  if (g.mode == PAUSED && (k == "f" || k == "F")) { startFull(g); return; }
  if (g.mode == PAUSED && (k == "t" || k == "T")) { toTitle(g); return; }
  if (g.mode == TITLE || g.mode == CLEARED || g.mode == DONE) {
    if (k == "Enter" || k == " ") {
      if (g.mode == TITLE) { begin(g, g.index); }
      else if (g.mode == CLEARED) { begin(g, g.index + 1); }
      else { toTitle(g); }
    } else if (g.mode == TITLE && isArrow(k)) {
      choose(g, movedTo(g.index, g.reached, k));
    } else if (g.mode == TITLE && isKey(k, "1 2 3 4 5 6 7 8 9")) {
      i32 n = wholeOf(k) - 1;
      if (n <= g.reached) { begin(g, n); }
    }
    return;
  }
  if (k == "p" || k == "P" || k == "Escape") {
    if (g.mode == PAUSED) { goOn(g); } else { pause(g); }
    return;
  }
  // Enter pauses as well — it is the key the cards over the game all go on with, and the pause card is a menu.
  if (g.mode == PLAYING && k == "Enter") {
    pause(g);
    return;
  }
  if (g.mode == PAUSED) {
    if (k == "Enter" || k == " ") {
      if (g.pick == g.index) { goOn(g); } else { leaveFor(g, g.pick); }
      return;
    }
    if (isArrow(k)) {
      g.pick = movedTo(g.pick, g.reached, k);
      g.bump();
      return;
    }
    if (isKey(k, "1 2 3 4 5 6 7 8 9")) {
      i32 n = wholeOf(k) - 1;
      if (n <= g.reached) { leaveFor(g, n); }
      return;
    }
  }
  if (k == "m" || k == "M") {
    turn(g.sp.options[SOUND], 1);
    applyOptions(g);
    return;
  }
  if (k == "g" || k == "G") {
    g.ghosts = !g.ghosts;
    g.bump();
    return;
  }
  if (k == "l" || k == "L") {
    turn(g.sp.options[LATENCY], 1);
    applyOptions(g);
    return;
  }
  if (k == "r" || k == "R") {
    // In a full run the clock goes on: the restart is in the run's keys, and the time spent stays spent.
    Full? full = g.sp.full;
    if (full is not null) { full!.keys.push(RESTART); }
    begin(g, g.index);
    return;
  }
  if (holding(g, k)) { return; }
  g.held.push(k);
  if (isJump(k) || k == " ") { g.keys.jumped = true; }
  if (g.pressedAt < 0.0) { g.pressedAt = e.at; }
  readKeys(g);
}

void up(Pip g, ElementEvent e) {
  for (i32 i = 0; i < g.held.len(); i++) {
    if (g.held.get(i) == e.value) {
      g.held.remove(i);
      break;
    }
  }
  // A shifted letter lets go as its other case.
  if (e.value.len() == 1) {
    for (i32 i = 0; i < g.held.len(); i++) {
      string h = g.held.get(i);
      if (h.len() == 1 && h != e.value && (h.toBytes()[0] | (32 as u8)) == (e.value.toBytes()[0] | (32 as u8))) {
        g.held.remove(i);
        break;
      }
    }
  }
  readKeys(g);
}

/** Time not yet stepped, carried from one screen frame to the next (`paced`). */
export struct Pace {
  f64 owed;
}

/**
 * **How many sixtieths of a second to step for a frame `dt` milliseconds after the last**: the time owed is carried
 * from one frame to the next, so the game runs sixty steps a second whatever the screen's rate. Rounded a frame at a
 * time and the rest dropped, a phone drawing 45 frames a second took 45 steps — the game itself at three-quarters
 * speed — and one refreshing 120 times a second stepped as rounding fell. A little early counts, so a screen at sixty
 * whose frames come a hair apart steps one each, not none and then two. Far behind — the window hidden, the device
 * asleep — it picks up from now rather than racing to catch up.
 */
export i32 paced(Pace p, f64 dt) {
  p.owed = p.owed + (dt > 250.0 ? STEP_MS : dt);
  i32 ticks = 0;
  while (p.owed >= STEP_MS * 0.9 && ticks < 5) {
    p.owed = p.owed - STEP_MS;
    ticks++;
  }
  if (ticks == 5) { p.owed = 0.0; }
  return ticks;
}

/** Steps for the time that has passed, then the picture: one frame. */
void frame(Pip g, f64 dt, f64 now) {
  i32 ticks = paced(g.pace, dt);
  // **No step, nothing new to show**: the picture as it is stays, and a screen refreshing 120 times a second costs
  // what one refreshing sixty does.
  if (ticks == 0) { return; }
  i32 before = g.frame;
  g.frame = g.frame + ticks;
  // The time between pictures averaged, then turned into a rate: a rate averaged reads high when frames come unevenly
  // — two a millisecond apart count as a thousand a second.
  if (g.drawnAt > 0.0 && now > g.drawnAt) { g.drawMs = g.drawMs * 0.9 + (now - g.drawnAt) * 0.1; }
  g.drawnAt = now;
  if (g.mode == PLAYING) {
    World w = g.world;
    i32 steps = 0;
    while (steps < ticks) {
      steps++;
      f64 key = g.pressedAt;
      g.pressedAt = 0.0 - 1.0;
      bool dying = w.hero.dying > 0;
      u8 byte = keyByte(g.keys);
      g.recording.push(byte);
      g.sp.recent.push(byte);
      if (g.sp.recent.len() > 60) { g.sp.recent.remove(0); }
      Full? full = g.sp.full;
      if (full is not null) { full!.keys.push(byte); }
      step(w, g.keys);
      World? ghost = g.shadow;
      if (ghost is not null) {
        u8[] run = g.ghostRun;
        if (g.shadowAt < run.len()) {
          step(ghost!, keysOf(run[g.shadowAt]));
          g.shadowAt++;
        }
      }
      // Back at a flag, the view goes straight there; otherwise it follows.
      if (dying && w.hero.dying == 0) { snap(g.screen, w); } else { follow(g.screen, w); }
      g.keys.jumped = false;
      if (key >= 0.0) { g.takenAt = key; }
      for (i32 i = 0; i < w.cues.len(); i++) {
        i32 c = w.cues.get(i);
        if (!g.muted && c < g.fx.len()) { g.fx[c].play(c == CUE_WIN || c == CUE_OPEN ? 0.9 : 0.75); }
        if ((c == CUE_JUMP || c == CUE_WALL_JUMP) && key >= 0.0) { g.toSound.add(g.page.now() - key); }
      }
      if (w.won) {
        g.mode = CLEARED;
        i32 prev = g.best[g.index];
        if (prev == 0 || w.steps < prev) {
          g.best[g.index] = w.steps;
          g.newBest = true;
          g.bestRuns[g.index] = g.recording.toArray();
          g.page.sys.files().writeFile("ghost-\{g.index + 1}", g.bestRuns[g.index]);
        }
        // The level's song stops for the fanfare; after the last level, the finale.
        silence(g);
        if (!g.muted && g.band.fanfare is not null) { g.band.fanfare!.play(0.8); }
        if (g.index + 1 < g.levels.len() && g.reached < g.index + 1) { g.reached = g.index + 1; }
        keepBest(g);
        if (full is not null) {
          levelDone(g, full!);
        } else if (g.index + 1 >= g.levels.len()) {
          g.mode = DONE;
          play(g, "finale");
        }
        g.bump();
        break;
      }
    }
  }
  if (g.mode == WATCHING) { watching(g, (ticks as f64) * STEP_MS); }
  tuneUp(g);
  bool inLevel = g.mode == PLAYING || g.mode == PAUSED || g.mode == CLEARED || g.mode == DONE
              || (g.mode == OPTIONS && g.sp.back == PAUSED);
  drawWorld(g.screen, g.world, g.ghosts && inLevel ? g.shadow : null, g.frame);
  if (g.sp.options[INPUTS].chosen == 1 && (inLevel || g.mode == WATCHING)) { drawInputs(g.screen, g.sp.recent.toArray()); }
  if (g.canvas is not null) { g.canvas!.pixels(SCREEN_W, SCREEN_H, g.screen.px); }
  if (g.takenAt >= 0.0) {
    g.showing = g.takenAt;
    g.takenAt = 0.0 - 1.0;
  }
  if (g.frame / 6 != before / 6) { g.bump(); }
}

/**
 * **One frame a screen refresh, the next asked for before this one is made.** In a window of the desktop the request
 * for a frame travels from this program's worker through the page to the desktop's and back; asked for only once a
 * frame was done, its journey came after the frame's work, and a frame that missed the screen's refresh waited for the
 * next — 45 frames a second on a phone refreshing 120 times. Asked for first, the journey overlaps the work.
 */
async void playLoop(Pip g) {
  f64 last = g.page.now();
  Ticket<f64> next = g.page.nextFrame();
  while (true) {
    f64 now = await next;
    next = g.page.nextFrame();
    // The frame after the one that showed a key: it was on the screen by now.
    if (g.showing >= 0.0) {
      g.toScreen.add(now - g.showing);
      g.showing = 0.0 - 1.0;
    }
    f64 dt = now - last;
    last = now;
    frame(g, dt, now);
  }
}

// ── Speedrunning ────────────────────────────────────────────────────────────

/** The title again: any full run or raced run left, and the title's level and song. */
void toTitle(Pip g) {
  g.sp.full = null;
  g.sp.race = null;
  g.sp.watch = null;
  g.mode = TITLE;
  g.world = load(g.levels[g.index]);
  snap(g.screen, g.world);
  play(g, "title");
  g.bump();
}

/** Paused, level `n` chosen: a full run under way is left, since it can only go on in order. */
void leaveFor(Pip g, i32 n) {
  g.sp.full = null;
  begin(g, n);
}

/**
 * **Whose ghost runs beside Pip on level `index`**: a run brought in to race, on its own level; in a full run, the
 * best full run's run of the level — the attempt that reached the door — or the level's own best, as the options say;
 * otherwise the level's own best, unless that is turned off.
 */
u8[] ghostFor(Pip g, i32 index) {
  Leg? race = g.sp.race;
  if (race is not null && race!.level == index) { return race!.keys; }
  if (g.sp.full is not null) {
    i32 c = g.sp.options[FULL_GHOST].chosen;
    if (c == 0 && index < g.sp.bestFull.len()) { return lastAttempt(g.sp.bestFull[index].keys); }
    return c <= 1 ? g.bestRuns[index] : u8[]();
  }
  return g.sp.options[GHOST].chosen == 0 ? g.bestRuns[index] : u8[]();
}

/** A full run from the first level, compared all the way with the best full run as it is now. */
void startFull(Pip g) {
  g.sp.race = null;
  g.sp.full = Full(Vec.create(), Vec.create(), Vec.create(), false, g.sp.bestSplits);
  begin(g, 0);
}

/** How long the full run has taken: every level done, and this one so far, restarts and all. */
i32 fullTime(Full f) {
  i32 t = 0;
  for (i32 i = 0; i < f.splits.len(); i++) { t = t + f.splits.get(i); }
  return t + stepsIn(f.keys.toArray());
}

/** A level of the full run reached its door: its time kept, and on to the next — or to the end of the run. */
void levelDone(Pip g, Full f) {
  u8[] keys = f.keys.toArray();
  f.splits.push(stepsIn(keys));
  f.legs.push(Leg(g.index, keys));
  f.keys = Vec.create();
  if (g.index + 1 >= g.levels.len()) {
    fullDone(g, f);
    return;
  }
  if (g.sp.options[BETWEEN].chosen == 0) { begin(g, g.index + 1); }
}

/** The last door: the run's time, kept as the best full run if it is one. */
void fullDone(Pip g, Full f) {
  g.mode = FULL_DONE;
  i32[] splits = f.splits.toArray();
  if (f.against.len() == 0 || total(splits) < total(f.against)) {
    f.newBest = true;
    g.sp.bestFull = f.legs.toArray();
    g.sp.bestSplits = splits;
    g.page.sys.files().writeFile(FULL, runBytes(Run(FULL_RUN, g.sp.bestFull)));
  }
  play(g, "finale");
}

/** A time as a file name can carry it: `12m34.5s`. */
string fileClock(i32 steps) {
  i32 tenths = steps * 10 / 60;
  i32 secs = tenths / 10;
  return "\{secs / 60}m\{secs % 60 < 10 ? "0" : ""}\{secs % 60}.\{tenths % 10}s";
}

/** `r` as a file: on the Desktop, from a window of the desktop's; downloaded, on a page of its own. */
async void exportRun(Pip g, Run r, i32[] times) {
  string name = r.kind == FULL_RUN ? "Pip full run \{fileClock(total(times))}.piprun"
                                   : "Pip level \{r.legs[0].level + 1} \{fileClock(total(times))}.piprun";
  u8[] bytes = runBytes(r);
  Desktop? d = g.sp.desk;
  if (d is null) {
    g.page.download(name, bytes);
    g.sp.note = "Downloaded \{name}";
    g.bump();
    return;
  }
  match (await d!.newFile(name)) {
    Ok(path): {
      match (await g.page.sys.files().writeFile(path, bytes)) {
        Ok(v): { g.sp.note = "Saved on the Desktop as \{name}"; }
        Err(why): { g.sp.note = "Not saved: \{why}"; }
      }
    }
    Err(why): { g.sp.note = "Not saved: \{why}"; }
  }
  g.bump();
}

void exportFull(Pip g) {
  Full? f = g.sp.full;
  if (f is null) { return; }
  exportRun(g, Run(FULL_RUN, f!.legs.toArray()), f!.splits.toArray());
}

// ── the Options card ──

void openOptions(Pip g) {
  g.sp.back = g.mode;
  g.sp.row = 0;
  g.mode = OPTIONS;
  g.bump();
}

/** What the options say, done: the corners shown or not, the sound, and the options kept. */
void applyOptions(Pip g) {
  g.latency = g.sp.options[LATENCY].chosen == 0;
  g.muted = g.sp.options[SOUND].chosen == 1;
  g.page.sys.files().writeFile(OPTIONS_FILE, optionsText(g.sp.options).toBytes());
  g.bump();
}

void optionsKey(Pip g, string k) {
  i32 n = g.sp.options.len();
  if (k == "Escape" || k == "o" || k == "O" || k == "Backspace") {
    g.mode = g.sp.back;
    g.bump();
    return;
  }
  if (k == "ArrowUp") { g.sp.row = (g.sp.row + n - 1) % n; }
  if (k == "ArrowDown") { g.sp.row = (g.sp.row + 1) % n; }
  if (k == "ArrowLeft") { turn(g.sp.options[g.sp.row], 0 - 1); applyOptions(g); }
  if (k == "ArrowRight" || k == "Enter" || k == " ") { turn(g.sp.options[g.sp.row], 1); applyOptions(g); }
  g.bump();
}

// ── the Replays card, and watching ──

/** What the Replays card lists: "full", a level's number as "L3" — the level's best — and "import". */
string[] replayRows(Pip g) {
  Vec<string> out = Vec.create();
  if (g.sp.bestFull.len() > 0) { out.push("full"); }
  for (i32 i = 0; i < g.levels.len(); i++) { if (g.bestRuns[i].len() > 0) { out.push("L\{i}"); } }
  if (g.sp.desk is not null) { out.push("import"); }
  return out.toArray();
}

/** The run a Replays row stands for, and each of its levels' times. */
Run runAt(Pip g, string row) {
  if (row == "full") { return Run(FULL_RUN, g.sp.bestFull); }
  i32 i = wholeOf(row);
  return Run(LEVEL_RUN, [Leg(i, g.bestRuns[i])]);
}

void openReplays(Pip g) {
  g.sp.back = TITLE;
  g.sp.row = 0;
  g.sp.note = "";
  g.mode = REPLAYS;
  g.bump();
}

void replaysKey(Pip g, string k) {
  string[] rows = replayRows(g);
  if (k == "Escape" || k == "v" || k == "V" || k == "Backspace") {
    g.mode = TITLE;
    g.bump();
    return;
  }
  if (rows.len() == 0) { return; }
  if (g.sp.row >= rows.len()) { g.sp.row = rows.len() - 1; }
  if (k == "ArrowUp") { g.sp.row = (g.sp.row + rows.len() - 1) % rows.len(); }
  if (k == "ArrowDown") { g.sp.row = (g.sp.row + 1) % rows.len(); }
  string row = rows[g.sp.row];
  if (k == "Enter" || k == " ") { replayRow(g, row); return; }
  if ((k == "x" || k == "X") && row != "import") {
    Run r = runAt(g, row);
    Checked c = checkRun(r, g.levels);
    if (c.ok) { exportRun(g, r, c.times); }
  }
  g.bump();
}

void replayRow(Pip g, string row) {
  if (row == "import") { importRun(g); return; }
  watchRun(g, runAt(g, row), false);
}

/** A run chosen from the disk, through the desktop's picker: watched, if playing it again shows it is one. */
async void importRun(Pip g) {
  Desktop? d = g.sp.desk;
  if (d is null) { return; }
  match (await d!.pick("a Pip run to watch")) {
    Ok(path): {
      match (await g.page.sys.files().readFile(path)) {
        Ok(bytes): {
          Run? r = runOf(bytes);
          if (r is null) { g.sp.note = "That is not a Pip run"; } else { watchRun(g, r!, true); }
        }
        Err(why): { g.sp.note = "Could not read it: \{why}"; }
      }
    }
    Err(why): { g.sp.note = why; }
  }
  g.bump();
}

/** `r` watched from its start — once playing it again from its keys has shown it reaches every door it should. */
void watchRun(Pip g, Run r, bool imported) {
  Checked c = checkRun(r, g.levels);
  if (!c.ok) {
    g.sp.note = "That run does not stand: \{c.why}";
    g.bump();
    return;
  }
  g.sp.note = "";
  g.sp.watch = Watch(r, c.times, 0, 0, 0, false, 0, 0.0, imported);
  startLeg(g, g.sp.watch!);
  g.mode = WATCHING;
  g.bump();
}

/** The level the watched run is on, from its start. */
void startLeg(Pip g, Watch v) {
  v.at = 0;
  v.steps = 0;
  g.world = load(g.levels[v.run.legs[v.leg].level]);
  g.sp.recent.clear();
  snap(g.screen, g.world);
  play(g, styleOf(g.world));
}

/** One key of the watched run: a step, a level started again, or on to the next level. False at the very end. */
bool watchStep(Pip g, Watch v, bool loud) {
  Leg leg = v.run.legs[v.leg];
  if (v.at >= leg.keys.len()) {
    if (v.leg + 1 >= v.run.legs.len()) { return false; }
    v.leg++;
    startLeg(g, v);
    return true;
  }
  u8 b = leg.keys[v.at];
  v.at++;
  if (b == RESTART) {
    g.world = load(g.levels[leg.level]);
    snap(g.screen, g.world);
    return true;
  }
  World w = g.world;
  bool dying = w.hero.dying > 0;
  step(w, keysOf(b));
  v.steps++;
  g.sp.recent.push(b);
  if (g.sp.recent.len() > 60) { g.sp.recent.remove(0); }
  if (dying && w.hero.dying == 0) { snap(g.screen, w); } else { follow(g.screen, w); }
  for (i32 i = 0; i < w.cues.len() && loud; i++) {
    i32 c = w.cues.get(i);
    if (!g.muted && c < g.fx.len()) { g.fx[c].play(c == CUE_WIN || c == CUE_OPEN ? 0.9 : 0.75); }
  }
  return true;
}

/** The watched run `steps` steps into the level it is on: played again from the level's start, quietly. */
void seek(Pip g, Watch v, i32 steps) {
  Leg leg = v.run.legs[v.leg];
  v.at = 0;
  v.steps = 0;
  g.world = load(g.levels[leg.level]);
  g.sp.recent.clear();
  while (v.steps < steps && v.at < leg.keys.len()) { watchStep(g, v, false); }
  snap(g.screen, g.world);
}

/** The watched run moved on by the time that has passed, at its speed. */
void watching(Pip g, f64 dt) {
  Watch? v = g.sp.watch;
  if (v is null || v!.paused) { return; }
  // The literal is given its type: `(1 << n) as f64` compiles to a function the engine rejects (wac 84955c78c).
  i32 one = 1;
  f64 rate = v!.speed >= 0 ? ((one << v!.speed) as f64) : 1.0 / ((one << (0 - v!.speed)) as f64);
  v!.owed = v!.owed + (dt > 250.0 ? STEP_MS : dt) * rate;
  i32 n = 0;
  while (v!.owed >= STEP_MS && n < 40) {
    v!.owed = v!.owed - STEP_MS;
    n++;
    if (!watchStep(g, v!, rate <= 1.0)) {
      v!.paused = true;
      g.bump();
      break;
    }
  }
}

void watchKey(Pip g, string k) {
  Watch? maybe = g.sp.watch;
  if (maybe is null) { return; }
  Watch v = maybe!;
  if (k == "Escape" || k == "Backspace" || k == "v" || k == "V") {
    g.sp.watch = null;
    g.mode = REPLAYS;
    g.world = load(g.levels[g.index]);
    snap(g.screen, g.world);
    play(g, "title");
  } else if (k == " " || k == "p" || k == "P" || k == "Enter") {
    // At the very end, it starts again.
    bool ended = v.leg + 1 >= v.run.legs.len() && v.at >= v.run.legs[v.leg].keys.len();
    if (ended) {
      v.leg = 0;
      startLeg(g, v);
      v.paused = false;
    } else {
      v.paused = !v.paused;
    }
    v.owed = 0.0;
  } else if (k == "ArrowLeft" || k == "ArrowRight") {
    i32 to = v.steps + (k == "ArrowLeft" ? 0 - 300 : 300);
    seek(g, v, to < 0 ? 0 : to);
  } else if (k == "ArrowUp" && v.speed < 3) {
    v.speed++;
  } else if (k == "ArrowDown" && v.speed > 0 - 2) {
    v.speed--;
  } else if (k == "." && v.paused) {
    watchStep(g, v, false);
  } else if (k == "," && v.paused) {
    seek(g, v, v.steps > 0 ? v.steps - 1 : 0);
  } else if (k == "x" || k == "X") {
    exportRun(g, v.run, v.times);
  } else if ((k == "r" || k == "R") && v.imported && v.run.kind == LEVEL_RUN) {
    Leg leg = v.run.legs[0];
    if (leg.level > g.reached) {
      g.sp.note = "Reach level \{leg.level + 1} to race it";
    } else {
      g.sp.watch = null;
      g.sp.full = null;
      g.sp.race = leg;
      begin(g, leg.level);
      return;
    }
  }
  g.bump();
}

// ── The window ──────────────────────────────────────────────────────────────

Node Help(Ui ui) {
  return <div class="pkeys">
    <span>Run</span><span><b>←</b> <b>→</b> or <b>A</b> <b>D</b></span>
    <span>Jump</span><span><b>Space</b>, <b>↑</b>, <b>Z</b> or <b>W</b> — hold for higher; against a wall, jump off it</span>
    <span>Pause</span><span><b>Enter</b>, <b>P</b> or <b>Esc</b> — and choose another level · <b>R</b> starts the level again</span>
    <span>Sound</span><span><b>M</b> · <b>L</b> shows or hides the latency · <b>G</b> your best run's ghost</span>
    <span>Speedrun</span><span><b>F</b> all the levels in one run · <b>V</b> replays · <b>O</b> options</span>
    <span>Screen</span><span><b>Shift</b> <b>F</b> full screen, and back</span>
  </div>;
}

/**
 * The levels, as the title and the pause card list them: each with its best time and medal, `chosen` marked, the one
 * being played marked too when paused, and those not reached yet locked. A click plays one — or, paused, goes on with
 * the one being played.
 */
Node levelList(Pip g, i32 chosen) {
  Vec<Node> levels = Vec.create();
  for (i32 i = 0; i < g.levels.len(); i++) {
    string best = g.best[i] > 0 ? clock(g.best[i]) : (i <= g.reached ? "–" : "locked");
    string cls = "plevel" + (i > g.reached ? " locked" : "") + (i == chosen ? " on" : "")
               + (g.mode == PAUSED && i == g.index ? " here" : "");
    i32 m = medal(g.best[i], g.pars[i]);
    i32 n = i;
    levels.push(<div class={cls} title={g.mode == PAUSED && i == g.index ? "Playing now" : null}
                     onclick={i > g.reached ? null : (ElementEvent e) => {
                       if (g.mode == PAUSED && n == g.index) { goOn(g); } else { begin(g, n); }
                     }}>
      <b>{"\{i + 1}"}</b> {g.levels[i].name}<span>{best}<span class={"pm " + medalName(m)} title={"par \{clock(g.pars[i])}"}/></span></div>);
  }
  return <div class="plevels">{levels.toArray()}</div>;
}

/**
 * What is over the game, by its mode: a function of the game rather than a component, since a component handed the
 * same game would be skipped when only the game's insides changed.
 */
Node overlay(Pip g) {
  if (g.mode == TITLE) {
    return <div class="pover"><div class="pcard">
      <h1>Pip and the Lost Lanterns</h1>
      <p>The lanterns of the valley have gone out. Light every one, then find the door.</p>
      <Help/>
      {levelList(g, g.index)}
      {runsLine(g)}
      <p class="pgo">Press <b>Enter</b> to play {g.levels[g.index].name}{g.reached > 0 ? " — or choose another with the arrows" : ""}</p>
      <div class="pbtns">
        <button class="pbtn go" onclick={(ElementEvent e) => { begin(g, g.index); }}><b>▶</b> Play</button>
        <button class="pbtn" onclick={(ElementEvent e) => { startFull(g); }}><b>F</b> Full run</button>
        <button class="pbtn" onclick={(ElementEvent e) => { openReplays(g); }}><b>V</b> Replays</button>
        <button class="pbtn" onclick={(ElementEvent e) => { openOptions(g); }}><b>O</b> Options</button>
        <button class="pbtn pscreenbtn" onclick={(ElementEvent e) => { toggleScreen(g); }}><span class={g.screenFull ? "pfs in" : "pfs"}></span> {g.screenFull ? "Leave full screen" : "Full screen"}</button>
      </div>
    </div></div>;
  }
  if (g.mode == PAUSED) {
    string here = g.levels[g.index].name;
    return <div class="pover"><div class="pcard">
      <h1>Paused</h1>
      <Help/>
      {levelList(g, g.pick)}
      {g.pick == g.index
        ? <p class="pgo">Press <b>Enter</b> or <b>P</b> to go on with {here}{g.reached > 0 ? " — or choose another level with the arrows" : ""}</p>
        : <p class="pgo">Press <b>Enter</b> to play {g.levels[g.pick].name}{g.sp.full is not null ? ", leaving the full run" : ""} · <b>P</b> goes on with {here}</p>}
      <div class="pbtns">
        <button class="pbtn go" onclick={(ElementEvent e) => { if (g.pick == g.index) { goOn(g); } else { leaveFor(g, g.pick); } }}>
          <b>▶</b> {g.pick == g.index ? "Go on" : "Play"}</button>
        <button class="pbtn" onclick={(ElementEvent e) => { startFull(g); }}><b>F</b> {g.sp.full is not null ? "Full run again" : "Full run"}</button>
        <button class="pbtn" onclick={(ElementEvent e) => { openOptions(g); }}><b>O</b> Options</button>
        <button class="pbtn" onclick={(ElementEvent e) => { toTitle(g); }}><b>T</b> Title</button>
        <button class="pbtn pscreenbtn" onclick={(ElementEvent e) => { toggleScreen(g); }}><span class={g.screenFull ? "pfs in" : "pfs"}></span> {g.screenFull ? "Leave full screen" : "Full screen"}</button>
      </div>
    </div></div>;
  }
  if (g.mode == CLEARED || g.mode == DONE) {
    World w = g.world;
    string line = "\{g.levels[g.index].name} in \{clock(w.steps)}" + (w.deaths > 0 ? ", \{w.deaths} \{w.deaths == 1 ? "fall" : "falls"}" : "");
    return <div class="pover"><div class="pcard">
      <h1>{g.mode == DONE ? "Every lantern is lit" : "The way is lit"}</h1>
      <p>{line}</p>
      <p class={g.newBest ? "pbest" : "pfaint"}>{g.newBest ? "A best time!" : "Best: \{clock(g.best[g.index])}"}</p>
      <p class="pmedal"><span class={"pm " + medalName(medal(w.steps, g.pars[g.index]))}/>
        {medalName(medal(w.steps, g.pars[g.index]))} — par \{clock(g.pars[g.index])}{g.newBest ? " · your ghost runs it next time" : ""}</p>
      {g.sp.full is not null ? <p>Full run {clockOf(fullTime(g.sp.full!))} {deltaNode(g.sp.full!)}</p> : <span/>}
      <p class="pgo">Press <b>Enter</b> {g.mode == DONE ? "for the title" : "for level \{g.index + 2}"}</p>
      <div class="pbtns">
        <button class="pbtn go" onclick={(ElementEvent e) => { if (g.mode == DONE) { toTitle(g); } else { begin(g, g.index + 1); } }}>
          <b>▶</b> {g.mode == DONE ? "The title" : "Level \{g.index + 2}"}</button>
        {g.mode == DONE ? <span/> : <button class="pbtn" onclick={(ElementEvent e) => { toTitle(g); }}><b>T</b> Title</button>}
      </div>
    </div></div>;
  }
  if (g.mode == OPTIONS) { return optionsCard(g); }
  if (g.mode == REPLAYS) { return replaysCard(g); }
  if (g.mode == FULL_DONE && g.sp.full is not null) { return fullCard(g, g.sp.full!); }
  return <span/>;
}

/** Ahead or behind the best full run, at the last level this run finished — or nothing, with nothing to compare. */
Node deltaNode(Full f) {
  i32 done = f.splits.len() - 1;
  if (done < 0 || done >= f.against.len()) { return <span/>; }
  i32 d = deltaAt(f.splits.toArray(), f.against, done);
  return <span class={d <= 0 ? "pdelta ahead" : "pdelta behind"} title={"against your best full run, at the end of level \{done + 1}"}>{deltaOf(d)}</span>;
}

/**
 * **The line along the top**: the level, its lanterns and its time — or, in a full run, the whole run's time first,
 * and how far ahead or behind the best full run it was at the last level finished.
 */
Node hudOf(Pip g) {
  if (g.mode == TITLE || g.mode == REPLAYS || (g.mode == OPTIONS && g.sp.back == TITLE)) { return <span/>; }
  World w = g.world;
  Watch? v = g.sp.watch;
  if (g.mode == WATCHING && v is not null) {
    Leg leg = v!.run.legs[v!.leg];
    i32 before = 0;
    for (i32 i = 0; i < v!.leg; i++) { before = before + v!.times[i]; }
    i32 one = 1;
    string speed = v!.speed == 0 ? "" : (v!.speed > 0 ? " · ×\{one << v!.speed}" : " · ×1/\{one << (0 - v!.speed)}");
    string whole = v!.run.kind == FULL_RUN ? " · run \{clockOf(before + v!.steps)} / \{clockOf(total(v!.times))}" : "";
    return <div class="phud">Replay · {g.levels[leg.level].name} · {clockOf(v!.steps)} / {clockOf(v!.times[v!.leg])}{whole}{speed}{v!.paused ? " · Paused" : ""}{g.sp.note != "" ? " · " + g.sp.note : ""}</div>;
  }
  string level = "\{g.levels[g.index].name} · Lanterns \{w.lit}/\{w.lanterns}" + (w.deaths > 0 ? " · Falls \{w.deaths}" : "") + (g.muted ? " · Muted" : "");
  Full? f = g.sp.full;
  if (f is null) {
    Leg? race = g.sp.race;
    return <div class="phud">{level} · {clock(w.steps)}{race is not null && race!.level == g.index ? " · racing a run brought in" : ""}</div>;
  }
  return <div class="phud"><span class="pfull">Full run {clockOf(fullTime(f!))}</span> {deltaNode(f!)} · {level}</div>;
}

/**
 * **Splits**, in a full run, when the options ask: the last few levels finished — each with the run's time at its end,
 * how that stood against the best full run, and a gold mark where the level was as fast as it has ever been — the level
 * under way, and the best full run and the sum of the best of every level, which is what a run could be at best.
 */
Node splitsOf(Pip g) {
  Full? maybe = g.sp.full;
  if (maybe is null || g.sp.options[SPLITS].chosen == 0) { return <span/>; }
  if (g.mode != PLAYING && g.mode != PAUSED && g.mode != CLEARED && !(g.mode == OPTIONS && g.sp.back == PAUSED)) { return <span/>; }
  Full f = maybe!;
  Vec<Node> rows = Vec.create();
  i32[] splits = f.splits.toArray();
  i32 at = 0;
  for (i32 i = 0; i < splits.len(); i++) {
    at = at + splits[i];
    if (i < splits.len() - 4) { continue; }
    i32 d = i < f.against.len() ? deltaAt(splits, f.against, i) : 0;
    rows.push(<div class="psrow">
      <span class="psname">{"\{i + 1} \{g.levels[i].name}"}{splits[i] <= g.best[i] ? <span class="pm gold" title="as fast as this level has been"/> : <span/>}</span>
      <span class="pstime">{clockOf(at)}</span>
      {i < f.against.len() ? <span class={d <= 0 ? "pdelta ahead" : "pdelta behind"}>{deltaOf(d)}</span> : <span class="pdelta"/>}
    </div>);
  }
  i32 n = splits.len();
  if (n < g.levels.len()) {
    i32 target = 0;
    for (i32 i = 0; i <= n && i < f.against.len(); i++) { target = target + f.against[i]; }
    rows.push(<div class="psrow now">
      <span class="psname">{"\{n + 1} \{g.levels[n].name}"}</span>
      <span class="pstime">{clockOf(fullTime(f))}</span>
      <span class="pdelta">{n < f.against.len() ? clockOf(target) : ""}</span>
    </div>);
  }
  i32 sob = sumOfBest(g.best);
  return <div class="psplits">
    {rows.toArray()}
    <div class="psfoot">
      <span>{f.against.len() > 0 ? "Best \{clockOf(total(f.against))}" : "No full run yet"}</span>
      <span>{sob > 0 ? "Sum of best \{clockOf(sob)}" : "No sum of best yet"}</span>
    </div>
  </div>;
}

/** On the title: the best full run, and the sum of the best of every level, once there are any. */
Node runsLine(Pip g) {
  i32 sob = sumOfBest(g.best);
  if (g.sp.bestSplits.len() == 0 && sob == 0) { return <span/>; }
  string full = g.sp.bestSplits.len() > 0 ? "Best full run \{clockOf(total(g.sp.bestSplits))}" : "";
  string sum = sob > 0 ? "Sum of best \{clockOf(sob)}" : "";
  return <p class="pfaint">{full}{full != "" && sum != "" ? " · " : ""}{sum}</p>;
}

Node optionsCard(Pip g) {
  Vec<Node> rows = Vec.create();
  for (i32 i = 0; i < g.sp.options.len(); i++) {
    Option o = g.sp.options[i];
    Vec<Node> cs = Vec.create();
    for (i32 c = 0; c < o.choices.len(); c++) {
      i32 pickIt = c;
      cs.push(<span class={c == o.chosen ? "pc on" : "pc"} onclick={(ElementEvent e) => { o.chosen = pickIt; applyOptions(g); }}>{o.choices[c]}</span>);
    }
    i32 row = i;
    rows.push(<div class={i == g.sp.row ? "popt on" : "popt"} onclick={(ElementEvent e) => { g.sp.row = row; g.bump(); }}>
      <span class="potitle">{o.title}</span><span class="pchoices">{cs.toArray()}</span></div>);
  }
  return <div class="pover"><div class="pcard">
    <h1>Options</h1>
    <div class="popts">{rows.toArray()}</div>
    <p class="pfaint">A ghost chosen here runs from the next start of a level.</p>
    <p class="pgo"><b>↑</b> <b>↓</b> choose · <b>←</b> <b>→</b> change · <b>Esc</b> back</p>
    <div class="pbtns"><button class="pbtn go" onclick={(ElementEvent e) => { optionsKey(g, "Escape"); }}><b>◀</b> Back</button></div>
  </div></div>;
}

Node replaysCard(Pip g) {
  string[] ids = replayRows(g);
  if (g.sp.row >= ids.len()) { g.sp.row = ids.len() > 0 ? ids.len() - 1 : 0; }
  Vec<Node> rows = Vec.create();
  for (i32 i = 0; i < ids.len(); i++) {
    string id = ids[i];
    string name = id == "full" ? "Best full run" : (id == "import" ? "A run from a file…" : "\{wholeOf(id) + 1} \{g.levels[wholeOf(id)].name}");
    string time = id == "full" ? clockOf(total(g.sp.bestSplits)) : (id == "import" ? "" : clockOf(g.best[wholeOf(id)]));
    i32 row = i;
    rows.push(<div class={i == g.sp.row ? "plevel on" : "plevel"} onclick={(ElementEvent e) => { g.sp.row = row; replayRow(g, id); }}>
      {name}<span>{time}</span></div>);
  }
  return <div class="pover"><div class="pcard">
    <h1>Replays</h1>
    {ids.len() == 0 ? <p>Your best runs are kept as you play: finish a level, and its best run is here to watch.</p>
                    : <div class="preplays">{rows.toArray()}</div>}
    {g.sp.note != "" ? <p class="pnote">{g.sp.note}</p> : <span/>}
    <p class="pgo"><b>Enter</b> watches · <b>X</b> saves it as a file · <b>Esc</b> back</p>
    <div class="pbtns"><button class="pbtn go" onclick={(ElementEvent e) => { replaysKey(g, "Escape"); }}><b>◀</b> Back</button></div>
    <p class="pfaint">Watching: <b>Space</b> pauses · <b>←</b> <b>→</b> five seconds · <b>↑</b> <b>↓</b> speed · <b>,</b> <b>.</b> a step, paused · <b>R</b> races a run brought in</p>
  </div></div>;
}

Node fullCard(Pip g, Full f) {
  i32[] splits = f.splits.toArray();
  i32 t = total(splits);
  bool had = f.against.len() > 0;
  Vec<Node> rows = Vec.create();
  i32 at = 0;
  for (i32 i = 0; i < splits.len(); i++) {
    at = at + splits[i];
    i32 d = had ? deltaAt(splits, f.against, i) : 0;
    rows.push(<div class="psrow">
      <span class="psname">{"\{i + 1} \{g.levels[i].name}"}{splits[i] <= g.best[i] ? <span class="pm gold"/> : <span/>}</span>
      <span class="pstime">{clockOf(splits[i])}</span><span class="pstime">{clockOf(at)}</span>
      {had ? <span class={d <= 0 ? "pdelta ahead" : "pdelta behind"}>{deltaOf(d)}</span> : <span class="pdelta"/>}
    </div>);
  }
  string verdict = f.newBest ? (had ? "A best full run! \{deltaOf(t - total(f.against))}" : "Your first full run — the ghost to race from now on")
                             : "Best \{clockOf(total(f.against))} · this run \{deltaOf(t - total(f.against))}";
  return <div class="pover"><div class="pcard">
    <h1>Every lantern, in one run</h1>
    <p>Full run in {clockOf(t)}</p>
    <p class={f.newBest ? "pbest" : "pfaint"}>{verdict}</p>
    <p class="pfaint">Sum of best {clockOf(sumOfBest(g.best))}</p>
    <div class="pfullsplits">{rows.toArray()}</div>
    {g.sp.note != "" ? <p class="pnote">{g.sp.note}</p> : <span/>}
    <p class="pgo">Press <b>Enter</b> for the title · <b>X</b> saves the run as a file</p>
    <div class="pbtns">
      <button class="pbtn go" onclick={(ElementEvent e) => { toTitle(g); }}><b>▶</b> The title</button>
      <button class="pbtn" onclick={(ElementEvent e) => { exportFull(g); }}><b>X</b> Save as a file</button>
    </div>
  </div></div>;
}

Node Game(Ui ui, Pip g) {
  auto tick = ui.state(0);
  g.bump = () => { tick.set(tick.get() + 1); };
  Ref stage = ui.ref();
  Ref cv = ui.ref();
  ui.effect("", () => {
    g.canvas = cv.element();
    g.stage = stage.element();
    if (g.stage is not null) { g.stage!.focus(); }
    return () => { };
  });
  i32 touchMode = g.sp.options[TOUCH].chosen;
  string cls = "pip" + (touchMode == 0 ? " touch-auto" : (touchMode == 1 ? " touch-on" : " touch-off"))
             + (g.sp.options[SWAP].chosen == 1 ? " swap" : "") + (g.screenFull ? " screenfull" : "");
  return <div class={cls} tabindex="0" ref={stage}
              prevent="ArrowLeft ArrowRight ArrowUp ArrowDown Space Enter Escape Backspace a d w s z x k p m l r g f v o t . , 1 2 3 4 5 6 7 8 9"
              onkeydown={(ElementEvent e) => { down(g, e); }}
              onkeyup={(ElementEvent e) => { up(g, e); }}
              onfullscreenchange={(ElementEvent e) => {
                g.screenFull = e.value == "1";
                g.bump();
              }}
              onblur={(ElementEvent e) => {
                g.held.clear();
                letGo(g);
                readKeys(g);
                if (g.mode == PLAYING) { pause(g); }
                Watch? v = g.sp.watch;
                if (g.mode == WATCHING && v is not null) { v!.paused = true; g.bump(); }
              }}
              onpointerdown={(ElementEvent e) => { if (g.stage is not null) { g.stage!.focus(); } }}>
    <canvas class="pscreen" ref={cv} width="320" height="180"/>
    {hudOf(g)}
    {splitsOf(g)}
    {g.latency
      ? <div class="plat">
          <div><span>key → program</span><b>{g.arrive.shown()}</b></div>
          <div><span>key → on screen, by</span><b>{g.toScreen.shown()}</b></div>
          <div><span>key → jump sound sent</span><b>{g.toSound.shown()}</b></div>
          <div><span>frames</span><b>{"\{fixed(1000.0 / g.drawMs, 0)} a second"}</b></div>
        </div>
      : <span/>}
    {touchControls(g)}
    {overlay(g)}
  </div>;
}

export async i32 main(Page page) {
  page.title("Pip and the Lost Lanterns");
  Level[] levels = allLevels();
  i32[] best = i32[].filled(levels.len(), 0);
  i32 reached = 0;
  auto kept = await page.sys.files().readFile(KEPT);
  if (kept.isOk()) { reached = restoreBest(string.fromBytes(kept.ok()!), best); }
  // The sounds, made once and sent; played by number from here on.
  f64[][] made = effects();
  Sound[] fx = Sound[].filled(made.len(), page.sound(made[0], RATE));
  for (i32 i = 1; i < made.len(); i++) { fx[i] = page.sound(made[i], RATE); }
  // Each level's par, and its best run's keys, kept beside its best time.
  i32[] pars = i32[].filled(levels.len(), 0);
  u8[][] runs = u8[][].filled(levels.len(), u8[]());
  for (i32 i = 0; i < levels.len(); i++) {
    pars[i] = par(load(levels[i]));
    auto run = await page.sys.files().readFile("ghost-\{i + 1}");
    if (run.isOk() && best[i] > 0) { runs[i] = run.ok()!; }
  }
  // The options, and the best full run — kept only if playing it again shows it is one.
  Option[] options = defaultOptions();
  auto chosen = await page.sys.files().readFile(OPTIONS_FILE);
  if (chosen.isOk()) { readOptions(string.fromBytes(chosen.ok()!), options); }
  Speed sp = Speed(options, TITLE, 0, null, Leg[](), i32[](), Vec.create(), null, null, null, "");
  auto full = await page.sys.files().readFile(FULL);
  if (full.isOk()) {
    Run? r = runOf(full.ok()!);
    if (r is not null && r!.kind == FULL_RUN) {
      Checked c = checkRun(r!, levels);
      if (c.ok) {
        sp.bestFull = r!.legs;
        sp.bestSplits = c.times;
      }
    }
  }
  match (await Desktop.of(page.sys)) {
    Ok(d): { sp.desk = d; }
    Err(why): { }
  }
  Pip g = Pip(page, levels, reached, load(levels[reached]), Screen.create(), TITLE, Keys.none(), Vec.create(), 0.0 - 1.0,
              0.0 - 1.0, 0.0 - 1.0, Meter.create(), Meter.create(), Meter.create(), STEP_MS, options[LATENCY].chosen == 0,
              options[SOUND].chosen == 1, fx, Band.create(), best, reached, false, pars, runs, Vec.create(), null, 0, true, 0,
              null, null, quiet, 0, Pace(0.0), 0.0, u8[](), sp, Touch(0 - 1, 0, 0, 0, 0, 0, 0 - 1), false);
  page.mount((Ui ui) => <div class="pippage"><style>{css() + pipCss()}</style><Game g={g}/></div>);
  g.band.fanfare = page.sound(mixed(stems(songNamed("fanfare")), LAYERS - 1), RATE);
  play(g, "title");
  playLoop(g);
  return 0;
}
