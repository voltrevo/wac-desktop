export string panelCss() {
  return """
    :host { display:block; height:100%; }
    * { box-sizing:border-box; }
    .kc-shell { height:100%; container-type:inline-size; }
    .kc { height:100%; overflow:auto; padding:clamp(14px,4vw,32px); color:#eceddb;
      background:radial-gradient(ellipse at top,#223e50,#0a141d 72%); font:15px/1.55 system-ui,sans-serif; }
    .kc-head { display:flex; justify-content:space-between; gap:12px; align-items:center; }
    .kc h1,.kc h2 { margin:0; line-height:1.15; }
    .kc h1 { font-size:clamp(26px,6vw,42px); }
    .kc-label,.kc-strip,.kc-footer { font:700 11px/1.5 ui-monospace,monospace; letter-spacing:.1em; color:#a4beb8; }
    .kc-clock,.kc-reading { font:700 20px/1.4 ui-monospace,monospace; color:#ffd28d;
      background:#111618; border:1px solid #56615b; border-radius:4px; padding:8px 12px; }
    .kc-clock { font-size:clamp(23px,5vw,34px); font-variant-numeric:tabular-nums; }
    .kc-clock.critical { color:#ff9683; border-color:#c56f5d; }
    .kc-mimic { position:relative; isolation:isolate; display:grid; grid-template-columns:repeat(3,1fr);
      margin-top:0; padding:7px 0 5px; border:1px solid #3d5653; border-radius:6px; background-color:#101b1c;
      background-image:linear-gradient(#94bcb014 1px,transparent 1px),linear-gradient(90deg,#94bcb014 1px,transparent 1px);
      background-size:14px 14px; }
    .kc-mimic::before { content:""; position:absolute; z-index:-1; inset:20px 16.67% auto;
      height:8px; border-block:2px solid #526963; background:#263b38; }
    .kc-unit { display:grid; place-items:center; gap:4px; font:700 10px ui-monospace,monospace;
      color:#a4beb8; letter-spacing:.13em; }
    .kc-symbol { width:34px; height:34px; background:#1b292a; border:2px solid #a88352;
      display:grid; place-items:center; color:#ffd28d; }
    .kc-symbol::before { content:""; display:block; width:15px; height:15px; background:currentColor; }
    .kc-symbol.bus { border-radius:4px; }
    .kc-symbol.bus::before { clip-path:polygon(45% 0,100% 0,64% 42%,94% 42%,20% 100%,40% 55%,5% 55%); }
    .kc-symbol.valve { transform:rotate(45deg) scale(.83); }
    .kc-symbol.valve::before { transform:rotate(-45deg); clip-path:polygon(0 12%,50% 41%,100% 12%,100% 88%,50% 59%,0 88%); }
    .kc-symbol.core { border-radius:50%; }
    .kc-symbol.core::before { border:3px double currentColor; background:none; border-radius:50%; }
    .kc-unit.live .kc-symbol { color:#a6ffdc; border-color:#80ccae; box-shadow:0 0 12px #74d9b35c; }
    .kc-home,.kc-manual { margin-top:16px; }
    .kc-manual h3 { margin:1.4em 0 .4em; color:#96d5dc; }
    .kc-sonar { position:relative; overflow:hidden; height:clamp(96px,21vw,145px);
      margin-bottom:17px; border:1px solid #3b666b; border-radius:5px;
      background:repeating-radial-gradient(circle at 50% 52%,#0d212a 0 21px,#31616b 22px,#0d212a 23px); }
    .kc-sonar::before { content:""; position:absolute; inset:0; opacity:.45;
      background:conic-gradient(from 230deg at 50% 52%,#7ce3dc66,transparent 85deg); }
    .kc-sonar span { position:absolute; width:74px; height:16px; top:46%; left:calc(50% - 37px);
      border-radius:80% 60% 65% 75%; background:#9ae7de; box-shadow:0 0 17px #85ddd9; }
    .kc-sonar span::before { content:""; position:absolute; width:18px; height:10px;
      top:-6px; left:22px; border-radius:6px 6px 0 0; background:inherit; }
    .kc-back { margin:10px 0; }
    .kc-bank { display:grid; gap:9px; }
    .kc-bank .kc-controls { display:grid; gap:4px; }
    .kc-bank .kc-controls>div { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); }
    .kc-bank>button { background:linear-gradient(#683a34,#482b2b); border-color:#ba746a; }
    .kc button.selected { background:#294d4a; border-color:#94dac9; color:#c4ffeb; }
    .kc-meters { display:flex; flex-wrap:wrap; gap:8px 18px; margin:0 0 14px;
      font:11px/1.5 ui-monospace,monospace; color:#a4beb8; }
    .kc-meter { display:block; width:100%; height:6px; margin-top:4px; overflow:hidden; border-radius:2px; background:#10191a; }
    .kc-meter>span { display:block; height:100%; background:repeating-linear-gradient(90deg,#ffc276 0 5px,#1b2728 5px 7px); }
    .kc-meter.flow>span { background:repeating-linear-gradient(90deg,#8af0c6 0 5px,#1b2728 5px 7px); }
    .kc-meters b { color:#eceddb; margin-left:4px; }
    .kc-panel { border:1px solid #425a58; border-top:3px solid #c79a54; border-radius:6px; background:linear-gradient(155deg,#243638,#182527); box-shadow:0 9px 22px #0005; padding:clamp(14px,4vw,25px); }
    .kc h2 { font-size:24px; }
    .kc-reading { font-size:15px; white-space:pre-wrap; }
    .kc-controls,.kc-controls>div { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .kc button,.kc a { touch-action:manipulation; min-height:44px; padding:10px 13px; font:700 14px/1.4 system-ui,sans-serif; }
    .kc button { background:linear-gradient(#405753,#2e403e); border:1px solid #809991; border-bottom-width:3px; border-radius:5px; color:#fff8e8; cursor:pointer; }
    .kc button:hover { background:#48625d; }
    .kc button:focus-visible,.kc a:focus-visible { outline:2px solid #ffd28d; outline-offset:2px; }
    .kc a { color:#ffd28d; }
    .kc-report { min-height:3em; margin-bottom:0; color:#d4e0da; }
    .kc-footer { margin-top:12px; display:flex; justify-content:space-between; gap:8px; align-items:center; }
    .kc-footer button { flex-shrink:0; }
    @container (max-width: 480px) {
      .kc { padding:14px; }
      .kc-head { align-items:flex-end; }
      .kc h1 { font-size:26px; }
      .kc-clock { padding:6px 8px; }
      .kc-strip { gap:6px 12px; margin-top:14px; }
      .kc-panel { padding:14px; }
      .kc-controls { display:grid; width:100%; }
      .kc-controls>div { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
      .kc button,.kc a { min-height:48px; text-align:center; }
      .kc-report { min-height:0; margin-top:8px; }
      .kc-bank { gap:6px; }
      .kc-bank .kc-controls>div { gap:5px; }
      .kc-meters { gap:6px 12px; }
    }
  """;
}
