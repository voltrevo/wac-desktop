// Fictional research sub. The manual describes these game systems.
export struct Dive {
  i32 leak;
  i32 fault;
  i32 hatch;
  i32 bus;
  i32 load;
  i32 outcome;
  bool air;
  bool rising;
  f64 depth;
  f64 water;
  f64 battery;
  f64 last;
  string report;
  f64 ascentSpeed;
  i32 mission;
  i32 gauge;
  f64 frozen;
}

export Dive dive(i32 seed, f64 now, i32 mission) {
  bool nearShelf = mission == 2 && seed % 3 == 2;
  f64 depth = mission == 1 ? 570.0 : nearShelf ? 615.0 : mission == 2 ? 470.0 : 420.0;
  f64 water = mission == 1 ? 34.0 : mission == 2 ? 49.0 : 29.0;
  f64 battery = mission == 1 ? 82.0 : nearShelf ? 70.0 : mission == 2 ? 37.0 : 100.0;
  return Dive(seed % 3, seed / 3 % 3, -1, -1, 0, 0, true, false,
    depth, water, battery, now, "Hull breach. Main bus offline.", 0.0, mission, -1, 490.0 + ((seed % 3) as f64) * 24.0);
}

export bool sealed(Dive d) { return d.hatch == (d.leak + 1) % 3; }
export bool powered(Dive d) { return d.bus == (d.fault + 2) % 3; }
export bool pumping(Dive d) { return powered(d) && sealed(d) && (d.load == 1 || d.load == 3); }

export i32 liveGauge(Dive d) { return d.fault == 1 ? 0 : 1; }
export f64 reading(Dive d, i32 gauge) { return gauge == liveGauge(d) ? d.depth : d.frozen; }
export f64 pumpRate(Dive d) { return d.load == 3 ? 1.05 : d.mission == 2 ? 3.5 : 2.5; }

// Preserve the original climb energy of 0.52 percentage points per 14 m.
export f64 ascentCost(Dive d) { return d.depth * (0.52 / 14.0); }

export void advance(Dive d, f64 now) {
  if (d.outcome != 0 || now <= d.last) { return; }
  f64 elapsed = (now - d.last) / 1000.0;
  d.last = now;
  // Small steps keep threshold crossings consistent after a suspended tab.
  while (elapsed > 0.0 && d.outcome == 0) {
    f64 dt = elapsed > 0.25 ? 0.25 : elapsed;
    elapsed -= dt;
    if (d.rising) {
      f64 travel = d.ascentSpeed * dt;
      f64 energy = ascentCost(d);
      if (d.battery <= energy && d.battery <= travel * (0.52 / 14.0)) {
        d.depth -= d.battery / (0.52 / 14.0);
        d.battery = 0.0;
        d.outcome = 2;
        d.report = "Battery exhausted during ascent.";
      } else if (travel >= d.depth - 0.000001) {
        d.battery -= energy;
        d.depth = 0.0;
        d.outcome = 1;
        d.report = "On the surface. All hands safe.";
      } else {
        d.depth -= travel;
        d.battery -= travel * (0.52 / 14.0);
      }
      continue;
    }
    d.water += (pumping(d) ? -pumpRate(d) : sealed(d) ? 0.0 : 0.85) * dt;
    if (d.water < 0.0) { d.water = 0.0; }
    d.battery -= (d.load == 3 ? 0.48 : d.load == 1 ? (d.mission == 2 ? 2.5 : 1.4) : d.load == 2 ? 0.52 : 0.24) * dt;
    d.depth += (0.65 + d.water * 0.025) * dt;
    if (d.depth >= 650.0) { d.outcome = 2; d.report = "Crush depth exceeded."; }
    else if (d.water >= 100.0) { d.outcome = 2; d.report = "Floodwater overwhelmed the boat."; }
    else if (d.battery <= 0.0) { d.outcome = 2; d.report = "Battery exhausted. Life support offline."; }
  }
}

// Controls 0–2 are hatches, 3–5 buses, 6–8 loads, 9 ballast, 10 auxiliary pump, 11–12 gauges.
export i32 operate(Dive d, i32 id, f64 now) {
  advance(d, now);
  if (d.outcome != 0 || d.rising) { return 0; }
  if (id == 11 || id == 12) {
    if (d.mission != 1) { return 0; }
    d.gauge = id - 11;
    d.report = d.gauge == 0 ? "Trim reference set to gauge A." : "Trim reference set to gauge B.";
    return 1;
  }
  if (id == 10 && d.mission != 2) { return 0; }
  if (id < 3) {
    d.hatch = id;
    d.report = sealed(d) ? "Inflow stopped. Sump route available." : "Inflow continues. Sump route blocked.";
  } else if (id < 6) {
    d.bus = id - 3;
    if (!powered(d)) {
      d.load = 0;
      d.battery -= 8.0;
      d.report = "Breaker tripped. Lost 8% battery.";
      if (d.battery <= 0.0) { d.outcome = 2; d.report = "Battery exhausted. Life support offline."; }
      return 2;
    }
    d.report = "Backup bus online. Select a load.";
  } else if (id < 9 || id == 10) {
    if (id != 6 && !powered(d)) { d.report = "Select a working backup bus first."; return 2; }
    d.load = id == 10 ? 3 : id - 6;
    d.report = (d.load == 1 || d.load == 3) ? (sealed(d) ? "Pump running. Watch floodwater." : "Pump blocked. Check the bulkhead.") :
      d.load == 2 ? "Trim servos ready. Check ascent conditions." : "Loads shed. Battery drain reduced.";
  } else if (d.air) {
    if (d.mission == 1 && d.gauge < 0) {
      d.report = "Select a depth reference before blowing ballast.";
      return 2;
    }
    d.air = false;
    if (d.mission == 1 && d.gauge != liveGauge(d)) {
      d.outcome = 2;
      d.report = "Air spent. The frozen gauge gave trim a false depth.";
      return 2;
    }
    if (!sealed(d) || d.water > 25.0 || !powered(d) || d.load != 2) {
      d.outcome = 2;
      d.report = "Air spent. The boat could not establish ascent.";
      return 2;
    }
    d.rising = true;
    d.ascentSpeed = d.depth / 4.0;
    d.report = "Ascent established. Hold for the surface.";
    return 3;
  }
  return 1;
}

export i32 margin(Dive d) {
  if (d.rising) { return 45; }
  return (2.0 * (650.0 - d.depth) / (0.65 + d.water * 0.025)).ceil() as~ i32;
}
