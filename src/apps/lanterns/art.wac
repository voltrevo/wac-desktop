// Lantern Light's picture: the board on Pip's 320 × 180 screen, sixteen pixels a tile, drawn with Pip's own pixels —
// Pip's sprite, the ghost's, the lantern — and the light itself: a lit tile warm, a dark one cold.

import { GHOST } from "../pip/world.wac";
import { SCREEN_H, SCREEN_W, Screen, dot, halo, mix, rect, sprite } from "../pip/art.wac";
import { pipSprite } from "../pip/sprites.wac";
import { enemyPalette, enemySprite } from "../pip/enemies.wac";
import { Board, DOOR, STONE, WALL, WATER, open } from "./rules.wac";

export static i32 TILE = 16;

/** Where the board's corner is on the screen: in the middle. */
i32 leftOf(Board b) { return (SCREEN_W - b.cols * TILE) / 2; }
i32 topOf(Board b) { return (SCREEN_H - b.rows * TILE) / 2; }

/** Around the board, as much of the screen as is shown with it: room for Pip's hood above the top row. */
static i32 MARGIN = 6;

/**
 * **What of the screen to show**: the board and a margin, `[x, y, w, h]`. Shown alone, a small board fills a phone's
 * width, rather than sitting small in the middle of the whole screen.
 */
export i32[] shownOf(Board b) {
  i32 x = leftOf(b) - MARGIN;
  i32 y = topOf(b) - MARGIN;
  i32[] box = [x < 0 ? 0 : x, y < 0 ? 0 : y, 0, 0];
  box[2] = b.cols * TILE + 2 * MARGIN;
  box[3] = b.rows * TILE + 2 * MARGIN;
  if (box[0] + box[2] > SCREEN_W) { box[2] = SCREEN_W - box[0]; }
  if (box[1] + box[3] > SCREEN_H) { box[3] = SCREEN_H - box[1]; }
  return box;
}

/** `box` of the screen's pixels, `[x, y, w, h]`, copied out: what the canvas is drawn with. */
export u8[] cropped(Screen s, i32[] box) {
  u8[] out = u8[].filled(box[2] * box[3] * 4, 255 as u8);
  for (i32 y = 0; y < box[3]; y++) {
    i32 from = ((box[1] + y) * SCREEN_W + box[0]) * 4;
    i32 to = y * box[2] * 4;
    out.copyFrom(s.px, from, to, box[2] * 4);
  }
  return out;
}

/** A number from a tile's place, so stones and ripples differ tile to tile but not frame to frame. */
i32 speckle(i32 x, i32 y) { return ((x * 73856093) ^ (y * 19349663)) & 1023; }

void floorTile(Screen s, i32 sx, i32 sy, i32 tx, i32 ty, bool lit) {
  i32 base = lit ? 0x6B5848 : 0x1C2038;
  i32 seam = lit ? 0x4E3F37 : 0x13162A;
  rect(s, sx, sy, TILE, TILE, base);
  rect(s, sx, sy + TILE - 1, TILE, 1, seam);
  rect(s, sx + TILE - 1, sy, 1, TILE, seam);
  i32 k = speckle(tx, ty);
  dot(s, sx + 3 + k % 9, sy + 4 + (k / 9) % 8, lit ? 0x8A7360 : 0x272C48);
  dot(s, sx + 9 - k % 5, sy + 10 - (k / 7) % 5, lit ? 0x7C6654 : 0x252A44);
}

void wallTile(Screen s, i32 sx, i32 sy, i32 tx, i32 ty) {
  rect(s, sx, sy, TILE, TILE, 0x2E2A44);
  i32 shift = ty % 2 == 0 ? 0 : 8;
  rect(s, sx, sy + 7, TILE, 1, 0x1F1C30);
  rect(s, sx, sy + 15, TILE, 1, 0x1F1C30);
  rect(s, sx + (shift + 4) % TILE, sy, 1, 7, 0x1F1C30);
  rect(s, sx + (shift + 12) % TILE, sy + 8, 1, 7, 0x1F1C30);
  rect(s, sx, sy, TILE, 1, 0x4A4466);
}

void waterTile(Screen s, i32 sx, i32 sy, i32 tx, i32 ty, bool lit, i32 frame) {
  rect(s, sx, sy, TILE, TILE, lit ? 0x2F6E8A : 0x0F2340);
  i32 k = speckle(tx, ty);
  for (i32 r = 0; r < 3; r++) {
    i32 y = sy + 3 + r * 5;
    i32 x = sx + (k + frame / 8 + r * 5) % 12;
    rect(s, x, y, 4, 1, lit ? 0x9FD6E0 : 0x2B4A6E);
  }
}

/** A crumbling stone, standing in the water: worn, cracked — it holds Pip once. */
void stoneTile(Screen s, i32 sx, i32 sy, i32 tx, i32 ty, i32 frame) {
  waterTile(s, sx, sy, tx, ty, false, frame);
  rect(s, sx + 2, sy + 3, 12, 11, 0x5D5868);
  rect(s, sx + 3, sy + 2, 10, 1, 0x7B7486);
  rect(s, sx + 2, sy + 13, 12, 1, 0x3A3546);
  rect(s, sx + 3, sy + 3, 10, 2, 0x8E879A);
  i32 k = speckle(tx, ty);
  // The crack, and a chip out of its edge.
  dot(s, sx + 5 + k % 3, sy + 6, 0x2E2A38);
  dot(s, sx + 6 + k % 3, sy + 7, 0x2E2A38);
  dot(s, sx + 6 + k % 3, sy + 8, 0x2E2A38);
  dot(s, sx + 7 + k % 3, sy + 9, 0x2E2A38);
  dot(s, sx + 12, sy + 10, 0x0F2340);
}

void doorTile(Screen s, i32 sx, i32 sy, bool isOpen, bool lit) {
  floorTile(s, sx, sy, 0, 0, lit);
  rect(s, sx + 2, sy + 1, 12, 15, 0x77717F);
  rect(s, sx + 2, sy + 1, 2, 15, 0xA3979C);
  rect(s, sx + 12, sy + 1, 2, 15, 0x474354);
  rect(s, sx + 4, sy + 2, 8, 14, isOpen ? 0xF0C780 : 0x49394D);
  if (!isOpen) {
    rect(s, sx + 7, sy + 2, 1, 14, 0x332D43);
    rect(s, sx + 9, sy + 8, 2, 2, 0xF4D8A0);
  }
}

/** A lantern, as Pip's levels draw one: dark glass waiting, or a flame that flickers. */
void lantern(Screen s, i32 sx, i32 sy, bool lit, i32 frame, i32 tx) {
  i32 lx = sx + 4;
  i32 ly = sy + 3;
  rect(s, lx + 2, ly - 2, 4, 1, 0xC39B69);
  dot(s, lx + 1, ly - 1, 0x8B684D);
  dot(s, lx + 6, ly - 1, 0x8B684D);
  rect(s, lx, ly, 8, 11, 0x202438);
  rect(s, lx, ly, 8, 2, 0xA7784B);
  rect(s, lx + 1, ly, 6, 1, 0xE4BD78);
  rect(s, lx + 1, ly + 2, 6, 7, lit ? 0xEBA956 : 0x344C69);
  rect(s, lx + 1, ly + 2, 1, 6, lit ? 0xFFE4A3 : 0x6E98A3);
  rect(s, lx + 6, ly + 2, 1, 7, lit ? 0xC77E46 : 0x263B57);
  rect(s, lx, ly + 9, 8, 2, 0x8B684D);
  rect(s, lx + 1, ly + 9, 6, 1, 0xE4BD78);
  if (lit) {
    i32 flick = (frame / 6 + tx) % 3;
    rect(s, lx + 3, ly + 4 + (flick == 1 ? 1 : 0), 2, 4, 0xFFF4D6);
    dot(s, lx + 4, ly + 3, 0xFFD078);
  } else {
    rect(s, lx + 3, ly + 6, 2, 2, 0x7D8A97);
  }
}

/** A mirror on its stand: a silvered slant, `/` or `\`, that catches the light when it is lit. */
void mirror(Screen s, i32 sx, i32 sy, u8 slant, bool lit) {
  rect(s, sx + 3, sy + 13, 10, 2, 0x6B4430);
  rect(s, sx + 4, sy + 12, 8, 1, 0xA57857);
  i32 glass = lit ? 0xFFF4D6 : 0xBFD6E2;
  i32 edge = lit ? 0xF0C780 : 0x6E8AA0;
  for (i32 i = 0; i < 11; i++) {
    i32 x = slant == '/' ? sx + 3 + i : sx + 13 - i;
    i32 y = sy + 12 - i;
    dot(s, x, y, glass);
    dot(s, x + (slant == '/' ? 1 : 0 - 1), y, edge);
  }
}

void ghost(Screen s, i32 sx, i32 sy, i32 frame, bool flip) {
  string[] rows = enemySprite(GHOST, 1 + (frame / 10) % 3);
  i32[] colours = enemyPalette(GHOST);
  i32 bob = (frame / 15) % 2;
  for (i32 dy = 0; dy < 16; dy++) {
    u8[] row = rows[dy].toBytes();
    for (i32 dx = 0; dx < 16; dx++) {
      u8 ch = row[flip ? 15 - dx : dx];
      if (ch == '.') { continue; }
      i32 px = sx + dx;
      i32 py = sy + dy - 2 + bob;
      if (px < 0 || py < 0 || px >= SCREEN_W || py >= SCREEN_H) { continue; }
      i32 at = (py * SCREEN_W + px) * 4;
      i32 under = ((s.px[at] as i32) << 16) | ((s.px[at + 1] as i32) << 8) | (s.px[at + 2] as i32);
      dot(s, px, py, mix(under, colours[(ch - '0') as i32], 0.7));
    }
  }
}

/** The board, at frame `frame` of the page's: the ground, what stands on it, the light, and Pip. */
export void drawBoard(Screen s, Board b, i32 frame) {
  rect(s, 0, 0, SCREEN_W, SCREEN_H, 0x0B0D22);
  i32 ox = leftOf(b);
  i32 oy = topOf(b);
  bool isOpen = open(b);
  for (i32 ty = 0; ty < b.rows; ty++) {
    for (i32 tx = 0; tx < b.cols; tx++) {
      i32 at = ty * b.cols + tx;
      i32 sx = ox + tx * TILE;
      i32 sy = oy + ty * TILE;
      u8 g = b.ground[at];
      if (g == WALL) { wallTile(s, sx, sy, tx, ty); }
      else if (g == WATER) { waterTile(s, sx, sy, tx, ty, b.light[at], frame); }
      else if (g == STONE) { stoneTile(s, sx, sy, tx, ty, frame); }
      else if (g == DOOR) { doorTile(s, sx, sy, isOpen, b.light[at]); }
      else { floorTile(s, sx, sy, tx, ty, b.light[at]); }
    }
  }
  // The lanterns' glow, over the ground and under what stands on it.
  for (i32 i = 0; i < b.lanterns.len(); i++) {
    if (!b.lit[i]) { continue; }
    i32 at = b.lanterns[i];
    halo(s, ox + (at % b.cols) * TILE + 8, oy + (at / b.cols) * TILE + 8, 22, 0xFFC870, 0.35);
  }
  if (isOpen) {
    for (i32 at = 0; at < b.ground.len(); at++) {
      if (b.ground[at] == DOOR) { halo(s, ox + (at % b.cols) * TILE + 8, oy + (at / b.cols) * TILE + 8, 18, 0xFFE3A3, 0.3); }
    }
  }
  for (i32 i = 0; i < b.mirrors.len(); i++) {
    i32 at = b.mirrors[i];
    mirror(s, ox + (at % b.cols) * TILE, oy + (at / b.cols) * TILE, b.slants[i], b.light[at]);
  }
  for (i32 i = 0; i < b.lanterns.len(); i++) {
    i32 at = b.lanterns[i];
    lantern(s, ox + (at % b.cols) * TILE, oy + (at / b.cols) * TILE, b.lit[i], frame, at % b.cols);
  }
  i32 px = b.pip % b.cols;
  for (i32 i = 0; i < b.ghosts.len(); i++) {
    i32 at = b.ghosts[i];
    if (at < 0) { continue; }
    ghost(s, ox + (at % b.cols) * TILE, oy + (at / b.cols) * TILE, frame, at % b.cols > px);
  }
  if (!b.won) {
    // Pip, sixteen by twenty, standing on the tile: breathing, and facing the last way moved.
    i32 pose = (frame / 30) % 2;
    sprite(s, pipSprite(pose), ox + px * TILE, oy + (b.pip / b.cols) * TILE - 5, b.facing < 0);
    halo(s, ox + px * TILE + 8, oy + (b.pip / b.cols) * TILE + 6, 10, 0x80D4BB, 0.12);
  }
}
