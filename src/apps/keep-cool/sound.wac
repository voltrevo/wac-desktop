// Synthesized console cues and a countdown score, generated locally.
import { Page, Sound, Voice } from "web";

export static i32 SWITCH = 0;
export static i32 ONLINE = 1;
export static i32 ALARM = 2;
export static i32 PUMP = 3;
export static i32 STABLE = 4;
export static i32 LOST = 5;

Sound sequence(Page page, f64[] notes, i32 beatMs, bool rough) {
  i32 rate = 22050;
  i32 beat = rate * beatMs / 1000;
  f64[] pcm = f64[].filled(beat * notes.len(), 0.0);
  for (i32 note = 0; note < notes.len(); note++) {
    if (notes[note] == 0.0) { continue; }
    for (i32 i = 0; i < beat; i++) {
      f64 t = (i as f64) / (beat as f64);
      f64 phase = (i as f64) * notes[note] / (rate as f64);
      f64 x = 2.0 * (phase - phase.floor()) - 1.0;
      f64 wave = rough ? x : 4.0 * x * (1.0 - x.abs());
      f64 attack = i < 80 ? (i as f64) / 80.0 : 1.0;
      pcm[note * beat + i] = 0.24 * wave * attack * (1.0 - t);
    }
  }
  return page.sound(pcm, rate);
}

f64 oscillator(f64 phase) {
  f64 x = 2.0 * (phase - phase.floor()) - 1.0;
  return 4.0 * x * (1.0 - x.abs());
}

// Four bars built around a D pedal. The same progression carries through each alert level.
Sound score(Page page, i32 beatMs, i32 intensity) {
  i32 rate = 11025;
  i32 beat = rate * beatMs / 1000;
  f64[] pcm = f64[].filled(beat * 16, 0.0);
  f64[][] harmony = [
    [146.83, 174.61, 220.0, 329.63], // D minor add 9
    [146.83, 174.61, 233.08, 349.23], // B-flat major over D
    [130.81, 155.56, 196.0, 293.66], // C minor add 9
    [138.59, 164.81, 220.0, 233.08], // A with a flat ninth
  ];
  f64[] bass = [73.42, 58.27, 65.41, 55.0];
  i32[] figure = [0, 2, 1, 3, 0, 1, 2, 3];
  f64 humCycles = (55.0 * (pcm.len() as f64) / (rate as f64)).floor();
  for (i32 i = 0; i < pcm.len(); i++) {
    i32 step = i / beat;
    i32 bar = step / 4;
    f64 time = (i as f64) / (rate as f64);
    f64 t = ((i % beat) as f64) / (beat as f64);
    f64 elapsed = ((i % beat) as f64) / (rate as f64);
    f64 barPhase = ((step % 4) as f64 + t) / 4.0;
    f64 swell = 4.0 * barPhase * (1.0 - barPhase);
    f64[] chord = harmony[bar];
    f64 mix = 0.08 * oscillator((i as f64) * humCycles / (pcm.len() as f64));
    mix += swell * (0.044 * oscillator(time * chord[0]) + 0.035 * oscillator(time * chord[1])
      + 0.031 * oscillator(time * chord[2]) + 0.016 * oscillator(time * chord[3]));
    f64 pulse = 5.0 * t * (1.0 - t) * (1.0 - t);
    if (step % 4 != 3 || intensity >= 2) {
      mix += (step % 4 == 0 ? 0.21 : 0.14) * pulse * oscillator(elapsed * bass[bar]);
    }

    // The arpeggio starts as a sparse answer to the bass, then fills in the gaps.
    i32 subdivision = (t * 2.0).trunc() as~ i32;
    f64 pluck = t * 2.0 - (subdivision as f64);
    if (intensity >= 2 || (intensity == 1 && subdivision == 0) || (step % 4 == 2 && subdivision == 1)) {
      f64 pitch = chord[figure[(step % 4) * 2 + subdivision]] * 2.0;
      f64 phase = pluck * (beat as f64) * pitch / (2.0 * (rate as f64));
      f64 shape = 9.0 * pluck * (1.0 - pluck) * (1.0 - pluck) * (1.0 - pluck);
      mix += (intensity >= 2 ? 0.095 : 0.063) * shape * (oscillator(phase) + 0.25 * oscillator(phase * 2.0));
    }

    if (intensity >= 1 && (step % 4 == 0 || (intensity >= 2 && step % 4 == 2)) && elapsed < 0.16) {
      f64 decay = 1.0 - elapsed / 0.16;
      mix += 0.18 * decay * decay * oscillator(elapsed * (92.0 - 180.0 * elapsed));
    }
    if (intensity >= 2 && subdivision == 1 && pluck < 0.33) {
      f64 tick = pluck / 0.33;
      mix += 0.05 * 4.0 * tick * (1.0 - tick) * (1.0 - tick)
        * oscillator(time * 1901.0) * oscillator(time * 2273.0);
    }
    if (intensity >= 3 && step % 2 == 1) {
      mix += 0.07 * pulse * oscillator(elapsed * chord[3] * 3.0);
    }
    // Soften the loop splice and the first attack after a change of alert level.
    f64 edge = i < pcm.len() / 2 ? i as f64 : (pcm.len() - 1 - i) as f64;
    pcm[i] = mix * (edge < 120.0 ? edge / 120.0 : 1.0);
  }
  return page.sound(pcm, rate);
}

export struct ConsoleSound {
  Sound[] cues;
  Voice? voice;
  bool enabled;
  Sound[] tracks;
  Voice? music;
  i32 intensity;

  ConsoleSound create(Page page) {
    return ConsoleSound([
      sequence(page, [185.0], 45, true),
      sequence(page, [440.0, 660.0], 105, false),
      sequence(page, [290.0, 0.0, 290.0], 150, true),
      sequence(page, [105.0, 145.0, 220.0], 135, false),
      sequence(page, [392.0, 494.0, 587.0, 784.0], 145, false),
      sequence(page, [330.0, 247.0, 165.0], 210, true),
    ], null, true, [score(page, 760, 0), score(page, 600, 1), score(page, 445, 2), score(page, 325, 3)], null, -1);
  }

  void background(this, i32 remaining, bool active) {
    i32 next = -1;
    if (active && this.enabled) {
      next = remaining <= 45 ? 3 : remaining <= 90 ? 2 : remaining <= 180 ? 1 : 0;
    }
    if (next == this.intensity) { return; }
    if (this.music is not null) { this.music!.stop(); this.music = null; }
    this.intensity = next;
    if (next >= 0) { this.music = this.tracks[next].loop(0.38); }
  }

  void stop(this) {
    this.background(0, false);
    this.stopCue();
  }

  void stopCue(this) {
    if (this.voice is not null) { this.voice!.stop(); this.voice = null; }
  }

  void play(this, i32 cue) {
    if (!this.enabled) { return; }
    this.stopCue();
    this.voice = this.cues[cue].play(0.7);
  }
}
