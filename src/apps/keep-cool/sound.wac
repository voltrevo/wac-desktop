// Short synthesized console cues. No network assets or continuous background audio.
import { Page, Sound, Voice } from "web";

export static i32 SWITCH = 0;
export static i32 ONLINE = 1;
export static i32 ALARM = 2;
export static i32 PUMP = 3;
export static i32 STABLE = 4;
export static i32 LOST = 5;

Sound sequence(Page page, f64[] notes, i32 beatMs, bool rough) {
  i32 rate = 22050;
  i32 beat = rate * beatMs / 1000;
  f64[] pcm = f64[].filled(beat * notes.len(), 0.0);
  for (i32 note = 0; note < notes.len(); note++) {
    if (notes[note] == 0.0) { continue; }
    for (i32 i = 0; i < beat; i++) {
      f64 t = (i as f64) / (beat as f64);
      f64 phase = (i as f64) * notes[note] / (rate as f64);
      f64 x = 2.0 * (phase - phase.floor()) - 1.0;
      f64 wave = rough ? x : 4.0 * x * (1.0 - x.abs());
      f64 attack = i < 80 ? (i as f64) / 80.0 : 1.0;
      pcm[note * beat + i] = 0.24 * wave * attack * (1.0 - t);
    }
  }
  return page.sound(pcm, rate);
}

export struct ConsoleSound {
  Sound[] cues;
  Voice? voice;
  bool enabled;

  ConsoleSound create(Page page) {
    return ConsoleSound([
      sequence(page, [185.0], 45, true),
      sequence(page, [440.0, 660.0], 105, false),
      sequence(page, [290.0, 0.0, 290.0], 150, true),
      sequence(page, [105.0, 145.0, 220.0], 135, false),
      sequence(page, [392.0, 494.0, 587.0, 784.0], 145, false),
      sequence(page, [330.0, 247.0, 165.0], 210, true),
    ], null, true);
  }

  void stop(this) {
    if (this.voice is not null) { this.voice!.stop(); this.voice = null; }
  }

  void play(this, i32 cue) {
    if (!this.enabled) { return; }
    this.stop();
    this.voice = this.cues[cue].play(0.7);
  }
}
