// Fictional plant logic. Keep the field manual in sync with these rules.
export struct Incident {
  i32 feed;
  i32 load;
  i32 loop;
  i32 signal;
  i32 stage;
  i32 step;
  i32 faults;
  f64 deadline;
  f64 cooling;
  string report;
}

export Incident incident(i32 seed, f64 now) {
  return Incident(seed % 3, seed / 3 % 3, seed / 9 % 2, seed / 18 % 4,
    0, 0, 0, now + 300000.0, 0.0, "Reactor shut down. Emergency cooling unavailable.");
}

export i32 seconds(Incident run, f64 now) {
  if (now >= run.deadline) { return 0; }
  return ((run.deadline - now) / 1000.0).ceil() as~ i32;
}

export void update(Incident run, f64 now) {
  if (run.stage == 3 && run.cooling < run.deadline && now >= run.cooling) {
    run.stage = 4;
    run.report = "Temperature falling. Unit 04 is stable.";
  } else if (run.stage < 4 && now >= run.deadline) {
    run.stage = 5;
    run.report = "Thermal limit exceeded. Incident lost.";
  }
}

export void command(Incident run, i32 control, f64 now) {
  update(run, now);
  if (run.stage >= 3) { return; }
  i32 expected = 0;
  if (run.stage == 0) {
    // Amber and white use isolator first. Blue uses reserve first.
    if ((run.step == 0 && run.feed != 1) || (run.step == 1 && run.feed == 1)) {
      expected = 3;
    } else {
      expected = (run.feed + run.load) % 3;
    }
  } else if (run.stage == 1) {
    expected = run.step == 0 ? run.loop : 2 + run.loop;
  } else {
    expected = (run.signal == 1 || run.signal == 2) ? 1 : 0;
  }
  if (control != expected) {
    run.faults++;
    run.step = 0;
    run.deadline -= 15000.0;
    run.report = "Interlock tripped. This panel reset. −15 seconds.";
    update(run, now);
    return;
  }
  run.step++;
  if (run.stage < 2 && run.step == 1) {
    run.report = "First control accepted. Awaiting next action.";
    return;
  }
  run.step = 0;
  run.stage++;
  if (run.stage == 1) { run.report = "Emergency bus live. Route coolant."; }
  if (run.stage == 2) { run.report = "Coolant path open. Select a pump."; }
  if (run.stage == 3) {
    run.cooling = now + 5000.0;
    run.report = "Flow rising. Hold for temperature confirmation.";
  }
}
