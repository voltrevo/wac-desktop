// The desktop's own apps' looks, each on top of the Archive Explorer's tokens and icons (`../style.wac`): an app is a
// program in a window of the desktop's, or a page on its own, and either way brings its own stylesheet.

/** The Calculator's. */
export string calcCss() {
  return """
    .calcpage { height: 100%; }
    .calc { height: 100%; display: flex; flex-direction: column; background: var(--surface-2); outline: 0; user-select: none; -webkit-user-select: none; }
    .cdisp { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 10px 18px 12px; gap: 2px; }
    .chist { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; gap: 1px; scrollbar-width: thin; }
    .chrow { display: flex; justify-content: flex-end; gap: 8px; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 12.5px;
             padding: 3px 6px; border-radius: 6px; cursor: pointer; text-align: right; }
    .chrow:hover { background: var(--hover); color: var(--text); }
    .chrow .chs { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .chrow .cha { font-weight: 650; color: var(--text); white-space: nowrap; }
    .csub { min-height: 20px; text-align: right; font-size: 14px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .csub.bad { color: var(--bad); }
    .cmain { text-align: right; font-size: 40px; font-weight: 600; letter-spacing: -.02em; line-height: 1.15; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
    .cmain.m { font-size: 28px; } .cmain.s { font-size: 20px; }
    .cghost { color: var(--faint); }
    .ckeys { flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; padding: 0 12px 12px; }
    .ck { height: 50px; border: 0; border-radius: 12px; font: inherit; font-size: 19px; font-weight: 550; cursor: pointer; color: var(--text);
          background: var(--surface); box-shadow: 0 1px 0 var(--line-strong), 0 0 0 1px var(--line) inset; transition: transform .05s, filter .12s; }
    .ck:hover { filter: brightness(.97); }
    .ck:active { transform: scale(.97); }
    .ck.fn { background: var(--sunken); font-size: 16px; color: var(--muted); }
    .ck.clear { color: var(--bad); }
    .ck.op { background: var(--accent-soft); color: var(--accent); font-size: 22px; }
    .ck.eq { background: linear-gradient(140deg, var(--accent), var(--accent-2)); color: white; font-size: 22px; box-shadow: 0 6px 16px -8px var(--accent); }
    @media (prefers-color-scheme: dark) { .ck:hover { filter: brightness(1.15); } }

  """;
}

/** The Viewer's, with the toolbar it shares with the Editor. */
export string viewerCss() {
  return toolsCss() + """
    .viewerpage, .viewer { display: flex; flex-direction: column; height: 100%; }
    .viewer > .pane.preview { flex: 1; min-height: 0; }
    /* The window's title names the file and the toolbar says what it is: the preview's own header goes. */
    .viewer .phead { display: none; }
  """;
}

/** The toolbar across the top of the Viewer, the Editor and the Markdown editor: what the file is, and what to do. */
string toolsCss() {
  return """
    .etools { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px solid var(--line); }
    .etools .btn { height: 30px; font-size: 12.5px; padding: 0 10px; }
    .epath { flex: 1; min-width: 0; font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  """;
}

/** The Editor's, with the toolbar it shares with the Viewer. */
export string editorCss() {
  return toolsCss() + """
    .editorpage { height: 100%; }
    .editor { display: flex; flex-direction: column; height: 100%; background: var(--surface); }
    .ename { flex: 1; min-width: 0; font: inherit; font-size: 13px; height: 30px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--sunken); color: var(--text); outline: 0; }
    .ename:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .estate { font-size: 12px; color: var(--faint); white-space: nowrap; }
    .estate.dirty { color: var(--warn); font-weight: 600; }
    .etext { flex: 1; min-height: 0; width: 100%; resize: none; border: 0; outline: 0; padding: 16px 18px; background: var(--surface);
             color: var(--text); font-size: 13px; line-height: 1.6; tab-size: 4; }
  """;
}

/** The Markdown editor's, on top of the Editor's. */
export string mdeditCss() {
  return """
    .mded .etools .segs { display: inline-flex; padding: 2px; gap: 2px; border-radius: 9px; background: var(--sunken); border: 1px solid var(--line); }
    .mded .seg { border: 0; background: transparent; padding: 4px 10px; border-radius: 7px; font: inherit; font-size: 12px; font-weight: 550;
                 color: var(--muted); cursor: pointer; }
    .mded .seg.on { background: var(--surface); color: var(--text); box-shadow: 0 1px 2px rgb(0 0 0 / .12); }
    .mdtools { display: flex; align-items: center; gap: 2px; padding: 4px 8px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
    .mdtools .mdt { height: 28px; min-width: 30px; padding: 0 7px; border-color: transparent; background: transparent; justify-content: center; }
    .mdtools .mdt:hover { background: var(--hover); }
    .mdglyph { font-weight: 700; font-size: 12.5px; }
    .mdcount { margin-left: auto; font-size: 12px; color: var(--faint); white-space: nowrap; padding-right: 4px; }
    .mdpanes { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; }
    .mdpane { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
    .mdwrite { border-right: 1px solid var(--line); }
    .mdsrc { height: 100%; }
    .mdread { overflow: auto; background: var(--bg); }
    .mdshown .md { padding-top: 18px; }
    .mdempty { padding: 28px; color: var(--faint); text-align: center; }
    .mded.write .mdpanes, .mded.read .mdpanes { grid-template-columns: 1fr; }
    .mded.write .mdread, .mded.read .mdwrite { display: none; }
    .mded.read .mdtools .mdt { visibility: hidden; }
    .mded.write .mdwrite { border-right: 0; }
    /* Too narrow for both side by side: one above the other. */
    @container (max-width: 720px) {
      .mded.split .mdpanes { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
      .mded.split .mdwrite { border-right: 0; border-bottom: 1px solid var(--line); }
    }
  """;
}

/** The Terminal's. */
export string termCss() {
  return """
    .termpage { height: 100%; }
    .term { height: 100%; display: flex; flex-direction: column; background: #12131a; color: #e3e6ef; cursor: text; }
    /* Stacked from the bottom up, so the browser keeps the newest output in view without being told. */
    .tscroll { flex: 1; min-height: 0; overflow: auto; display: flex; flex-direction: column-reverse; padding: 12px 14px 10px; }
    .tinner { font-size: 13px; line-height: 1.5; }
    .tout { margin: 0; white-space: pre-wrap; word-break: break-word; }
    .tline { display: flex; align-items: baseline; gap: 8px; }
    .tps { color: #8d88ff; font-weight: 600; white-space: nowrap; }
    .tcmd { flex: 1; min-width: 0; border: 0; outline: 0; padding: 0; background: transparent; color: #f2f4fa; font-size: 13px; line-height: 1.5; caret-color: #8d88ff; }
  """;
}

/** Mandelbrot's: the picture fills the window, the controls float over its corner. */
export string mandelCss() {
  return """
    .mandelpage, .mandel { height: 100%; }
    .mandel { position: relative; overflow: hidden; background: #18181c; color: #f4f4f6; user-select: none; -webkit-user-select: none; }
    .mstage { position: absolute; inset: 0; outline: 0; cursor: crosshair; overflow: hidden; touch-action: none; }
    .mcanvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 0 0; image-rendering: auto; }
    .mwheel { position: absolute; inset: 0; }
    .mmenu { position: absolute; left: 10px; top: 10px; width: 34px; height: 34px; border-radius: 9px; border: 0; cursor: pointer;
             background: rgba(20,20,26,.72); color: #fff; font: inherit; font-size: 17px; backdrop-filter: blur(8px); }
    .mmenu:hover { background: rgba(40,40,52,.85); }
    .mpanel { position: absolute; left: 10px; top: 52px; width: 270px; padding: 8px 10px; border-radius: 12px;
              background: rgba(20,20,26,.78); backdrop-filter: blur(10px); display: flex; flex-direction: column; gap: 4px;
              box-shadow: 0 10px 30px -12px rgba(0,0,0,.6); }
    .mrow { display: flex; align-items: center; gap: 6px; min-height: 30px; }
    .mlabel { width: 96px; font-size: 13px; color: #c8c8d0; }
    .mwhat { flex: 1; text-align: right; font-size: 12.5px; color: #9a9aa8; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .mbtn { width: 28px; height: 26px; border-radius: 7px; border: 0; background: rgba(255,255,255,.12); color: #fff; font: inherit;
            font-size: 16px; cursor: pointer; }
    .mbtn:hover, .mwide:hover { background: rgba(255,255,255,.22); }
    .mrange { width: 100px; accent-color: #a78bfa; }
    .mlast { gap: 8px; margin-top: 4px; }
    .mwide { flex: 1; height: 30px; border-radius: 8px; border: 0; background: rgba(255,255,255,.12); color: #fff; font: inherit;
             font-size: 13px; cursor: pointer; }
    .mstatus { position: absolute; right: 10px; bottom: 10px; padding: 4px 9px; border-radius: 7px; font-size: 12px;
               background: rgba(20,20,26,.62); color: #d8d8e0; pointer-events: none; font-variant-numeric: tabular-nums; }
    .mabout { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.45); }
    .mcard { max-width: 520px; max-height: calc(100% - 40px); overflow-y: auto; margin: 20px; padding: 18px 22px; border-radius: 14px;
             background: var(--surface); color: var(--text); line-height: 1.5; font-size: 14px; }
    .mcard h2 { margin: 0 0 8px; font-size: 20px; }
    .mkeys { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 12px 0; font-size: 13px; }
    .mkeys > span:nth-child(odd) { color: var(--muted); }
    .mfaint { color: var(--muted); font-size: 12.5px; }
  """;
}
