// Paint: pictures drawn, and PNGs opened, changed and saved.
//
// **The picture is the program's, not the canvas's.** Every pixel is worked out here (`paint/image.wac`) and the
// canvas is sent only the rectangle that changed, so what is saved is exactly what was drawn, and undo needs nothing
// from the page. The canvas is shown at the zoom chosen by its size on screen alone, with its pixels kept square.
//
// **A press anywhere in the window keeps drawing.** Pointer events are heard by the frame around the canvas, in its
// own pixels, so a stroke can leave the picture and come back; while one is under way a layer covering the window is
// put in the frame, so the pointer is still over it wherever it goes. (A page cannot capture the pointer, and a
// listener hears only what is over it.) The colour picker's square is dragged the same way.
//
// **Some things stay unfinished until they are put down**: a selection being moved, a picture pasted, and text being
// typed are each a stroke under way, drawn again from the picture as it was at every change, and made one step to
// undo when they are put down — by Enter, by another tool, or by anything else that changes the picture (`settle`).
//
// **A program of the desktop's** (`src/desk/builtin.wac`): started from the site, handed the picture it was opened on
// to change, and anything dropped on its window. Open asks the desktop's picker for another; a new picture is saved
// on the Desktop under a free name like the one typed (`Desktop.newFile`). The tool, the sizes, the colours and the
// colours lately chosen are kept in its own folder, and so is what was copied — `clipboard.png` — so every Paint
// window pastes it. Opened as a page on its own, it opens what is dropped on it and saves by downloading.

import { Vec } from "core";
import { Desktop, Element, ElementEvent, Listen, MOD_ALT, MOD_CTRL, MOD_META, MOD_SHIFT, Node, Page, Picked, Ref, Ui,
         html.b, html.button, html.canvas, html.div, html.h2, html.input, html.p, html.span, html.style } from "web";
import { icon } from "../preview.wac";
import { css } from "../style.wac";
import { MOST_PIXELS, Picture, decodePng, encodePng } from "../png.wac";
import { Doc, ERASE, PAINT, Rect, textWidth } from "./paint/image.wac";
import { Hsv, blue, codePoints, fromHsv, green, hexOf, parseColour, red, toHsv } from "./paint/colour.wac";
import { paintCss } from "./paint/style.wac";

/** Where the tool, the sizes and the colours are kept, and what was copied, in the program's own folder. */
static string KEPT = "settings";
static string CLIPBOARD = "clipboard.png";
/** The zooms the buttons and keys step through. */
static f64[] ZOOMS = [0.0625, 0.125, 0.25, 0.333, 0.5, 0.667, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0, 16.0, 24.0, 32.0];
/** The largest picture New, Canvas size and Scale make, each way. */
static i32 MOST_SIDE = 8192;
/** The colour picker's square, in CSS pixels, and how many colours lately chosen it offers. */
static f64 SV_W = 220.0;
static f64 SV_H = 150.0;
static i32 RECENT = 14;

/** A tool: its name, its icon, its key, and what it is called. */
struct Tool {
  string name;
  string ic;
  string key;
  string title;
}

Tool[] tools() {
  return [Tool("select", "select", "s", "Select — drag inside to move, with Alt to copy"),
          Tool("pencil", "pencil", "p", "Pencil — hard edges, a pixel at a time"), Tool("brush", "brush", "b", "Brush — soft edges"),
          Tool("eraser", "eraser", "e", "Eraser — to transparent"), Tool("line", "line", "l", "Line — Shift for every 45°"),
          Tool("rect", "rect", "r", "Rectangle — Shift for a square"), Tool("ellipse", "ellipse", "o", "Ellipse — Shift for a circle"),
          Tool("bucket", "bucket", "f", "Fill — the area of one colour"), Tool("text", "type", "t", "Text"),
          Tool("picker", "picker", "i", "Pick a colour from the picture")];
}

/** The colours offered, a palette of its own. */
string[] palette() {
  return ["#000000", "#464646", "#787878", "#b4b4b4", "#ffffff", "#7a1f1f", "#d63a3a", "#f08a3c", "#f5c84b", "#fff59d",
          "#3e8e41", "#8bc34a", "#1e6fb8", "#6ec6ff", "#2b2d5c", "#5b55e6", "#8b5cf6", "#c084fc", "#ec4899", "#f9a8d4",
          "#7c4a2d", "#c08457", "#e8c39e", "#0f766e", "#2dd4bf", "#94a3b8", "#334155", "#fde68a"];
}

export struct Painter {
  Page page;
  Desktop? desk;
  Doc doc;
  /** The file, from the disk's root, and its name; `""` for a picture not saved yet. */
  string path;
  string name;
  string tool;
  /** The tool before the colour picker, which picking goes back to; and which colour picking sets, `""` for Alt's say. */
  string before;
  string pickInto;
  i32 size;
  bool smooth;
  bool filled;
  /** How different a colour the fill spreads to, in percent. */
  i32 tolerance;
  /** The colour drawn with and the second colour — drawn with when Alt is held — each with its opacity, 0 to 255. */
  i32 fg;
  i32 fgA;
  i32 bg;
  i32 bgA;
  /** Colours lately chosen in the picker, as `hexOf` writes them, the latest first. */
  Vec<string> recent;
  f64 zoom;
  /** Whether to fit the picture to the window when the window's size is next known. */
  bool fitting;
  /** The size of the area the picture is shown in, in CSS pixels. */
  f64 viewW;
  f64 viewH;
  /** A stroke: whether the pointer is down, when, where it started and was last, in the picture's pixels. */
  bool down;
  f64 downAt;
  f64 startX;
  f64 startY;
  f64 lastX;
  f64 lastY;
  /** Where the pointer is over the picture, for the status; -1 when it is not. */
  i32 overX;
  i32 overY;
  /** The selection, empty for none; whether one is being dragged out, and whether the pointer has moved since. */
  Rect sel;
  bool selecting;
  bool selMoved;
  /**
   * A floating selection — lifted from `hole`, or pasted, with no hole — being moved: its pixels, where its corner is,
   * and where in it the pointer took hold.
   */
  bool floating;
  Picture flt;
  Rect hole;
  i32 fltX;
  i32 fltY;
  bool moving;
  i32 grabX;
  i32 grabY;
  /** Text being typed: where its corner is, what it says, its size — the font's pixel at this many — and boldness. */
  bool typing;
  i32 tx;
  i32 ty;
  string words;
  i32 textScale;
  bool bold;
  /** What was copied, when it could not be kept in the program's folder. */
  Picture? clip;
  /** The colour picker: which colour it is open on (`""` when it is not), that colour as hue, saturation and value, its
   * opacity, what its hex field says, the colour when it opened, and whether its square is being dragged. */
  string picking;
  Hsv hsv;
  i32 pickA;
  string pickHex;
  /** What the hex field is drawn with: changed by the square, the strips and the recent colours, not by typing. */
  string pickShown;
  i32 openedC;
  i32 openedA;
  bool svDrag;
  /**
   * An open dialog — "new", "size", "scale", "save", "discard", "keys" — and its fields: as typed, and as they were
   * when it opened, which is what the fields are drawn with (a field drawn with what is typed so far is set back).
   */
  string dialog;
  string fieldW;
  string fieldH;
  string fieldName;
  string openedW;
  string openedH;
  string openedName;
  bool fieldClear;
  /** What a "discard" dialog goes on to do once the person agrees. */
  fn<void()> then;
  string note;
  bool saving;
  /** The settings as last written, and as wanted: a write under way is followed by one more if they changed. */
  string written;
  string wanted;
  bool writing;
  Element? canvas;
  /** The size the canvas was last sent, to know when it must be sent whole. */
  i32 sentW;
  i32 sentH;
  string shownTitle;
  fn<void()> bump;
}

void unseen() { }

Painter create(Page page, Doc doc) {
  return Painter {
    page: page, desk: null, doc: doc, path: "", name: "Untitled.png", tool: "brush", before: "brush", pickInto: "",
    size: 6, smooth: true, filled: false, tolerance: 12, fg: 0x1e1e2e, fgA: 255, bg: 0xffffff, bgA: 255,
    recent: Vec.create(), zoom: 1.0, fitting: true, viewW: 0.0, viewH: 0.0, down: false, downAt: 0.0, startX: 0.0,
    startY: 0.0, lastX: 0.0, lastY: 0.0, overX: 0 - 1, overY: 0 - 1, sel: Rect.none(), selecting: false,
    selMoved: false, floating: false, flt: Picture(0, 0, u8[]()), hole: Rect.none(), fltX: 0, fltY: 0, moving: false,
    grabX: 0, grabY: 0, typing: false, tx: 0, ty: 0, words: "", textScale: 2, bold: false, clip: null, picking: "",
    hsv: Hsv(0.0, 0.0, 0.0), pickA: 255, pickHex: "", pickShown: "", openedC: 0, openedA: 255, svDrag: false,
    dialog: "", fieldW: "", fieldH: "", fieldName: "", openedW: "", openedH: "", openedName: "", fieldClear: false, then: unseen, note: "", saving: false, written: "", wanted: "",
    writing: false, canvas: null, sentW: 0 - 1, sentH: 0 - 1, shownTitle: "", bump: unseen
  };
}

// ── Showing the picture ─────────────────────────────────────────────────────

/** What changed in the picture, sent to the canvas: all of it when its size changed. */
void flush(Painter m) {
  Rect r = m.doc.taken();
  if (m.canvas is null) { return; }
  Doc d = m.doc;
  if (d.w != m.sentW || d.h != m.sentH) {
    m.canvas!.pixels(d.w, d.h, d.rgba);
    m.sentW = d.w;
    m.sentH = d.h;
    return;
  }
  if (r.empty()) { return; }
  m.canvas!.pixelsIn(r.x0, r.y0, r.w(), r.h(), d.region(r));
}

/** The title: the picture's name, marked while it has changes not saved. */
void retitle(Painter m) {
  string t = m.name + (m.doc.modified() ? " •" : "");
  if (t != m.shownTitle) {
    m.shownTitle = t;
    m.page.title(t);
  }
}

void changed(Painter m) {
  flush(m);
  retitle(m);
  m.bump();
}

/** The zoom at which the whole picture fits the area it is shown in, at most actual size. */
f64 fitZoom(Painter m) {
  if (m.viewW <= 0.0 || m.viewH <= 0.0) { return 1.0; }
  f64 z = ((m.viewW - 40.0) / (m.doc.w as f64)).min((m.viewH - 40.0) / (m.doc.h as f64));
  return z > 1.0 ? 1.0 : (z < ZOOMS[0] ? ZOOMS[0] : z);
}

/** One step of the zooms in or out from where it is. */
void zoomStep(Painter m, i32 dir) {
  f64 z = m.zoom;
  if (dir > 0) {
    for (i32 i = 0; i < ZOOMS.len(); i++) { if (ZOOMS[i] > z * 1.001) { m.zoom = ZOOMS[i]; m.fitting = false; m.bump(); return; } }
  } else {
    for (i32 i = ZOOMS.len() - 1; i >= 0; i--) { if (ZOOMS[i] < z * 0.999) { m.zoom = ZOOMS[i]; m.fitting = false; m.bump(); return; } }
  }
}

void fit(Painter m) {
  m.zoom = fitZoom(m);
  m.fitting = true;
  m.bump();
}

string percent(f64 z) {
  f64 p = (z * 100.0).round();
  return "\{p as~ i32}%";
}

// ── Putting things down ─────────────────────────────────────────────────────

/** The floating selection put down where it is: one step to undo. The selection stays around where it landed. */
void dropFloat(Painter m) {
  if (!m.floating) { return; }
  m.doc.end();
  m.floating = false;
  m.moving = false;
  m.sel = m.doc.clip(Rect(m.fltX, m.fltY, m.fltX + m.flt.w, m.fltY + m.flt.h));
  m.hole = Rect.none();
  m.flt = Picture(0, 0, u8[]());
}

/** The text typed put down: one step to undo, or nothing when nothing was typed. */
void dropText(Painter m) {
  if (!m.typing) { return; }
  m.typing = false;
  m.doc.end();
  m.words = "";
}

/**
 * **Everything unfinished put down**, before anything else changes the picture or the tool: the text typed and a
 * floating selection. The selection itself goes too, unless `keepSel`.
 */
void settle(Painter m, bool keepSel) {
  dropText(m);
  dropFloat(m);
  m.selecting = false;
  if (!keepSel) { m.sel = Rect.none(); }
  if (m.doc.active) { m.doc.end(); }
  changed(m);
}

// ── Strokes ─────────────────────────────────────────────────────────────────

/** A point on a pixel's centre, or on a corner between pixels for an even size, so a hard edge is even all round. */
f64 snap(f64 v, i32 size) { return size % 2 == 1 ? v.floor() + 0.5 : v.round(); }

/** The end of a line from (`x0`, `y0`) to (`x1`, `y1`) kept to a multiple of 45°. */
f64[] constrainLine(f64 x0, f64 y0, f64 x1, f64 y1) {
  f64 dx = x1 - x0;
  f64 dy = y1 - y0;
  f64 ax = dx.abs();
  f64 ay = dy.abs();
  if (ax > 2.0 * ay) { return [x1, y0]; }
  if (ay > 2.0 * ax) { return [x0, y1]; }
  f64 d = ax.max(ay);
  return [x0 + d.copySign(dx), y0 + d.copySign(dy)];
}

/** The corner of a rectangle from (`x0`, `y0`) made square. */
i32[] constrainSquare(i32 x0, i32 y0, i32 x1, i32 y1) {
  i32 dx = x1 - x0;
  i32 dy = y1 - y0;
  i32 ax = dx < 0 ? 0 - dx : dx;
  i32 ay = dy < 0 ? 0 - dy : dy;
  i32 d = ax > ay ? ax : ay;
  return [x0 + (dx < 0 ? 0 - d : d), y0 + (dy < 0 ? 0 - d : d)];
}

/** A shape from where the stroke began to (`x`, `y`), drawn again in place of the last. */
void shape(Painter m, f64 x, f64 y, bool shift) {
  Doc d = m.doc;
  d.clearStroke();
  if (m.tool == "line") {
    f64 x0 = snap(m.startX, m.size);
    f64 y0 = snap(m.startY, m.size);
    f64 x1 = snap(x, m.size);
    f64 y1 = snap(y, m.size);
    if (shift) {
      f64[] c = constrainLine(x0, y0, x1, y1);
      x1 = c[0];
      y1 = c[1];
    }
    d.segment(x0, y0, x1, y1, m.size as f64, m.smooth);
    return;
  }
  i32 x0 = m.startX.floor() as~ i32;
  i32 y0 = m.startY.floor() as~ i32;
  i32 x1 = x.floor() as~ i32;
  i32 y1 = y.floor() as~ i32;
  if (shift) {
    i32[] c = constrainSquare(x0, y0, x1, y1);
    x1 = c[0];
    y1 = c[1];
  }
  if (m.tool == "rect") { d.rect(x0, y0, x1, y1, m.size, m.filled); }
  else { d.ellipse(x0, y0, x1, y1, m.size, m.filled, m.smooth); }
}

/** A freehand stroke carried on from where it last was to (`x`, `y`). */
void freehand(Painter m, f64 x, f64 y) {
  f64 s = m.size as f64;
  if (m.tool == "brush") {
    m.doc.segment(m.lastX, m.lastY, x, y, s, true);
  } else {
    bool hard = m.tool == "pencil" || !m.smooth;
    f64 ax = hard ? snap(m.lastX, m.size) : m.lastX;
    f64 ay = hard ? snap(m.lastY, m.size) : m.lastY;
    f64 bx = hard ? snap(x, m.size) : x;
    f64 by = hard ? snap(y, m.size) : y;
    m.doc.segment(ax, ay, bx, by, s, !hard);
  }
  m.lastX = x;
  m.lastY = y;
}

bool inside(Rect r, i32 x, i32 y) { return x >= r.x0 && x < r.x1 && y >= r.y0 && y < r.y1; }

/** The rectangle of the floating selection, or of the text being typed. */
Rect floatRect(Painter m) { return Rect(m.fltX, m.fltY, m.fltX + m.flt.w, m.fltY + m.flt.h); }

Rect textRect(Painter m) {
  i32 w = textWidth(codePoints(m.words), m.textScale);
  i32 thick = m.bold ? (m.textScale + 1) / 2 : 0;
  return Rect(m.tx, m.ty, m.tx + (w > 0 ? w : 8 * m.textScale) + thick, m.ty + 16 * m.textScale);
}

void pressed(Painter m, f64 x, f64 y, i32 mods, f64 at) {
  if (m.dialog != "" || m.picking != "") { return; }
  m.note = "";
  Doc d = m.doc;
  i32 ix = x.floor() as~ i32;
  i32 iy = y.floor() as~ i32;
  m.down = true;
  m.downAt = at;
  m.startX = x;
  m.startY = y;
  if (m.tool == "select") {
    pressSelect(m, ix, iy, mods);
    return;
  }
  if (m.tool == "text") {
    pressText(m, ix, iy);
    return;
  }
  settle(m, false);
  bool second = (mods & MOD_ALT) != 0;
  if (m.tool == "picker") {
    m.down = false;
    i32[] c = d.at(ix, iy);
    if (c[3] > 0) {
      i32 v = (c[0] << 16) | (c[1] << 8) | c[2];
      if (m.pickInto == "bg" || (m.pickInto == "" && second)) { m.bg = v; m.bgA = c[3]; } else { m.fg = v; m.fgA = c[3]; }
      keepSettings(m);
    }
    m.pickInto = "";
    m.tool = m.before;
    m.bump();
    return;
  }
  i32 colour = second ? m.bg : m.fg;
  i32 alpha = second ? m.bgA : m.fgA;
  d.begin(m.tool == "eraser" ? ERASE : PAINT, red(colour), green(colour), blue(colour), alpha);
  if (m.tool == "bucket") {
    m.down = false;
    d.fill(ix, iy, m.tolerance * 255 / 100);
    d.end();
    changed(m);
    return;
  }
  m.lastX = x;
  m.lastY = y;
  if (m.tool == "line" || m.tool == "rect" || m.tool == "ellipse") { shape(m, x, y, (mods & MOD_SHIFT) != 0); }
  else { freehand(m, x, y); }
  changed(m);
}

void dragged(Painter m, f64 x, f64 y, i32 mods) {
  m.overX = x >= 0.0 && x < (m.doc.w as f64) && y >= 0.0 && y < (m.doc.h as f64) ? x.floor() as~ i32 : 0 - 1;
  m.overY = m.overX >= 0 ? y.floor() as~ i32 : 0 - 1;
  if (!m.down) {
    m.bump();
    return;
  }
  i32 ix = x.floor() as~ i32;
  i32 iy = y.floor() as~ i32;
  if (m.tool == "select") { dragSelect(m, ix, iy, (mods & MOD_SHIFT) != 0); }
  else if (m.tool == "text") {
    if (m.moving && m.typing) {
      m.tx = ix - m.grabX;
      m.ty = iy - m.grabY;
      drawText(m);
    }
  }
  else if (m.doc.active) {
    if (m.tool == "line" || m.tool == "rect" || m.tool == "ellipse") { shape(m, x, y, (mods & MOD_SHIFT) != 0); }
    else { freehand(m, x, y); }
  }
  flush(m);
  m.bump();
}

void released(Painter m) {
  if (!m.down) { return; }
  m.down = false;
  if (m.tool == "select") {
    m.moving = false;
    // A click that did not drag a selection out lets go of the one there was.
    if (m.selecting && !m.selMoved) { m.sel = Rect.none(); }
    m.selecting = false;
    m.bump();
    return;
  }
  if (m.tool == "text") {
    m.moving = false;
    m.bump();
    return;
  }
  m.doc.end();
  changed(m);
}

// ── Selecting, copying and pasting ──────────────────────────────────────────

/** The selection lifted off the picture to float — or, when `copy`, a copy of it, leaving the picture as it was. */
void lift(Painter m, bool copy) {
  m.flt = m.doc.copyRect(m.sel);
  m.hole = copy ? Rect.none() : m.sel;
  m.fltX = m.sel.x0;
  m.fltY = m.sel.y0;
  m.floating = true;
  m.doc.begin(PAINT, 0, 0, 0, 255);
  m.doc.float(m.hole, m.flt, m.fltX, m.fltY);
}

void pressSelect(Painter m, i32 x, i32 y, i32 mods) {
  if (m.floating && inside(floatRect(m), x, y)) {
    m.moving = true;
  } else if (!m.floating && !m.sel.empty() && inside(m.sel, x, y)) {
    lift(m, (mods & MOD_ALT) != 0);
    m.moving = true;
    changed(m);
  } else {
    dropFloat(m);
    m.sel = Rect.none();
    m.selecting = true;
    m.selMoved = false;
    changed(m);
    return;
  }
  m.grabX = x - m.fltX;
  m.grabY = y - m.fltY;
}

void dragSelect(Painter m, i32 x, i32 y, bool shift) {
  if (m.moving && m.floating) {
    m.fltX = x - m.grabX;
    m.fltY = y - m.grabY;
    m.doc.float(m.hole, m.flt, m.fltX, m.fltY);
    return;
  }
  if (!m.selecting) { return; }
  i32 x0 = m.startX.floor() as~ i32;
  i32 y0 = m.startY.floor() as~ i32;
  if (x == x0 && y == y0 && !m.selMoved) { return; }
  m.selMoved = true;
  i32 x1 = x;
  i32 y1 = y;
  if (shift) {
    i32[] c = constrainSquare(x0, y0, x1, y1);
    x1 = c[0];
    y1 = c[1];
  }
  m.sel = m.doc.clip(Rect(x0 < x1 ? x0 : x1, y0 < y1 ? y0 : y1, (x0 > x1 ? x0 : x1) + 1, (y0 > y1 ? y0 : y1) + 1));
}

/** Where the floating selection is, moved by (`dx`, `dy`) — lifted first, if it is only a selection. */
void nudge(Painter m, i32 dx, i32 dy) {
  if (!m.floating) {
    if (m.sel.empty()) { return; }
    lift(m, false);
  }
  m.fltX = m.fltX + dx;
  m.fltY = m.fltY + dy;
  m.doc.float(m.hole, m.flt, m.fltX, m.fltY);
  changed(m);
}

/** What is selected, as a picture of its own: the floating selection, or the picture's pixels under the selection. */
Picture selected(Painter m) { return m.floating ? m.flt : m.doc.copyRect(m.sel); }

async void copy(Painter m) {
  if (!m.floating && m.sel.empty()) {
    m.note = "Select something to copy";
    m.bump();
    return;
  }
  Picture p = selected(m);
  m.clip = p;
  m.note = "Copied \{p.w} × \{p.h}";
  m.bump();
  // Kept in the program's folder, so every Paint window — and this one after a reload — pastes it.
  await m.page.sys.files().writeFile(CLIPBOARD, encodePng(p.w, p.h, p.rgba));
}

/** What is selected taken away to transparent; a floating selection, dropped. */
void wipe(Painter m) {
  if (m.floating) {
    m.doc.float(m.hole, Picture(0, 0, u8[]()), 0, 0);
    m.doc.end();
    m.floating = false;
    m.moving = false;
  } else if (!m.sel.empty()) {
    m.doc.begin(ERASE, 0, 0, 0, 255);
    m.doc.rect(m.sel.x0, m.sel.y0, m.sel.x1 - 1, m.sel.y1 - 1, 1, true);
    m.doc.end();
  } else {
    return;
  }
  m.sel = Rect.none();
  changed(m);
}

async void cut(Painter m) {
  if (!m.floating && m.sel.empty()) { return; }
  await copy(m);
  wipe(m);
}

/** What was copied, floating over the picture at the selection's corner — or the picture's — to be moved and put down. */
async void paste(Painter m) {
  Picture? got = m.clip;
  auto kept = await m.page.sys.files().readFile(CLIPBOARD);
  if (kept.isOk()) {
    match (decodePng(kept.ok()!)) {
      Ok(p): { got = p; }
      Err(why): { }
    }
  }
  if (got is null || got!.w == 0) {
    m.note = "Nothing to paste: copy part of a picture first";
    m.bump();
    return;
  }
  i32 x = m.sel.empty() ? 0 : m.sel.x0;
  i32 y = m.sel.empty() ? 0 : m.sel.y0;
  settle(m, false);
  m.tool = "select";
  m.flt = got!;
  m.hole = Rect.none();
  m.fltX = x;
  m.fltY = y;
  m.floating = true;
  m.doc.begin(PAINT, 0, 0, 0, 255);
  m.doc.float(m.hole, m.flt, x, y);
  m.sel = floatRect(m);
  m.note = got!.w > m.doc.w || got!.h > m.doc.h ? "Pasted: larger than the picture — Canvas size makes room" : "";
  changed(m);
}

void selectAll(Painter m) {
  settle(m, false);
  m.tool = "select";
  m.sel = Rect(0, 0, m.doc.w, m.doc.h);
  changed(m);
}

void crop(Painter m) {
  settle(m, true);
  if (m.sel.empty()) {
    m.note = "Select the part to keep first";
    m.bump();
    return;
  }
  m.doc.crop(m.sel);
  m.sel = Rect.none();
  if (m.fitting) { m.zoom = fitZoom(m); }
  changed(m);
}

// ── Text ────────────────────────────────────────────────────────────────────

/** The text typed, drawn again where it is, in the colour drawn with. */
void drawText(Painter m) {
  Doc d = m.doc;
  d.cr = red(m.fg);
  d.cg = green(m.fg);
  d.cb = blue(m.fg);
  d.ca = m.fgA;
  d.clearStroke();
  if (m.words != "") { d.text(codePoints(m.words), m.tx, m.ty, m.textScale, m.bold); }
}

void pressText(Painter m, i32 x, i32 y) {
  if (m.typing && inside(textRect(m), x, y)) {
    m.moving = true;
    m.grabX = x - m.tx;
    m.grabY = y - m.ty;
    return;
  }
  settle(m, false);
  m.down = false;
  m.typing = true;
  m.tx = x;
  m.ty = y;
  m.words = "";
  m.doc.begin(PAINT, red(m.fg), green(m.fg), blue(m.fg), m.fgA);
  changed(m);
}

void typed(Painter m, string words) {
  m.words = words;
  if (!m.typing) { return; }
  drawText(m);
  changed(m);
}

/** The text being typed dropped, leaving the picture as it was. */
void cancelText(Painter m) {
  if (!m.typing) { return; }
  m.typing = false;
  m.words = "";
  m.doc.cancel();
  changed(m);
}

// ── The colour picker ───────────────────────────────────────────────────────

/** The colour picker opened on the colour drawn with, `"fg"`, or the second, `"bg"`. */
void openPicker(Painter m, string which) {
  i32 c = which == "fg" ? m.fg : m.bg;
  i32 a = which == "fg" ? m.fgA : m.bgA;
  m.picking = which;
  m.hsv = toHsv(c);
  m.pickA = a;
  m.pickHex = hexOf(c, a);
  m.pickShown = m.pickHex;
  m.openedC = c;
  m.openedA = a;
  m.bump();
}

/** The colour the picker is on, made `c` at opacity `a`. */
void setPicked(Painter m, i32 c, i32 a, bool fromHex) {
  if (m.picking == "fg") {
    m.fg = c;
    m.fgA = a;
  } else {
    m.bg = c;
    m.bgA = a;
  }
  if (!fromHex) {
    m.pickHex = hexOf(c, a);
    m.pickShown = m.pickHex;
  }
  if (m.typing) {
    drawText(m);
    flush(m);
  }
  keepSettings(m);
  m.bump();
}

void fromPicker(Painter m) { setPicked(m, fromHsv(m.hsv.h, m.hsv.s, m.hsv.v), m.pickA, false); }

/** The square: saturation across, value up, from where the pointer is over it, in its CSS pixels. */
void pickAt(Painter m, i32 x, i32 y) {
  m.hsv.s = ((x as f64) / SV_W).max(0.0).min(1.0);
  m.hsv.v = 1.0 - ((y as f64) / SV_H).max(0.0).min(1.0);
  fromPicker(m);
}

/** A colour typed in the hex field, taken when it reads as one; the hue kept when it is a grey. */
void pickHex(Painter m, string s) {
  m.pickHex = s;
  i32[] c = parseColour(s);
  if (c.len() == 0) {
    m.bump();
    return;
  }
  Hsv h = toHsv(c[0]);
  if (h.s == 0.0 || h.v == 0.0) { h.h = m.hsv.h; }
  m.hsv = h;
  m.pickA = c[1];
  setPicked(m, c[0], c[1], true);
}

/** The picker closed, the colour chosen remembered among the recent ones when it changed. */
void closePicker(Painter m) {
  if (m.picking == "") { return; }
  i32 c = m.picking == "fg" ? m.fg : m.bg;
  i32 a = m.picking == "fg" ? m.fgA : m.bgA;
  if (c != m.openedC || a != m.openedA) { remember(m, hexOf(c, a)); }
  m.picking = "";
  m.svDrag = false;
  keepSettings(m);
  m.bump();
}

void remember(Painter m, string colour) {
  for (i32 i = 0; i < m.recent.len(); i++) {
    if (m.recent.get(i) == colour) {
      m.recent.remove(i);
      break;
    }
  }
  m.recent.insert(0, colour);
  while (m.recent.len() > RECENT) { m.recent.pop(); }
}

// ── Opening and saving ──────────────────────────────────────────────────────

/** The last part of a path. */
export string leafOf(string path) {
  i32 k = path.len() - 1;
  while (k >= 0 && path.slice(k, k + 1) != "/") { k--; }
  return path.slice(k + 1, path.len());
}

/** A picture to paint on, in place of the one there, from `path` (`""` for none) named `name`. */
void adopt(Painter m, Doc doc, string path, string name) {
  m.doc = doc;
  m.path = path;
  m.name = name;
  m.down = false;
  m.typing = false;
  m.words = "";
  m.floating = false;
  m.moving = false;
  m.selecting = false;
  m.sel = Rect.none();
  m.overX = 0 - 1;
  m.overY = 0 - 1;
  m.sentW = 0 - 1;
  m.fitting = true;
  m.zoom = fitZoom(m);
  changed(m);
}

/** The bytes of a PNG opened, or a note saying why not. */
void openBytes(Painter m, string path, string name, u8[] bytes) {
  match (decodePng(bytes)) {
    Ok(p): {
      adopt(m, Doc.of(p), path, name);
      m.note = "";
    }
    Err(why): { m.note = "Could not open \{name}: \{why}"; }
  }
  m.bump();
}

async void openPath(Painter m, string path) {
  match (await m.page.sys.files().readFile(path)) {
    Ok(bytes): { openBytes(m, path, leafOf(path), bytes); }
    Err(why): {
      m.note = "Could not read \{leafOf(path)}: \{why}";
      m.bump();
    }
  }
}

/** Do `then` now, or once the person has agreed to lose the changes not saved. */
void unlessUnsaved(Painter m, fn<void()> then) {
  settle(m, true);
  if (!m.doc.modified()) {
    then();
    return;
  }
  m.then = then;
  m.dialog = "discard";
  m.bump();
}

async void pickAndOpen(Painter m) {
  if (m.desk is null) {
    m.note = "Drop a PNG on this window to open it";
    m.bump();
    return;
  }
  match (await m.desk!.pick("a PNG picture to open in Paint")) {
    Ok(path): { openPath(m, path); }
    Err(why): { }
  }
}

void newPicture(Painter m, i32 w, i32 h, bool clear) {
  Doc d = clear ? Doc.blank(w, h, 0, 0, 0, 0) : Doc.blank(w, h, red(m.bg), green(m.bg), blue(m.bg), m.bgA);
  adopt(m, d, "", "Untitled.png");
}

/** The name to save a new picture as: the one typed, made to end in `.png`. */
export string pngName(string typed) {
  string t = trimmed(typed);
  if (t == "") { t = "Untitled"; }
  string lower = cased(t, false);
  if (lower.len() < 4 || lower.slice(lower.len() - 4, lower.len()) != ".png") { t = t + ".png"; }
  return t;
}

/** Save to the picture's file — a new picture first asks for a name — or, on a page of its own, download it. */
async void save(Painter m) {
  if (m.saving) { return; }
  settle(m, true);
  if (m.desk is null) {
    m.page.download(m.name, encodePng(m.doc.w, m.doc.h, m.doc.rgba));
    m.doc.saved();
    m.note = "Downloaded \{m.name}";
    changed(m);
    return;
  }
  if (m.path == "") {
    m.fieldName = m.name;
    m.openedName = m.name;
    m.dialog = "save";
    m.bump();
    return;
  }
  writeTo(m, m.path);
}

async void saveAs(Painter m, string typed) {
  string name = pngName(typed);
  if (name.indexOf("/") >= 0) {
    m.note = "A name cannot contain “/”";
    m.bump();
    return;
  }
  m.dialog = "";
  match (await m.desk!.newFile(name)) {
    Ok(path): { writeTo(m, path); }
    Err(why): {
      m.note = "Not saved: \{why}";
      m.bump();
    }
  }
}

async void writeTo(Painter m, string path) {
  m.saving = true;
  m.note = "Saving…";
  m.bump();
  await m.page.painted();
  // What is saved is the picture as it is now; a stroke made while it is written is a change after it.
  i32 steps = m.doc.undos.len();
  u8[] bytes = encodePng(m.doc.w, m.doc.h, m.doc.rgba);
  match (await m.page.sys.files().writeFile(path, bytes)) {
    Ok(v): {
      if (m.doc.undos.len() == steps) { m.doc.saved(); }
      m.path = path;
      m.name = leafOf(path);
      m.note = "Saved \{m.name}";
      if (m.desk is not null) { m.desk!.note("Saved \{m.name}"); }
    }
    Err(why): { m.note = "Not saved: \{why}"; }
  }
  m.saving = false;
  changed(m);
}

/** Pictures dropped on the window, or handed over, opened one at a time as they come. */
async void receive(Painter m) {
  while (true) {
    Picked p = await m.page.nextFile();
    if (!p.ok) { continue; }
    u8[] bytes = p.bytes;
    string name = leafOf(p.name);
    unlessUnsaved(m, () => { openBytes(m, "", name, bytes); });
  }
}

// ── Settings ────────────────────────────────────────────────────────────────

string settingsText(Painter m) {
  string recent = "";
  for (i32 i = 0; i < m.recent.len(); i++) { recent = recent + (i > 0 ? " " : "") + m.recent.get(i); }
  return "\{m.tool} \{m.size} \{m.smooth ? "1" : "0"} \{m.filled ? "1" : "0"} \{m.tolerance} \{hexOf(m.fg, m.fgA)} "
         + "\{hexOf(m.bg, m.bgA)} \{m.textScale} \{m.bold ? "1" : "0"}\n" + recent + "\n";
}

/** Settings as `settingsText` wrote them — or an older one, shorter — onto `m`; whatever does not read is left. */
export void restore(Painter m, string text) {
  string[] lines = split(text, "\n");
  string[] f = words(lines.len() > 0 ? lines[0] : "");
  if (f.len() < 7) { return; }
  Tool[] ts = tools();
  for (i32 i = 0; i < ts.len(); i++) {
    if (ts[i].name == f[0] && f[0] != "picker") {
      m.tool = f[0];
      m.before = f[0];
    }
  }
  i32 size = number(f[1], m.size);
  m.size = size < 1 ? 1 : (size > 100 ? 100 : size);
  m.smooth = f[2] != "0";
  m.filled = f[3] == "1";
  i32 tol = number(f[4], m.tolerance);
  m.tolerance = tol < 0 ? 0 : (tol > 100 ? 100 : tol);
  i32[] fg = parseColour(f[5]);
  if (fg.len() == 2) { m.fg = fg[0]; m.fgA = fg[1]; }
  i32[] bg = parseColour(f[6]);
  if (bg.len() == 2) { m.bg = bg[0]; m.bgA = bg[1]; }
  if (f.len() >= 9) {
    i32 s = number(f[7], m.textScale);
    m.textScale = s < 1 ? 1 : (s > 8 ? 8 : s);
    m.bold = f[8] == "1";
  }
  if (lines.len() > 1) {
    string[] r = words(lines[1]);
    for (i32 i = 0; i < r.len() && m.recent.len() < RECENT; i++) { if (parseColour(r[i]).len() == 2) { m.recent.push(r[i]); } }
  }
}

/** `s` without the spaces and line ends around it. */
string trimmed(string s) {
  u8[] b = s.toBytes();
  i32 a = 0;
  i32 z = b.len();
  while (a < z && (b[a] == ' ' || b[a] == '\n' || b[a] == '\t' || b[a] == '\r')) { a++; }
  while (z > a && (b[z - 1] == ' ' || b[z - 1] == '\n' || b[z - 1] == '\t' || b[z - 1] == '\r')) { z--; }
  return s.slice(a, z);
}

/** `s` with its ASCII letters made capitals, when `upper`, or small. */
string cased(string s, bool upper) {
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (upper && b[i] >= 'a' && b[i] <= 'z') { b[i] = b[i] - 32; }
    if (!upper && b[i] >= 'A' && b[i] <= 'Z') { b[i] = b[i] + 32; }
  }
  return string.fromBytes(b);
}

/** `s` in the pieces between each `sep`. */
string[] split(string s, string sep) {
  Vec<string> out = Vec.create();
  string rest = s;
  while (true) {
    i32 k = rest.indexOf(sep);
    if (k < 0) {
      out.push(rest);
      return out.toArray();
    }
    out.push(rest.slice(0, k));
    rest = rest.slice(k + sep.len(), rest.len());
  }
}

/** The words of `s`, split at spaces and line ends. */
string[] words(string s) {
  Vec<string> out = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    bool gap = i == s.len() || s.slice(i, i + 1) == " " || s.slice(i, i + 1) == "\n";
    if (gap) {
      if (i > start) { out.push(s.slice(start, i)); }
      start = i + 1;
    }
  }
  return out.toArray();
}

/** A whole number written in decimal, or `fallback`. */
export i32 number(string s, i32 fallback) {
  u8[] b = trimmed(s).toBytes();
  if (b.len() == 0 || b.len() > 6) { return fallback; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return fallback; }
    v = v * 10 + ((b[i] - '0') as i32);
  }
  return v;
}

/** The settings written to the program's folder, one write at a time, the last asked for written last. */
async void keepSettings(Painter m) {
  m.wanted = settingsText(m);
  if (m.writing || m.wanted == m.written) { return; }
  m.writing = true;
  while (m.wanted != m.written) {
    string text = m.wanted;
    await m.page.sys.files().writeFile(KEPT, text.toBytes());
    m.written = text;
  }
  m.writing = false;
}

// ── Keys ────────────────────────────────────────────────────────────────────

void choose(Painter m, string tool) {
  if (tool == m.tool) { return; }
  settle(m, tool == "select");
  if (tool == "picker" && m.tool != "picker") { m.before = m.tool; }
  m.tool = tool;
  keepSettings(m);
  m.bump();
}

void resize(Painter m, i32 by) {
  if (m.tool == "text") {
    i32 s = m.textScale + (by > 0 ? 1 : 0 - 1);
    m.textScale = s < 1 ? 1 : (s > 8 ? 8 : s);
    if (m.typing) { drawText(m); flush(m); }
  } else {
    i32 s = m.size + by;
    m.size = s < 1 ? 1 : (s > 100 ? 100 : s);
  }
  keepSettings(m);
  m.bump();
}

/** The last step undone — anything unfinished put down first, and so undone first. */
void undo(Painter m) {
  settle(m, false);
  if (m.doc.undo()) { changed(m); }
}

void redo(Painter m) {
  settle(m, false);
  if (m.doc.redo()) { changed(m); }
}

void swapColours(Painter m) {
  i32 t = m.fg;
  i32 ta = m.fgA;
  m.fg = m.bg;
  m.fgA = m.bgA;
  m.bg = t;
  m.bgA = ta;
  if (m.typing) { drawText(m); flush(m); }
  keepSettings(m);
  m.bump();
}

/** A whole-picture change, everything unfinished and the selection put down first. */
void whole(Painter m, fn<void()> change) {
  settle(m, false);
  change();
  if (m.fitting) { m.zoom = fitZoom(m); }
  changed(m);
}

/** What a key does; false for one that does nothing here. */
bool onKey(Painter m, string k, i32 mods) {
  bool ctrl = (mods & MOD_CTRL) != 0 || (mods & MOD_META) != 0;
  bool shift = (mods & MOD_SHIFT) != 0;
  if (m.picking != "") {
    if (k == "Escape" || k == "Enter") { closePicker(m); return true; }
    return false;
  }
  if (m.dialog != "") {
    if (k == "Escape") {
      m.dialog = "";
      m.bump();
      return true;
    }
    return false;
  }
  // Typing goes to the text field, which says what Enter and Escape do; the rest is its own.
  if (m.typing) { return false; }
  if (ctrl) {
    if ((k == "z" || k == "Z") && !shift) { undo(m); }
    else if (k == "y" || k == "Y" || ((k == "z" || k == "Z") && shift)) { redo(m); }
    else if (k == "s" || k == "S") { save(m); }
    else if (k == "o" || k == "O") { unlessUnsaved(m, () => { pickAndOpen(m); }); }
    else if (k == "c" || k == "C") { copy(m); }
    else if (k == "x" || k == "X") { cut(m); }
    else if (k == "v" || k == "V") { paste(m); }
    else if (k == "a" || k == "A") { selectAll(m); }
    else { return false; }
    return true;
  }
  if (k == "Escape" || k == "Enter") {
    if (m.doc.active && !m.floating) {
      m.doc.cancel();
      m.down = false;
    }
    // Enter puts a floating selection down and keeps it selected; Escape lets go of it.
    settle(m, k == "Enter" && m.tool == "select");
    return true;
  }
  if ((k == "Delete" || k == "Backspace") && (m.floating || !m.sel.empty())) {
    wipe(m);
    return true;
  }
  if (m.tool == "select" && (k == "ArrowLeft" || k == "ArrowRight" || k == "ArrowUp" || k == "ArrowDown")) {
    i32 step = shift ? 10 : 1;
    nudge(m, k == "ArrowLeft" ? 0 - step : (k == "ArrowRight" ? step : 0), k == "ArrowUp" ? 0 - step : (k == "ArrowDown" ? step : 0));
    return true;
  }
  Tool[] ts = tools();
  for (i32 i = 0; i < ts.len(); i++) {
    if (k == ts[i].key || k == cased(ts[i].key, true)) {
      choose(m, ts[i].name);
      return true;
    }
  }
  if (k == "[") { resize(m, m.size > 10 ? 0 - 2 : 0 - 1); }
  else if (k == "]") { resize(m, m.size >= 10 ? 2 : 1); }
  else if (k == "x" || k == "X") { swapColours(m); }
  else if (k == "+" || k == "=") { zoomStep(m, 1); }
  else if (k == "-" || k == "_") { zoomStep(m, 0 - 1); }
  else if (k == "0") { fit(m); }
  else if (k == "1") {
    m.zoom = 1.0;
    m.fitting = false;
    m.bump();
  }
  else if (k == "?") {
    m.dialog = "keys";
    m.bump();
  }
  else { return false; }
  return true;
}

// ── The window ──────────────────────────────────────────────────────────────

Node ToolButton(Ui ui, Painter m, Tool t, i32 rev) {
  return <button class={m.tool == t.name ? "ptool on" : "ptool"} title={t.title + " (" + cased(t.key, true) + ")"}
                 onclick={(ElementEvent e) => { choose(m, t.name); }}>{icon(t.ic, "")}</button>;
}

Node Action(Ui ui, string ic, string title, bool enabled, fn<void()> run) {
  return enabled
    ? <button class="pbtn" title={title} onclick={(ElementEvent e) => { run(); }}>{icon(ic, "sm")}</button>
    : <button class="pbtn" title={title} disabled="">{icon(ic, "sm")}</button>;
}

/** A button in the options bar, with its icon and its word. */
Node Labelled(Ui ui, string ic, string label, string title, bool enabled, fn<void()> run) {
  return enabled
    ? <button class="pchip pact-btn" title={title} onclick={(ElementEvent e) => { run(); }}>{icon(ic, "sm")}<span>{label}</span></button>
    : <button class="pchip pact-btn" title={title} disabled="">{icon(ic, "sm")}<span>{label}</span></button>;
}

/** What the tool in hand can be changed by. */
Node Options(Ui ui, Painter m, i32 rev, Ref field) {
  string t = m.tool;
  bool sized = t != "bucket" && t != "picker" && t != "select" && t != "text";
  Vec<Node> parts = Vec.create();
  if (sized) {
    parts.push(<span class="plabel">Size</span>);
    parts.push(<input class="prange" type="range" min="1" max="100" step="1" value={"\{m.size}"} title="Size ([ and ])"
                      oninput={(ElementEvent e) => { m.size = number(e.value, m.size); keepSettings(m); m.bump(); }}/>);
    parts.push(<span class="pval">{"\{m.size} px"}</span>);
  }
  if (t == "eraser" || t == "line" || t == "ellipse") {
    parts.push(<button class={m.smooth ? "pchip on" : "pchip"} title="Soft, anti-aliased edges"
                       onclick={(ElementEvent e) => { m.smooth = !m.smooth; keepSettings(m); m.bump(); }}>Smooth</button>);
  }
  if (t == "rect" || t == "ellipse") {
    parts.push(<span class="pseg">
      <button class={m.filled ? "pchip" : "pchip on"} onclick={(ElementEvent e) => { m.filled = false; keepSettings(m); m.bump(); }}>Outline</button>
      <button class={m.filled ? "pchip on" : "pchip"} onclick={(ElementEvent e) => { m.filled = true; keepSettings(m); m.bump(); }}>Filled</button>
    </span>);
  }
  if (t == "bucket") {
    parts.push(<span class="plabel">Tolerance</span>);
    parts.push(<input class="prange" type="range" min="0" max="100" step="1" value={"\{m.tolerance}"}
                      title="How different a colour the fill spreads into"
                      oninput={(ElementEvent e) => { m.tolerance = number(e.value, m.tolerance); keepSettings(m); m.bump(); }}/>);
    parts.push(<span class="pval">{"\{m.tolerance}%"}</span>);
  }
  if (t == "select") {
    bool some = m.floating || !m.sel.empty();
    parts.push(<Labelled ic="copy" label="Copy" title="Copy (Ctrl+C)" enabled={some} run={() => { copy(m); }}/>);
    parts.push(<Labelled ic="cut" label="Cut" title="Cut (Ctrl+X)" enabled={some} run={() => { cut(m); }}/>);
    parts.push(<Labelled ic="paste" label="Paste" title="Paste (Ctrl+V)" enabled={true} run={() => { paste(m); }}/>);
    parts.push(<Labelled ic="trash" label="Delete" title="Delete (Del)" enabled={some} run={() => { wipe(m); }}/>);
    parts.push(<Labelled ic="crop" label="Crop" title="Keep only what is selected" enabled={some} run={() => { crop(m); }}/>);
    parts.push(<Labelled ic="select" label="All" title="Select all (Ctrl+A)" enabled={true} run={() => { selectAll(m); }}/>);
    if (some) {
      Rect r = m.floating ? floatRect(m) : m.sel;
      parts.push(<span class="pval">{"\{r.w()} × \{r.h()}"}</span>);
    }
  }
  if (t == "text") {
    parts.push(<span class="plabel">Size</span>);
    parts.push(<input class="prange pshort" type="range" min="1" max="8" step="1" value={"\{m.textScale}"} title="Size ([ and ])"
                      oninput={(ElementEvent e) => {
                        m.textScale = number(e.value, m.textScale);
                        if (m.typing) { drawText(m); flush(m); }
                        keepSettings(m);
                        m.bump();
                      }}/>);
    parts.push(<span class="pval">{"\{16 * m.textScale} px"}</span>);
    parts.push(<button class={m.bold ? "pchip on" : "pchip"} title="Bold"
                       onclick={(ElementEvent e) => {
                         m.bold = !m.bold;
                         if (m.typing) { drawText(m); flush(m); }
                         keepSettings(m);
                         m.bump();
                       }}><b>B</b></button>);
    parts.push(m.typing
      // Drawn empty and never with what is typed, and made again for each place text is put.
      ? <input class="ptextin" ref={field} key={"text \{m.tx},\{m.ty}"} value="" placeholder="Type, then Enter" spellcheck="false" prevent="Enter Escape"
               oninput={(ElementEvent e) => { typed(m, e.value); }}
               onkeydown={(ElementEvent e) => {
                 if (e.value == "Enter") { settle(m, false); }
                 else if (e.value == "Escape") { cancelText(m); }
               }}/>
      : <span class="phint">Click the picture where the text goes</span>);
  }
  if (t == "picker") { parts.push(<span class="phint">Click the picture to take its colour; with Alt, as the second colour</span>); }
  if (t == "brush" || t == "pencil" || t == "line" || t == "rect" || t == "ellipse" || t == "bucket") {
    parts.push(<span class="phint">Alt draws with the second colour</span>);
  }
  return <div class="popts">{parts.toArray()}</div>;
}

/** A colour shown over a checkerboard, so its opacity shows too. */
string chip(i32 c, i32 a) {
  string col = colourCss(c, a);
  return "background:linear-gradient(\{col},\{col}),repeating-conic-gradient(#c8ccd4 0% 25%,#fff 0% 50%) 0 0/8px 8px";
}

string colourCss(i32 c, i32 a) {
  return a == 255 ? hexOf(c, 255) : "rgb(\{red(c)} \{green(c)} \{blue(c)} / \{fixed3((a as f64) / 255.0)})";
}

string fixed3(f64 v) {
  i32 k = (v * 1000.0).round() as~ i32;
  string frac = "\{k % 1000}";
  while (frac.len() < 3) { frac = "0" + frac; }
  return "\{k / 1000}.\{frac}";
}

Node Swatch(Ui ui, Painter m, string colour) {
  i32[] c = parseColour(colour);
  return <button class="pswatch" style={chip(c[0], c[1])} title={colour + " — Shift-click for the second colour"}
                 onclick={(ElementEvent e) => {
                   if ((e.mods & MOD_SHIFT) != 0) { m.bg = c[0]; m.bgA = c[1]; } else { m.fg = c[0]; m.fgA = c[1]; }
                   if (m.typing) { drawText(m); flush(m); }
                   keepSettings(m);
                   m.bump();
                 }}/>;
}

Node Colours(Ui ui, Painter m, i32 rev) {
  string[] ps = palette();
  Vec<Node> swatches = Vec.create();
  for (i32 i = 0; i < ps.len(); i++) { swatches.push(<Swatch m={m} colour={ps[i]}/>); }
  return <div class="pcolours">
    <div class="pwell">
      <button class="pcolor pfg" style={chip(m.fg, m.fgA)} title={"The colour drawn with, " + hexOf(m.fg, m.fgA) + " — click to choose"}
              onclick={(ElementEvent e) => { openPicker(m, "fg"); }}/>
      <button class="pcolor pbg" style={chip(m.bg, m.bgA)} title={"The second colour, " + hexOf(m.bg, m.bgA) + " — click to choose"}
              onclick={(ElementEvent e) => { openPicker(m, "bg"); }}/>
      <button class="pswap" title="Swap the colours (X)" onclick={(ElementEvent e) => { swapColours(m); }}>{icon("swap", "sm")}</button>
    </div>
    <div class="ppalette">{swatches.toArray()}</div>
  </div>;
}

/**
 * **The colour picker**: a square of saturation across and value up for the hue chosen below it, a strip of opacity,
 * the colour as hex to read or type, the colour before and after, the colours lately chosen, and a way to take one
 * from the picture. Every change is the colour at once.
 */
Node Picker(Ui ui, Painter m, i32 rev) {
  Hsv h = m.hsv;
  i32 now = fromHsv(h.h, h.s, h.v);
  string hue = hexOf(fromHsv(h.h, 1.0, 1.0), 255);
  Vec<Node> recent = Vec.create();
  for (i32 i = 0; i < m.recent.len(); i++) {
    string r = m.recent.get(i);
    i32[] c = parseColour(r);
    recent.push(<button class="pswatch" style={chip(c[0], c[1])} title={r}
                        onclick={(ElementEvent e) => {
                          Hsv got = toHsv(c[0]);
                          if (got.s == 0.0 || got.v == 0.0) { got.h = m.hsv.h; }
                          m.hsv = got;
                          m.pickA = c[1];
                          setPicked(m, c[0], c[1], false);
                        }}/>);
  }
  return <div class="ppickshade" onpointerdown={(ElementEvent e) => { }}>
    <div class="ppickaway" onclick={(ElementEvent e) => { closePicker(m); }}/>
    <div class="ppicker">
      <div class="ppickhead"><span>{m.picking == "fg" ? "Colour drawn with" : "Second colour"}</span>
        <button class="pbtn" title="Done (Enter)" onclick={(ElementEvent e) => { closePicker(m); }}>{icon("check", "sm")}</button></div>
      <div class="psv" style={"background-color:" + hue}
           onpointerdown={(ElementEvent e) => { m.svDrag = true; pickAt(m, e.x, e.y); }}
           onpointermove={(ElementEvent e) => { if (m.svDrag) { pickAt(m, e.x, e.y); } }}
           onpointerup={(ElementEvent e) => { m.svDrag = false; m.bump(); }}>
        <span class="psvdot" style={"left:\{fixed3(h.s * SV_W)}px;top:\{fixed3((1.0 - h.v) * SV_H)}px;background:" + hexOf(now, 255)}/>
        {m.svDrag ? <div class="pcover"/> : <span/>}
      </div>
      <input class="phue" type="range" min="0" max="359" step="1" value={"\{h.h.round() as~ i32}"} title="Hue"
             oninput={(ElementEvent e) => { m.hsv.h = number(e.value, 0) as f64; fromPicker(m); }}/>
      <input class="palpha" type="range" min="0" max="255" step="1" value={"\{m.pickA}"} title="Opacity"
             style={"--c:" + hexOf(now, 255)}
             oninput={(ElementEvent e) => { m.pickA = number(e.value, m.pickA); fromPicker(m); }}/>
      <div class="ppickrow">
        <span class="pbefore" title="Before" style={chip(m.openedC, m.openedA)}
              onclick={(ElementEvent e) => {
                pickHex(m, hexOf(m.openedC, m.openedA));
                m.pickShown = m.pickHex;
                m.bump();
              }}/>
        <span class="pafter" title="Now" style={chip(now, m.pickA)}/>
        <input class="phex" value={m.pickShown} spellcheck="false" title="As hex: #rrggbb, or #rrggbbaa with opacity"
               oninput={(ElementEvent e) => { pickHex(m, e.value); }}/>
        <span class="pval">{"\{m.pickA * 100 / 255}%"}</span>
      </div>
      {recent.len() > 0 ? <div class="precent">{recent.toArray()}</div> : <span/>}
      <button class="pchip pact-btn pfrom" title="Click the picture to take a colour from it"
              onclick={(ElementEvent e) => {
                string into = m.picking;
                closePicker(m);
                choose(m, "picker");
                m.pickInto = into;
              }}>{icon("picker", "sm")}<span>From the picture</span></button>
    </div>
  </div>;
}

/** A dialog's width and height fields. */
Node SizeFields(Ui ui, Painter m, i32 rev) {
  return <div class="pfields">
    <span>Width</span><input class="pnum pw" type="number" min="1" max={"\{MOST_SIDE}"} value={m.openedW}
                             oninput={(ElementEvent e) => { m.fieldW = e.value; }}/>
    <span>Height</span><input class="pnum ph" type="number" min="1" max={"\{MOST_SIDE}"} value={m.openedH}
                              oninput={(ElementEvent e) => { m.fieldH = e.value; }}/>
  </div>;
}

/** The width and height typed, when both are sizes a picture can have; otherwise the note says why not. */
i32[] typedSize(Painter m) {
  i32 w = number(m.fieldW, 0);
  i32 h = number(m.fieldH, 0);
  if (w < 1 || h < 1 || w > MOST_SIDE || h > MOST_SIDE || (w as i64) * (h as i64) > MOST_PIXELS as i64) {
    m.note = "A picture is 1 to \{MOST_SIDE} pixels each way, and at most 16 million in all";
    m.bump();
    return i32[]();
  }
  return [w, h];
}

Node Dialog(Ui ui, Painter m, i32 rev) {
  string d = m.dialog;
  fn<void()> close = () => { m.dialog = ""; m.bump(); };
  Node body = <span/>;
  if (d == "new") {
    body = <div class="pcard">
      <h2>New picture</h2>
      <SizeFields m={m} rev={rev}/>
      <div class="pfields"><span>Background</span><span class="pseg">
        <button class={m.fieldClear ? "pchip" : "pchip on"} onclick={(ElementEvent e) => { m.fieldClear = false; m.bump(); }}>Second colour</button>
        <button class={m.fieldClear ? "pchip on" : "pchip"} onclick={(ElementEvent e) => { m.fieldClear = true; m.bump(); }}>Transparent</button>
      </span></div>
      <div class="pact">
        <button class="btn" onclick={(ElementEvent e) => { close(); }}>Cancel</button>
        <button class="btn primary pgo" onclick={(ElementEvent e) => {
          i32[] s = typedSize(m);
          if (s.len() == 0) { return; }
          m.dialog = "";
          bool clear = m.fieldClear;
          unlessUnsaved(m, () => { newPicture(m, s[0], s[1], clear); });
        }}>Create</button>
      </div>
    </div>;
  } else if (d == "size" || d == "scale") {
    bool scaling = d == "scale";
    body = <div class="pcard">
      <h2>{scaling ? "Scale picture" : "Canvas size"}</h2>
      <p class="pfaint">{scaling ? "The picture stretched or shrunk to the new size." : "The picture kept at the top left; new space is the second colour."}</p>
      <SizeFields m={m} rev={rev}/>
      <div class="pact">
        <button class="btn" onclick={(ElementEvent e) => { close(); }}>Cancel</button>
        <button class="btn primary pgo" onclick={(ElementEvent e) => {
          i32[] s = typedSize(m);
          if (s.len() == 0) { return; }
          m.dialog = "";
          whole(m, () => {
            if (scaling) { m.doc.scale(s[0], s[1]); }
            else { m.doc.canvasSize(s[0], s[1], red(m.bg), green(m.bg), blue(m.bg), m.bgA); }
          });
        }}>{scaling ? "Scale" : "Resize"}</button>
      </div>
    </div>;
  } else if (d == "save") {
    body = <div class="pcard">
      <h2>Save picture</h2>
      <p class="pfaint">It is saved on the Desktop, as a PNG.</p>
      <div class="pfields"><span>Name</span><input class="pname" value={m.openedName} autofocus="" prevent="Enter"
        oninput={(ElementEvent e) => { m.fieldName = e.value; }}
        onkeydown={(ElementEvent e) => { if (e.value == "Enter") { saveAs(m, m.fieldName); } }}/></div>
      <div class="pact">
        <button class="btn" onclick={(ElementEvent e) => { close(); }}>Cancel</button>
        <button class="btn primary pgo" onclick={(ElementEvent e) => { saveAs(m, m.fieldName); }}>Save</button>
      </div>
    </div>;
  } else if (d == "discard") {
    body = <div class="pcard">
      <h2>Lose your changes?</h2>
      <p>{m.name} has changes that are not saved.</p>
      <div class="pact">
        <button class="btn" onclick={(ElementEvent e) => { close(); }}>Keep editing</button>
        <button class="btn primary pgo" onclick={(ElementEvent e) => {
          m.dialog = "";
          fn<void()> t = m.then;
          m.then = unseen;
          m.doc.saved();
          t();
          m.bump();
        }}>Lose them</button>
      </div>
    </div>;
  } else if (d == "keys") {
    body = <div class="pcard" onclick={(ElementEvent e) => { close(); }}>
      <h2>Paint</h2>
      <div class="pkeys">
        <span>Tools</span><span><b>S</b>elect, <b>P</b>encil, <b>B</b>rush, <b>E</b>raser, <b>L</b>ine, <b>R</b>ectangle, ellipse (<b>O</b>), <b>F</b>ill, <b>T</b>ext, p<b>I</b>ck a colour</span>
        <span>Size</span><span><b>[</b> and <b>]</b></span>
        <span>Straight, square</span><span>hold <b>Shift</b> while drawing a line, rectangle, ellipse or selection</span>
        <span>Second colour</span><span>hold <b>Alt</b> while drawing; Shift-click a swatch to choose it; <b>X</b> swaps</span>
        <span>Choose a colour</span><span>click the colour drawn with, or the second colour, below</span>
        <span>Select</span><span><b>Ctrl+A</b> all; drag inside to move, with <b>Alt</b> to copy; arrows nudge, with <b>Shift</b> by 10</span>
        <span>Copy, cut, paste</span><span><b>Ctrl+C</b>, <b>Ctrl+X</b>, <b>Ctrl+V</b>; <b>Del</b> clears; <b>Enter</b> puts down</span>
        <span>Undo, redo</span><span><b>Ctrl+Z</b>, and <b>Ctrl+Y</b> or <b>Ctrl+Shift+Z</b></span>
        <span>Zoom</span><span><b>+</b> and <b>−</b>; <b>0</b> fits, <b>1</b> is actual size</span>
        <span>Save, open</span><span><b>Ctrl+S</b>, <b>Ctrl+O</b>, or drop a PNG on the window</span>
        <span>Stop</span><span><b>Esc</b> stops a shape, drops text being typed, and puts a selection down</span>
      </div>
    </div>;
  }
  return <div class="pmodal" onpointerdown={(ElementEvent e) => { }}>{body}</div>;
}

/** A dialog with a width and a height opened on the picture's own. */
void opening(Painter m, Doc d) {
  m.fieldW = "\{d.w}";
  m.fieldH = "\{d.h}";
  m.openedW = m.fieldW;
  m.openedH = m.fieldH;
}

/** A rectangle of the picture as a box over it, in the frame's CSS pixels. */
string boxCss(Rect r, f64 z) {
  return "left:\{fixed3((r.x0 as f64) * z)}px;top:\{fixed3((r.y0 as f64) * z)}px;width:\{fixed3((r.w() as f64) * z)}px;"
         + "height:\{fixed3((r.h() as f64) * z)}px";
}

Node App(Ui ui, Painter m) {
  auto tick = ui.state(0);
  m.bump = () => { tick.set(tick.get() + 1); };
  // **Each part is handed the revision**: a component renders again only when what it is handed changes, and the
  // painter it is handed is always the same one.
  i32 rev = tick.get();
  Ref root = ui.ref();
  Ref cv = ui.ref();
  Ref scroller = ui.ref();
  Ref frame = ui.ref();
  Ref field = ui.ref();
  ui.effect("", () => {
    m.canvas = cv.element();
    m.sentW = 0 - 1;
    flush(m);
    if (scroller.element() is not null) {
      scroller.element()!.on("resize", Listen.none(), (ElementEvent e) => {
        f64 ratio = e.value == "" ? 1.0 : parseRatio(e.value);
        m.viewW = (e.x as f64) / ratio;
        m.viewH = (e.y as f64) / ratio;
        if (m.fitting) { m.zoom = fitZoom(m); }
        m.bump();
      });
    }
    // A stroke whose button was let go outside the window is finished when the pointer leaves it.
    if (frame.element() is not null) {
      frame.element()!.on("pointerleave", Listen.none(), (ElementEvent e) => {
        if (m.down && m.page.now() - m.downAt > 150.0) { released(m); }
      });
    }
    if (root.element() is not null) { root.element()!.focus(); }
    return () => { };
  });
  // Text placed on the picture is typed into the field at once; and once a dialog, the colour picker or the text
  // closes, the keys are the window's again — the field that had them is gone.
  bool idle = !m.typing && m.picking == "" && m.dialog == "";
  ui.effect(m.typing ? "typing \{m.tx},\{m.ty}" : (idle ? "idle" : "open \{m.picking}\{m.dialog}"), () => {
    if (m.typing && field.element() is not null) { field.element()!.focus(); }
    else if (idle && root.element() is not null) { root.element()!.focus(); }
    return () => { };
  });
  Doc d = m.doc;
  f64 z = m.zoom;
  i32 shownW = ((d.w as f64) * z).round() as~ i32;
  i32 shownH = ((d.h as f64) * z).round() as~ i32;
  string pixelated = z >= 2.0 ? "image-rendering:pixelated;" : "";
  string status = m.overX >= 0 ? "\{m.overX}, \{m.overY}" : "";
  string summary = "\{d.w} × \{d.h} · " + percent(z) + (d.modified() ? " · Not saved" : "");
  Tool[] ts = tools();
  Vec<Node> toolButtons = Vec.create();
  for (i32 i = 0; i < ts.len(); i++) { toolButtons.push(<ToolButton m={m} t={ts[i]} rev={rev}/>); }
  Rect box = m.floating ? floatRect(m) : m.sel;
  Node selBox = !box.empty() && m.tool == "select"
    ? <div class={m.floating ? "psel floating" : "psel"} style={boxCss(box, z)}/> : <span/>;
  Node textBox = m.typing ? <div class="ptextbox" style={boxCss(textRect(m), z)}/> : <span/>;
  // What is prevented is decided once, for every field in the window too: copying, cutting, pasting and the arrows
  // are left to do what they do in a field, and do nothing in the browser's way elsewhere.
  return <div class="paint" tabindex="0" ref={root}
              prevent="Ctrl+z Ctrl+y Ctrl+Shift+z Ctrl+s Ctrl+o Ctrl+a Meta+z Meta+y Meta+Shift+z Meta+s Meta+o Meta+a"
              onkeydown={(ElementEvent e) => { onKey(m, e.value, e.mods); }}>
    <div class="ptop">
      <button class="btn pnew" title="New picture" onclick={(ElementEvent e) => {
        opening(m, d);
        m.dialog = "new";
        m.bump();
      }}>{icon("plus", "sm")}<span class="label">New</span></button>
      <button class="btn popen" title="Open a PNG (Ctrl+O)" onclick={(ElementEvent e) => { unlessUnsaved(m, () => { pickAndOpen(m); }); }}>{icon("open", "sm")}<span class="label">Open</span></button>
      <button class="btn psave" title="Save (Ctrl+S)" onclick={(ElementEvent e) => { save(m); }}>{icon(m.desk is null ? "download" : "save", "sm")}<span class="label">{m.desk is null ? "Download" : "Save"}</span></button>
      <span class="psep"/>
      <Action ic="undo" title="Undo (Ctrl+Z)" enabled={d.canUndo() || d.active} run={() => { undo(m); }}/>
      <Action ic="redo" title="Redo (Ctrl+Y)" enabled={d.canRedo()} run={() => { redo(m); }}/>
      <span class="psep"/>
      <Action ic="fliph" title="Flip left to right" enabled={true} run={() => { whole(m, () => { m.doc.flip(true); }); }}/>
      <Action ic="flipv" title="Flip top to bottom" enabled={true} run={() => { whole(m, () => { m.doc.flip(false); }); }}/>
      <Action ic="turn" title="Turn a quarter clockwise" enabled={true} run={() => { whole(m, () => { m.doc.turn(true); }); }}/>
      <Action ic="resize" title="Canvas size" enabled={true} run={() => { opening(m, d); m.dialog = "size"; m.bump(); }}/>
      <Action ic="scale" title="Scale picture" enabled={true} run={() => { opening(m, d); m.dialog = "scale"; m.bump(); }}/>
      <span class="pgrow"/>
      <Action ic="min" title="Zoom out (−)" enabled={true} run={() => { zoomStep(m, 0 - 1); }}/>
      <button class="pzoom" title="Fit the window (0); actual size is 1" onclick={(ElementEvent e) => {
        if (m.fitting) { m.zoom = 1.0; m.fitting = false; m.bump(); } else { fit(m); }
      }}>{percent(z)}</button>
      <Action ic="plus" title="Zoom in (+)" enabled={true} run={() => { zoomStep(m, 1); }}/>
      <button class="pbtn" title="Keys (?)" onclick={(ElementEvent e) => { m.dialog = "keys"; m.bump(); }}>?</button>
    </div>
    <Options m={m} rev={rev} field={field}/>
    <div class="pbody">
      <div class="ptools">{toolButtons.toArray()}</div>
      <div class="pscroll" ref={scroller}>
        <div class="pstage">
          <div class={"pframe t-" + m.tool} ref={frame} style={"width:\{shownW}px;height:\{shownH}px"}
               onpointerdown={(ElementEvent e) => {
                 if (!m.typing && root.element() is not null) { root.element()!.focus(); }
                 pressed(m, (e.x as f64) / m.zoom, (e.y as f64) / m.zoom, e.mods, m.page.now());
               }}
               onpointermove={(ElementEvent e) => { dragged(m, (e.x as f64) / m.zoom, (e.y as f64) / m.zoom, e.mods); }}
               onpointerup={(ElementEvent e) => { released(m); }}>
            <canvas class="pcanvas" ref={cv} style={pixelated}/>
            {selBox}
            {textBox}
            {m.down ? <div class="pcover"/> : <span/>}
          </div>
        </div>
      </div>
    </div>
    <div class="pbottom">
      <Colours m={m} rev={rev}/>
      <div class="pstatus">
        <span class="pnote">{m.note}</span>
        <span class="ppos">{status}</span>
        <span class="psum">{summary}</span>
      </div>
    </div>
    {m.picking != "" ? <Picker m={m} rev={rev}/> : <span/>}
    {m.dialog != "" ? <Dialog m={m} rev={rev}/> : <span/>}
  </div>;
}

/** The device's pixels to a CSS pixel, as `resize` says it: a decimal such as `1` or `1.25`. */
f64 parseRatio(string s) {
  u8[] b = s.toBytes();
  f64 v = 0.0;
  f64 scale = 0.0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '.') {
      if (scale > 0.0) { return 1.0; }
      scale = 1.0;
    } else if (b[i] >= '0' && b[i] <= '9') {
      v = v * 10.0 + (((b[i] - '0') as i32) as f64);
      if (scale > 0.0) { scale = scale * 10.0; }
    } else {
      return 1.0;
    }
  }
  if (scale > 0.0) { v = v / scale; }
  return v > 0.0 ? v : 1.0;
}

export async i32 main(Page page) {
  Painter m = create(page, Doc.blank(800, 600, 255, 255, 255, 255));
  auto kept = await page.sys.files().readFile(KEPT);
  if (kept.isOk()) {
    restore(m, string.fromBytes(kept.ok()!));
    m.written = settingsText(m);
  }
  match (await Desktop.of(page.sys)) {
    Ok(d): { m.desk = d; }
    Err(why): { }
  }
  string[] args = page.sys.args();
  if (args.len() > 0 && args[0] != "") {
    m.path = args[0];
    m.name = leafOf(args[0]);
    match (await page.sys.files().readFile(args[0])) {
      Ok(bytes): {
        match (decodePng(bytes)) {
          Ok(p): { m.doc = Doc.of(p); }
          Err(why): {
            m.note = "Could not open \{m.name}: \{why}";
            m.path = "";
            m.name = "Untitled.png";
          }
        }
      }
      Err(why): {
        m.note = "Could not read \{m.name}: \{why}";
        m.path = "";
        m.name = "Untitled.png";
      }
    }
  }
  retitle(m);
  receive(m);
  page.mount((Ui ui) => <div class="paintpage"><style>{css() + paintCss()}</style><App m={m}/></div>);
  return 0;
}
