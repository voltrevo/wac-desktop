// Numbers as people read and write them — a decimal read, and written with commas, to so many places, or as a power
// of ten — for the desktop's apps.
//
// **Not the functions of a real number**, which are core's: `import { math } from "core"` for `math.log`, `math.exp`
// and `math.pow`, and a float's own `sqrt` and `abs`. This file had its own until core did (wac `9ccf257c7`).

/** A decimal as a person or a browser writes one — `-0.25`, `3`, `1.5e-7` — or `fallback` when `s` is not one. */
export f64 parseNumber(string s, f64 fallback) {
  u8[] b = s.toBytes();
  i32 i = 0;
  bool neg = false;
  if (i < b.len() && (b[i] == '-' || b[i] == '+')) {
    neg = b[i] == '-';
    i++;
  }
  f64 v = 0.0;
  i32 digits = 0;
  while (i < b.len() && b[i] >= '0' && b[i] <= '9') {
    v = v * 10.0 + ((b[i] - '0') as f64);
    digits++;
    i++;
  }
  if (i < b.len() && b[i] == '.') {
    i++;
    f64 place = 0.1;
    while (i < b.len() && b[i] >= '0' && b[i] <= '9') {
      v = v + ((b[i] - '0') as f64) * place;
      place = place / 10.0;
      digits++;
      i++;
    }
  }
  if (digits == 0) { return fallback; }
  if (i < b.len() && (b[i] == 'e' || b[i] == 'E')) {
    i++;
    bool eneg = false;
    if (i < b.len() && (b[i] == '-' || b[i] == '+')) {
      eneg = b[i] == '-';
      i++;
    }
    i32 e = 0;
    while (i < b.len() && b[i] >= '0' && b[i] <= '9') {
      e = e * 10 + ((b[i] - '0') as i32);
      i++;
    }
    for (i32 k = 0; k < e && k < 400; k++) { v = eneg ? v / 10.0 : v * 10.0; }
  }
  if (i != b.len()) { return fallback; }
  return neg ? 0.0 - v : v;
}

/** A whole number with its thousands marked: `1,234,567`. */
export string commas(i64 n) {
  if (n < 0 as i64) { return "-" + commas((0 as i64) - n); }
  string digits = "\{n}";
  string out = "";
  for (i32 i = 0; i < digits.len(); i++) {
    if (i > 0 && (digits.len() - i) % 3 == 0) { out = out + ","; }
    out = out + digits.slice(i, i + 1);
  }
  return out;
}

/** `x` to `places` decimal places: `fixed(3.14159, 2)` is `3.14`. */
export string fixed(f64 x, i32 places) {
  if (x != x) { return "NaN"; }
  if (x < 0.0) {
    string rest = fixed(0.0 - x, places);
    bool zero = true;
    u8[] rb = rest.toBytes();
    for (i32 i = 0; i < rb.len(); i++) { if (rb[i] >= '1' && rb[i] <= '9') { zero = false; } }
    return zero ? rest : "-" + rest;
  }
  f64 scale = 1.0;
  for (i32 k = 0; k < places; k++) { scale = scale * 10.0; }
  i64 n = (x * scale).round() as~ i64;
  if (places == 0) { return "\{n}"; }
  i64 unit = scale as~ i64;
  string frac = "\{n % unit}";
  while (frac.len() < places) { frac = "0" + frac; }
  return "\{n / unit}.\{frac}";
}

/** A magnitude as a person reads it: `850`, `12,400`, then `3.2 × 10^7` once it is long. */
export string magnitude(f64 x) {
  if (x < 1000000.0) { return x < 10.0 ? fixed(x, 1) : commas(x.round() as~ i64); }
  i32 e = 0;
  f64 m = x;
  while (m >= 10.0) {
    m = m / 10.0;
    e++;
  }
  return "\{fixed(m, 1)} × 10^\{e}";
}
