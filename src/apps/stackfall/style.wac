/** A quiet violet workbench, with its own palette and no styles reaching out of the app's shadow root. */
export string stackfallCss() {
  return """
    :host { display:block; height:100%; }
    * { box-sizing:border-box; }
    .sf { height:100%; overflow:auto; outline:0; padding:22px; background:#151524; color:#f0edf8;
      font:13px/1.4 system-ui,sans-serif; user-select:none; -webkit-user-select:none;
      display:flex; flex-direction:column; gap:16px; }
    .sf-head { display:flex; justify-content:space-between; align-items:center; gap:12px; }
    .sf h1 { margin:0; font-size:25px; font-weight:700; letter-spacing:-1px; }
    .sf p { margin:3px 0 0; color:#a6a2b8; font-size:12px; }
    .sf-tag { color:#c7b7ff; border:1px solid #4c3e70; border-radius:20px; padding:5px 9px; font-size:9px; letter-spacing:1.5px; }
    .sf-main { display:flex; gap:22px; flex:1; min-height:340px; container-type:size; max-height:600px; justify-content:center; }
    .sf-well { position:relative; width:min(calc(100cqw - 130px), calc(100cqh / 2)); height:auto; aspect-ratio:1/2; align-self:flex-start; flex-shrink:0;
      border:1px solid #464059; border-radius:8px; overflow:hidden; background:#0d0d18;
      box-shadow:0 12px 36px #0004; }
    .sf-board { display:grid; grid-template-columns:repeat(10,1fr); grid-template-rows:repeat(20,1fr); height:100%; padding:3px; gap:1px; }
    .sf-cell { display:block; min-width:0; min-height:0; border-radius:2px; border:1px solid #ffffff22;
      box-shadow:inset 0 2px 0 #ffffff22, inset 0 -2px 0 #0002; }
    .sf-empty { background:#181725; border-color:#201e30; box-shadow:none; }
    .sf-ghost { background:#bfa2ff10; border:1px dashed #bfa2ff88; box-shadow:none; }
    .sf-p0 { background:#a78bfa; } .sf-p1 { background:#edb85c; } .sf-p2 { background:#d67dba; }
    .sf-p3 { background:#7db394; } .sf-p4 { background:#da8475; } .sf-p5 { background:#719cce; } .sf-p6 { background:#8cc6c0; }
    .sf-side { display:flex; flex-direction:column; gap:16px; width:108px; flex-shrink:0; padding-top:5px; }
    .sf-stat { display:flex; flex-direction:column; gap:4px; }
    .sf-stat > span { color:#a6a2b8; font-size:9px; letter-spacing:1.5px; font-weight:650; }
    .sf-stat b { font-size:20px; font-weight:550; font-variant-numeric:tabular-nums; }
    .sf-stat .sf-score { font-size:30px; letter-spacing:-1px; }
    .sf-stat .sf-best { color:#c2adef; font-size:18px; }
    .sf-pair { display:flex; gap:25px; }
    .sf-preview { display:grid; grid-template-columns:repeat(4,18px); grid-template-rows:repeat(2,18px); gap:2px; margin-top:3px; }
    .sf-preview .sf-empty { background:none; border-color:transparent; }
    .sf-overlay { position:absolute; inset:0; background:#10101bea; display:flex; flex-direction:column;
      justify-content:center; align-items:center; text-align:center; padding:15px; }
    .sf-eyebrow { font-size:9px; letter-spacing:2px; color:#bda8ee; }
    .sf-message { font-size:21px; font-weight:650; letter-spacing:-.5px; margin:12px 0 4px; }
    .sf-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .sf button { border:1px solid #484058; border-radius:6px; padding:9px 14px; cursor:pointer; color:#e7def5;
      background:#292435; font:600 12px system-ui; }
    .sf button:hover { background:#393046; }
    .sf button:focus-visible { outline:2px solid #bd9ff3; outline-offset:2px; }
    .sf button.sf-primary { color:#21172e; background:#c3a6ef; border-color:#c3a6ef; min-width:72px; }
    .sf button:disabled { opacity:.4; cursor:default; }
    .sf-save { margin-left:auto; font-size:10px; color:#888397; }
    .sf-help { display:flex; gap:5px 15px; flex-wrap:wrap; color:#a6a2b8; font-size:10px; padding-top:10px; border-top:1px solid #302b3e; }
    @media(max-width:480px) { .sf { padding:14px; gap:12px; } .sf-main { gap:14px; } }
  """;
}
