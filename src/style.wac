// The look: one stylesheet, and the icons as SVG `data:` URLs.
//
// **Icons are masks, not images.** Each is a shape in a `data:` URL used as a CSS `mask-image`, and
// the colour is the element's `background-color` — so one icon serves both themes and any accent,
// and the page's Content Security Policy (`img-src data:`) is all it needs. wac's tag set has no SVG
// elements to draw them inline.

/** An icon's shape, as the `url(…)` a mask takes. `#` is the one character a data URL must escape. */
string svg(string body) {
  return "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'>" + body + "</svg>\")";
}

string icons() {
  return
    ".i-folder { --i: " + svg("<path fill='black' stroke='none' d='M2.5 6.6c0-1 .8-1.8 1.8-1.8h4.6c.5 0 1 .2 1.3.6l1.3 1.4h8.2c1 0 1.8.8 1.8 1.8v9.6c0 1-.8 1.8-1.8 1.8H4.3c-1 0-1.8-.8-1.8-1.8z'/>") + "; }" +
    ".i-file { --i: " + svg("<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7z'/><path d='M14 3v4h4'/>") + "; }" +
    ".i-text { --i: " + svg("<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7z'/><path d='M14 3v4h4M9 12h6M9 15.5h6M9 8.5h2'/>") + "; }" +
    ".i-code { --i: " + svg("<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7z'/><path d='M14 3v4h4M10.5 11.5 8.8 13.6l1.7 2.1M13.5 11.5l1.7 2.1-1.7 2.1'/>") + "; }" +
    ".i-image { --i: " + svg("<rect x='3.5' y='4.5' width='17' height='15' rx='2'/><circle cx='9' cy='9.5' r='1.6'/><path d='m20.5 15.5-4.6-4.4-9.4 8.4'/>") + "; }" +
    ".i-archive { --i: " + svg("<rect x='4' y='3' width='16' height='18' rx='2'/><path d='M12 3v2m0 2v2m0 2v2'/><rect x='10.4' y='13' width='3.2' height='4' rx='1'/>") + "; }" +
    ".i-binary { --i: " + svg("<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7z'/><path d='M14 3v4h4'/><rect x='8.6' y='11' width='2.4' height='3.6' rx='1.2'/><path d='M14 11v3.6M9.8 16.8v1.2M14 16.8v1.2'/>") + "; }" +
    ".i-link { --i: " + svg("<path d='M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1'/><path d='M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1'/>") + "; }" +
    ".i-up { --i: " + svg("<path d='M12 19V5M6 11l6-6 6 6'/>") + "; }" +
    ".i-chev { --i: " + svg("<path d='m9.5 6 6 6-6 6'/>") + "; }" +
    ".i-download { --i: " + svg("<path d='M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14'/>") + "; }" +
    ".i-upload { --i: " + svg("<path d='M12 15V4M7.5 8.5 12 4l4.5 4.5M5 19.5h14'/>") + "; }" +
    ".i-close { --i: " + svg("<path d='M6 6l12 12M18 6 6 18'/>") + "; }" +
    ".i-search { --i: " + svg("<circle cx='11' cy='11' r='6.5'/><path d='m20 20-4.4-4.4'/>") + "; }" +
    ".i-open { --i: " + svg("<path d='M4 7.5V6.3c0-1 .8-1.8 1.8-1.8h3.6l2 2h6.8c1 0 1.8.8 1.8 1.8v1.2'/><path d='M3.2 10.5h17.6l-1.6 8H4.8z'/>") + "; }" +
    ".i-check { --i: " + svg("<path d='m5 12.5 4.5 4.5L19 7.5'/>") + "; }" +
    ".i-alert { --i: " + svg("<path d='M12 4 2.8 19.5h18.4z'/><path d='M12 10v4M12 17v.01'/>") + "; }" +
    ".i-lock { --i: " + svg("<rect x='5' y='10.5' width='14' height='9.5' rx='2'/><path d='M8 10.5V8a4 4 0 0 1 8 0v2.5'/>") + "; }" +
    ".i-shield { --i: " + svg("<path d='M12 3 5 6v5.5c0 4.3 3 7.7 7 9.5 4-1.8 7-5.2 7-9.5V6z'/><path d='m9 12 2.2 2.2L15.5 10'/>") + "; }" +
    ".i-terminal { --i: " + svg("<rect x='3' y='4.5' width='18' height='15' rx='2.5'/><path d='m7 9.5 3 2.5-3 2.5M12.5 15h4.5'/>") + "; }" +
        ".i-home { --i: " + svg("<path d='M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-6H9v6H5.5A1.5 1.5 0 0 1 4 19z'/>") + "; }" +
    ".i-edit { --i: " + svg("<path d='M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z'/><path d='m14 8 3 3'/>") + "; }" +
    ".i-rename { --i: " + svg("<path d='M4 7.5h11M4 16.5h7'/><path d='M18 5v14M16 5h4M16 19h4'/>") + "; }" +
    ".i-trash { --i: " + svg("<path d='M4.5 7h15M10 7V5h4v2M6.5 7l1 12.5h9l1-12.5'/><path d='M10.5 11v5M13.5 11v5'/>") + "; }" +
    ".i-plus { --i: " + svg("<path d='M12 5v14M5 12h14'/>") + "; }" +
    ".i-save { --i: " + svg("<path d='M5 4h11l3 3v12.5A.5.5 0 0 1 18.5 20h-13a.5.5 0 0 1-.5-.5z'/><path d='M8 4v5h7V4M8 20v-6h8v6'/>") + "; }" +
    ".i-min { --i: " + svg("<path d='M6 12h12'/>") + "; }" +
    ".i-max { --i: " + svg("<rect x='5.5' y='5.5' width='13' height='13' rx='1.5'/>") + "; }" +
    ".i-restore { --i: " + svg("<rect x='5' y='8.5' width='10.5' height='10.5' rx='1.5'/><path d='M8.5 8.5V6.5A1.5 1.5 0 0 1 10 5h7.5A1.5 1.5 0 0 1 19 6.5V14a1.5 1.5 0 0 1-1.5 1.5h-2'/>") + "; }" +
    ".i-grid { --i: " + svg("<rect x='4' y='4' width='6.5' height='6.5' rx='1.6'/><rect x='13.5' y='4' width='6.5' height='6.5' rx='1.6'/><rect x='4' y='13.5' width='6.5' height='6.5' rx='1.6'/><rect x='13.5' y='13.5' width='6.5' height='6.5' rx='1.6'/>") + "; }" +
    ".i-layers { --i: " + svg("<path d='m12 3 9 5-9 5-9-5z'/><path d='m3 12.5 9 5 9-5'/><path d='m3 16.5 9 5 9-5'/>") + "; }";
}

/** The whole stylesheet. Tokens first, so the dark theme is a second set of the same names. */
export string css() {
  return """
    :root {
      --bg: #f5f6f8; --bg-grad: #eceefe;
      --surface: #ffffff; --surface-2: #f9fafb; --sunken: #f1f3f6;
      --line: #e6e8ee; --line-strong: #d6d9e1;
      --text: #121826; --muted: #616a7d; --faint: #9aa1b1;
      --accent: #5b55e6; --accent-2: #8b5cf6; --accent-soft: #ecebfd; --accent-ink: #ffffff;
      --sel: #eeedfd; --hover: #f4f5f8;
      --folder: #f0a33a; --archive: #8b5cf6; --image: #e64a8f; --text-ic: #4a7cf0; --code: #12a383; --binary: #8a93a6;
      --ok: #16a34a; --bad: #dc2626; --warn: #d97706;
      --shadow: 0 1px 2px rgb(16 24 40 / .05), 0 8px 24px -6px rgb(16 24 40 / .08);
      --shadow-lg: 0 24px 64px -20px rgb(44 40 120 / .28), 0 2px 6px rgb(16 24 40 / .05);
      --checker: #eef0f4;
      --tk-k: #8b3fd9; --tk-s: #0f7b4a; --tk-c: #8a93a3; --tk-n: #c2410c; --tk-f: #2457c5; --tk-t: #0e7490;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0c0e13; --bg-grad: #17163a;
        --surface: #13161d; --surface-2: #171a22; --sunken: #0f1117;
        --line: #232733; --line-strong: #2f3443;
        --text: #e7e9f0; --muted: #949bad; --faint: #646b7c;
        --accent: #8d88ff; --accent-2: #b28bff; --accent-soft: #24224a; --accent-ink: #0c0e13;
        --sel: #22213f; --hover: #1a1d26;
        --folder: #f5b454; --archive: #a98bff; --image: #f472b6; --text-ic: #7aa2ff; --code: #34d3a6; --binary: #8a93a6;
        --ok: #4ade80; --bad: #f87171; --warn: #fbbf24;
        --shadow: 0 1px 2px rgb(0 0 0 / .4), 0 8px 24px -6px rgb(0 0 0 / .5);
        --shadow-lg: 0 24px 64px -20px rgb(0 0 0 / .7), 0 2px 6px rgb(0 0 0 / .4);
        --checker: #1b1e27;
        --tk-k: #c792ea; --tk-s: #a5d6a7; --tk-c: #6b7385; --tk-n: #f7a76c; --tk-f: #82aaff; --tk-t: #7fdbca;
        color-scheme: dark;
      }
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body {
      background: var(--bg); color: var(--text);
      font: 14px/1.45 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      -webkit-font-smoothing: antialiased; font-feature-settings: "cv11", "ss01";
    }
    #app, #app > div { height: 100%; }
    button, input { font: inherit; color: inherit; }
    .mono { font-family: ui-monospace, "SF Mono", "JetBrains Mono", "Cascadia Code", Menlo, Consolas, monospace; }
    .num { font-variant-numeric: tabular-nums; }
    .hidden { display: none; }

    .ic { display: inline-block; flex: none; width: 18px; height: 18px; background-color: currentColor;
          -webkit-mask: var(--i) center / contain no-repeat; mask: var(--i) center / contain no-repeat; }
    .ic.sm { width: 15px; height: 15px; }
    .ic.lg { width: 22px; height: 22px; }
    .c-folder { color: var(--folder); } .c-archive { color: var(--archive); } .c-image { color: var(--image); }
    .c-text { color: var(--text-ic); } .c-terminal { color: var(--text); } .c-code { color: var(--code); } .c-binary, .c-link { color: var(--binary); }

    .btn { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 13px; border-radius: 9px;
           border: 1px solid var(--line-strong); background: var(--surface); cursor: pointer; font-weight: 550;
           font-size: 13px; white-space: nowrap; transition: background .15s, border-color .15s, box-shadow .15s, transform .05s; }
    .btn:hover { background: var(--hover); border-color: var(--faint); }
    .btn:active { transform: translateY(1px); }
    .btn.primary { background: linear-gradient(180deg, var(--accent), color-mix(in oklab, var(--accent) 86%, black));
                   color: var(--accent-ink); border-color: transparent;
                   box-shadow: 0 1px 0 rgb(255 255 255 / .18) inset, 0 6px 16px -6px color-mix(in oklab, var(--accent) 70%, transparent); }
    .btn.primary:hover { filter: brightness(1.06); }
    .btn.ghost { border-color: transparent; background: transparent; color: var(--muted); }
    .btn.ghost:hover { background: var(--hover); color: var(--text); }
    .btn.icon { width: 34px; padding: 0; justify-content: center; }
    .btn.big { height: 44px; padding: 0 20px; font-size: 14.5px; border-radius: 11px; }

    /* ── landing ─────────────────────────────────────────────────────────── */
    .landing { height: 100%; display: grid; place-items: center; padding: 24px 16px; overflow: auto;
               background: radial-gradient(1200px 600px at 50% -10%, var(--bg-grad), transparent 70%), var(--bg); }
    .hero { width: min(600px, 100%); text-align: center; animation: rise .5s cubic-bezier(.2,.8,.2,1) both; }
    .drop { position: relative; margin-top: 30px; padding: 44px 28px 36px; border-radius: 22px; background: var(--surface);
            border: 1.5px dashed var(--line-strong); box-shadow: var(--shadow-lg); }
    .drop::before { content: ""; position: absolute; inset: -1px; border-radius: 22px; pointer-events: none;
                    background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 14%, transparent), transparent 40%); }
    .mark { width: 76px; height: 76px; margin: 0 auto 22px; border-radius: 22px; display: grid; place-items: center;
            color: white; background: linear-gradient(140deg, var(--accent), var(--accent-2));
            box-shadow: 0 14px 30px -10px color-mix(in oklab, var(--accent) 80%, transparent), 0 1px 0 rgb(255 255 255 / .3) inset; }
    .mark .ic { width: 38px; height: 38px; }
    .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; letter-spacing: -.01em; color: var(--muted); font-size: 13px;
             padding: 5px 12px 5px 8px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); }
    .brand .dot { width: 8px; height: 8px; border-radius: 99px; background: linear-gradient(140deg, var(--accent), var(--accent-2)); }
    h1.title { font-size: clamp(28px, 5vw, 40px); line-height: 1.1; letter-spacing: -.035em; margin: 18px 0 10px; font-weight: 720; }
    h1.title em { font-style: normal; background: linear-gradient(120deg, var(--accent), var(--accent-2));
                  -webkit-background-clip: text; background-clip: text; color: transparent; }
    .lede { color: var(--muted); font-size: 15.5px; margin: 0 auto; max-width: 440px; }
    .drop h2 { margin: 0 0 6px; font-size: 18px; letter-spacing: -.015em; }
    .drop p { margin: 0 0 22px; color: var(--muted); }
    .pick { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 26px; }
    .chip { font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--muted); padding: 4px 10px; border-radius: 99px;
            background: var(--sunken); border: 1px solid var(--line); }
    .fine { margin-top: 22px; color: var(--faint); font-size: 12.5px; }
    .fine .ic { vertical-align: -3px; margin-right: 6px; }
    .error { margin: 18px auto 0; max-width: 460px; display: flex; gap: 10px; align-items: flex-start; text-align: left;
             padding: 12px 14px; border-radius: 12px; color: var(--bad);
             background: color-mix(in oklab, var(--bad) 9%, var(--surface)); border: 1px solid color-mix(in oklab, var(--bad) 30%, transparent); }
    .error > span:nth-child(2) { color: var(--text); flex: 1; }
    .error .btn { flex: none; align-self: center; }
    .error .btn .label { display: inline; }
    .error .btn { width: auto; padding: 0 13px; }

    /* ── explorer ────────────────────────────────────────────────────────── */
    .shell { height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); }
    .top { display: flex; align-items: center; gap: 12px; padding: 10px 16px; min-height: 58px;
           background: color-mix(in oklab, var(--surface) 82%, transparent); backdrop-filter: blur(12px);
           border-bottom: 1px solid var(--line); position: relative; z-index: 2; }
    .logo { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; color: white; flex: none;
            background: linear-gradient(140deg, var(--accent), var(--accent-2)); box-shadow: 0 4px 12px -4px color-mix(in oklab, var(--accent) 80%, transparent); }
    .crumbs { display: flex; align-items: center; gap: 2px; min-width: 0; flex: 1; overflow-x: auto; scrollbar-width: none; }
    .crumb { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 7px; border: 0; background: none;
             cursor: pointer; color: var(--muted); font-weight: 550; white-space: nowrap; max-width: 260px; }
    .crumb span.t { overflow: hidden; text-overflow: ellipsis; }
    .crumb:hover { background: var(--hover); color: var(--text); }
    .crumb.here { color: var(--text); font-weight: 650; cursor: default; }
    .crumb.here:hover { background: none; }
    .crumb.level { color: var(--text); }
    .sep { color: var(--faint); }
    .actions { display: flex; gap: 6px; align-items: center; }

    .main { min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 44%); }
    .pane { min-height: 0; min-width: 0; display: flex; flex-direction: column; }
    .pane.list { border-right: 1px solid var(--line); background: var(--surface); }
    .toolbar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    .search { flex: 1; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; border-radius: 9px;
              background: var(--sunken); border: 1px solid var(--line); color: var(--faint); transition: border-color .15s, box-shadow .15s; }
    .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); color: var(--accent); }
    .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); }
    .search input::placeholder { color: var(--faint); }
    .stats { display: flex; gap: 14px; align-items: center; color: var(--muted); font-size: 12.5px; white-space: nowrap; }
    .stats b { color: var(--text); font-weight: 600; }

    .thead, .row { display: grid; grid-template-columns: minmax(0, 1fr) 84px 108px 128px; align-items: center; gap: 12px; padding: 0 16px; }
    .thead { height: 34px; font-size: 11.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--faint);
             border-bottom: 1px solid var(--line); background: var(--surface-2); }
    .thead button { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; }
    .thead button:hover { color: var(--text); }
    .thead .on { color: var(--accent); }
    .thead .r, .row .r { text-align: right; justify-content: flex-end; }
    .plain .thead, .plain .row { grid-template-columns: minmax(0, 1fr) 96px; }
    .plain .thead > :nth-child(n+3), .plain .row > :nth-child(n+3) { display: none; }
    .rows { flex: 1; overflow: auto; outline: none; padding: 6px 8px 24px; }
    .row { height: 38px; border-radius: 9px; cursor: default; padding: 0 8px; position: relative; color: var(--text);
           transition: background .12s; }
    .row:hover { background: var(--hover); }
    .row.sel { background: var(--sel); }
    .row.cursor { box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent) 55%, transparent); }
    .rows:not(:focus-within) .row.cursor:not(.sel) { box-shadow: none; }
    .row .name { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .row .name .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row .name .sub { color: var(--faint); font-size: 12px; margin-left: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .dim { color: var(--muted); font-size: 12.5px; white-space: nowrap; }
    .row .badge { font-size: 10.5px; font-weight: 700; letter-spacing: .04em; padding: 2px 6px; border-radius: 5px; text-transform: uppercase;
                  color: var(--archive); background: color-mix(in oklab, var(--archive) 13%, transparent); flex: none; }
    .ratio { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
    .bar { width: 46px; height: 5px; border-radius: 9px; background: var(--sunken); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
    .bar i { display: block; height: 100%; border-radius: 9px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
    .more { margin: 10px 8px; }
    .empty { padding: 48px 16px; text-align: center; color: var(--muted); }

    /* ── preview ─────────────────────────────────────────────────────────── */
    .pane.preview { background: var(--bg); }
    .phead { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: var(--surface); }
    .tile { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; flex: none;
            background: color-mix(in oklab, currentColor 12%, var(--surface)); }
    .phead .who { min-width: 0; flex: 1; }
    .phead .nm { font-weight: 650; font-size: 15px; letter-spacing: -.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .phead .meta { color: var(--muted); font-size: 12.5px; }
    .tabs { display: flex; gap: 4px; padding: 10px 18px 0; border-bottom: 1px solid var(--line); background: var(--surface); }
    .tab { border: 0; background: none; padding: 8px 12px 10px; cursor: pointer; color: var(--muted); font-weight: 600; font-size: 13px;
           border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .tab:hover { color: var(--text); }
    .tab.on { color: var(--accent); border-bottom-color: var(--accent); }
    .pbody { flex: 1; min-height: 0; overflow: auto; }
    .note { margin: 12px 18px 0; padding: 9px 12px; border-radius: 9px; font-size: 12.5px; color: var(--muted);
            background: var(--surface); border: 1px solid var(--line); display: flex; gap: 8px; align-items: center; }

    .pbody > div:has(> .code), .pbody > .anim:has(> .hex) { background: var(--surface); min-height: 100%; }
    .code { display: grid; grid-template-columns: auto 1fr; min-width: min-content; font-size: 12.5px; line-height: 1.6; }
    .code pre { margin: 0; padding: 14px 0; }
    .code .gut { padding: 14px 12px 14px 18px; text-align: right; color: var(--faint); user-select: none; border-right: 1px solid var(--line);
                 background: var(--surface-2); position: sticky; left: 0; }
    .code .src { padding: 14px 18px; white-space: pre; tab-size: 4; }

    .hex { padding: 14px 18px; font-size: 12.5px; line-height: 1.7; white-space: pre; }
    .hex .o { color: var(--faint); } .hex .h { color: var(--text); } .hex .a { color: var(--muted); }
    .hexrow { display: flex; gap: 18px; }

    .imgwrap { min-height: 100%; display: grid; place-items: center; padding: 28px;
               background-color: var(--surface);
               background-image: linear-gradient(45deg, var(--checker) 25%, transparent 25%), linear-gradient(-45deg, var(--checker) 25%, transparent 25%),
                                 linear-gradient(45deg, transparent 75%, var(--checker) 75%), linear-gradient(-45deg, transparent 75%, var(--checker) 75%);
               background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0; }
    .imgwrap img { max-width: 100%; max-height: 70vh; border-radius: 6px; box-shadow: var(--shadow-lg); image-rendering: auto; }

    .info { padding: 18px; display: grid; gap: 14px; }
    .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
    .kv { display: grid; grid-template-columns: 120px minmax(0, 1fr); }
    .kv > div { padding: 11px 14px; font-size: 13.5px; line-height: 1.5; border-top: 1px solid var(--line); min-width: 0; overflow-wrap: anywhere; }
    .kv > div:nth-child(-n+2) { border-top: 0; }
    .kv .k { color: var(--muted); font-size: 12.5px; line-height: 1.62; }
    .okay { color: var(--ok); display: inline-flex; gap: 6px; align-items: center; font-weight: 600; }
    .bad { color: var(--bad); display: inline-flex; gap: 6px; align-items: center; font-weight: 600; }
    .digest { font-size: 12px; color: var(--muted); }

    .nested { margin: auto; text-align: center; padding: 48px 24px; max-width: 420px; }
    .nested .tile { width: 72px; height: 72px; border-radius: 20px; margin: 0 auto 16px; }
    .nested .tile .ic { width: 34px; height: 34px; }
    .nested h3 { margin: 0 0 6px; font-size: 18px; letter-spacing: -.015em; }
    .nested p { margin: 0 0 20px; color: var(--muted); }
    .placeholder { height: 100%; display: grid; place-items: center; color: var(--faint); text-align: center; padding: 24px; }
    .placeholder .ic { width: 40px; height: 40px; margin-bottom: 10px; opacity: .6; }

    .busy { position: fixed; inset: 0; display: grid; place-items: center; z-index: 10;
            background: color-mix(in oklab, var(--bg) 55%, transparent); backdrop-filter: blur(3px); animation: fade .2s both; }
    .busy .card { padding: 18px 22px; display: flex; gap: 14px; align-items: center; }
    .spin { width: 20px; height: 20px; border-radius: 99px; border: 2.5px solid var(--accent-soft); border-top-color: var(--accent); animation: spin .8s linear infinite; }

    /* ── code ── */
    .tk-k { color: var(--tk-k); } .tk-s { color: var(--tk-s); } .tk-n { color: var(--tk-n); }
    .tk-c { color: var(--tk-c); font-style: italic; } .tk-f { color: var(--tk-f); } .tk-t { color: var(--tk-t); }

    /* ── markdown ── */
    .md { max-width: 760px; margin: 0 auto; padding: 22px 28px 48px; font-size: 14.5px; line-height: 1.65; color: var(--text); }
    .pbody > .anim:has(> .md) { background: var(--surface); min-height: 100%; }
    .md h1, .md h2, .md h3, .md h4, .md h5, .md h6 { letter-spacing: -.02em; line-height: 1.25; margin: 1.5em 0 .6em; font-weight: 680; }
    .md h1 { font-size: 1.9em; padding-bottom: .3em; border-bottom: 1px solid var(--line); margin-top: .4em; }
    .md h2 { font-size: 1.45em; padding-bottom: .25em; border-bottom: 1px solid var(--line); }
    .md h3 { font-size: 1.2em; } .md h4 { font-size: 1.05em; } .md h5, .md h6 { font-size: .95em; color: var(--muted); }
    .md p, .md ul, .md ol, .md blockquote, .md pre, .md .mdtable { margin: 0 0 1em; }
    .md ul, .md ol { padding-left: 1.6em; } .md li { margin: .25em 0; } .md li > ul, .md li > ol { margin: .25em 0 0; }
    .md li.task { list-style: none; margin-left: -1.3em; }
    .md a, .md .ilink { color: var(--accent); text-decoration: none; cursor: pointer; border-bottom: 1px solid color-mix(in oklab, var(--accent) 35%, transparent); }
    .md a:hover { border-bottom-color: var(--accent); }
    .md .ilink.dead { cursor: default; }
    .md code { font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; font-size: .86em;
               padding: .15em .4em; border-radius: 5px; background: var(--sunken); border: 1px solid var(--line); }
    .md pre.mdcode { padding: 14px 16px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--line);
                     overflow: auto; font-size: 12.5px; line-height: 1.6; white-space: pre; }
    .md blockquote { padding: .2em 1em; border-left: 3px solid var(--accent-soft); color: var(--muted); }
    .md blockquote > :last-child { margin-bottom: 0; }
    .md hr { border: 0; border-top: 1px solid var(--line); margin: 1.6em 0; }
    .md .mdimg { max-width: 100%; border-radius: 6px; vertical-align: middle; }
    .md .mdhtml { margin: 0 0 1em; text-align: center; }
    .md .imgph { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 6px; font-size: 12px;
                 color: var(--muted); background: var(--sunken); border: 1px dashed var(--line-strong); }
    .md .imgph::before { content: "🖼"; }
    .md .del { text-decoration: line-through; color: var(--muted); }
    .md .mdtable { overflow-x: auto; }
    .md table { border-collapse: collapse; font-size: 13.5px; }
    .md th, .md td { border: 1px solid var(--line); padding: 6px 12px; text-align: left; }
    .md th { background: var(--surface-2); font-weight: 650; }
    .md .r { text-align: right; } .md .c { text-align: center; }

    /* ── json ── */
    .jtree { background: var(--surface); min-height: 100%; }
    .jtools { display: flex; gap: 8px; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--line);
              position: sticky; top: 0; background: var(--surface); z-index: 1; }
    .jtools .btn { height: 28px; font-size: 12px; padding: 0 10px; }
    .jrows { padding: 8px 0 24px; font-size: 12.5px; line-height: 1.75; }
    .jrow { white-space: nowrap; padding-right: 18px; border-radius: 4px; }
    .jrow.fold { cursor: pointer; } .jrow.fold:hover { background: var(--hover); }
    .caret { display: inline-block; width: 16px; color: var(--faint); font-size: 10px; }
    .jk { color: var(--tk-f); } .jx { color: var(--faint); } .jp { color: var(--faint); }
    .js { color: var(--tk-s); } .jn { color: var(--tk-n); } .jl { color: var(--tk-k); }
    .jsum { color: var(--muted); } .jmore { color: var(--faint); font-style: italic; }

    /* ── tables ── */
    .grid { overflow: auto; background: var(--surface); margin: 12px 18px 24px; border: 1px solid var(--line); border-radius: 10px; max-height: calc(100% - 70px); }
    .grid table { border-collapse: separate; border-spacing: 0; font-size: 13px; min-width: 100%; }
    .grid th, .grid td { padding: 7px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; text-align: left;
                         max-width: 360px; overflow: hidden; text-overflow: ellipsis; }
    .grid th { position: sticky; top: 0; background: var(--surface-2); font-weight: 650; font-size: 12px; z-index: 1; }
    .grid tr:hover td { background: var(--hover); }
    .grid .r { text-align: right; font-variant-numeric: tabular-nums; }
    .grid .rn { color: var(--faint); text-align: right; font-variant-numeric: tabular-nums; font-size: 11.5px;
                position: sticky; left: 0; background: var(--surface-2); border-right: 1px solid var(--line); }
    .grid th.rn { z-index: 2; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes fade { from { opacity: 0; } }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
    @keyframes slide { from { opacity: 0; transform: translateY(4px); } }
    .anim { animation: slide .22s ease-out both; }

    @media (max-width: 860px) {
      .main { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
      .pane.list { border-right: 0; border-bottom: 1px solid var(--line); }
      .thead, .row { grid-template-columns: minmax(0, 1fr) 72px 92px; }
      .thead > :nth-child(4), .row > :nth-child(4) { display: none; }
      .stats .wide { display: none; }
      .top { gap: 6px; padding: 8px 10px; }
      .top .logo { display: none; }
      .toolbar { padding: 10px 12px; }
      .rows { padding: 4px 4px 16px; }
      .thead { padding: 0 12px; }
      .phead { padding: 12px 14px; }
      .tabs { padding: 6px 14px 0; }
      .btn:not(.big) .label { display: none; }
      .btn:not(.big) { width: 34px; padding: 0; justify-content: center; }
    }
    """ + icons();
}
