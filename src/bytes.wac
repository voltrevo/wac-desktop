// Little helpers over raw bytes: reading integers out of a header, and writing sizes, hex and base64
// for people and for the page.

import { Buf } from "core";

/** The unsigned 16-bit little-endian value at `at`, or -1 when it runs past the end. */
export i32 le16(const u8[] b, i32 at) {
  if (at < 0 || at + 2 > b.len()) { return -1; }
  return (b[at] as i32) | ((b[at + 1] as i32) << 8);
}

/** The unsigned 32-bit little-endian value at `at`, widened so it is never negative; -1 past the end. */
export i64 le32(const u8[] b, i32 at) {
  if (at < 0 || at + 4 > b.len()) { return -1; }
  u32 v = (b[at] as u32) | ((b[at + 1] as u32) << 8) | ((b[at + 2] as u32) << 16) | ((b[at + 3] as u32) << 24);
  return v as i64;
}

/** The 64-bit little-endian value at `at`, or -1 when it runs past the end or does not fit an i64. */
export i64 le64(const u8[] b, i32 at) {
  i64 lo = le32(b, at);
  i64 hi = le32(b, at + 4);
  if (lo < 0 || hi < 0 || hi >= 0x80000000) { return -1; }
  return (hi << 32) | lo;
}

/** Whether `b` holds `sig` at `at`. */
export bool hasAt(const u8[] b, i32 at, const u8[] sig) {
  if (at < 0 || at + sig.len() > b.len()) { return false; }
  for (i32 i = 0; i < sig.len(); i++) {
    if (b[at + i] != sig[i]) { return false; }
  }
  return true;
}

/** A copy of `b[from, to)`, clamped to the array. */
export u8[] sliceOf(const u8[] b, i32 from, i32 to) {
  i32 s = from < 0 ? 0 : from;
  i32 e = to > b.len() ? b.len() : to;
  if (e <= s) { return u8[](); }
  u8[] out = u8[].filled(e - s, 0);
  for (i32 i = s; i < e; i++) { out[i - s] = b[i]; }
  return out;
}

static string HEX = "0123456789abcdef";

/** `n` as `width` lowercase hex digits, zero-padded. */
export string hexOf(i64 n, i32 width) {
  Buf out = Buf.create();
  for (i32 i = width - 1; i >= 0; i--) {
    i32 d = ((n >> (i * 4)) & 15) as@ i32;
    out.push(HEX.toBytes()[d]);
  }
  return out.toStr();
}

/** Every byte of `b` as two hex digits. */
export string hexBytes(const u8[] b) {
  u8[] digits = HEX.toBytes();
  Buf out = Buf.withCapacity(b.len() * 2);
  for (i32 i = 0; i < b.len(); i++) {
    out.push(digits[(b[i] >> 4) as i32]);
    out.push(digits[(b[i] & 15) as i32]);
  }
  return out.toStr();
}

/** A byte count as people read it: `912 B`, `14.2 KB`, `3.1 MB`. Binary units, one decimal. */
export string sizeOf(i64 n) {
  if (n < 0) { return "?"; }
  if (n < 1024) { return "\{n} B"; }
  string[] units = ["KB", "MB", "GB", "TB"];
  i64 scale = 1024;
  i32 u = 0;
  while (u < 3 && n >= scale * 1024) { scale = scale * 1024; u++; }
  i64 tenths = (n * 10 + scale / 2) / scale;
  if (tenths >= 1000) { return "\{tenths / 10} \{units[u]}"; }
  return "\{tenths / 10}.\{tenths % 10} \{units[u]}";
}

/** `n` with thousands separators: `1,234,567`. */
export string grouped(i64 n) {
  string digits = "\{n < 0 ? 0 - n : n}";
  Buf out = Buf.create();
  if (n < 0) { out.push('-'); }
  i32 len = digits.len();
  u8[] d = digits.toBytes();
  for (i32 i = 0; i < len; i++) {
    if (i > 0 && (len - i) % 3 == 0) { out.push(','); }
    out.push(d[i]);
  }
  return out.toStr();
}

/** How much of the original the compressed form keeps, as a whole percentage; 100 when it saved nothing. */
export i32 percentKept(i64 size, i64 csize) {
  if (size <= 0) { return 100; }
  i64 p = (csize * 100 + size / 2) / size;
  if (p > 999) { return 999; }
  return p as! i32;
}

static string B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

/** Standard base64, padded — what a `data:` URL carries. */
export string base64(const u8[] b) {
  u8[] a = B64.toBytes();
  Buf out = Buf.withCapacity((b.len() + 2) / 3 * 4);
  i32 i = 0;
  while (i + 3 <= b.len()) {
    i32 v = ((b[i] as i32) << 16) | ((b[i + 1] as i32) << 8) | (b[i + 2] as i32);
    out.push(a[(v >> 18) & 63]);
    out.push(a[(v >> 12) & 63]);
    out.push(a[(v >> 6) & 63]);
    out.push(a[v & 63]);
    i += 3;
  }
  i32 rest = b.len() - i;
  if (rest == 1) {
    i32 v = (b[i] as i32) << 16;
    out.push(a[(v >> 18) & 63]);
    out.push(a[(v >> 12) & 63]);
    out.pushStr("==");
  } else if (rest == 2) {
    i32 v = ((b[i] as i32) << 16) | ((b[i + 1] as i32) << 8);
    out.push(a[(v >> 18) & 63]);
    out.push(a[(v >> 12) & 63]);
    out.push(a[(v >> 6) & 63]);
    out.push('=');
  }
  return out.toStr();
}

/** ASCII lowercase; other bytes pass through, so UTF-8 survives. */
export string lower(string s) {
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] >= 'A' && b[i] <= 'Z') { b[i] = b[i] + 32; }
  }
  return string.fromBytes(b);
}

/** ASCII uppercase. */
export string upper(string s) {
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] >= 'a' && b[i] <= 'z') { b[i] = b[i] - 32; }
  }
  return string.fromBytes(b);
}

/** The part of `path` after its last `/`. */
export string baseName(string path) {
  u8[] b = path.toBytes();
  for (i32 i = b.len() - 1; i >= 0; i--) {
    if (b[i] == '/') { return path.slice(i + 1, path.len()); }
  }
  return path;
}

/** The extension of `name`, lowercased and without the dot; "" when there is none. */
export string extOf(string name) {
  string base = baseName(name);
  u8[] b = base.toBytes();
  for (i32 i = b.len() - 1; i > 0; i--) {
    if (b[i] == '.') { return lower(base.slice(i + 1, base.len())); }
  }
  return "";
}

/** Whether `s` ends with `tail`. */
export bool endsWith(string s, string tail) {
  return s.len() >= tail.len() && s.slice(s.len() - tail.len(), s.len()) == tail;
}

/** Sort `idx` in place, stably, by `less`. A merge sort, so 20,000 entries cost 300,000 comparisons. */
export void sortBy(i32[] idx, fn<bool(i32, i32)> less) {
  i32 n = idx.len();
  if (n < 2) { return; }
  i32[] tmp = i32[].filled(n, 0);
  i32 width = 1;
  while (width < n) {
    i32 lo = 0;
    while (lo < n) {
      i32 mid = lo + width < n ? lo + width : n;
      i32 hi = lo + 2 * width < n ? lo + 2 * width : n;
      i32 a = lo;
      i32 b = mid;
      i32 k = lo;
      while (a < mid && b < hi) {
        if (less(idx[b], idx[a])) { tmp[k] = idx[b]; b++; } else { tmp[k] = idx[a]; a++; }
        k++;
      }
      while (a < mid) { tmp[k] = idx[a]; a++; k++; }
      while (b < hi) { tmp[k] = idx[b]; b++; k++; }
      lo = hi;
    }
    for (i32 i = 0; i < n; i++) { idx[i] = tmp[i]; }
    width = width * 2;
  }
}
