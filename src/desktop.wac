// The desktop's page: windows, a taskbar and a disk of its own, in a browser tab.

import { Sys } from "std";
import { Page, Ui } from "web";
import { Desktop } from "./desk/shell.wac";
import { box.boxApplet } from "wac";

/**
 * What a copy of this page started by the shell runs: one of box's programs, as a process of its own in
 * a worker of its own. The build names it with `--spawn applet`.
 */
export async i32 applet(Sys sys) { return await boxApplet(sys.core, sys.cli); }

export async i32 main(Page page) {
  page.title("Desktop");
  page.mount((Ui ui) => <Desktop page={page}/>);
  return 0;
}
