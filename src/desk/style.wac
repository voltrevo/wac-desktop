// The desktop's look, on top of the Archive Explorer's tokens and icons (`../style.wac`).

/** The desktop's stylesheet. */
export string deskCss() {
  return """
    /* As the tokens are: light and dark in one, the scheme choosing; Settings' wallpapers set the glows again. */
    :root { --wall-a: light-dark(#c9c6ff, #2a2569); --wall-b: light-dark(#f3d3f5, #4a1d5e); --wall-c: light-dark(#cfe9f7, #10365a);
            --wall-ink: light-dark(#1d2140, #eef0ff); --glass: light-dark(rgb(255 255 255 / .72), rgb(20 23 32 / .74)); }
    body { overflow: hidden; }
    .desk { position: fixed; inset: 0; overflow: hidden; color: var(--text);
            background:
              radial-gradient(60% 70% at 15% 20%, var(--wall-a), transparent 70%),
              radial-gradient(55% 60% at 85% 25%, var(--wall-b), transparent 70%),
              radial-gradient(70% 70% at 60% 95%, var(--wall-c), transparent 70%),
              var(--bg); }
    .desk.dragging, .desk.dragging * { user-select: none; -webkit-user-select: none; }
    .desk.dragging { cursor: grabbing; }
    .desk.rz-e, .desk.rz-w { cursor: ew-resize; } .desk.rz-n, .desk.rz-s { cursor: ns-resize; }
    .desk.rz-ne, .desk.rz-sw { cursor: nesw-resize; } .desk.rz-nw, .desk.rz-se { cursor: nwse-resize; }
    .desk.dragging .win.moving { pointer-events: none; }
    /*
     * Clear of a phone's notch, rounded corners and home bar — the page is drawn to the screen's edges (`--edge`) — and
     * of the taskbar; everywhere else the insets are 0.
     */
    .area { position: absolute; top: env(safe-area-inset-top); left: env(safe-area-inset-left); right: env(safe-area-inset-right);
            bottom: calc(52px + env(safe-area-inset-bottom)); }
    .sizer { position: absolute; inset: 0; pointer-events: none; visibility: hidden; }
    .booting { position: absolute; inset: 0; display: grid; place-items: center; color: var(--wall-ink); gap: 10px; grid-auto-flow: column; }

    /* ── desktop icons ── */
    .dicons { position: absolute; top: 14px; left: 14px; bottom: 14px; display: grid; grid-auto-flow: column;
              grid-template-rows: repeat(auto-fill, 100px); grid-auto-columns: 92px; gap: 4px; }
    .dicon { display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 8px 4px 6px; border-radius: 12px;
             cursor: default; text-align: center; color: var(--wall-ink); }
    .dicon:hover { background: rgb(255 255 255 / .16); }
    .dicon.sel { background: color-mix(in oklab, var(--accent) 22%, transparent); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 45%, transparent); }
    .dtile { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--glass);
             backdrop-filter: blur(10px); box-shadow: 0 6px 18px -8px rgb(30 20 80 / .45), 0 0 0 1px rgb(255 255 255 / .35) inset; }
    .dtile .ic { width: 26px; height: 26px; }
    .dname { font-size: 12px; font-weight: 550; line-height: 1.25; max-width: 88px; overflow: hidden; text-overflow: ellipsis;
             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-word;
             text-shadow: 0 1px 2px rgb(0 0 0 / .18); }

    /* ── windows ── */
    .win { position: absolute; display: flex; flex-direction: column; background: var(--surface); border-radius: 12px;
           border: 1px solid var(--line-strong); box-shadow: 0 18px 50px -18px rgb(20 16 60 / .35), 0 2px 6px rgb(0 0 0 / .06);
           min-width: 0; max-width: 100%; max-height: 100%; animation: pop .16s ease-out both; }
    .win.focus { box-shadow: 0 28px 70px -20px rgb(30 22 90 / .5), 0 0 0 1px color-mix(in oklab, var(--accent) 22%, transparent), 0 2px 6px rgb(0 0 0 / .08); }
    .win.max { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; max-width: none; max-height: none; border-radius: 0; border-width: 0; }
    .win.snapl, .win.snapr { top: 0 !important; width: 50% !important; height: 100% !important; max-width: none; max-height: none; border-radius: 0; }
    .win.snapl { left: 0 !important; } .win.snapr { left: 50% !important; }
    .win.min { display: none; }
    .tbar { flex: none; height: 40px; display: flex; align-items: center; gap: 9px; padding: 0 6px 0 13px; cursor: default;
            background: var(--surface-2); border-bottom: 1px solid var(--line); border-radius: 11px 11px 0 0; }
    /* The frame does not clip — a clipped rounded corner cannot be grabbed — so its two halves do. */
    .win.max .tbar, .win.snapl .tbar, .win.snapr .tbar, .win.max .wbody, .win.snapl .wbody, .win.snapr .wbody { border-radius: 0; }
    .win:not(.focus) .tbar { color: var(--muted); }
    .win:not(.focus) .tbar .ic { opacity: .65; }
    .tbar .tt { flex: 1; min-width: 0; font-weight: 620; font-size: 13px; letter-spacing: -.005em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wbtns { display: flex; gap: 2px; }
    .wbtn { width: 30px; height: 28px; border: 0; border-radius: 7px; background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer; }
    .wbtn:hover { background: var(--hover); color: var(--text); }
    .wbtn.close:hover { background: #e5484d; color: white; }
    .wbody { flex: 1; min-height: 0; position: relative; display: flex; flex-direction: column; container-type: inline-size;
             overflow: hidden; border-radius: 0 0 11px 11px; }
    .wbody > * { flex: 1; min-height: 0; }
    .wbody .busy { position: absolute; }
    .rz { position: absolute; z-index: 2; }
    .rz.n { top: -4px; left: 10px; right: 10px; height: 8px; cursor: ns-resize; }
    .rz.s { bottom: -4px; left: 10px; right: 10px; height: 8px; cursor: ns-resize; }
    .rz.e { right: -4px; top: 10px; bottom: 10px; width: 8px; cursor: ew-resize; }
    .rz.w { left: -4px; top: 10px; bottom: 10px; width: 8px; cursor: ew-resize; }
    .rz.ne, .rz.nw, .rz.se, .rz.sw { width: 16px; height: 16px; }
    .rz.ne { top: -4px; right: -4px; cursor: nesw-resize; } .rz.sw { bottom: -4px; left: -4px; cursor: nesw-resize; }
    .rz.nw { top: -4px; left: -4px; cursor: nwse-resize; } .rz.se { bottom: -4px; right: -4px; cursor: nwse-resize; }
    .snapghost { position: absolute; top: 6px; bottom: 6px; border-radius: 14px; pointer-events: none; z-index: 100000;
                 background: color-mix(in oklab, var(--accent) 14%, transparent); border: 2px solid color-mix(in oklab, var(--accent) 45%, transparent);
                 backdrop-filter: blur(2px); animation: fade .12s both; }
    .snapghost.l { left: 6px; width: calc(50% - 9px); } .snapghost.r { right: 6px; width: calc(50% - 9px); }
    .snapghost.m { left: 6px; right: 6px; }
    .edge-r { position: absolute; top: 0; right: 0; bottom: 0; width: 6px; z-index: 100001; }

    /* ── dragging files ── */
    .desk.carrying, .desk.carrying * { cursor: grabbing !important; }
    .row, .dicon { user-select: none; -webkit-user-select: none; }
    .fghost { position: absolute; z-index: 300000; pointer-events: none; display: flex; align-items: center; gap: 7px; max-width: 320px;
              padding: 7px 11px; border-radius: 10px; font-size: 12.5px; font-weight: 600; background: var(--surface); color: var(--text);
              border: 1px solid var(--line-strong); box-shadow: var(--shadow-lg); animation: fade .1s both; }
    .fghost .fwhat { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .fghost .fto { color: var(--accent); white-space: nowrap; }
    .fghost.ok { border-color: color-mix(in oklab, var(--accent) 55%, transparent); }
    .row.dropon { background: color-mix(in oklab, var(--accent) 18%, transparent) !important; box-shadow: inset 0 0 0 1.5px var(--accent); }
    .pane.list.dropon .rows { box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--accent) 55%, transparent); background: color-mix(in oklab, var(--accent) 5%, transparent); }
    .crumb.dropon { background: color-mix(in oklab, var(--accent) 18%, transparent); box-shadow: inset 0 0 0 1.5px var(--accent); }
    .dicon.dropon { background: color-mix(in oklab, var(--accent) 26%, transparent); box-shadow: inset 0 0 0 2px var(--accent); }
    .dtile.c-trash.full::after { content: ""; position: absolute; top: 9px; right: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
    .dtile { position: relative; }
    .toast .tundo { margin-left: 6px; border: 0; background: transparent; color: var(--accent); font: inherit; font-weight: 700; cursor: pointer; padding: 2px 6px; border-radius: 6px; }
    .toast .tundo:hover { background: var(--accent-soft); }

    /* ── apps inside windows ── */
    .files { display: flex; flex-direction: column; height: 100%; position: relative; }
    .ftop { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px solid var(--line); background: var(--surface); min-width: 0; }
    .ftop .crumbs { flex: 1; display: flex; align-items: center; min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .ftop .crumbs nav.crumbs { flex: none; }
    .ftop .actions { display: flex; gap: 6px; flex: none; }
    .ftop .btn { height: 30px; font-size: 12.5px; padding: 0 10px; }
    .files .main { flex: 1; min-height: 0; grid-template-columns: minmax(0, 1fr) minmax(280px, 42%); }
    .pactions { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--surface); }
    .pactions .actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .pactions .btn { height: 30px; font-size: 12.5px; padding: 0 10px; }
    .pane.preview.stacked > .pane.preview { flex: 1; min-height: 0; }
    .btn.danger { color: white; background: #e5484d; border-color: transparent; }
    .rename { font: inherit; height: 28px; padding: 0 8px; border-radius: 6px; border: 1px solid var(--accent); box-shadow: 0 0 0 3px var(--accent-soft);
              background: var(--surface); color: var(--text); outline: 0; min-width: 0; width: 100%; }
    .program { display: flex; flex-direction: column; height: 100%; }
    .pick-shade { position: fixed; inset: 0; background: rgb(20 16 40 / .28); display: flex; align-items: center; justify-content: center; z-index: 100000; }
    .pick { width: 460px; max-width: calc(100vw - 32px); max-height: 70vh; display: flex; flex-direction: column; background: var(--surface);
            border: 1px solid var(--line-strong); border-radius: 12px; box-shadow: 0 18px 50px -18px rgb(20 16 60 / .45); }
    .phead { padding: 14px 16px 6px; }
    .ppath { display: flex; align-items: center; gap: 8px; padding: 6px 12px; border-bottom: 1px solid var(--line); }
    .plist { flex: 1; overflow: auto; min-height: 120px; padding: 4px 0; }
    .prow { display: flex; align-items: center; gap: 8px; padding: 5px 14px; cursor: default; }
    .prow:hover { background: var(--surface-2); }
    .prow.sel { background: var(--accent-soft); }
    .pfoot { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); }
    .pnote { flex: 1; color: var(--muted); font-size: 12px; }
    .consent .phead { padding: 18px 16px 10px; }
    .allowed { padding: 6px 0; overflow: auto; height: 100%; }
    .arow { display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-bottom: 1px solid var(--line); }
    .aprog { font-weight: 600; min-width: 120px; }
    .awhat { flex: 1; color: var(--muted); }
    .cpath { background: var(--surface-2); padding: 1px 6px; border-radius: 5px; }
    .program-body { flex: 1; overflow: auto; min-height: 0; position: relative; contain: layout paint; }
    .program-status { padding: 6px 10px; color: var(--muted); border-top: 1px solid var(--line); }
    .program-said { margin: 0; padding: 8px 10px; max-height: 40%; overflow: auto; border-top: 1px solid var(--line); white-space: pre-wrap; }
    .c-terminal { color: var(--text); }
    .settings { height: 100%; overflow: auto; padding: 6px 22px 18px; }
    .sgroup { padding: 10px 0 14px; border-bottom: 1px solid var(--line); }
    .sgroup h3 { margin: 6px 0 10px; font-size: 13px; font-weight: 700; letter-spacing: .02em; }
    .srow { display: flex; align-items: center; gap: 16px; padding: 7px 0; flex-wrap: wrap; }
    .srow.top { align-items: flex-start; }
    .slabel { width: 150px; flex: none; color: var(--muted); font-size: 13px; }
    .srow.top .slabel { padding-top: 6px; }
    .segs { display: inline-flex; padding: 3px; gap: 2px; border-radius: 10px; background: var(--sunken); border: 1px solid var(--line); flex-wrap: wrap; }
    .seg { border: 0; background: transparent; padding: 5px 12px; border-radius: 7px; font: inherit; font-size: 12.5px; font-weight: 550;
           color: var(--muted); cursor: pointer; }
    .seg:hover { color: var(--text); }
    .seg.on { background: var(--surface); color: var(--text); box-shadow: 0 1px 3px rgb(0 0 0 / .12), inset 0 0 0 1px color-mix(in oklab, var(--accent) 35%, transparent); }
    .vol .seg { border: 1px solid var(--line); background: var(--sunken); }
    .vol .seg.on { background: var(--accent-soft); color: var(--accent); }
    .swatches { display: flex; gap: 10px; flex-wrap: wrap; }
    .swatch { width: 28px; height: 28px; border-radius: 50%; border: 0; cursor: pointer; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .12); }
    .swatch.on { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--text); }
    .walls { display: flex; gap: 10px; flex-wrap: wrap; }
    .wall { display: flex; flex-direction: column; align-items: center; gap: 5px; border: 0; padding: 0; background: transparent; cursor: pointer;
            font: inherit; font-size: 12px; color: var(--muted); }
    .wthumb { width: 92px; height: 58px; border-radius: 9px; box-shadow: inset 0 0 0 1px var(--line-strong); }
    .wall.on .wthumb { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--accent); }
    .wall.on { color: var(--text); font-weight: 600; }
    .vol { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 220px; }
    .vrange { flex: 1; max-width: 260px; accent-color: var(--accent); }
    .vrange:disabled { opacity: .45; }
    .vnum { width: 44px; color: var(--muted); font-size: 12.5px; }
    .snote { margin: 4px 0 0 166px; font-size: 12px; color: var(--faint); }
    .sfoot { display: flex; gap: 8px; padding: 14px 0 0; }
    @container (max-width: 560px) { .slabel { width: 100%; } .srow { gap: 8px; } .snote { margin-left: 0; } }

    @container (max-width: 640px) {
      .files .main { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
      .files .pane.list { border-right: 0; border-bottom: 1px solid var(--line); }
      .thead, .row { grid-template-columns: minmax(0, 1fr) 72px; }
      .thead > :nth-child(n+3), .row > :nth-child(n+3) { display: none; }
      .btn .label { display: none; }
    }

    /* ── taskbar ── */
    .taskbar { position: absolute; left: 0; right: 0; bottom: 0; height: calc(52px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8px;
               padding: 0 calc(10px + env(safe-area-inset-right)) env(safe-area-inset-bottom) calc(10px + env(safe-area-inset-left));
               background: var(--glass); backdrop-filter: blur(18px) saturate(1.4); border-top: 1px solid rgb(255 255 255 / .35); z-index: 200000; }
    .tblaunch { width: 40px; height: 40px; border-radius: 11px; border: 0; display: grid; place-items: center; cursor: pointer; color: white;
                background: linear-gradient(140deg, var(--accent), var(--accent-2)); box-shadow: 0 6px 16px -6px color-mix(in oklab, var(--accent) 80%, transparent); }
    .tblaunch:hover, .tblaunch.on { filter: brightness(1.08); }
    .tbwins { display: flex; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: none; flex: 1; }
    .tbwin { flex: 0 1 190px; min-width: 52px; height: 38px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 0;
             border-radius: 9px; background: transparent; color: var(--text); cursor: pointer; font-size: 12.5px; font-weight: 550; position: relative; }
    .tbwin .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tbwin:hover { background: rgb(255 255 255 / .35); }
    /* The window in front is the one whose button is filled in: tinted with the accent, outlined, its title bolder. */
    .tbwin.on { background: color-mix(in oklab, var(--accent) 13%, var(--surface)); color: var(--text); font-weight: 650;
                box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 40%, transparent), 0 1px 3px rgb(0 0 0 / .08); }
    .tbwin.on:hover { background: color-mix(in oklab, var(--accent) 18%, var(--surface)); }
    .tbwin.min { opacity: .62; }
    .tbright { display: flex; align-items: center; gap: 10px; flex: none; }
    .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 99px;
            color: var(--ok); background: color-mix(in oklab, var(--ok) 12%, transparent); }
    .pill.warn { color: var(--warn); background: color-mix(in oklab, var(--warn) 14%, transparent); }
    .clock { font-size: 13px; font-weight: 600; color: var(--text); padding: 0 4px; }
    .clock .tz { font-size: 10px; color: var(--faint); font-weight: 700; letter-spacing: .04em; }

    /* Never taller than the space above the taskbar; the list scrolls inside it. */
    .launcher { position: absolute; left: 10px; bottom: 62px; width: 340px; max-height: calc(100% - 74px); padding: 8px; border-radius: 16px; z-index: 200001;
                display: flex; flex-direction: column;
                background: var(--glass); backdrop-filter: blur(20px) saturate(1.4); border: 1px solid rgb(255 255 255 / .4);
                box-shadow: 0 30px 70px -20px rgb(20 14 70 / .45); }
    .lhead { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); padding: 8px 10px 6px; }
    .litem { width: 100%; display: flex; align-items: center; gap: 12px; padding: 8px 10px; border: 0; border-radius: 10px; background: transparent;
             color: var(--text); cursor: pointer; text-align: left; }
    .litem:hover { background: var(--surface); }
    .litem.on { background: var(--surface); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent) 45%, transparent); }
    .lsearch { flex: none; display: flex; align-items: center; gap: 8px; margin: 2px 2px 6px; padding: 0 10px; height: 38px; border-radius: 10px;
               background: var(--surface); color: var(--muted); box-shadow: 0 1px 3px rgb(0 0 0 / .08); }
    .lq { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 13.5px; color: var(--text); }
    .llist { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
    .lgroup { width: 100%; display: flex; align-items: center; gap: 6px; padding: 8px 8px 4px; border: 0; background: transparent; cursor: pointer;
              font: inherit; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
    .lgroup:hover { color: var(--muted); }
    .lgroup .lchev { display: inline-flex; transform: rotate(90deg); transition: transform .12s; }
    .lgroup.shut .lchev { transform: none; }
    .lgroup .lcount { margin-left: auto; font-weight: 600; letter-spacing: 0; }
    .lnone { padding: 14px 12px; color: var(--muted); font-size: 13px; }
    .ltile { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: var(--surface); box-shadow: 0 1px 3px rgb(0 0 0 / .08); }
    .ltext { display: flex; flex-direction: column; } .lt { font-weight: 620; font-size: 13.5px; } .ls { font-size: 12px; color: var(--muted); }
    .lfoot { flex: none; margin: 6px 4px 2px; padding: 8px 8px 4px; border-top: 1px solid var(--line); font-size: 11.5px; color: var(--muted); }

    .toast { position: absolute; left: 50%; bottom: 66px; transform: translateX(-50%); z-index: 200002; display: flex; align-items: center; gap: 9px;
             max-width: min(560px, calc(100% - 32px)); padding: 10px 16px; border-radius: 12px; font-size: 13px;
             background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-lg); animation: rise .2s both; }
    .toast .ic { color: var(--ok); } .toast.bad .ic { color: var(--bad); }
    @keyframes pop { from { opacity: 0; transform: scale(.985) translateY(4px); } }

    /* ── a phone (`Desk.phone`): every window the whole screen, a home screen of apps, a thumb's taskbar ── */
    .desk.phone .area { bottom: calc(60px + env(safe-area-inset-bottom)); }
    .desk.phone .win { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; max-width: none; max-height: none;
                       border-radius: 0; border-width: 0; box-shadow: none; animation: none; }
    .desk.phone .rz, .desk.phone .wbtn:not(.close), .desk.phone .snapghost { display: none; }
    .desk.phone .tbar { height: 48px; border-radius: 0; padding-left: 16px; }
    .desk.phone .tbar .tt { font-size: 15px; }
    .desk.phone .wbtn { width: 44px; height: 44px; border-radius: 10px; }
    .desk.phone .wbody { border-radius: 0; }
    .desk.phone .row { min-height: 44px; }
    .desk.phone .ftop .btn, .desk.phone .pactions .btn { height: 40px; min-width: 40px; }
    .desk.phone .toast { bottom: calc(72px + env(safe-area-inset-bottom)); }
    .desk.phone .launcher { left: calc(8px + env(safe-area-inset-left)); right: calc(8px + env(safe-area-inset-right)); width: auto;
                            top: calc(8px + env(safe-area-inset-top)); bottom: calc(68px + env(safe-area-inset-bottom)); max-height: none; }
    .desk.phone .litem { min-height: 52px; }
    .desk.phone .lq { font-size: 16px; }
    .phonebar { height: calc(60px + env(safe-area-inset-bottom)); justify-content: space-around; gap: 0; }
    .pbbtn { position: relative; width: 56px; height: 48px; border: 0; border-radius: 14px; background: transparent; color: var(--text);
             display: grid; place-items: center; cursor: pointer; }
    .pbbtn .ic { width: 24px; height: 24px; }
    .pbbtn.on { background: color-mix(in oklab, var(--accent) 16%, transparent); color: var(--accent); }
    .pbcount { position: absolute; top: 6px; right: 8px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; font-size: 11px; font-weight: 700;
               line-height: 18px; color: var(--accent-ink); background: var(--accent); }
    .phonebar .clock { font-size: 12px; }
    .phome { position: absolute; inset: 0; overflow-y: auto; padding: 14px 14px 24px; -webkit-overflow-scrolling: touch; }
    .psearch { width: 100%; height: 46px; display: flex; align-items: center; gap: 10px; padding: 0 16px; border: 0; border-radius: 14px;
               background: var(--glass); backdrop-filter: blur(14px); color: var(--muted); font: inherit; font-size: 15px; cursor: pointer;
               box-shadow: 0 6px 18px -10px rgb(30 20 80 / .45); }
    .phsec { margin-top: 18px; }
    .phhead { font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--wall-ink); opacity: .7; margin: 0 4px 10px; }
    .phgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 6px; }
    .ptile { display: flex; flex-direction: column; align-items: center; gap: 7px; min-width: 0; border: 0; padding: 0; background: transparent;
             color: var(--wall-ink); font: inherit; cursor: pointer; }
    .ptic { width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center; background: var(--glass); backdrop-filter: blur(10px);
            box-shadow: 0 6px 18px -8px rgb(30 20 80 / .45), 0 0 0 1px rgb(255 255 255 / .35) inset; }
    .ptic .ic { width: 28px; height: 28px; }
    .ptile:active .ptic { transform: scale(.94); }
    .ptname { max-width: 100%; font-size: 11.5px; font-weight: 550; line-height: 1.25; text-align: center; overflow: hidden; word-break: break-word;
              display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-shadow: 0 1px 2px rgb(0 0 0 / .18); }
    .recents { position: absolute; z-index: 200001; left: env(safe-area-inset-left); right: env(safe-area-inset-right); top: env(safe-area-inset-top);
               bottom: calc(60px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; padding: 14px;
               background: var(--glass); backdrop-filter: blur(20px) saturate(1.4); animation: fade .12s both; }
    .rhead { display: flex; align-items: center; justify-content: space-between; min-height: 40px; margin-bottom: 8px; font-size: 16px; }
    .rlist { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
    .rcard { display: flex; align-items: center; border-radius: 14px; background: var(--surface); box-shadow: var(--shadow); }
    .rgo { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 0 16px; border: 0; background: transparent;
           color: var(--text); font: inherit; font-size: 15px; font-weight: 600; text-align: left; cursor: pointer; }
    .rgo .ic { width: 22px; height: 22px; flex: none; }
    .rt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rclose { width: 52px; height: 56px; border: 0; background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer; }
    .rnone { padding: 30px 0; text-align: center; color: var(--muted); }
    .share { height: 100%; overflow: auto; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 18px 20px; text-align: center; }
    .shead { margin: 0; font-weight: 600; }
    .sqr { width: min(300px, 80cqw); height: auto; image-rendering: pixelated; border-radius: 10px; box-shadow: var(--shadow); background: white; }
    .saddr { width: 100%; max-width: 360px; height: 36px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--sunken);
             color: var(--text); font-size: 12.5px; text-align: center; }
    .snote { margin: 0; max-width: 360px; font-size: 12px; color: var(--muted); }
    .rhead .btn { flex: none; height: 40px; padding: 0 14px; white-space: nowrap; }
    /* On its side, a phone's home screen has room for more to a row. */
    @media (orientation: landscape) { .desk.phone .phgrid { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); } }

    @media (max-width: 700px) {
      .win { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; border-radius: 0; border-width: 0; }
      .rz { display: none; }
      .tbwin { flex-basis: 46px; padding: 0 12px; } .tbwin .t { display: none; }
      .pill span, .pill { font-size: 0; gap: 0; padding: 6px; } .pill .ic { font-size: 0; }
    }
  """;
}
