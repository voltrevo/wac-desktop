// The desktop's own apps — the Calculator, the Viewer, the Editor and the Markdown editor, Paint, the Terminal, the
// Archive Explorer and the wac IDE — as programs on the site it was served from.
//
// **Each is a program like any other**, built beside the desktop into `dist/apps/<name>.wasm` and started from
// `/site/apps/` by `launch`, in windows it opens itself. What makes one the desktop's own is only how it is started:
// with what it was opened on as its argument, handed that and nothing more — the Viewer the file it shows, to read;
// the Editor the file it edits, to change; the Terminal, a shell on this disk, all of it — at the size its window
// suits, and kept by a session as the app and what it showed, so a reload starts it again where it was.
//
// **Served over http only** (the owner's choice, 2026-11-01). A desktop opened from a file has no site, so none of
// these: what would open in one opens its folder in Files, where the preview shows it, and the launcher does not
// offer them.

import { Grants } from "./grants.wac";
import { leafOf, parentOf } from "./vfs.wac";
import { Vec } from "core";
import { Desk, Placed, Running, Start, MAX_WINDOWS, focus, open } from "./wm.wac";

/** Where the build leaves the desktop's own apps, on the site. */
export string appPath(string app) { return "site/apps/" + app + ".wasm"; }

/** How the desktop starts its app `app` opened on `arg` — a file, a folder, or nothing. */
export Start builtin(string app, string arg) {
  Grants g = Grants.create();
  string[] args = arg == "" ? string[]() : ["/" + arg];
  i32 w = 760;
  i32 h = 560;
  string ic = "terminal";
  if (app == "viewer") {
    g.grant(arg, false);
    ic = "text";
  } else if (app == "editor" || app == "markdown") {
    if (arg != "") { g.grant(arg, true); }
    ic = app == "editor" ? "edit" : "markdown";
    // The Markdown editor shows what it writes beside it.
    if (app == "markdown") { w = 1040; h = 640; }
  } else if (app == "terminal") {
    // **The Terminal is handed the whole disk**, as the owner chose: it is a shell, and what it runs is the person's.
    g.grant("", true);
  } else if (app == "calc") {
    w = 340;
    h = 540;
    ic = "calc";
  } else if (app == "pip") {
    // Three of the game's pixels to one of the screen's, and the title bar.
    w = 964;
    h = 584;
    ic = "lantern";
  } else if (app == "lanterns") {
    // Two of the board's pixels to one of the screen's, with the moves above it and the buttons below.
    w = 760;
    h = 560;
    ic = "beam";
  } else if (app == "paint") {
    // **Paint is handed the picture it is opened on**, to change; Open asks the desktop's picker for another, and a
    // new picture is saved where the desktop says.
    if (arg != "") { g.grant(arg, true); }
    w = 1060;
    h = 720;
    ic = "paint";
  } else if (app == "mandelbrot") {
    w = 900;
    h = 620;
    ic = "fractal";
  } else if (app == "crush-depth") {
    w = 690;
    h = 540;
    ic = "beam";
  } else if (app == "stackfall") {
    w = 460;
    h = 760;
    ic = "stackfall";
  } else if (app == "explorer") {
    w = 980;
    h = 600;
    ic = "layers";
  } else if (app == "ide") {
    // **The IDE's projects are a folder of the disk** — `Projects`, from the launcher — each project a folder in
    // it, which Files and the Terminal see too. It is handed that folder to change, and what is dropped on it,
    // which it imports as a project.
    g.grant(arg, true);
    w = 1180;
    h = 720;
    ic = "code";
  }
  return Start(appPath(app), args, g, w, h, ic, app == "explorer" || app == "ide" || app == "paint", app, arg, Vec.create());
}

/** A window of running app `app`, if one has a window open; -1 if not. */
i32 windowOf(Desk d, string app) {
  for (i32 i = 0; i < d.running.len(); i++) {
    Running r = d.running.get(i);
    if (r.start.app != app) { continue; }
    for (i32 k = 0; k < MAX_WINDOWS; k++) { if (r.wins.get(k) >= 0) { return r.wins.get(k); } }
  }
  return 0 - 1;
}

/**
 * Open the desktop's app `app` on `arg`: started from the site, or — the Calculator and the IDE, which there is one
 * of — a window of it brought forward: the IDE opens a window per project itself. Without a site, a file's folder
 * opens in Files instead, and anything else is not there to open.
 */
export void startApp(Desk d, string app, string arg) { startPlaced(d, app, arg, Vec.create()); }

/** As `startApp`, its windows where a session had them. */
export void startPlaced(Desk d, string app, string arg, Vec<Placed> places) {
  if (!d.site || d.launch is null) {
    if (app == "viewer" || app == "editor" || app == "markdown") {
      if (places.len() == 0) {
        open(d, "files", parentOf(arg), leafOf(parentOf(arg)) == "" ? "Home" : leafOf(parentOf(arg)), "folder");
        d.note = "Opened from a file, the desktop has no " + app + ": " + leafOf(arg) + " is shown here";
      }
    }
    return;
  }
  if (app == "calc" || app == "ide" || app == "stackfall" || app == "pip" || app == "lanterns" || app == "crush-depth") {
    i32 open = windowOf(d, app);
    if (open >= 0) {
      focus(d, open);
      return;
    }
  }
  Start s = builtin(app, arg);
  s.places = places;
  d.launch!(s);
}
