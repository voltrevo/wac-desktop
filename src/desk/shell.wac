// The desktop: wallpaper and icons, windows, a taskbar, and files arriving from outside.
//
// **What renders when.** The desktop component draws the frames — position, size, title, stacking — and
// every window's contents are a component of their own, handed the window record and two numbers: the
// window's revision and the disk's. A drag changes neither, so a drag redraws frames and nothing inside
// them; a save bumps the disk's, so every window showing the disk looks again.

import { Ticket, Vec } from "core";
import { ElementEvent, MOD_CTRL, MOD_META, Node, Page, Picked, Ui, html.button, html.div, html.input, html.label, html.span, html.style } from "web";
import { Vfs, Got, Info, nowMillis, copyInto, filesystem, freeName, join, leafOf, moveInto, parentOf, usable, vfsOf } from "./vfs.wac";
import { Files, MemoryStore } from "std";
import { fs.ProcTable, fs.systemFiles } from "wac";
import { box.boxNames } from "wac";
import { Desk, Drag, FileDrag, Win, SESSION, close, dragFilesTo, dragging, dropKey, dropOn, endDrag, find, focus, dragTo, hintRight,
         hover, minimise, moved, newDesk, open, pressFiles, restore, sessionOf, startMove, startResize, taskbarClick, toggleMax } from "./wm.wac";
import { TRASH, restoreFromTrash, toTrash, trashCount } from "./trash.wac";
import { CalcApp } from "./calc.wac";
import { FilesApp, appFor, openPath } from "./files.wac";
import { EditorApp, ViewerApp } from "./apps.wac";
import { TerminalApp } from "./terminal.wac";
import { deskCss } from "./style.wac";
import { demoZip, welcomeMd } from "./seed.wac";
import { css } from "../style.wac";
import { icon } from "../preview.wac";
import { iconFor } from "../model.wac";
import { plural } from "../browse.wac";

static i32 QUIET = 600;
static i32 GRACE = 200;

// ── starting up ─────────────────────────────────────────────────────────────

/** Choose the disk, give a new one something to start with, and bring the last session back. */
async void start(Page page, Desk d, fn<void()> bump, fn<void()> ready) {
  // One filesystem for every window: the browser's storage if it is offered, memory if not, with the
  // system a shell expects mounted on it — `/bin` with box's programs, `/dev`, `/proc`.
  bool persistent = await usable(page.sys.files());
  Vec<string> argv = Vec.create();
  argv.push("desktop");
  ProcTable table = ProcTable.create();
  table.current = table.start(0, argv, nowMillis(page));
  Files system = systemFiles(filesystem(page.sys, persistent), page.sys.random(), table, boxNames());
  d.fs = vfsOf(system, table, persistent);
  Vfs fs = d.fs;
  await fs.mkdir("Desktop");
  Got<u8[]> saved = await fs.read(SESSION);
  if (!saved.ok) {
    // The first time: a note and something to open.
    Got<string[]> there = await fs.list("Desktop");
    if (there.ok && there.value.len() == 0) {
      await fs.write("Desktop/Welcome.md", welcomeMd());
      await fs.write("Desktop/demo.zip", demoZip());
    }
    open(d, "viewer", "Desktop/Welcome.md", "Welcome.md", "text");
  } else {
    restore(d, saved.value);
  }
  d.dirty = true;
  ready();
  files(page, d, bump);
}

async void saveSession(Desk d) {
  d.dirty = false;
  await d.fs.mkdir(".desktop");
  await d.fs.write(SESSION, sessionOf(d));
}

// ── files from outside ──────────────────────────────────────────────────────

/** Where dropped files go: the folder of a Files window in front, or the desktop. */
string target(Desk d) {
  Win? w = find(d, d.focused);
  if ((w is not null) && w!.app == "files" && !w!.min) { return w!.arg; }
  return "Desktop";
}

/**
 * Each file dropped or picked, for as long as the page lives — gathered the way the Archive Explorer
 * gathers them, since a folder arrives a file at a time with nothing marking the last, then written to
 * the disk. This loop only gathers; writing is a task of its own (see the explorer's `files`).
 */
async void files(Page page, Desk d, fn<void()> bump) {
  Vec<Picked> batch = Vec.create();
  Ticket<Picked> next = page.nextFile();
  while (true) {
    if (batch.len() == 0) {
      await next;
    } else {
      bool alone = batch.len() == 1 && batch.get(0).name.indexOf("/") < 0;
      Ticket<f64> quiet = page.sleep(alone ? GRACE : QUIET);
      await Ticket.any(next, quiet);
      if (!next.settled()) {
        Vec<Picked> done = batch;
        batch = Vec.create();
        save(d, done, target(d), bump);
        continue;
      }
    }
    Picked f = next.value();
    next = page.nextFile();
    batch.push(f);
    d.note = "Receiving \{plural(batch.len(), "file")}…";
    bump();
  }
}

/** Write what arrived into `dir`, each top-level name made unique there first. */
async void save(Desk d, Vec<Picked> batch, string dir, fn<void()> bump) {
  Vec<string> from = Vec.create();
  Vec<string> to = Vec.create();
  i32 written = 0;
  i32 failed = 0;
  bool folderRefused = false;
  for (i32 i = 0; i < batch.len(); i++) {
    Picked f = batch.get(i);
    if (!f.ok) {
      failed++;
      if (f.error.indexOf("dropped folder") >= 0) { folderRefused = true; }
      continue;
    }
    i32 cut = f.name.indexOf("/");
    string head = cut < 0 ? f.name : f.name.slice(0, cut);
    string rest = cut < 0 ? "" : f.name.slice(cut, f.name.len());
    string renamed = "";
    for (i32 k = 0; k < from.len(); k++) { if (from.get(k) == head) { renamed = to.get(k); } }
    if (renamed == "") {
      renamed = await freeName(d.fs, dir, head);
      from.push(head);
      to.push(renamed);
    }
    Got<bool> w = await d.fs.write(join(dir, renamed + rest), f.bytes);
    if (w.ok) { written++; } else { failed++; }
  }
  string where = dir == "Desktop" ? "the desktop" : (dir == "" ? "Home" : leafOf(dir));
  if (folderRefused) {
    d.error = "This browser won't let a page opened from a file read a dropped folder. Use the Add files button, or serve the page.";
  } else if (failed > 0) {
    d.error = "\{failed} of \{batch.len()} could not be added";
  }
  if (written > 0) { d.note = "Added \{plural(written, "file")} to \{where}"; } else { d.note = ""; }
  d.fsRev++;
  bump();
}

// ── the desktop's own icons ─────────────────────────────────────────────────

struct Icons {
  Info[] infos;
  string[] names;
  /** What is selected: names on the desktop, or "\0home" and "\0trash" for those two. */
  string[] picked;
  /** How many things are in the Trash. */
  i32 trash;
}

async void loadIcons(Desk d, Icons s, fn<void()> bump) {
  Got<string[]> names = await d.fs.list("Desktop");
  if (!names.ok) { return; }
  Vec<string> keep = Vec.create();
  Vec<Info> infos = Vec.create();
  for (i32 i = 0; i < names.value.len(); i++) {
    string n = names.value[i];
    if (n.len() > 0 && n[0] == ".") { continue; }
    Got<Info> st = await d.fs.stat(join("Desktop", n));
    if (st.ok) { keep.push(n); infos.push(st.value); }
  }
  s.names = keep.toArray();
  s.infos = infos.toArray();
  s.trash = await trashCount(d.fs);
  bump();
}

bool picked(Icons s, string n) {
  for (i32 i = 0; i < s.picked.len(); i++) { if (s.picked[i] == n) { return true; } }
  return false;
}

/** A click on an icon: just it, or — with Ctrl — it added to the selection or taken out. */
void pick(Icons s, string n, ElementEvent e) {
  if ((e.mods & (MOD_CTRL | MOD_META)) == 0) { s.picked = [n]; return; }
  Vec<string> next = Vec.create();
  bool had = false;
  for (i32 i = 0; i < s.picked.len(); i++) { if (s.picked[i] == n) { had = true; } else { next.push(s.picked[i]); } }
  if (!had) { next.push(n); }
  s.picked = next.toArray();
}

/** The desktop's icons: Home, the Trash, and what is in the Desktop folder. `drop` is the desktop's `dropKey`. */
Node DesktopIcons(Ui ui, Desk d, fn<void()> bumpDesk, i32 fsRev, string drop) {
  Icons s = ui.memo<Icons>("", () => Icons(Info[](), string[](), string[](), 0));
  auto version = ui.state(0);
  fn<void()> bump = () => { version.update((i32 v) => v + 1); };
  ui.effect("\{fsRev}", () => { loadIcons(d, s, bump); return () => { }; });
  bool drag = dragging(drop);
  fn<Node(string, string, string, string, string, string)> special = (string key, string dir, string name, string ic, string cls, string tip) =>
    <div class={"dicon" + (picked(s, key) ? " sel" : "") + (dropOn(drop, dir) ? " dropon" : "")} title={tip}
         onclick={(ElementEvent e) => { pick(s, key, e); bump(); }}
         onpointermove={drag ? (ElementEvent e) => { hover(d, dir, name == "Trash" ? "the Trash" : name); } : null}
         ondblclick={(ElementEvent e) => { open(d, "files", dir, name, ic); bumpDesk(); }}>
      <div class={"dtile " + cls}>{icon(ic, "lg")}</div><span class="dname">{name}</span></div>;
  Node[] out = Node[].filled(s.names.len() + 2, Node.Text(""));
  out[0] = special("\0home", "", "Home", "home", "c-folder", "Home");
  out[1] = special("\0trash", TRASH, "Trash", "trash", s.trash > 0 ? "c-trash full" : "c-trash",
                   s.trash == 0 ? "The Trash is empty" : (s.trash == 1 ? "The Trash: 1 item" : "The Trash: \{s.trash} items"));
  for (i32 i = 0; i < s.names.len(); i++) {
    string n = s.names[i];
    string path = join("Desktop", n);
    bool dir = s.infos[i].isDir;
    string ic = dir ? "folder" : iconFor(n);
    out[i + 2] = <div class={"dicon" + (picked(s, n) ? " sel" : "") + (dropOn(drop, path) ? " dropon" : "")} key={n} title={n}
                      onpointerdown={(ElementEvent e) => {
                        // What a drag from here takes: everything selected on the desktop, if this is, or just this.
                        Vec<string> paths = Vec.create();
                        if (picked(s, n)) {
                          for (i32 k = 0; k < s.picked.len(); k++) { if (s.picked[k][0] != "\0") { paths.push(join("Desktop", s.picked[k])); } }
                        } else {
                          paths.push(path);
                        }
                        pressFiles(d, paths.toArray());
                        bumpDesk();
                      }}
                      onclick={(ElementEvent e) => { pick(s, n, e); bump(); }}
                      onpointermove={drag && dir ? (ElementEvent e) => { hover(d, path, n); } : null}
                      ondblclick={(ElementEvent e) => { openPath(d, path, dir); bumpDesk(); }}>
      <div class={"dtile c-\{ic}"}>{icon(ic, "lg")}</div><span class="dname">{n}</span></div>;
  }
  return <div class="dicons">{out}</div>;
}

/** Files let go of over a place that takes them: moved there, copied with Ctrl held, or put in the Trash. */
async void dropFiles(Desk d, Page page, FileDrag f, fn<void()> bump) {
  if (f.over == TRASH && !f.copy) {
    Got<string[]> r = await toTrash(d.fs, f.paths, nowMillis(page));
    if (!r.ok) { d.error = r.error; }
    if (r.value.len() > 0) {
      d.note = "Moved \{f.paths.len() == 1 ? leafOf(f.paths[0]) : plural(f.paths.len(), "item")} to the Trash";
      d.undo = r.value;
    }
  } else {
    i32 n = 0;
    for (i32 i = 0; i < f.paths.len(); i++) {
      Got<string> r = f.copy ? await copyInto(d.fs, f.paths[i], f.over) : await moveInto(d.fs, f.paths[i], f.over);
      if (!r.ok) { d.error = r.error; continue; }
      n++;
      if (!f.copy) { moved(d, f.paths[i], join(f.over, r.value)); }
    }
    if (n > 0) {
      d.note = "\{f.copy ? "Copied" : "Moved"} \{n == 1 && f.paths.len() == 1 ? leafOf(f.paths[0]) : plural(n, "item")} to \{f.overName}";
    }
  }
  d.fsRev++;
  bump();
}

async void undoTrash(Desk d, fn<void()> bump) {
  string[] names = d.undo;
  d.undo = string[]();
  Got<i32> r = await restoreFromTrash(d.fs, names);
  if (!r.ok) { d.error = r.error; }
  d.note = r.value > 0 ? "Put back \{plural(r.value, "item")}" : "";
  d.fsRev++;
  bump();
}

// ── a window's contents ─────────────────────────────────────────────────────

Node WinBody(Ui ui, Desk d, Win w, Page page, fn<void()> bumpDesk, i32 fsRev, i32 rev, string drop, i32 clipN) {
  if (w.app == "files") { return <FilesApp d={d} w={w} page={page} bumpDesk={bumpDesk} fsRev={fsRev} rev={rev} drop={drop} clipN={clipN}/>; }
  if (w.app == "calc") { return <CalcApp d={d} w={w} page={page} bumpDesk={bumpDesk} fsRev={fsRev} rev={rev}/>; }
  if (w.app == "terminal") { return <TerminalApp d={d} w={w} page={page} bumpDesk={bumpDesk} fsRev={fsRev} rev={rev}/>; }
  if (w.app == "editor") { return <EditorApp d={d} w={w} page={page} bumpDesk={bumpDesk} fsRev={fsRev} rev={rev}/>; }
  return <ViewerApp d={d} w={w} page={page} bumpDesk={bumpDesk} fsRev={fsRev} rev={rev}/>;
}

// ── the taskbar ─────────────────────────────────────────────────────────────

string two(i32 n) { return n < 10 ? "0\{n}" : "\{n}"; }

Node Clock(Ui ui, Page page) {
  auto tick = ui.state(0);
  ui.every(10000, () => { tick.update((i32 v) => v + 1); });
  // The wall clock comes from the system, and the page is told nothing about time zones: so it says UTC.
  i64 secs = nowMillis(page) / 1000;
  i32 mins = ((secs / 60) % 1440) as! i32;
  return <span class="clock num" title="The page is not told your time zone">{two(mins / 60)}:{two(mins % 60)} <span class="tz">UTC</span></span>;
}

Node taskbar(Desk d, Page page, fn<void()> bump) {
  Node[] buttons = Node[].filled(d.wins.len(), Node.Text(""));
  for (i32 i = 0; i < d.wins.len(); i++) {
    Win w = d.wins.get(i);
    i32 id = w.id;
    string cls = "tbwin" + (d.focused == w.id && !w.min ? " on" : "") + (w.min ? " min" : "");
    buttons[i] = <button class={cls} key={"\{w.id}"} title={w.title}
                         onclick={(ElementEvent e) => { taskbarClick(d, id); bump(); }}>
      <span class={"ic sm i-\{w.icon} c-\{w.icon}"}></span><span class="t">{w.title}</span></button>;
  }
  return <div class="taskbar">
    <button class={d.launcher ? "tblaunch on" : "tblaunch"} title="Apps"
            onclick={(ElementEvent e) => { d.launcher = !d.launcher; bump(); }}>{icon("grid", "")}</button>
    <div class="tbwins">{buttons}</div>
    <div class="tbright">
      <span class={d.fs.persistent ? "pill" : "pill warn"}
            title={d.fs.persistent ? "Your files are kept in this browser's storage." : "This page was opened from a file, so the browser gives it no storage: files are kept until the tab closes. Serve the page over http to keep them."}>
        {icon(d.fs.persistent ? "shield" : "alert", "sm")}{d.fs.persistent ? "Saved in this browser" : "Not saved"}</span>
      <Clock page={page}/>
    </div>
  </div>;
}

Node launcherItem(string ic, string title, string sub, fn<void()> go) {
  return <button class="litem" onclick={(ElementEvent e) => { go(); }}>
    <span class={"ltile c-\{ic}"}>{icon(ic, "")}</span>
    <span class="ltext"><span class="lt">{title}</span><span class="ls">{sub}</span></span></button>;
}

Node launcher(Desk d, fn<void()> bump) {
  return <div class="launcher anim">
    <div class="lhead">Apps</div>
    {launcherItem("home", "Files", "Your home folder", () => { open(d, "files", "", "Home", "home"); bump(); })}
    {launcherItem("folder", "Desktop", "The files on your desktop", () => { open(d, "files", "Desktop", "Desktop", "folder"); bump(); })}
    {launcherItem("terminal", "Terminal", "A shell on this desktop's disk", () => { open(d, "terminal", "Desktop", "Terminal", "terminal"); bump(); })}
    {launcherItem("edit", "Text editor", "A new text file", () => { open(d, "editor", "", "Untitled", "edit"); bump(); })}
    {launcherItem("calc", "Calculator", "Sums, typed or clicked", () => { open(d, "calc", "", "Calculator", "calc"); bump(); })}
    {launcherItem("trash", "Trash", "What was deleted, to restore or let go", () => { open(d, "files", TRASH, "Trash", "trash"); bump(); })}
    {launcherItem("text", "Welcome", "What this is, and what to try", () => { open(d, "viewer", "Desktop/Welcome.md", "Welcome.md", "text"); bump(); })}
    <div class="lfoot">{d.fs.persistent ? "Files are kept in this browser." : "Opened from a file: nothing is kept after the tab closes."}</div>
  </div>;
}

// ── window frames ───────────────────────────────────────────────────────────

Node frame(Desk d, Win w, Page page, fn<void()> bump, string drop) {
  i32 id = w.id;
  Drag? g = d.drag;
  bool moving = (g is not null) && g!.id == id && g!.moved;
  string cls = "win" + (d.focused == id ? " focus" : "") + (w.max ? " max" : "") + (w.snap == 1 ? " snapl" : "")
             + (w.snap == 2 ? " snapr" : "") + (w.min ? " min" : "") + (moving ? " moving" : "");
  string style = "left:\{w.x}px;top:\{w.y}px;width:\{w.w}px;height:\{w.h}px;z-index:\{w.z}";
  string[] edges = ["n", "s", "e", "w", "ne", "nw", "se", "sw"];
  Node[] handles = Node[].filled(edges.len(), Node.Text(""));
  if (!w.max) {
    for (i32 k = 0; k < edges.len(); k++) {
      string edge = edges[k];
      // Where the handle sits in the window, which is where its event's x and y are measured from.
      i32 hx = edge == "e" ? w.w - 4 : (edge == "ne" || edge == "se" ? w.w - 12 : (edge == "n" || edge == "s" ? 10 : -4));
      i32 hy = edge == "s" ? w.h - 4 : (edge == "se" || edge == "sw" ? w.h - 12 : (edge == "e" || edge == "w" ? 10 : -4));
      handles[k] = <div class={"rz \{edge}"} onpointerdown={(ElementEvent e) => { startResize(d, id, edge, w.x + 1 + hx + e.x, w.y + 1 + hy + e.y); bump(); }}></div>;
    }
  }
  // A window takes no drop of its own — only a Files window does, and says so before this hears of it —
  // but it is in the way of the desktop behind it.
  return <div class={cls} style={style} key={"w\{id}"}
              onpointermove={dragging(drop) ? (ElementEvent e) => { hover(d, null, ""); } : null}
              onpointerdown={(ElementEvent e) => { if (d.focused != id || d.launcher) { focus(d, id); bump(); } }}>
    <div class="tbar"
         onpointerdown={(ElementEvent e) => { startMove(d, id, w.x + 1 + e.x, w.y + 1 + e.y); bump(); }}
         ondblclick={(ElementEvent e) => { toggleMax(d, id); bump(); }}>
      <span class={"ic sm i-\{w.icon} c-\{w.icon}"}></span>
      <span class="tt">{w.title}</span>
      <div class="wbtns">
        <button class="wbtn" title="Minimise" onclick={(ElementEvent e) => { minimise(d, id); bump(); }}>{icon("min", "sm")}</button>
        <button class="wbtn" title={w.max || w.snap != 0 ? "Restore" : "Maximise"} onclick={(ElementEvent e) => { toggleMax(d, id); bump(); }}>{icon(w.max || w.snap != 0 ? "restore" : "max", "sm")}</button>
        <button class="wbtn close" title="Close" onclick={(ElementEvent e) => { close(d, id); bump(); }}>{icon("close", "sm")}</button>
      </div>
    </div>
    <div class="wbody"><WinBody key={"b\{id}"} d={d} w={w} page={page} bumpDesk={bump} fsRev={d.fsRev} rev={w.rev} drop={drop} clipN={d.clip.len()}/></div>
    {handles}
  </div>;
}

// ── the desktop ─────────────────────────────────────────────────────────────

export Node Desktop(Ui ui, Page page) {
  // A disk to stand on until `start` has chosen the real one, a moment later.
  Desk d = ui.memo<Desk>("", () => newDesk(vfsOf(MemoryStore.create(page.sys.clock()).asUser("root"), ProcTable.create(), false)));
  auto version = ui.state(0);
  auto ready = ui.state(false);
  fn<void()> bump = () => { version.update((i32 v) => v + 1); };
  ui.effect("", () => {
    start(page, d, bump, () => { ready.set(true); });
    return () => { };
  });
  // The watchdog: opening that was still "in progress" when a timer ran has trapped.
  ui.every(400, () => {
    if (d.trying == "") { return; }
    d.error = d.trying;
    d.trying = "";
    bump();
  });
  // The layout, saved a second after it changes — and notes, gone a few seconds after they appear.
  ui.every(1000, () => {
    if (ready.get() && d.dirty && d.drag is null) { saveSession(d); }
  });
  ui.effect("\{d.note}|\{d.error}", () => {
    if (d.note == "" && d.error == "") { return () => { }; }
    string note = d.note;
    string error = d.error;
    return ui.after(error != "" ? 8000 : (d.undo.len() > 0 ? 7000 : 3500), () => {
      if (d.note == note) { d.note = ""; d.undo = string[](); }
      if (d.error == error) { d.error = ""; }
      bump();
    });
  });

  Drag? g = d.drag;
  FileDrag? f = d.fdrag;
  // Pressed is listening for where the pointer goes; dragging is once it has gone somewhere.
  bool pressed = (g is not null) || (f is not null);
  bool dragging = (g is not null) && g!.moved;
  bool carrying = (f is not null) && f!.moved;
  string drop = dropKey(d);
  Node[] frames = Node[].filled(d.wins.len(), Node.Text(""));
  for (i32 i = 0; i < d.wins.len(); i++) { frames[i] = frame(d, d.wins.get(i), page, bump, drop); }
  i32 hint = dragging ? g!.hint : 0;
  string cursor = dragging ? (g!.mode == "move" ? "" : " rz-\{g!.mode}") : "";

  Node ghost = Node.Text("");
  if (carrying) {
    FileDrag c = f!;
    string what = c.paths.len() == 1 ? leafOf(c.paths[0]) : plural(c.paths.len(), "item");
    string ic = c.paths.len() == 1 ? iconFor(leafOf(c.paths[0])) : "layers";
    ghost = <div class={c.hasOver ? "fghost ok" : "fghost"} style={"left:\{c.x + 14}px;top:\{c.y + 12}px"}>
      <span class={"ic sm i-\{ic} c-\{ic}"}></span><span class="fwhat">{what}</span>
      {c.hasOver ? <span class="fto">{c.over == TRASH && !c.copy ? "→ the Trash" : (c.copy ? "+ copy to " : "→ ") + (c.over == TRASH ? "the Trash" : c.overName)}</span> : Node.Text("")}
    </div>;
  }
  return <div class={"desk" + (dragging || carrying ? " dragging" : "") + (carrying ? " carrying" : "") + cursor}
              onpointermove={pressed ? (ElementEvent e) => {
                if (d.fdrag is not null) {
                  if (dragFilesTo(d, e.x, e.y, (e.mods & (MOD_CTRL | MOD_META)) != 0)) { bump(); }
                } else if (dragTo(d, e.x, e.y)) { bump(); }
              } : null}
              onpointerup={pressed ? (ElementEvent e) => {
                FileDrag? done = d.fdrag;
                d.fdrag = null;
                if ((done is not null) && done!.moved && done!.hasOver) {
                  done!.copy = (e.mods & (MOD_CTRL | MOD_META)) != 0;
                  dropFiles(d, page, done!, bump);
                }
                endDrag(d);
                bump();
              } : null}>
    <style>{css()}</style>
    <style>{deskCss()}</style>
    <div class="area" onpointerdown={(ElementEvent e) => { if (d.launcher) { d.launcher = false; bump(); } }}
         onpointermove={carrying ? (ElementEvent e) => { hover(d, "Desktop", "the desktop"); } : null}>
      {ready.get() ? <DesktopIcons d={d} bumpDesk={bump} fsRev={d.fsRev} drop={drop}/> : <div class="booting"><span class="spin"></span>Starting…</div>}
      {frames}
      {hint == 1 ? <div class="snapghost l"></div> : (hint == 2 ? <div class="snapghost r"></div> : (hint == 3 ? <div class="snapghost m"></div> : Node.Text("")))}
      {dragging && g!.mode == "move" ? <div class="edge-r" onpointermove={(ElementEvent e) => { hintRight(d); bump(); }}></div> : Node.Text("")}
    </div>
    {d.launcher ? launcher(d, bump) : Node.Text("")}
    {d.error != "" ? <div class="toast bad">{icon("alert", "sm")}<span>{d.error}</span></div>
                   : (d.note != "" ? <div class="toast">{icon("check", "sm")}<span>{d.note}</span>
                                       {d.undo.len() > 0 ? <button class="tundo" onclick={(ElementEvent e) => { undoTrash(d, bump); }}>Undo</button> : Node.Text("")}</div>
                                   : Node.Text(""))}
    {ghost}
    {taskbar(d, page, bump)}
  </div>;
}
