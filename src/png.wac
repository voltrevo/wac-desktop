// PNG, both ways: a picture written as Mandelbrot and Paint save one, and read back from any PNG a person has.
//
// **Written as one kind**: eight-bit RGBA, not interlaced, each row filtered by its left neighbour — which a smooth
// picture compresses well after — and deflated as zlib wants it, with its Adler-32 after.
//
// **Read as every kind** the format has (ISO 15948): greyscale, RGB, a palette, greyscale with alpha and RGBA; one to
// sixteen bits a sample; Adam7's seven passes; and transparency given by `tRNS`. Each comes out as eight-bit RGBA,
// row by row, which is what a canvas is drawn from. A picture larger than `MOST_PIXELS` is refused rather than
// allocated, and so is anything whose data does not add up — a short row, a bad filter, a palette index past the
// palette — with a reason a person can read; the checksums are not checked, as browsers do not.

import { Result, Vec } from "core";
import { gzip.crc32, gzip.deflateDynamic, gzip.inflateResult } from "wac";

/**
 * The most pixels a picture read may have: 4096 × 4096, 64 MB as RGBA — and Paint keeps two more of it, a copy and a
 * mask, for the stroke under way.
 */
export static i32 MOST_PIXELS = 16777216;

/** A picture: `w` by `h`, four bytes a pixel — red, green, blue and alpha — row by row from the top. */
export struct Picture {
  i32 w;
  i32 h;
  u8[] rgba;
}

// ── Writing ─────────────────────────────────────────────────────────────────

void putU32(Vec<u8> out, u32 v) {
  out.push((v >> 24) as@ u8);
  out.push((v >> 16) as@ u8);
  out.push((v >> 8) as@ u8);
  out.push(v as@ u8);
}

void chunk(Vec<u8> out, string kind, u8[] data) {
  putU32(out, data.len() as@ u32);
  u8[] typed = u8[].filled(4 + data.len(), 0 as u8);
  typed.copyFrom(kind.toBytes(), 0, 0, 4);
  typed.copyFrom(data, 0, 4, data.len());
  for (i32 i = 0; i < typed.len(); i++) { out.push(typed[i]); }
  putU32(out, crc32(typed));
}

/** `rgba`, `w` by `h`, as a PNG. */
export u8[] encodePng(i32 w, i32 h, u8[] rgba) {
  i32 row = w * 4 + 1;
  u8[] raw = u8[].filled(row * h, 0 as u8);
  for (i32 y = 0; y < h; y++) {
    raw[y * row] = 1 as u8;
    for (i32 i = 0; i < w * 4; i++) {
      i32 cur = rgba[y * w * 4 + i] as i32;
      i32 left = i >= 4 ? rgba[y * w * 4 + i - 4] as i32 : 0;
      raw[y * row + 1 + i] = ((cur - left) & 255) as@ u8;
    }
  }
  u32 a = 1 as u32;
  u32 b = 0 as u32;
  for (i32 i = 0; i < raw.len(); i++) {
    a = (a + (raw[i] as u32)) % (65521 as u32);
    b = (b + a) % (65521 as u32);
  }
  u8[] deflated = deflateDynamic(raw);
  u8[] z = u8[].filled(deflated.len() + 6, 0 as u8);
  z[0] = 0x78 as u8;
  z[1] = 0x01 as u8;
  z.copyFrom(deflated, 0, 2, deflated.len());
  u32 adler = (b << 16) | a;
  for (i32 k = 0; k < 4; k++) { z[deflated.len() + 2 + k] = (adler >> ((24 - 8 * k) as@ u32)) as@ u8; }
  Vec<u8> out = Vec.create();
  u8[] sig = signature();
  for (i32 i = 0; i < sig.len(); i++) { out.push(sig[i]); }
  Vec<u8> head = Vec.create();
  putU32(head, w as@ u32);
  putU32(head, h as@ u32);
  head.push(8 as u8);
  head.push(6 as u8);
  head.push(0 as u8);
  head.push(0 as u8);
  head.push(0 as u8);
  chunk(out, "IHDR", head.toArray());
  chunk(out, "IDAT", z);
  chunk(out, "IEND", u8[]());
  return out.toArray();
}

u8[] signature() { return [0x89 as u8, 'P', 'N', 'G', 0x0D as u8, 0x0A as u8, 0x1A as u8, 0x0A as u8]; }

// ── Reading ─────────────────────────────────────────────────────────────────

/** Whether `b` starts as a PNG does. */
export bool isPng(u8[] b) {
  u8[] sig = signature();
  if (b.len() < sig.len()) { return false; }
  for (i32 i = 0; i < sig.len(); i++) { if (b[i] != sig[i]) { return false; } }
  return true;
}

/** The big-endian word at `at`, as a non-negative i64 (a length or a size can use all 31 bits and more). */
i64 word(u8[] b, i32 at) {
  return ((b[at] as i64) << 24) | ((b[at + 1] as i64) << 16) | ((b[at + 2] as i64) << 8) | (b[at + 3] as i64);
}

/** What the header says, and what was gathered from the chunks after it. */
struct Header {
  i32 w;
  i32 h;
  i32 depth;
  i32 colour;
  bool interlaced;
  /** The palette, three bytes an entry, and each entry's alpha (255 unless `tRNS` says otherwise). */
  u8[] palette;
  u8[] paletteAlpha;
  /** For greyscale and RGB, the one colour that is transparent, in the image's own sample values; -1 for none. */
  i32 keyR;
  i32 keyG;
  i32 keyB;
}

/** Samples a pixel has, for each colour type. */
i32 channels(i32 colour) {
  if (colour == 0 || colour == 3) { return 1; }
  if (colour == 2) { return 3; }
  if (colour == 4) { return 2; }
  return 4;
}

/** Whether `depth` is allowed with colour type `colour`. */
bool allowed(i32 colour, i32 depth) {
  if (colour == 0) { return depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16; }
  if (colour == 3) { return depth == 1 || depth == 2 || depth == 4 || depth == 8; }
  if (colour == 2 || colour == 4 || colour == 6) { return depth == 8 || depth == 16; }
  return false;
}

/** A PNG read into a `Picture`, or why it cannot be. */
export Result<Picture, string> decodePng(u8[] b) {
  if (!isPng(b)) { return Result.Err("not a PNG"); }
  i32 at = 8;
  bool seenHeader = false;
  bool ended = false;
  Header hd = Header(0, 0, 0, 0, false, u8[](), u8[](), 0 - 1, 0 - 1, 0 - 1);
  Vec<u8[]> data = Vec.create();
  i32 dataLen = 0;
  while (at + 8 <= b.len() && !ended) {
    i64 len64 = word(b, at);
    if (len64 > (b.len() - at - 12) as i64) { return Result.Err("a chunk runs past the end of the file"); }
    i32 len = len64 as~ i32;
    string kind = string.fromBytes(sliced(b, at + 4, 4));
    i32 body = at + 8;
    if (!seenHeader && kind != "IHDR") { return Result.Err("the header is not first"); }
    if (kind == "IHDR") {
      if (len < 13) { return Result.Err("the header is short"); }
      i64 w = word(b, body);
      i64 h = word(b, body + 4);
      if (w < 1 as i64 || h < 1 as i64) { return Result.Err("a picture with no pixels"); }
      if (w > 65535 as i64 || h > 65535 as i64 || w * h > MOST_PIXELS as i64) {
        return Result.Err("\{w} × \{h} is too large to open");
      }
      hd.w = w as~ i32;
      hd.h = h as~ i32;
      hd.depth = b[body + 8] as i32;
      hd.colour = b[body + 9] as i32;
      if (!allowed(hd.colour, hd.depth)) { return Result.Err("colour type \{hd.colour} at \{hd.depth} bits is not a PNG's"); }
      if (b[body + 10] != 0 as u8 || b[body + 11] != 0 as u8) { return Result.Err("an unknown compression or filter method"); }
      if (b[body + 12] > 1 as u8) { return Result.Err("an unknown interlace method"); }
      hd.interlaced = b[body + 12] == 1 as u8;
      seenHeader = true;
    } else if (kind == "PLTE") {
      if (len % 3 != 0 || len > 768) { return Result.Err("a palette of \{len} bytes"); }
      hd.palette = sliced(b, body, len);
      hd.paletteAlpha = u8[].filled(len / 3, 255 as u8);
    } else if (kind == "tRNS") {
      if (hd.colour == 3) {
        for (i32 i = 0; i < len && i < hd.paletteAlpha.len(); i++) { hd.paletteAlpha[i] = b[body + i]; }
      } else if (hd.colour == 0 && len >= 2) {
        hd.keyR = ((b[body] as i32) << 8) | (b[body + 1] as i32);
      } else if (hd.colour == 2 && len >= 6) {
        hd.keyR = ((b[body] as i32) << 8) | (b[body + 1] as i32);
        hd.keyG = ((b[body + 2] as i32) << 8) | (b[body + 3] as i32);
        hd.keyB = ((b[body + 4] as i32) << 8) | (b[body + 5] as i32);
      }
    } else if (kind == "IDAT") {
      data.push(sliced(b, body, len));
      dataLen = dataLen + len;
    } else if (kind == "IEND") {
      ended = true;
    }
    at = body + len + 4;
  }
  if (!seenHeader) { return Result.Err("no header"); }
  if (dataLen < 3) { return Result.Err("no picture data"); }
  if (hd.colour == 3 && hd.palette.len() == 0) { return Result.Err("a palette picture with no palette"); }
  u8[] z = u8[].filled(dataLen, 0 as u8);
  i32 put = 0;
  for (i32 i = 0; i < data.len(); i++) {
    z.copyFrom(data.get(i), 0, put, data.get(i).len());
    put = put + data.get(i).len();
  }
  // zlib: a method byte and a flags byte, then deflate, then the Adler-32 the inflater does not reach.
  if ((z[0] & (15 as u8)) != 8 as u8) { return Result.Err("the data is not deflated"); }
  if ((z[1] & (32 as u8)) != 0 as u8) { return Result.Err("the data needs a preset dictionary"); }
  match (inflateResult(sliced(z, 2, z.len() - 2))) {
    Ok(raw): { return unpack(hd, raw); }
    Err(why): { return Result.Err("the data is damaged: \{why}"); }
  }
}

/** `n` bytes of `b` from `at`. */
u8[] sliced(u8[] b, i32 at, i32 n) {
  u8[] out = u8[].filled(n, 0 as u8);
  out.copyFrom(b, at, 0, n);
  return out;
}

/** Each of Adam7's passes: where its first pixel is, and how far apart its pixels are, across and down. */
i32[] passes() { return [0, 0, 8, 8, 4, 0, 8, 8, 0, 4, 4, 8, 2, 0, 4, 4, 0, 2, 2, 4, 1, 0, 2, 2, 0, 1, 1, 2]; }

/** The inflated rows unfiltered and turned into RGBA, pass by pass when interlaced. */
Result<Picture, string> unpack(Header hd, u8[] raw) {
  Picture p = Picture(hd.w, hd.h, u8[].filled(hd.w * hd.h * 4, 0 as u8));
  i32 bitsPerPixel = channels(hd.colour) * hd.depth;
  // How far back the pixel to the left is, in bytes, for the filters: at least one.
  i32 bpp = bitsPerPixel < 8 ? 1 : bitsPerPixel / 8;
  i32 at = 0;
  i32[] ps = hd.interlaced ? passes() : [0, 0, 1, 1];
  for (i32 k = 0; k < ps.len(); k = k + 4) {
    i32 x0 = ps[k];
    i32 y0 = ps[k + 1];
    i32 dx = ps[k + 2];
    i32 dy = ps[k + 3];
    i32 pw = hd.w > x0 ? (hd.w - x0 + dx - 1) / dx : 0;
    i32 ph = hd.h > y0 ? (hd.h - y0 + dy - 1) / dy : 0;
    if (pw == 0 || ph == 0) { continue; }
    i32 stride = (pw * bitsPerPixel + 7) / 8;
    if (at + (stride + 1) * ph > raw.len()) { return Result.Err("the picture data is short"); }
    u8[] prev = u8[].filled(stride, 0 as u8);
    u8[] cur = u8[].filled(stride, 0 as u8);
    for (i32 y = 0; y < ph; y++) {
      i32 filter = raw[at] as i32;
      at++;
      for (i32 i = 0; i < stride; i++) {
        i32 x = raw[at + i] as i32;
        i32 a = i >= bpp ? cur[i - bpp] as i32 : 0;
        i32 b = prev[i] as i32;
        i32 c = i >= bpp ? prev[i - bpp] as i32 : 0;
        i32 v = 0;
        if (filter == 0) { v = x; }
        else if (filter == 1) { v = x + a; }
        else if (filter == 2) { v = x + b; }
        else if (filter == 3) { v = x + (a + b) / 2; }
        else if (filter == 4) { v = x + paeth(a, b, c); }
        else { return Result.Err("row filter \{filter} is not a PNG's"); }
        cur[i] = (v & 255) as@ u8;
      }
      at = at + stride;
      string bad = row(hd, cur, pw, p, x0, y0 + y * dy, dx);
      if (bad != "") { return Result.Err(bad); }
      u8[] t = prev;
      prev = cur;
      cur = t;
    }
  }
  return Result.Ok(p);
}

i32 paeth(i32 a, i32 b, i32 c) {
  i32 p = a + b - c;
  i32 pa = p > a ? p - a : a - p;
  i32 pb = p > b ? p - b : b - p;
  i32 pc = p > c ? p - c : c - p;
  if (pa <= pb && pa <= pc) { return a; }
  if (pb <= pc) { return b; }
  return c;
}

/** Sample `i` of a row of `depth`-bit samples, as it is (0 to 2^depth − 1). */
i32 sample(u8[] r, i32 i, i32 depth) {
  if (depth == 8) { return r[i] as i32; }
  if (depth == 16) { return ((r[2 * i] as i32) << 8) | (r[2 * i + 1] as i32); }
  i32 bit = i * depth;
  i32 shift = 8 - depth - bit % 8;
  return ((r[bit / 8] as i32) >> shift) & ((1 << depth) - 1);
}

/** A sample of `depth` bits scaled to eight. */
i32 eight(i32 v, i32 depth) {
  if (depth == 8) { return v; }
  if (depth == 16) { return v >> 8; }
  return v * 255 / ((1 << depth) - 1);
}

/** One unfiltered row of `pw` pixels, put into the picture at row `y`, from column `x0` every `dx`; or what is wrong. */
string row(Header hd, u8[] r, i32 pw, Picture p, i32 x0, i32 y, i32 dx) {
  i32 n = channels(hd.colour);
  for (i32 i = 0; i < pw; i++) {
    i32 o = (y * p.w + x0 + i * dx) * 4;
    i32 cr = 0;
    i32 cg = 0;
    i32 cb = 0;
    i32 ca = 255;
    if (hd.colour == 3) {
      i32 k = sample(r, i, hd.depth);
      if (k * 3 + 2 >= hd.palette.len()) { return "a pixel names palette entry \{k}, past the palette's \{hd.palette.len() / 3}"; }
      cr = hd.palette[k * 3] as i32;
      cg = hd.palette[k * 3 + 1] as i32;
      cb = hd.palette[k * 3 + 2] as i32;
      ca = hd.paletteAlpha[k] as i32;
    } else if (hd.colour == 0 || hd.colour == 4) {
      i32 g = sample(r, i * n, hd.depth);
      cr = eight(g, hd.depth);
      cg = cr;
      cb = cr;
      if (hd.colour == 4) { ca = eight(sample(r, i * n + 1, hd.depth), hd.depth); }
      else if (g == hd.keyR) { ca = 0; }
    } else {
      i32 sr = sample(r, i * n, hd.depth);
      i32 sg = sample(r, i * n + 1, hd.depth);
      i32 sb = sample(r, i * n + 2, hd.depth);
      cr = eight(sr, hd.depth);
      cg = eight(sg, hd.depth);
      cb = eight(sb, hd.depth);
      if (hd.colour == 6) { ca = eight(sample(r, i * n + 3, hd.depth), hd.depth); }
      else if (sr == hd.keyR && sg == hd.keyG && sb == hd.keyB) { ca = 0; }
    }
    p.rgba[o] = cr as@ u8;
    p.rgba[o + 1] = cg as@ u8;
    p.rgba[o + 2] = cb as@ u8;
    p.rgba[o + 3] = ca as@ u8;
  }
  return "";
}
