// The last step of the build: the site's programs where the desktop starts them, and the site's `index.json`.
//
//     wac run --allow-read --allow-write site.wac dist
//
// **The desktop's own apps are programs on the site** (`src/desk/builtin.wac`). Each app's build leaves its module as
// `dist/apps/<name>/page.wasm`, beside the page it is on its own — and the Archive Explorer's as
// `dist/explorer/page.wasm` — and each is copied to `dist/apps/<name>.wasm`, which the desktop, served over http,
// reads as `/site/apps/<name>.wasm` and starts as it starts any program, its folder `.apps/<name>` named after it.
// Then `index.json` (web's `indexSite`), which is how the desktop lists the site and knows its sizes, since a site
// can only be asked for a file.

import { Files, Sys } from "std";
import { flatten } from "core";
import { indexSite } from "webbuild";

/** Copy `from` to `to`: `""`, or what went wrong. */
string copied(Files fs, string from, string to) {
  auto module = flatten(fs.readFile(from).wait());
  if (module.isErr()) { return "\{from}: \{module.err()!}"; }
  auto wrote = flatten(fs.writeFile(to, module.ok()!).wait());
  if (wrote.isErr()) { return "\{to}: \{wrote.err()!}"; }
  return "";
}

export i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() != 1) {
    sys.stderr().line("usage: site.wac <site-dir>");
    return 2;
  }
  string root = args[0];
  Files fs = sys.files();
  auto made = flatten(fs.mkdir(root + "/apps", true).wait());
  if (made.isErr()) {
    sys.stderr().line("site.wac: \{root}/apps: \{made.err()!}");
    return 1;
  }
  string why = copied(fs, root + "/explorer/page.wasm", root + "/apps/explorer.wasm");
  auto listed = flatten(fs.readDir(root + "/apps").wait());
  if (listed.isErr()) { why = "\{root}/apps: \{listed.err()!}"; }
  string[] names = listed.isOk() ? listed.ok()! : string[]();
  i32 apps = 1;
  for (i32 i = 0; i < names.len() && why == ""; i++) {
    auto st = flatten(fs.stat(root + "/apps/" + names[i]).wait());
    if (st.isErr() || !st.ok()!.isDir) { continue; }
    why = copied(fs, root + "/apps/" + names[i] + "/page.wasm", root + "/apps/" + names[i] + ".wasm");
    apps++;
  }
  if (why != "") {
    sys.stderr().line("site.wac: " + why + " — build the apps first (wac task build)");
    return 1;
  }
  sys.stdout().line("\{root}/apps: \{apps} programs");
  why = indexSite(fs, sys.stdout(), root);
  if (why != "") {
    sys.stderr().line("site.wac: " + why);
    return 1;
  }
  return 0;
}
