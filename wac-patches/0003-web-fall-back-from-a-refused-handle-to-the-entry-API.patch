From 71bdb1fdce3f6bf3c0ba851f9f441784d96da0fb Mon Sep 17 00:00:00 2001
From: Andrew Morris <andrew.morris@ethereum.org>
Date: Tue, 27 Oct 2026 23:43:24 +0000
Subject: [PATCH 3/4] web: fall back from a refused handle to the entry API;
 say when a dropped folder cannot be listed

A handle the browser refuses (as in a sandboxed frame) now falls back to the drop's
directory entry rather than to reading the folder as a file. Where listing a dropped
folder fails, as it does for a file:// page in browsers without handles, the error
says it was a dropped folder, so a program can offer something that works.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7c8hTEmTN5s7KvmrRMqXX
---
 packages/web/tools/build.wac | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/packages/web/tools/build.wac b/packages/web/tools/build.wac
index 26e6f91fb..90efb86aa 100644
--- a/packages/web/tools/build.wac
+++ b/packages/web/tools/build.wac
@@ -699,10 +699,12 @@ export string documentSide() {
           if (entry.isFile) {
             entry.file((f) => send(f, rel(entry.fullPath)), (e) => failed(rel(entry.fullPath), e));
           } else if (entry.isDirectory) {
+            // Some browsers refuse to list a dropped folder on a page opened from a `file://` URL: the
+            // error says it was a folder, so a program can say what to do instead.
             const reader = entry.createReader();
             const more = () => reader.readEntries(
               (batch) => { if (batch.length > 0) { batch.forEach(walk); more(); } },
-              (e) => failed(rel(entry.fullPath), e));
+              (e) => failed(rel(entry.fullPath), `a dropped folder could not be listed here (${e?.name}: ${e?.message})`));
             more();
           }
         };
@@ -721,13 +723,16 @@ export string documentSide() {
         const dropped = (dt) => {
           const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
           const files = [...(dt?.files ?? [])];
+          // Both are asked for now, while the drop's items can still answer: a handle the browser then
+          // refuses — as it may in a sandboxed frame — falls back to the entry, and that to the file.
+          const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
+          const instead = (i) => entries[i] ? walk(entries[i]) : take([files[i]]);
           if (items.length > 0 && items.every((it) => it.getAsFileSystemHandle)) {
             items.map((it) => it.getAsFileSystemHandle()).forEach((pending, i) => pending.then(
-              (h) => h ? walkHandle(h, h.name) : take([files[i]]),
-              () => take([files[i]])));
+              (h) => h ? walkHandle(h, h.name) : instead(i),
+              () => instead(i)));
             return;
           }
-          const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
           if (entries.length > 0 && entries.every((x) => x !== null)) entries.forEach(walk);
           else take(dt?.files);
         };
