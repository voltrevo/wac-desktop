From 2a6ca392bc1d7d066f8641d591ed076f1788d6a0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 01:39:17 +0000
Subject: [PATCH] wacc: grow the generic instantiations table instead of
 declining a large module

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7c8hTEmTN5s7KvmrRMqXX
---
 packages/wacc/src/emit.wac | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/packages/wacc/src/emit.wac b/packages/wacc/src/emit.wac
index 665cd6c0e..e05957020 100644
--- a/packages/wacc/src/emit.wac
+++ b/packages/wacc/src/emit.wac
@@ -2172,9 +2172,16 @@ export struct Env {
     for (i32 i = 0; i < this.instCount; i++) {
       if (this.instName[i] == inst) { return; }
     }
+    // **Grown as it fills**, like the lambda capture tables: a fixed table declined a module that
+    // named one generic instantiation more than it had room for, and a program that combines a shell
+    // with an application reaches that by being large rather than by being wrong.
     if (this.instCount >= this.instName.len()) {
-      this.ranOut("generic instantiations");
-      return;
+      i32 grown = this.instName.len() < 64 ? 64 : this.instName.len() * 2;
+      string[] nn = string[].filled(grown, "");
+      string[] no = string[].filled(grown, "");
+      for (i32 i = 0; i < this.instCount; i++) { nn[i] = this.instName[i]; no[i] = this.instOf[i]; }
+      this.instName = nn;
+      this.instOf = no;
     }
     this.instName[this.instCount] = inst;
     this.instOf[this.instCount] = of;
-- 
