From 0597a1e538287905fdc20412df699298a66ebf39 Mon Sep 17 00:00:00 2001
From: Andrew Morris <andrew.morris@ethereum.org>
Date: Wed, 28 Oct 2026 00:13:52 +0000
Subject: [PATCH 4/4] web: read a dropped file as a file, and walk only folders

Every dropped item went through the entry API, and some browsers (Brave, Firefox,
Safari: those without FileSystemHandle) cannot read even a lone file that way on a
page opened from a file:// URL, so dropping a file failed with an EncodingError.
A file is read from the drop's files again, as before folders were supported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7c8hTEmTN5s7KvmrRMqXX
---
 packages/web/tools/build.wac | 25 ++++++++++++++-----------
 1 file changed, 14 insertions(+), 11 deletions(-)

diff --git a/packages/web/tools/build.wac b/packages/web/tools/build.wac
index 90efb86aa..ab8b74f83 100644
--- a/packages/web/tools/build.wac
+++ b/packages/web/tools/build.wac
@@ -718,23 +718,26 @@ export string documentSide() {
           try { for await (const kid of h.values()) await walkHandle(kid, path + "/" + kid.name); }
           catch (e) { failed(path, e); }
         };
-        // Handles and entries are taken during the event: a drop's items are unreadable once it returns.
-        // A browser with neither, or a drop of something that is not a file, falls back to `files`.
+        // **Only a folder is walked.** A dropped file is read as the file it is: through an entry, some
+        // browsers cannot read even a lone file on a page opened from a `file://` URL. Entries and handles
+        // are taken during the event, because a drop's items are unreadable once it returns; a handle the
+        // browser then refuses — as it may in a sandboxed frame — falls back to the entry. A browser with
+        // no entries at all cannot tell a folder from a file, and is given `files` as it always was.
         const dropped = (dt) => {
           const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
           const files = [...(dt?.files ?? [])];
-          // Both are asked for now, while the drop's items can still answer: a handle the browser then
-          // refuses — as it may in a sandboxed frame — falls back to the entry, and that to the file.
           const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
-          const instead = (i) => entries[i] ? walk(entries[i]) : take([files[i]]);
-          if (items.length > 0 && items.every((it) => it.getAsFileSystemHandle)) {
-            items.map((it) => it.getAsFileSystemHandle()).forEach((pending, i) => pending.then(
-              (h) => h ? walkHandle(h, h.name) : instead(i),
-              () => instead(i)));
+          if (items.length === 0 || files.length !== items.length || entries.some((x) => x === null)) {
+            take(dt?.files);
             return;
           }
-          if (entries.length > 0 && entries.every((x) => x !== null)) entries.forEach(walk);
-          else take(dt?.files);
+          const handles = items.map((it, i) =>
+            entries[i].isDirectory && it.getAsFileSystemHandle ? it.getAsFileSystemHandle() : null);
+          items.forEach((it, i) => {
+            if (!entries[i].isDirectory) take([files[i]]);
+            else if (handles[i]) handles[i].then((h) => h ? walkHandle(h, h.name) : walk(entries[i]), () => walk(entries[i]));
+            else walk(entries[i]);
+          });
         };
         root.addEventListener("change", (ev) => { if (ev.target?.files) take(ev.target.files); });
         // A link to `#/somewhere`, and the browser's back and forward, move the location; the program follows.
