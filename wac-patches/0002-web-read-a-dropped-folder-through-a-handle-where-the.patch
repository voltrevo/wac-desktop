From f7ff079535afc61e7299ca53064820a848074b70 Mon Sep 17 00:00:00 2001
From: Andrew Morris <andrew.morris@ethereum.org>
Date: Tue, 27 Oct 2026 23:36:49 +0000
Subject: [PATCH 2/4] web: read a dropped folder through a handle where the
 browser has one

readEntries fails with an EncodingError on a page opened from a file:// URL, which
is how a built page is often opened; a FileSystemHandle reads the same folder there.
The entry API stays as the fallback for browsers without handles.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7c8hTEmTN5s7KvmrRMqXX
---
 packages/web/tools/build.wac | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/packages/web/tools/build.wac b/packages/web/tools/build.wac
index 8811ac021..26e6f91fb 100644
--- a/packages/web/tools/build.wac
+++ b/packages/web/tools/build.wac
@@ -706,10 +706,27 @@ export string documentSide() {
             more();
           }
         };
-        // The entries are taken during the event: a drop's items are unreadable once it returns. A
-        // browser without them, or a drop of something that is not a file, falls back to `files`.
+        // **A handle where the browser has one** (Chrome, Edge): the entry API's `readEntries` fails with
+        // an EncodingError on a page opened from a `file://` URL, and a built page is often opened that way.
+        const walkHandle = async (h, path) => {
+          if (h.kind === "file") {
+            try { send(await h.getFile(), path); } catch (e) { failed(path, e); }
+            return;
+          }
+          try { for await (const kid of h.values()) await walkHandle(kid, path + "/" + kid.name); }
+          catch (e) { failed(path, e); }
+        };
+        // Handles and entries are taken during the event: a drop's items are unreadable once it returns.
+        // A browser with neither, or a drop of something that is not a file, falls back to `files`.
         const dropped = (dt) => {
           const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
+          const files = [...(dt?.files ?? [])];
+          if (items.length > 0 && items.every((it) => it.getAsFileSystemHandle)) {
+            items.map((it) => it.getAsFileSystemHandle()).forEach((pending, i) => pending.then(
+              (h) => h ? walkHandle(h, h.name) : take([files[i]]),
+              () => take([files[i]])));
+            return;
+          }
           const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
           if (entries.length > 0 && entries.every((x) => x !== null)) entries.forEach(walk);
           else take(dt?.files);
