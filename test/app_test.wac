// The explorer driven with no browser: a `TestDoc` stands in for the document, files arrive the way the
// host delivers them, and the timers and frames the page asks for are fired by hand.

import { Vec } from "core";
import { Dom, Page, TestDoc, fileArrived, timerFired } from "web";
import { main } from "../src/app.wac";
import { tarGz, zipBasic } from "./fixtures.wac";

struct Harness { TestDoc doc; Page page; Vec<i32> pending; }

Harness started() {
  TestDoc doc = TestDoc.create();
  Vec<i32> pending = Vec.create();
  Dom d = doc.dom();
  d.timer = (i32 id, i32 ms) => { pending.push(id); };
  d.frame = (i32 id) => { pending.push(id); };
  Page page = Page.create(d);
  doc.attach(page);
  schedule page.take;
  main(page);
  page.drain();
  page.turn();
  return Harness(doc, page, pending);
}

/** Fire what the page is waiting on, a few rounds — the watchdog's timer asks again every time. */
void settle(Harness h) {
  for (i32 round = 0; round < 4; round++) {
    i32[] now = h.pending.toArray();
    h.pending.clear();
    for (i32 i = 0; i < now.len(); i++) { timerFired(h.page, now[i]); }
  }
}

void drop(Harness h, string name, u8[] bytes) {
  fileArrived(h.page, true, name, bytes, "");
  settle(h);
}

string page(Harness h) { return h.doc.shown(0); }

bool showing(Harness h, string s) { return page(h).indexOf(s) >= 0; }

void click(Harness h, string title) { h.doc.fire(h.doc.find("title", title), "click", ""); }

export string test_landing_asks_for_a_file() {
  Harness h = started();
  if (!showing(h, "Drop a file or folder anywhere")) { return "landing: \{page(h).slice(0, 120)}"; }
  return "";
}

export string test_a_dropped_zip_lists_as_folders_and_previews_a_file() {
  Harness h = started();
  drop(h, "basic.zip", zipBasic());
  if (!showing(h, "basic.zip") || !showing(h, "readme.txt") || !showing(h, "src")) { return "listing: \{page(h).slice(0, 300)}"; }
  click(h, "readme.txt");
  if (!showing(h, "hello zip")) { return "preview did not show the text"; }
  click(h, "src");
  if (!showing(h, "main.c") || !showing(h, "lib")) { return "src folder: \{page(h).slice(0, 300)}"; }
  return "";
}

export string test_a_tgz_opens_straight_to_its_tar() {
  Harness h = started();
  drop(h, "pkg.tgz", tarGz());
  if (!showing(h, "pkg.tgz")) { return "breadcrumb missing"; }
  click(h, "pkg");
  if (!showing(h, "a.txt")) { return "pkg folder: \{page(h).slice(0, 300)}"; }
  return "";
}

export string test_a_filter_that_matches_nothing_says_so() {
  Harness h = started();
  drop(h, "basic.zip", zipBasic());
  h.doc.fire(h.doc.find("placeholder", "Filter everything…"), "input", "no-such-file");
  if (!showing(h, "Nothing here matches")) { return "empty filter: \{page(h).slice(0, 300)}"; }
  h.doc.fire(h.doc.find("placeholder", "Filter everything…"), "input", "deep");
  if (!showing(h, "deep.txt")) { return "filter did not reach below the root"; }
  return "";
}

export string test_a_folder_arrives_file_by_file_and_opens_as_one() {
  Harness h = started();
  // As the host delivers a dropped folder: one file at a time, each named by its path.
  fileArrived(h.page, true, "proj/notes.txt", "folder notes\n".toBytes(), "");
  fileArrived(h.page, true, "proj/src/basic.zip", zipBasic(), "");
  fileArrived(h.page, false, "proj/locked.bin", u8[](), "NotReadableError");
  if (!showing(h, "Reading 3 files")) { return "while gathering: \{page(h).slice(0, 200)}"; }
  settle(h);
  if (!showing(h, "proj") || !showing(h, "notes.txt") || !showing(h, "src")) { return "folder: \{page(h).slice(0, 300)}"; }
  if (showing(h, "locked.bin")) { return "an unreadable file was listed"; }
  if (!showing(h, "1 file could not be read")) { return "the failure was not noted"; }
  click(h, "notes.txt");
  if (!showing(h, "folder notes")) { return "preview of a folder file"; }
  click(h, "src");
  click(h, "basic.zip");
  if (!showing(h, "Open archive")) { return "an archive in a folder did not offer to open"; }
  return "";
}

export string test_a_single_file_after_a_folder_still_opens_alone() {
  Harness h = started();
  fileArrived(h.page, true, "proj/a.txt", "a".toBytes(), "");
  settle(h);
  drop(h, "basic.zip", zipBasic());
  if (!showing(h, "basic.zip") || !showing(h, "readme.txt")) { return "after a folder: \{page(h).slice(0, 300)}"; }
  return "";
}

export string test_files_dropped_together_open_together() {
  Harness h = started();
  // A folder and a loose file, dropped at once: the loose file tends to arrive first.
  fileArrived(h.page, true, "notes.txt", "loose\n".toBytes(), "");
  fileArrived(h.page, true, "proj/a.txt", "a".toBytes(), "");
  settle(h);
  if (!showing(h, "Dropped items") || !showing(h, "notes.txt") || !showing(h, "proj")) { return "together: \{page(h).slice(0, 300)}"; }
  // Two archives at once are a folder of two archives.
  Harness g = started();
  fileArrived(g.page, true, "one.zip", zipBasic(), "");
  fileArrived(g.page, true, "two.tgz", tarGz(), "");
  settle(g);
  if (!showing(g, "Dropped items") || !showing(g, "one.zip") || !showing(g, "two.tgz")) { return "two archives: \{page(g).slice(0, 300)}"; }
  return "";
}
