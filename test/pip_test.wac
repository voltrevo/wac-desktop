// Pip's rules, played a step at a time on small levels made for each test: how high a jump goes and how a tap
// differs from a hold, the forgiveness at edges and before landing, a wall jump, lanterns and the door, spikes and
// checkpoints, and a stomp. Then the levels themselves, the tune's notes, and the times kept.

import { Level, allLevels } from "../src/apps/pip/levels.wac";
import { Vec } from "core";
import { CUE_HURT, CUE_JUMP, CUE_SPRING, Foe, CUE_LANTERN, CUE_OPEN, CUE_STOMP, CUE_WALL_JUMP, CUE_WIN, Keys, World, load, step } from "../src/apps/pip/world.wac";
import { noteOf } from "../src/apps/pip/chip.wac";
import { Screen, follow, snap } from "../src/apps/pip/art.wac";
import { clock, restoreBest } from "../src/apps/pip.wac";

/** A level of `rows`, padded with air to the full width, bedrock below. */
World made(string[] rows) {
  string[] full = string[].filled(12, "");
  for (i32 y = 0; y < 12; y++) {
    string r = y < rows.len() ? rows[y] : (y == 11 ? "#" : ".");
    u8 fill = y == 11 ? '#' : '.';
    while (r.len() < 64) { r = r + string.fromBytes([fill]); }
    full[y] = r;
  }
  return load(Level("test", full));
}

Keys pressing(bool left, bool right, bool jump, bool jumped) { return Keys(left, right, jump, jumped); }

/** Steps with `k`, the first with `jumped` as given and the rest without; whether any cued `c`. */
bool stepFor(World w, Keys k, i32 n, i32 c) {
  bool seen = false;
  for (i32 i = 0; i < n; i++) {
    step(w, k);
    k.jumped = false;
    for (i32 j = 0; j < w.cues.len(); j++) { if (w.cues.get(j) == c) { seen = true; } }
  }
  return seen;
}

/** The highest Pip's feet rise above where they started, jumping with jump held for `hold` steps. */
f64 rise(i32 hold) {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "..P", "####"]);
  stepFor(w, Keys.none(), 5, 0);
  f64 floor = w.hero.y;
  f64 top = floor;
  for (i32 i = 0; i < 80; i++) {
    step(w, pressing(false, false, i < hold, i == 0));
    if (w.hero.y < top) { top = w.hero.y; }
  }
  return floor - top;
}

export string test_a_held_jump_clears_three_tiles_and_a_tap_is_a_hop() {
  f64 high = rise(80);
  if (high < 49.0 || high > 60.0) { return "a held jump rises \{high} px; three tiles are 48"; }
  f64 hop = rise(2);
  if (hop > 20.0) { return "a tap rises \{hop} px — it should be a hop"; }
  return "";
}

export string test_a_jump_just_after_the_edge_still_jumps() {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "P.", "###"]);
  stepFor(w, Keys.none(), 5, 0);
  // Run right off the edge of the third tile, and jump four steps after leaving it.
  i32 left = 0 - 1;
  for (i32 i = 0; i < 120 && left < 0; i++) {
    step(w, pressing(false, true, false, false));
    if (!w.hero.ground) { left = i; }
  }
  if (left < 0) { return "never left the edge"; }
  stepFor(w, pressing(false, true, false, false), 3, 0);
  if (!stepFor(w, pressing(false, true, true, true), 1, CUE_JUMP)) { return "a jump four steps after the edge did nothing"; }
  World late = made([".", ".", ".", ".", ".", ".", ".", ".", "P.", "###"]);
  stepFor(late, Keys.none(), 5, 0);
  while (late.hero.ground) { step(late, pressing(false, true, false, false)); }
  stepFor(late, pressing(false, true, false, false), 12, 0);
  if (stepFor(late, pressing(false, true, true, true), 1, CUE_JUMP)) { return "a jump twelve steps after the edge jumped from the air"; }
  return "";
}

export string test_a_jump_pressed_just_before_landing_happens_on_landing() {
  World w = made([".", ".", ".", ".", "..P", ".", ".", ".", ".", "####"]);
  // Falling; jump pressed a few steps before the ground, and held.
  i32 landedAt = 0 - 1;
  World probe = made([".", ".", ".", ".", "..P", ".", ".", ".", ".", "####"]);
  for (i32 i = 0; i < 80 && landedAt < 0; i++) {
    step(probe, Keys.none());
    if (probe.hero.ground) { landedAt = i; }
  }
  stepFor(w, Keys.none(), landedAt - 4, 0);
  if (!stepFor(w, pressing(false, false, true, true), 8, CUE_JUMP)) { return "the jump pressed four steps early was lost"; }
  return "";
}

export string test_against_a_wall_pip_slides_and_jumps_off_it() {
  World w = made([".", ".", "....#", "....#", "....#", "....#", "....#", "....#", "..P.#", "#####"]);
  stepFor(w, Keys.none(), 5, 0);
  // Up against the wall, falling, holding toward it.
  stepFor(w, pressing(false, true, true, true), 14, 0);
  stepFor(w, pressing(false, true, false, false), 12, 0);
  if (w.hero.wall != 1) { return "not against the wall: \{w.hero.x}, \{w.hero.y}"; }
  if (w.hero.vy > 1.4) { return "falling at \{w.hero.vy} against the wall, not sliding"; }
  if (!stepFor(w, pressing(false, true, true, true), 1, CUE_WALL_JUMP)) { return "no wall jump"; }
  if (w.hero.vx >= 0.0) { return "the wall jump pushed toward the wall"; }
  return "";
}

export string test_the_door_opens_once_every_lantern_is_lit() {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "P.L...E..L..#", "#############"]);
  stepFor(w, Keys.none(), 3, 0);
  if (!stepFor(w, pressing(false, true, false, false), 30, CUE_LANTERN)) { return "the first lantern was not lit"; }
  // On past the door, shut, to the last lantern.
  if (!stepFor(w, pressing(false, true, false, false), 60, CUE_OPEN)) { return "lighting the last lantern did not open the door"; }
  if (w.won) { return "the door let Pip through with a lantern unlit"; }
  if (!stepFor(w, pressing(true, false, false, false), 200, CUE_WIN)) { return "the open door was not a way out"; }
  if (w.lit != 2 || !w.won) { return "lit \{w.lit}, won \{w.won}"; }
  return "";
}

export string test_spikes_send_pip_back_to_the_last_flag() {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "P..C....^", "#########"]);
  stepFor(w, Keys.none(), 3, 0);
  if (!stepFor(w, pressing(false, true, false, false), 90, CUE_HURT)) { return "the spikes did not hurt"; }
  stepFor(w, Keys.none(), 60, 0);
  if (w.deaths != 1) { return "\{w.deaths} falls"; }
  if (w.hero.x < 48.0 || w.hero.x > 56.0) { return "back at \{w.hero.x}, not at the flag (51)"; }
  return "";
}

export string test_landing_on_a_beetle_stomps_it_and_walking_into_one_hurts() {
  World w = made([".", ".", ".", ".", ".", "...P", ".", ".", "...p", "########"]);
  Foe still = w.foes.get(0);
  still.vx = 0.0;
  if (!stepFor(w, Keys.none(), 30, CUE_STOMP)) { return "falling on the beetle did not stomp it"; }
  if (w.foes.get(0).alive) { return "the beetle lived"; }
  World v = made([".", ".", ".", ".", ".", ".", ".", ".", "P....p", "########"]);
  Foe waiting = v.foes.get(0);
  waiting.vx = 0.0;
  if (!stepFor(v, pressing(false, true, false, false), 60, CUE_HURT)) { return "walking into the beetle did not hurt"; }
  return "";
}

export string test_every_level_has_a_start_a_door_and_lanterns() {
  Level[] ls = allLevels();
  if (ls.len() != 15) { return "\{ls.len()} levels"; }
  for (i32 i = 0; i < ls.len(); i++) {
    World w = load(ls[i]);
    if (ls[i].rows.len() < 12) { return "\{ls[i].name}: \{ls[i].rows.len()} rows"; }
    for (i32 y = 0; y < w.rows; y++) {
      if (ls[i].rows[y].len() != w.cols) { return "\{ls[i].name}, row \{y}: \{ls[i].rows[y].len()} wide, not \{w.cols}"; }
    }
    // The first five are short; the next seven at least twice as long, and the last three towers.
    if (i >= 5 && i < 12 && w.cols < 128) { return "\{ls[i].name}: \{w.cols} wide"; }
    if (i >= 12 && w.rows < 40) { return "\{ls[i].name}: \{w.rows} high"; }
    if (w.lanterns < 3) { return "\{ls[i].name}: \{w.lanterns} lanterns"; }
    if (w.hero.x <= 0.0) { return "\{ls[i].name}: no start"; }
    bool door = false;
    for (i32 k = 0; k < w.tiles.len(); k++) { if (w.tiles[k] == 'E') { door = true; } }
    if (!door) { return "\{ls[i].name}: no door"; }
    // Standing still at the start, nothing happens to Pip.
    stepFor(w, Keys.none(), 60, 0);
    if (w.deaths != 0 || !w.hero.ground) { return "\{ls[i].name}: Pip does not stand at the start"; }
  }
  return "";
}

export string test_notes_and_times_read_as_written() {
  if (noteOf("A4") != 0 || noteOf("C5") != 3 || noteOf("A2") != 0 - 24 || noteOf("C#4") != 0 - 8) { return "notes"; }
  if (clock(3600) != "1:00.0" || clock(83) != "0:01.3") { return "clock: \{clock(3600)}, \{clock(83)}"; }
  i32[] best = i32[].filled(5, 0);
  i32 reached = restoreBest("2 300 0 451\n", best);
  if (reached != 2 || best[0] != 300 || best[1] != 0 || best[2] != 451 || best[3] != 0) { return "kept times: \{reached}"; }
  return "";
}

/**
 * **Turning round does not jerk the view**: running right and then back, the camera never moves further in a step than
 * Pip can run in one and a little more, and a hop on the spot does not move it at all.
 */
export string test_the_camera_follows_smoothly_when_pip_turns() {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "..........P", "################################################################"]);
  Screen s = Screen.create();
  snap(s, w);
  f64 worst = 0.0;
  for (i32 i = 0; i < 400; i++) {
    bool right = (i / 50) % 2 == 0;
    f64 before = s.camF;
    step(w, pressing(!right, right, false, false));
    follow(s, w);
    f64 moved = s.camF - before;
    if (moved < 0.0) { moved = 0.0 - moved; }
    if (moved > worst) { worst = moved; }
  }
  if (worst > 4.0) { return "the camera moved \{worst} px in one step"; }
  World still = made([".", ".", ".", ".", ".", ".", ".", ".", "..........P", "################################################################"]);
  Screen t = Screen.create();
  snap(t, still);
  f64 at = t.camF;
  for (i32 i = 0; i < 60; i++) {
    step(still, pressing(false, false, i < 10, i == 0));
    follow(t, still);
  }
  if (t.camF != at) { return "a hop on the spot moved the camera from \{at} to \{t.camF}"; }
  return "";
}


export string test_a_spring_throws_pip_seven_tiles_up() {
  World w = made([".", ".", ".", ".", ".", ".", ".", ".", "..P", "##S#"]);
  f64 floor = 0.0;
  bool sprung = false;
  f64 top = 999.0;
  for (i32 i = 0; i < 120; i++) {
    step(w, pressing(false, false, false, false));
    // From the first throw to the top of it.
    for (i32 j = 0; j < w.cues.len(); j++) {
      if (w.cues.get(j) == CUE_SPRING && !sprung) {
        sprung = true;
        floor = w.hero.y;
      }
    }
    if (sprung && w.hero.y < top) { top = w.hero.y; }
  }
  if (!sprung) { return "standing on the spring did not throw Pip"; }
  f64 rose = floor - top;
  if (rose < 7.0 * 16.0 || rose > 9.0 * 16.0) { return "the spring threw Pip \{rose} px"; }
  return "";
}

/** The level's tile at (`x`, `y`): air above it, bedrock beside and below. */
u8 at(Level l, i32 x, i32 y) {
  if (y < 0) { return '.'; }
  if (y >= l.rows.len() || x < 0 || x >= l.rows[y].len()) { return '#'; }
  return l.rows[y].toBytes()[x];
}

bool firm(u8 c) { return c == '#' || c == 'X' || c == 'S'; }

/** One place Pip can be: standing, or against a wall in the air — `side` -1 a wall on the left, 1 on the right. */
struct Spot {
  i32 x;
  i32 y;
  bool stands;
  i32 side;
}

/** Whether a jump from standing at (`x`, `y`) reaches (`u`, `v`): the envelope, smaller than Pip's own leaps. */
bool leap(i32 x, i32 y, i32 u, i32 v, bool sprung) {
  i32 dx = u > x ? u - x : x - u;
  i32 up = y - v;
  return (up == 3 && dx <= 2) || (up == 2 && dx <= 4) || (up >= 0 && up <= 1 && dx <= 5) || (up < 0 && dx <= 6 + (0 - up) / 2)
      || (sprung && up >= 0 && up <= 7 && dx <= 3);
}

/** Whether a wall jump from `a` reaches `b`: to the facing wall up to three across and two up, or to ground likewise. */
bool offTheWall(Spot a, Spot b) {
  i32 away = 0 - a.side;
  i32 across = (b.x - a.x) * away;
  i32 up = a.y - b.y;
  if (b.side == 0 - a.side && across >= 0 && across <= 3 && up >= 0 && up <= 2) { return true; }
  if (b.stands && across >= 0 && across <= 4 && up >= 0 && up <= 2) { return true; }
  // Or slid, or fallen, down.
  i32 dx = b.x > a.x ? b.x - a.x : a.x - b.x;
  return up < 0 && dx <= 5;
}

/**
 * **Every lantern, flag and door can be reached** from the start by runs, jumps, drops, springs and wall jumps — under
 * an envelope smaller than Pip's own (`test_the_leaps_the_reachability_check_assumes_are_real`,
 * `test_pip_climbs_a_chimney_and_steps_out_at_the_top`), ignoring the foes, the time a block takes to crumble, and
 * where a sliding plank is: what the levels were designed to.
 */
export string test_every_lantern_flag_and_door_can_be_reached() {
  Level[] ls = allLevels();
  for (i32 n = 0; n < ls.len(); n++) {
    Level l = ls[n];
    i32 cols = l.rows[0].len();
    i32 rows = l.rows.len();
    // Where a sliding plank can be: three tiles from its left end, and the two of its width beyond.
    bool[] slides = bool[].filled(cols * (rows + 1), false);
    for (i32 y = 0; y < rows; y++) {
      for (i32 x = 0; x < cols; x++) {
        if (at(l, x, y) == 'M') { for (i32 d = 0; d < 6 && x + d < cols; d++) { slides[y * cols + x + d] = true; } }
      }
    }
    // Where Pip can be: two tiles of room, standing on something or against a wall two tiles high.
    Vec<Spot> spots = Vec.create();
    i32 start = 0 - 1;
    for (i32 y = 1; y < rows - 1; y++) {
      for (i32 x = 0; x < cols; x++) {
        u8 c = at(l, x, y);
        u8 above = at(l, x, y - 1);
        u8 below = at(l, x, y + 1);
        bool room = !firm(c) && c != '^' && !slides[y * cols + x] && !firm(above) && above != '^';
        if (!room) { continue; }
        bool held = firm(below) || below == '=' || slides[(y + 1) * cols + x];
        if (held) {
          if (c == 'P') { start = spots.len(); }
          spots.push(Spot(x, y, true, 0));
          continue;
        }
        for (i32 side = 0 - 1; side <= 1; side = side + 2) {
          if (firm(at(l, x + side, y)) && firm(at(l, x + side, y - 1))) { spots.push(Spot(x, y, false, side)); }
        }
      }
    }
    if (start < 0) { return "\{l.name}: Pip does not start on anything"; }
    bool[] seen = bool[].filled(spots.len(), false);
    seen[start] = true;
    Vec<i32> todo = Vec.create();
    todo.push(start);
    while (todo.len() > 0) {
      Spot a = spots.get(todo.get(todo.len() - 1));
      todo.remove(todo.len() - 1);
      bool sprung = a.stands && at(l, a.x, a.y + 1) == 'S';
      for (i32 k = 0; k < spots.len(); k++) {
        if (seen[k]) { continue; }
        Spot b = spots.get(k);
        if ((a.stands && leap(a.x, a.y, b.x, b.y, sprung)) || (!a.stands && offTheWall(a, b))) {
          seen[k] = true;
          todo.push(k);
        }
      }
    }
    // A lantern, flag or door is touched from where Pip is, up to two below it and a tile either side.
    for (i32 y = 0; y < rows; y++) {
      for (i32 x = 0; x < cols; x++) {
        u8 c = at(l, x, y);
        if (c != 'L' && c != 'C' && c != 'E') { continue; }
        bool reached = false;
        for (i32 k = 0; k < spots.len() && !reached; k++) {
          Spot b = spots.get(k);
          if (seen[k] && b.x - x >= 0 - 1 && b.x - x <= 1 && b.y - y >= 0 && b.y - y <= 2) { reached = true; }
        }
        if (!reached) { return "\{l.name}: the \{string.fromBytes([c])} at \{x}, \{y} cannot be reached"; }
      }
    }
  }
  return "";
}

/**
 * **Pip climbs a chimney and steps out at the top**, on real physics: in under the shaft's inner wall, then off each
 * wall in turn — `gap` tiles apart, seven high, as the towers have them — and onto the floor above, beside the shaft.
 */
bool chimney(i32 gap) {
  // A floor at row 17, the next at row 10; the shaft against the right wall, its inner wall from 10 down to 14.
  i32 cols = 16;
  i32 inner = cols - 2 - gap;
  string[] rows = string[].filled(19, "");
  for (i32 y = 0; y < 19; y++) {
    string r = "";
    for (i32 x = 0; x < cols; x++) {
      bool wall = x == 0 || x == cols - 1 || y >= 17 || (y == 10 && x < inner) || (x == inner && y >= 10 && y <= 14);
      r = r + (wall ? "#" : (x == 2 && y == 16 ? "P" : "."));
    }
    rows[y] = r;
  }
  World w = load(Level("chimney", rows));
  i32 dir = 1;
  for (i32 i = 0; i < 900; i++) {
    // Standing on the floor above: out. The last jump off the outer wall is the one that carries Pip over the inner.
    if (w.hero.ground && w.hero.y < 160.0) { return true; }
    bool inside = w.hero.x > ((inner * 16) as f64);
    bool press = (inside && w.hero.ground) || (w.hero.wall != 0 && w.hero.lock == 0);
    if (w.hero.wall != 0 && !w.hero.ground) { dir = 0 - w.hero.wall; }
    step(w, pressing(dir < 0, dir > 0, true, press));
  }
  return false;
}

export string test_pip_climbs_a_chimney_and_steps_out_at_the_top() {
  for (i32 gap = 1; gap <= 4; gap++) { if (!chimney(gap)) { return "a chimney \{gap} wide was not climbed"; } }
  // And one too wide is not: off each wall, Pip falls further than the jump rises.
  if (chimney(6)) { return "a chimney six wide should be too wide"; }
  return "";
}

/**
 * Whether Pip, running from the left and jumping at the last moment, lands `across` tiles on (counting from the last
 * tile of ground) and `up` tiles higher — on real physics, the leaps the reachability check above takes for granted.
 */
bool leaps(i32 across, i32 up) {
  string[] rows = string[].filled(12, "");
  for (i32 y = 0; y < 12; y++) {
    string r = "";
    for (i32 x = 0; x < 64; x++) {
      bool ground = (x <= 9 && y >= 9) || (x >= 9 + across && y >= 9 - up) || y == 11;
      r = r + (ground ? "#" : (x == 2 && y == 8 ? "P" : "."));
    }
    rows[y] = r;
  }
  World w = load(Level("leap", rows));
  bool jumped = false;
  for (i32 i = 0; i < 240; i++) {
    bool now = !jumped && w.hero.x + 10.0 >= 158.0;
    if (now) { jumped = true; }
    step(w, pressing(false, true, jumped, now));
  }
  return w.hero.ground && w.hero.x >= (((9 + across) * 16) as f64) - 6.0 && w.hero.y < (((9 - up) * 16) as f64);
}

export string test_the_leaps_the_reachability_check_assumes_are_real() {
  if (!leaps(2, 3)) { return "two across and three up"; }
  if (!leaps(4, 2)) { return "four across and two up"; }
  if (!leaps(5, 1)) { return "five across and one up"; }
  if (!leaps(5, 0)) { return "five across"; }
  // And it can tell: what is out of reach is not reached.
  if (leaps(9, 0)) { return "nine across should be too far"; }
  if (leaps(1, 5)) { return "five up should be too high"; }
  return "";
}

/** **The camera follows Pip up a tower**: from the bottom floor's view to a floor high above, smoothly. */
export string test_the_camera_follows_pip_up_and_down() {
  World w = load(allLevels()[12]);
  Screen s = Screen.create();
  snap(s, w);
  i32 bottom = s.camY;
  if (bottom != w.rows * 16 - 180) { return "at the start the view is not at the bottom: \{bottom}"; }
  // Pip, set three floors up.
  w.hero.y = w.hero.y - 21.0 * 16.0;
  f64 worst = 0.0;
  for (i32 i = 0; i < 120; i++) {
    f64 before = s.camYF;
    follow(s, w);
    f64 moved = before - s.camYF;
    if (moved > worst) { worst = moved; }
  }
  f64 shown = w.hero.y - s.camYF;
  if (shown < 40.0 || shown > 140.0) { return "Pip is \{shown} px down the view, not near its middle"; }
  if (worst > 60.0) { return "the view jumped \{worst} px in a step"; }
  return "";
}
