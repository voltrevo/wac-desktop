import { Incident, command, incident, seconds, update } from "../src/apps/keep-cool/rules.wac";

export string test_keep_cool_all_incidents_match_the_manual() {
  i32[] reserve = [0, 1, 2, 1, 2, 0, 2, 0, 1];
  i32[] pump = [0, 1, 1, 0];
  for (i32 seed = 0; seed < 72; seed++) {
    Incident run = incident(seed, 0.0);
    i32 r = reserve[run.feed * 3 + run.load];
    command(run, run.feed == 1 ? r : 3, 1000.0);
    command(run, run.feed == 1 ? 3 : r, 2000.0);
    if (run.stage != 1) { return "manual reserve failed for incident \{seed}"; }
    command(run, run.loop == 0 ? 0 : 1, 3000.0);
    command(run, run.loop == 0 ? 2 : 3, 4000.0);
    if (run.stage != 2) { return "manual routing failed for incident \{seed}"; }
    command(run, pump[run.signal], 5000.0);
    update(run, 9999.0);
    if (run.stage != 3) { return "confirmation happened too early"; }
    update(run, 10000.0);
    if (run.stage != 4 || run.faults != 0) { return "manual pump failed for incident \{seed}"; }
  }
  return "";
}

export string test_keep_cool_interlock_resets_the_panel_and_costs_time() {
  Incident run = incident(0, 0.0);
  command(run, 3, 1000.0);
  command(run, 2, 2000.0);
  if (run.stage != 0 || run.step != 0 || run.faults != 1 || seconds(run, 2000.0) != 283) {
    return "interlock state: \{run.stage} \{run.step} \{run.faults} \{seconds(run, 2000.0)}";
  }
  command(run, 3, 3000.0);
  command(run, 0, 4000.0);
  if (run.stage != 1) { return "could not retry after an interlock"; }
  update(run, 285000.0);
  command(run, 0, 285001.0);
  if (run.stage != 5 || run.step != 0) { return "timed out incident accepted a command"; }
  return "";
}

export string test_keep_cool_confirmation_has_to_beat_the_deadline() {
  Incident run = incident(0, 0.0);
  run.stage = 2;
  command(run, 0, 295000.0);
  update(run, 300000.0);
  if (run.stage != 5) { return "cooling confirmation at the deadline should lose"; }

  run = incident(0, 0.0);
  run.stage = 2;
  command(run, 0, 294000.0);
  update(run, 301000.0);
  if (run.stage != 4) { return "late render lost a successful confirmation"; }
  return "";
}
