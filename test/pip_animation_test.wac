// Drive the real simulation: animation should describe the jump immediately and cover the full stride on flat ground.
import { allLevels } from "../src/apps/pip/levels.wac";
import { Keys, load, step } from "../src/apps/pip/world.wac";
import { Screen, drawWorld, snap } from "../src/apps/pip/art.wac";
import { pipPose } from "../src/apps/pip/sprites.wac";

export string test_pip_jump_animation_follows_takeoff_apex_fall_and_landing() {
  auto w = load(allLevels()[0]);
  for (i32 i = 0; i < 10; i++) { step(w, Keys.none()); }
  Screen s = Screen.create(); snap(s, w);
  f64 floor = w.hero.y;
  step(w, Keys(false, false, true, true));
  drawWorld(s, w, null, w.steps);
  i32 first = pipPose(w.hero, w.steps, s.landedAt);
  if (w.hero.y >= floor || (first != 9 && first != 10)) { return "takeoff was delayed for animation"; }
  bool apex = false; bool fall = false; bool landing = false; bool recovered = false;
  for (i32 i = 0; i < 85; i++) {
    step(w, Keys(false, false, i < 10, false));
    drawWorld(s, w, null, w.steps);
    i32 pose = pipPose(w.hero, w.steps, s.landedAt);
    if (pose == 11) { apex = true; }
    if (pose == 12 || pose == 13) { fall = true; }
    if (pose == 14) { landing = true; }
    if (landing && pose == 15) { recovered = true; }
  }
  if (!apex || !fall || !landing || !recovered) { return "missing stage in the real jump"; }
  if (w.hero.y != floor || !w.hero.ground) { return "jump did not return to the same floor"; }
  return "";
}

export string test_pip_running_uses_all_six_frames_with_feet_on_the_same_floor() {
  auto w = load(allLevels()[0]);
  for (i32 i = 0; i < 10; i++) { step(w, Keys.none()); }
  f64 floor = w.hero.y;
  bool[] seen = bool[].filled(6, false);
  for (i32 i = 0; i < 30; i++) {
    step(w, Keys(false, true, false, false));
    i32 pose = pipPose(w.hero, w.steps, -1000);
    if (pose >= 3 && pose <= 8) { seen[pose - 3] = true; }
    if (w.hero.y != floor || !w.hero.ground) { return "run animation moved the collision body"; }
  }
  for (i32 i = 0; i < 6; i++) { if (!seen[i]) { return "run frame \{i} never played"; } }
  return "";
}
