// The rich previews' parsers: Markdown as HTML, CSV as cells, code as tokens, paths inside an archive.

import { Node, htmlOf } from "web";
import { MdHost, markdown, resolve } from "../src/markdown.wac";
import { Table, numeric, parseTable } from "../src/table.wac";
import { Lang, highlight, langFor } from "../src/highlight.wac";

MdHost host() {
  return MdHost("docs", (string path) => path == "img/logo.png" ? [0x89, 0x50, 0x4E, 0x47] as u8[] : null, (string path) => { });
}

string md(string src) { return htmlOf(markdown(src.toBytes(), host())); }

bool has(string s, string part) { return s.indexOf(part) >= 0; }

export string test_markdown_blocks() {
  string h = md("# Title\n\nSome *em* and **strong** and `code`.\n\n- one\n- two\n  - nested\n\n1. first\n2. second\n\n> quoted\n\n---\n");
  if (!has(h, "<h1>Title</h1>")) { return "heading: \{h}"; }
  if (!has(h, "<em>em</em>") || !has(h, "<strong>strong</strong>") || !has(h, "<code>code</code>")) { return "inline: \{h}"; }
  if (!has(h, "<ul><li>one</li><li>two<ul><li>nested</li></ul></li></ul>")) { return "lists: \{h}"; }
  if (!has(h, "<ol><li>first</li><li>second</li></ol>")) { return "ordered: \{h}"; }
  if (!has(h, "<blockquote><p>quoted</p></blockquote>") || !has(h, "<hr>")) { return "quote/rule: \{h}"; }
  return "";
}

export string test_markdown_setext_tables_tasks_and_fences() {
  string h = md("Big\n===\n\n| a | b |\n|---|--:|\n| 1 | 2 |\n\n- [x] done\n- [ ] todo\n\n```js\nconst x = 1;\n```\n");
  if (!has(h, "<h1>Big</h1>")) { return "setext: \{h}"; }
  if (!has(h, "<th>a</th><th class=\"r\">b</th>") || !has(h, "<td class=\"r\">2</td>")) { return "table: \{h}"; }
  if (!has(h, "☑ done") || !has(h, "☐ todo")) { return "tasks: \{h}"; }
  if (!has(h, "<span class=\"tk-k\">const</span>") || !has(h, "<span class=\"tk-n\">1</span>")) { return "fence: \{h}"; }
  return "";
}

export string test_markdown_is_never_html() {
  string h = md("<script>alert(1)</script> and <b onclick=x>bold</b> &amp; <br> done");
  if (has(h, "<script") || has(h, "onclick") || has(h, "<b ")) { return "markup got through: \{h}"; }
  if (!has(h, "alert(1)") || !has(h, "bold") || !has(h, "&amp;") || !has(h, "<br>")) { return "text was lost: \{h}"; }
  return "";
}

export string test_markdown_links_and_images_resolve_inside_the_archive() {
  string h = md("![logo](../img/logo.png) ![far](https://example.invalid/x.png) [ext](https://example.invalid) see https://example.invalid/y.");
  if (!has(h, "src=\"data:image/png;base64,iVBORw==\"")) { return "local image: \{h}"; }
  if (!has(h, "class=\"imgph\"")) { return "a remote image should be a placeholder: \{h}"; }
  if (!has(h, "href=\"https://example.invalid\"") || !has(h, "href=\"https://example.invalid/y\"")) { return "links: \{h}"; }
  if (resolve("docs/a", "../b/./c.md#top") != "docs/b/c.md") { return "resolve: \{resolve("docs/a", "../b/./c.md#top")}"; }
  return "";
}

export string test_csv_quotes_delimiters_and_numbers() {
  Table t = parseTable("name,note,n\n\"Smith, J\",\"said \"\"hi\"\"\n twice\",3\nx,,4\n".toBytes(), "a.csv", 100);
  if (t.total != 3 || t.width != 3) { return "shape: \{t.total} rows, \{t.width} wide"; }
  if (t.rows[1][0] != "Smith, J" || t.rows[1][1] != "said \"hi\"\n twice") { return "quoted: \{t.rows[1][0]} / \{t.rows[1][1]}"; }
  if (t.rows[2][1] != "") { return "empty cell"; }
  Table s = parseTable("a;b\n1,5;2\n".toBytes(), "eu.csv", 100);
  if (s.rows[1][0] != "1,5") { return "semicolons: \{s.rows[1][0]}"; }
  if (!numeric("1,234.5") || !numeric("-3e5") || numeric("12 apples")) { return "numeric"; }
  return "";
}

export string test_highlight_keeps_every_byte() {
  Lang c = langFor("x.c")!;
  string src = "int main() { /* hi */ return \"s\\\"q\" + 42; } // end";
  Node[] spans = highlight(src.toBytes(), c);
  string h = htmlOf(Node.Fragment(spans));
  if (!has(h, "<span class=\"tk-k\">int</span>") || !has(h, "<span class=\"tk-f\">main</span>")) { return "words: \{h}"; }
  if (!has(h, "<span class=\"tk-c\">/* hi */</span>") || !has(h, "<span class=\"tk-c\">// end</span>")) { return "comments: \{h}"; }
  if (!has(h, "<span class=\"tk-s\">\"s\\\"q\"</span>")) { return "string with an escape: \{h}"; }
  // Strip the tags and decode the two entities in play: what is left must be the input, exactly.
  string text = "";
  bool inTag = false;
  for (i32 i = 0; i < h.len(); i++) {
    string ch = h.slice(i, i + 1);
    if (ch == "<") { inTag = true; } else if (ch == ">") { inTag = false; } else if (!inTag) { text = text + ch; }
  }
  string back = text;
  while (back.indexOf("&quot;") >= 0) { i32 k = back.indexOf("&quot;"); back = back.slice(0, k) + "\"" + back.slice(k + 6, back.len()); }
  if (back != src) { return "bytes lost: \{back}"; }
  if (langFor("notes.txt") is not null) { return "plain text got a language"; }
  return "";
}
