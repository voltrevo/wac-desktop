{
  imports: {
    // The rest of wac, as one dependency — `import { json.parse, fs.Fs } from "wac"` — read only as far
    // as a program reaches into it.
    wac: { git: 'https://github.com/voltrevo/wac', ref: '001db0fc5825f87b9da89605b16823fa00fe3ab5' },
    // The page a program is handed — `import { Page, Event } from "web"`.
    web: { git: 'https://github.com/voltrevo/wac', ref: '001db0fc5825f87b9da89605b16823fa00fe3ab5', subdir: './packages/web' },
    // The page builder `build.wac` calls — a program, so building needs nothing but `wac`.
    webbuild: { git: 'https://github.com/voltrevo/wac', ref: '001db0fc5825f87b9da89605b16823fa00fe3ab5', subdir: './packages/web/tools' },
  },
}
