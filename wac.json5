{
  imports: {
    // The rest of wac, as one dependency — `import { json.parse, fs.Fs } from "wac"` — read only as far
    // as a program reaches into it.
    wac: { git: 'https://github.com/voltrevo/wac', ref: 'b0d60f33053d2e52977d8e063faf3184bf2182ab' },
    // The page a program is handed — `import { Page, Event } from "web"`.
    web: { git: 'https://github.com/voltrevo/wac', ref: 'b0d60f33053d2e52977d8e063faf3184bf2182ab', subdir: './packages/web' },
    // The page builder `build.wac` calls — a program, so building needs nothing but `wac`.
    webbuild: { git: 'https://github.com/voltrevo/wac', ref: 'b0d60f33053d2e52977d8e063faf3184bf2182ab', subdir: './packages/web/tools' },
  },
}
