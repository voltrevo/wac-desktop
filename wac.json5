{
  imports: {
    // The rest of wac, as one dependency — `import { json.parse, fs.Fs } from "wac"` — read only as far
    // as a program reaches into it.
    wac: { git: 'https://github.com/voltrevo/wac', ref: '1afa908ef255fc585c444447b18ed2b50ad6568d' },
    // The page a program is handed — `import { Page, Event } from "web"`.
    web: { git: 'https://github.com/voltrevo/wac', ref: '1afa908ef255fc585c444447b18ed2b50ad6568d', subdir: './packages/web' },
    // The page builder `build.wac` calls — a program, so building needs nothing but `wac`.
    webbuild: { git: 'https://github.com/voltrevo/wac', ref: '1afa908ef255fc585c444447b18ed2b50ad6568d', subdir: './packages/web/tools' },
  },
}
