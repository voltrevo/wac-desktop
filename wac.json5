{
  imports: {
    // The rest of wac, as one dependency — `import { json.parse, fs.Fs } from "wac"` — read only as far
    // as a program reaches into it.
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: '84955c78c187a9c5f0c5be13d6666927c7fbdcef' },
    // The page a program is handed — `import { Page, Event } from "web"` — a repository of its own since 2026-10-29.
    web: { git: 'https://github.com/voltrevo/wac-web.git', ref: 'b60d2f47315eee84c9776a9ca976882ebfdcd077' },
    // The wac IDE, which the build makes one of the desktop's programs (`src/apps/ide.wac`).
    ide: { git: 'https://github.com/voltrevo/wac-ide.git', ref: '5a88260f90099b4446712f092d308e6200c1ab75' },
    // The page builder `build.wac` calls — a program, so building needs nothing but `wac`.
    webbuild: { git: 'https://github.com/voltrevo/wac-web.git', ref: 'b60d2f47315eee84c9776a9ca976882ebfdcd077', subdir: './tools' },
  },
}
